// ממשק.יוד — לוח בקרה כהה · מידע בתוך הגרפים

פונקציה צבע_תוויות()
  תווית_מותג.קבע_צבע: 56, 189, 248
  תווית_כותרת.קבע_צבע: 139, 148, 158
  תווית_עלייה.קבע_צבע: 167, 243, 208
  תווית_התראה.קבע_צבע: 251, 146, 60
  תווית_סיכום.קבע_צבע: 148, 163, 184
  תווית_סינון.קבע_צבע: 148, 163, 184
  תווית_תהליכים_כ.קבע_צבע: 230, 237, 243
סוף

פונקציה ייצא_תהליכים()
  משתנה נתיב = חלונות.בחר_שמירה("שמירת תהליכים כ־CSV")
  אם נתיב == ריק
    החזר ריק
  סוף
  רשימת_תה.ייצא_csv: נתיב
  חלונות.הודעה: "ייצוא", "הקובץ נשמר:\n" + נתיב
סוף

פונקציה סנן_תהליכים()
  רשימת_תה.סנן: שדה_סינון.קרא_טקסט()
סוף

פונקציה בנה_חלון_מידע()
  משתנה ח = חלונות.חלון: "מידע מחשב · יוד"
  ח.קבע_גודל: 1180, 900
  ח.קבע_כהה: אמת

  ח.קבע_תפריט: [
    {
      "שם": "קובץ",
      "פריטים": [
        {"שם": "רענון", "פעולה": רענן_מידע},
        {"שם": "ייצוא CSV…", "פעולה": ייצא_תהליכים},
        {"שם": "-"},
        {"שם": "יציאה", "פעולה": סגור_חלון_הודעה}
      ]
    }
  ]

  // —— כותרת ——
  תווית_מותג = חלונות.תווית: "מידע מחשב"
  תווית_כותרת = חלונות.תווית: "טוען…"
  תווית_עלייה = חלונות.תווית: "…"
  תווית_התראה = חלונות.תווית: ""

  משתנה כרטיס_כותרת = חלונות.מסגרת: "אופקי"
  כרטיס_כותרת.קבע_רקע: 22, 27, 34
  כרטיס_כותרת.הוסף: תווית_מותג
  כרטיס_כותרת.הוסף: תווית_כותרת
  כרטיס_כותרת.הוסף: תווית_עלייה
  כרטיס_כותרת.הוסף: תווית_התראה

  // —— גרפים ——
  גרף_מעבד = גרפים.קו()
  גרף_מעבד.קבע_כותרת: "מעבד"
  גרף_מעבד.קבע_תת_כותרת: "טוען…"
  גרף_מעבד.קבע_ציר_Y: "%"
  גרף_מעבד.קבע_טווח_Y: 0, 100
  גרף_מעבד.קבע_מקרא: שקר
  גרף_מעבד.קבע_גובה: 260

  גרף_זיכרון = גרפים.עוגה()
  גרף_זיכרון.קבע_כותרת: "זיכרון"
  גרף_זיכרון.קבע_תת_כותרת: "טוען…"
  גרף_זיכרון.קבע_גובה: 260

  משתנה שורת_גרפים = חלונות.מסגרת: "אופקי"
  שורת_גרפים.הוסף: גרף_מעבד
  שורת_גרפים.הוסף: גרף_זיכרון

  גרף_כוננים = גרפים.עמודות()
  גרף_כוננים.קבע_כותרת: "כוננים"
  גרף_כוננים.קבע_תת_כותרת: "טוען…"
  גרף_כוננים.קבע_ציר_Y: "מגה"
  גרף_כוננים.קבע_גובה: 220

  משתנה כרטיס_כוננים = חלונות.מסגרת: "אנכי"
  כרטיס_כוננים.קבע_רקע: 22, 27, 34
  כרטיס_כוננים.הוסף: גרף_כוננים

  // —— תהליכים ——
  תווית_תהליכים_כ = חלונות.תווית: "תהליכים"
  תווית_סיכום = חלונות.תווית: "טוען…"
  תווית_סינון = חלונות.תווית: "סינון:"
  שדה_סינון = חלונות.שדה: ""
  שדה_סינון.קבע_רמז: "הקלדו חלק משם תהליך"

  משתנה כפתור_רענון = חלונות.כפתור: "רענון"
  כפתור_רענון.קבע_רמז: "רענון מיידי"
  כפתור_רענון.בלחיצה: רענן_מידע

  משתנה כפתור_סיום = חלונות.כפתור: "סיים תהליך"
  כפתור_סיום.קבע_רמז: "מסיים את התהליך הנבחר"
  כפתור_סיום.בלחיצה: סיים_נבחר

  משתנה כפתור_סנן = חלונות.כפתור: "סנן"
  כפתור_סנן.בלחיצה: סנן_תהליכים

  משתנה כפתור_ייצוא = חלונות.כפתור: "CSV"
  כפתור_ייצוא.קבע_רמז: "ייצוא הטבלה לקובץ"
  כפתור_ייצוא.בלחיצה: ייצא_תהליכים

  רשימת_תה = חלונות.טבלה()
  רשימת_תה.קבע_שדות: [
    {"שם": "שם", "רוחב": 280},
    {"שם": "מזהה", "רוחב": 90},
    {"שם": "זיכרון", "רוחב": 140},
    {"שם": "נתיב", "רוחב": 360}
  ]
  רשימת_תה.קבע_גובה: 260

  משתנה סרגל = חלונות.מסגרת: "אופקי"
  סרגל.קבע_רקע: 30, 37, 46
  סרגל.הוסף: כפתור_רענון
  סרגל.הוסף: כפתור_סיום
  סרגל.הוסף: כפתור_ייצוא
  סרגל.הוסף: תווית_סינון
  סרגל.הוסף: שדה_סינון
  סרגל.הוסף: כפתור_סנן

  משתנה כרטיס_תהליכים = חלונות.מסגרת: "אנכי"
  כרטיס_תהליכים.קבע_רקע: 22, 27, 34
  כרטיס_תהליכים.הוסף: תווית_תהליכים_כ
  כרטיס_תהליכים.הוסף: תווית_סיכום
  כרטיס_תהליכים.הוסף: סרגל
  כרטיס_תהליכים.הוסף: רשימת_תה

  ח.הוסף: כרטיס_כותרת
  ח.הוסף: שורת_גרפים
  ח.הוסף: כרטיס_כוננים
  ח.הוסף: כרטיס_תהליכים

  צבע_תוויות()

  ח.בהתחלה: פונקציה ()
    צבע_תוויות()
    רענן_מידע()
    מזהה_טיימר = טיימרים.כל_כמה: 2, רענן_מידע
  סוף

  ח.הצג()
סוף

פונקציה סגור_חלון_הודעה()
  חלונות.הודעה: "יציאה", "סגרו את החלון עם כפתור ×"
סוף
