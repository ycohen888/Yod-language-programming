פונקציה סיכוי_מציאה שחקן, דרגה
  משתנה בסיס = סיכוי_בסיס[דרגה - 1]
  משתנה בונוס = בונוס_מקדחה[שחקן["מקדחה"]]
  משתנה פועלים = שחקן["פועלים"]
  אם פועלים > 5
    פועלים = 5
  סוף
  משתנה ס = בסיס + בונוס + פועלים * 3
  אם שחקן["גלאי"]
    ס = ס + 6
  סוף
  אם ס > 94
    ס = 94
  סוף
  החזר ס
סוף

פונקציה לשלם_משכורות()
  משתנה i = 0
  כל_עוד i < שחקנים.גודל()
    משתנה ש = שחקנים[i]
    משתנה עלות = ש["פועלים"] * משכורת_פועל
    ש["כסף"] = ש["כסף"] - עלות
    אם עלות > 0
      הוסף_ליומן: שם_שחקן(i) + " שילם משכורות " + מספרים.שלם(עלות) + "₪"
    סוף
    i = i + 1
  סוף
סוף

פונקציה קנה_מקדחה רמה
  משתנה ש = שחקן_נוכחי()
  אם רמה <= ש["מקדחה"]
    הודעה = "כבר יש לכם מקדחה כזו או טובה יותר"
    החזר שקר
  סוף
  משתנה מחיר = מחיר_מקדחה[רמה]
  אם ש["כסף"] < מחיר
    הודעה = "אין מספיק כסף למקדחה (" + מספרים.שלם(מחיר) + "₪)"
    החזר שקר
  סוף
  ש["כסף"] = ש["כסף"] - מחיר
  ש["מקדחה"] = רמה
  הוסף_ליומן: שם_שחקן(תור) + " קנה מקדחה " + שמות_מקדחה[רמה]
  הודעה = "נרכשה מקדחה " + שמות_מקדחה[רמה]
  החזר אמת
סוף

פונקציה גייס_פועל()
  משתנה ש = שחקן_נוכחי()
  אם ש["כסף"] < עלות_פועל
    הודעה = "אין מספיק כסף לפועל (" + מספרים.שלם(עלות_פועל) + "₪)"
    החזר שקר
  סוף
  ש["כסף"] = ש["כסף"] - עלות_פועל
  ש["פועלים"] = ש["פועלים"] + 1
  הוסף_ליומן: שם_שחקן(תור) + " גייס פועל (סה״כ " + ש["פועלים"] + ")"
  הודעה = "פועל חדש בצוות"
  החזר אמת
סוף

