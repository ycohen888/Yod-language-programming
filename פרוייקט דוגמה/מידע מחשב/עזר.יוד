// עזר.יוד — עיצוב טקסט ומספרים

פונקציה פורמט_זמן_פעיל שניות
  משתנה ש = מתמטיקה.עיגול: שניות
  משתנה ימים = מתמטיקה.רצפה: ש / 86400
  ש = ש - ימים * 86400
  משתנה שעות = מתמטיקה.רצפה: ש / 3600
  ש = ש - שעות * 3600
  משתנה דקות = מתמטיקה.רצפה: ש / 60
  משתנה שנ = ש - דקות * 60
  אם ימים > 0
    החזר מספרים.שלם(ימים) + "י " + מספרים.שלם(שעות) + "ש " + מספרים.שלם(דקות) + "ד"
  סוף
  אם שעות > 0
    החזר מספרים.שלם(שעות) + "ש " + מספרים.שלם(דקות) + "ד " + מספרים.שלם(שנ) + "שנ"
  סוף
  החזר מספרים.שלם(דקות) + "ד " + מספרים.שלם(שנ) + "שנ"
סוף

פונקציה שורת_תהליך פ
  משתנה שם = פ["שם"]
  משתנה מזהה = מספרים.שלם: פ["מזהה"]
  משתנה זיכרון = מספרים.בתים: פ["זיכרון_בתים"]
  החזר שם + "   |   מזהה " + מזהה + "   |   " + זיכרון
סוף

פונקציה שורת_כונן כ
  משתנה אות = כ["אות"]
  משתנה סהכ = מספרים.בתים: כ["סהכ_בתים"]
  משתנה פנוי = מספרים.בתים: כ["פנוי_בתים"]
  החזר אות + ": בשימוש/סה״כ " + מספרים.בתים(כ["בשימוש_בתים"]) + " / " + סהכ + "  (פנוי " + פנוי + ")"
סוף
