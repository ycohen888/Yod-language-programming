// סגירות — לכידת משתנים מהסביבה החיצונית
// yod הרץ examples\sgira.יוד
// yod מכונה examples\sgira.יוד
פונקציה צור_מונה(התחלה)
    משתנה נ = התחלה
    פונקציה הבא()
        נ = נ + 1
        החזר נ
    סוף
    החזר הבא
סוף

משתנה מונה = צור_מונה(10)
הדפס(מונה())
הדפס(מונה())
הדפס(מונה())
פונקציה צור_מוסיף(כמה)
    פונקציה הוסף(x)
        החזר x + כמה
    סוף
    החזר הוסף
סוף

משתנה פלוס5 = צור_מוסיף(5)
הדפס("7+5 = " + פלוס5(7))
// שתי סגירות חולקות את אותו משתנה
פונקציה צור_זוג()
    משתנה נ = 0
    פונקציה הגדל()
        נ = נ + 1
        החזר נ
    סוף
    פונקציה קרא()
        החזר נ
    סוף
    החזר[הגדל, קרא]
סוף

משתנה זוג = צור_זוג()
הדפס("אחרי הגדל: " + זוג[0]())
הדפס("קרא: " + זוג[1]())
