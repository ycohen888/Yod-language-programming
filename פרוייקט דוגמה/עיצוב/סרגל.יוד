// סרגל.יוד — Slider / טווח מספרי
כלול "פקד.יוד"

מחלקה סרגל מרחיב פקד {
    פונקציה בנאי(מינ = 0, מקס = 100, ערך = 50, מזהה = "") {
        אם (מינ == ריק) {
            מינ = 0
        }
        אם (מקס == ריק) {
            מקס = 100
        }
        אם (ערך == ריק) {
            ערך = מינ
        }
        הורה(מזהה)
        זה.מינ = מינ
        זה.מקס = מקס
        זה.ערך = ערך
        זה._שינוי = ריק
        זה._צור("סרגל", {
            "מינ": מינ,
            "מקס": מקס,
            "ערך": ערך
        })
    }

    פונקציה קבע_ערך(מספר) {
        אם (מספר == ריק) {
            מספר = זה.מינ
        }
        זה.ערך = מספר
        זה._שלח_פקודה("קבע_ערך", { "ערך": מספר })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
