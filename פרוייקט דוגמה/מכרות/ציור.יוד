        לוח.תמונה: נתיב_נעול, px + 9, py + 7, 24, 24
      אחרת
        משתנה ת = תא_ב(x, y)
        אם ת["חפור"]
          // רקע בצבע השחקן שקנה
          אם ת["בעלים"] == 0
            לוח.קבע_מילוי: 25, 90, 70
          אחרת
            לוח.קבע_מילוי: 35, 70, 130
          סוף
          לוח.מלבן_מעוגל_מלא: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4, 5

          אם ת["משאב"] >= 0
            לוח.תמונה: נתיבי_משאב[ת["משאב"]], px + 3, py + 3, 18, 18
            משתנה ממ = ת["ממצאים"]
