// מדריך_שלבים.יוד — Stepper
כלול "פקד.יוד"

מחלקה מדריך_שלבים מרחיב פקד {
    פונקציה בנאי(שלבים, נוכחי = 1, מזהה = "") {
        אם (שלבים == ריק) {
            שלבים = []
        }
        אם (נוכחי == ריק או נוכחי < 1) {
            נוכחי = 1
        }
        הורה(מזהה)
        זה.שלבים = שלבים
        זה.ערך = נוכחי
        זה._שינוי = ריק
        זה._צור("מדריך_שלבים", {
            "שלבים": שלבים,
            "ערך": נוכחי
        })
    }

    פונקציה קבע_ערך(מספר) {
        אם (מספר == ריק) {
            מספר = 1
        }
        זה.ערך = מספר
        זה._שלח_פקודה("קבע_ערך", { "ערך": מספר })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
