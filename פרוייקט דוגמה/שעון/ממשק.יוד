// ממשק.יוד — שעון: בלי מסגרת, צורת חלון = רק השעון נראה (דסקטופ מסביב)
כלול "חלונות"
כלול "קבצים"
כלול "מערכת"

משתנה חלון_ראשי = ריק
משתנה דפדפן_שעון = ריק

פונקציה תיקיית_פרויקט() {
    משתנה תיק = מערכת.תיקיית_הרצה()
    אם (תיק == ריק או תיק == "") {
        תיק = מערכת.תיקייה()
    }
    אם (קבצים.קיים(תיק + "\\ממשק.html")) {
        החזר תיק
    }
    אם (קבצים.קיים(תיק + "\\שעון\\ממשק.html")) {
        החזר תיק + "\\שעון"
    }
    החזר תיק
}

פונקציה לנתיב_file(נתיב) {
    משתנה פ = "" + נתיב
    פ = פ.החלף("\\", "/")
    החזר "file:///" + פ
}

פונקציה פרסר_הזז(טקסט) {
    משתנה חלקים = ("" + טקסט).החלף("הזז:", "").פצל(",")
    אם (חלקים.אורך < 2) {
        החזר ריק
    }
    החזר [למספר(חלקים[0]), למספר(חלקים[1])]
}

פונקציה על_הודעת_שעון(הודעה) {
    נסה {
        משתנה ט = ("" + הודעה).גזום()
        אם (ט.מתחיל_ב("\"") וגם ט.מסתיים_ב("\"")) {
            ט = ט.חתוך(1, ט.אורך() - 1)
        }
        אם (ט == "יציאה") {
            אם (חלון_ראשי != ריק) {
                נסה {
                    חלון_ראשי.סגור()
                } תפוס שגיאה {
                }
            }
            החזר ריק
        }
        אם (ט == "גרור") {
            אם (חלון_ראשי != ריק) {
                חלון_ראשי.התחל_גרירה()
            }
            החזר ריק
        }
        אם (ט.מתחיל_ב("הזז:")) {
            משתנה דלתא = פרסר_הזז(ט)
            אם (דלתא != ריק וגם חלון_ראשי != ריק) {
                חלון_ראשי.הזז(דלתא[0], דלתא[1])
            }
            החזר ריק
        }
        אם (ט == "תמיד_מעל:אמת") {
            אם (חלון_ראשי != ריק) {
                חלון_ראשי.קבע_תמיד_מעל(אמת)
            }
            החזר ריק
        }
        אם (ט == "תמיד_מעל:שקר") {
            אם (חלון_ראשי != ריק) {
                חלון_ראשי.קבע_תמיד_מעל(שקר)
            }
            החזר ריק
        }
        אם (ט.מתחיל_ב("גודל:")) {
            משתנה חלקים = ט.החלף("גודל:", "").פצל(",")
            אם (חלקים.אורך >= 2 וגם חלון_ראשי != ריק) {
                חלון_ראשי.קבע_גודל(למספר(חלקים[0]), למספר(חלקים[1]))
            }
            החזר ריק
        }
        אם (ט.מתחיל_ב("צורה:")) {
            אם (חלון_ראשי != ריק) {
                חלון_ראשי.קבע_צורת_חלון(ט.החלף("צורה:", ""))
            }
            החזר ריק
        }
        אם (ט == "שקיפות:אמת") {
            אם (חלון_ראשי != ריק) {
                חלון_ראשי.קבע_שקוף(אמת)
            }
            החזר ריק
        }
        אם (ט == "שקיפות:שקר") {
            אם (חלון_ראשי != ריק) {
                חלון_ראשי.קבע_שקוף(שקר)
                חלון_ראשי.קבע_רקע(12, 18, 28)
            }
            החזר ריק
        }
        אם (ט.מתחיל_ב("מיקום:")) {
            משתנה חלקים = ט.החלף("מיקום:", "").פצל(",")
            אם (חלקים.אורך >= 2 וגם חלון_ראשי != ריק) {
                חלון_ראשי.קבע_מיקום(למספר(חלקים[0]), למספר(חלקים[1]))
            }
            החזר ריק
        }
    } תפוס שגיאה {
    }
}

פונקציה בנה_חלון_שעון() {
    משתנה ח = חלונות.חלון("שעון · יוד")
    חלון_ראשי = ח
    ח.קבע_גודל(300, 170)
    ח.קבע_גודל_קבוע(אמת)
    ח.קבע_בלי_מסגרת(אמת)
    ח.קבע_שקוף(שקר)
    ח.קבע_צורת_חלון("מעוגל")
    ח.קבע_תמיד_מעל(אמת)
    ח.מרכז()
    ח.קבע_כהה(אמת)
    ח.קבע_רקע(12, 18, 28)

    משתנה תיק = תיקיית_פרויקט()
    נסה {
        אם (קבצים.קיים(תיק + "\\app.ico")) {
            ח.קבע_איקון(תיק + "\\app.ico")
        } אחרת_אם (קבצים.קיים(תיק + "\\נכסים\\app.ico")) {
            ח.קבע_איקון(תיק + "\\נכסים\\app.ico")
        }
    } תפוס שגיאה {
    }

    דפדפן_שעון = חלונות.דפדפן()
    נסה {
        דפדפן_שעון.קבע_מתיחה(-1)
    } תפוס שגיאה {
    }

    דפדפן_שעון.בהודעה(פונקציה(ה) {
        על_הודעת_שעון(ה)
    })

    משתנה קובץ = תיק + "\\ממשק.html"
    אם (לא קבצים.קיים(קובץ)) {
        חלונות.הודעה("שעון", "לא נמצא ממשק.html בתיקיית הפרויקט:\n" + תיק)
        החזר ריק
    }

    דפדפן_שעון.נווט(לנתיב_file(קובץ))
    ח.הוסף(דפדפן_שעון)
    ח.הצג()
}
