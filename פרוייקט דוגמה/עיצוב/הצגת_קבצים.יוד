// הצגת_קבצים.יוד — עץ קבצים בסגנון FileZilla (מקומי + מרוחק)
כלול "פקד.יוד"

מחלקה הצגת_קבצים מרחיב פקד {
    פונקציה בנאי(פריטים, נבחר = "", מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (נבחר == ריק) {
            נבחר = ""
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה.ערך = נבחר
        זה._לחץ = ריק
        זה._שינוי = ריק
        זה._פתיחה = ריק
        זה._פתיחה_משתמש = ריק
        זה._מצב = "ריק"
        זה._נתיב_שורש = ""
        זה._חיבור = ריק
        זה._רק_תיקיות = שקר
        זה._צור("הצגת_קבצים", {
            "פריטים": פריטים,
            "ערך": נבחר
        })
        משתנה עצמי = זה
        זה._פתיחה = פונקציה(ערך_אב) {
            עצמי._טען_ילדים(ערך_אב)
            אם (עצמי._פתיחה_משתמש != ריק) {
                עצמי._פתיחה_משתמש(ערך_אב)
            }
        }
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה קבע_ילדים(ערך_אב, רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה._שלח_פקודה("קבע_ילדים", { "ערך": ערך_אב, "ילדים": רשימה })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }

    פונקציה בפתיחה(פונק) {
        זה._פתיחה_משתמש = פונק
    }

    פונקציה קבע_חיבור(חיבור) {
        זה._חיבור = חיבור
    }

    פונקציה קבע_רק_תיקיות(כן) {
        זה._רק_תיקיות = (כן == אמת)
    }

    פונקציה _סיומת_משם(שם) {
        אם (שם == ריק או שם == "") {
            החזר ""
        }
        משתנה נ = "" + שם
        משתנה i = נ.אינדקס_אחרון(".")
        אם (i < 0 או i >= נ.אורך() - 1) {
            החזר ""
        }
        החזר נ.חתוך(i + 1)
    }

    פונקציה _פורמט_זמן_יוניקס(שניות) {
        אם (שניות == ריק או שניות <= 0) {
            החזר ""
        }
        החזר "" + שניות
    }

    פונקציה _פריט_מקומי(תיקיה, שם) {
        משתנה מלא = קבצים.צרף(תיקיה, שם)
        משתנה תיקיה_היא = קבצים.האם_תיקייה(מלא)
        משתנה גודל = 0
        משתנה תאריך = ""
        נסה {
            אם (לא תיקיה_היא) {
                גודל = קבצים.גודל(מלא)
            }
            תאריך = זה._פורמט_זמן_יוניקס(קבצים.זמן_שינוי(מלא))
        } תפוס שגיאה {
        }
        משתנה סוג = "קובץ"
        אם (תיקיה_היא) {
            סוג = "תיקיה"
        }
        החזר {
            "שם": שם,
            "ערך": מלא,
            "סוג": סוג,
            "סיומת": זה._סיומת_משם(שם),
            "גודל": גודל,
            "תאריך": תאריך,
            "הרשאות": "",
            "בעלות": "",
            "ילדים": [],
            "יש_ילדים": תיקיה_היא
        }
    }

    פונקציה _רשימת_מקומית(נתיב) {
        משתנה פריטים = []
        אם (נתיב == ריק או נתיב == "" או לא קבצים.קיים(נתיב) או לא קבצים.האם_תיקייה(נתיב)) {
            החזר פריטים
        }
        משתנה שמות = []
        נסה {
            שמות = קבצים.רשימת_קבצים(נתיב)
        } תפוס שגיאה {
            החזר פריטים
        }
        עבור שם בתוך שמות {
            אם (שם == "." או שם == "..") {
                המשך
            }
            משתנה פריט = זה._פריט_מקומי(נתיב, שם)
            אם (זה._רק_תיקיות וגם פריט.סוג != "תיקיה") {
                המשך
            }
            פריטים.הוסף(פריט)
        }
        החזר פריטים
    }

    פונקציה _פריט_מרוחק(אב, פריט) {
        משתנה שם = פריט.שם
        אם (שם == ריק) {
            שם = ""
        }
        משתנה מלא = אב
        אם (מלא == ריק או מלא == "") {
            מלא = "/"
        }
        כל_עוד (מלא.מסתיים_ב("/") וגם מלא.אורך() > 1) {
            מלא = מלא.חתוך(0, מלא.אורך() - 1)
        }
        אם (שם != "") {
            אם (מלא == "/") {
                מלא = "/" + שם
            } אחרת {
                מלא = מלא + "/" + שם
            }
        }
        משתנה סוג = "קובץ"
        אם (פריט.סוג == "תיקיה" או פריט.סוג == "תיקייה") {
            סוג = "תיקיה"
        }
        משתנה גודל = 0
        אם (פריט.יש("גודל") וגם פריט.גודל != ריק) {
            גודל = פריט.גודל
        }
        משתנה תאריך = ""
        אם (פריט.יש("זמן") וגם פריט.זמן != ריק) {
            תאריך = זה._פורמט_זמן_יוניקס(פריט.זמן)
        }
        החזר {
            "שם": שם,
            "ערך": מלא,
            "סוג": סוג,
            "סיומת": זה._סיומת_משם(שם),
            "גודל": גודל,
            "תאריך": תאריך,
            "הרשאות": "",
            "בעלות": "",
            "ילדים": [],
            "יש_ילדים": סוג == "תיקיה"
        }
    }

    פונקציה _רשימת_מרוחקת(נתיב) {
        משתנה פריטים = []
        אם (זה._חיבור == ריק) {
            החזר פריטים
        }
        משתנה רשימה = []
        נסה {
            רשימה = זה._חיבור.רשימה(נתיב)
        } תפוס שגיאה {
            החזר פריטים
        }
        עבור פ בתוך רשימה {
            אם (פ.שם == "." או פ.שם == "..") {
                המשך
            }
            משתנה פריט_מ = זה._פריט_מרוחק(נתיב, פ)
            אם (זה._רק_תיקיות וגם פריט_מ.סוג != "תיקיה") {
                המשך
            }
            פריטים.הוסף(פריט_מ)
        }
        החזר פריטים
    }

    פונקציה _טען_ילדים(ערך_אב) {
        אם (ערך_אב == ריק או ערך_אב == "") {
            החזר ריק
        }
        משתנה ילדים = []
        אם (זה._מצב == "מרוחק") {
            ילדים = זה._רשימת_מרוחקת(ערך_אב)
        } אחרת {
            ילדים = זה._רשימת_מקומית(ערך_אב)
        }
        זה.קבע_ילדים(ערך_אב, ילדים)
    }

    פונקציה טען_מקומי(נתיב) {
        זה._מצב = "מקומי"
        זה._חיבור = ריק
        אם (נתיב == ריק) {
            נתיב = ""
        }
        זה._נתיב_שורש = נתיב
        זה.קבע_פריטים(זה._רשימת_מקומית(נתיב))
    }

    פונקציה טען_מרוחק(חיבור, נתיב) {
        זה._מצב = "מרוחק"
        זה._חיבור = חיבור
        אם (נתיב == ריק או נתיב == "") {
            נתיב = "/"
        }
        זה._נתיב_שורש = נתיב
        זה.קבע_פריטים(זה._רשימת_מרוחקת(נתיב))
    }

    פונקציה רענן() {
        אם (זה._מצב == "מרוחק") {
            זה.טען_מרוחק(זה._חיבור, זה._נתיב_שורש)
        } אחרת_אם (זה._מצב == "מקומי") {
            זה.טען_מקומי(זה._נתיב_שורש)
        }
    }
}
