פונקציה נקודה_בחלקה(ח, x, y) {
    אם (x < ח["x"]) {
        החזר שקר
    }
    אם (y < ח["y"]) {
        החזר שקר
    }
    אם (x > ח["x"] + ח["רחב"]) {
        החזר שקר
    }
    אם (y > ח["y"] + ח["גבה"]) {
        החזר שקר
    }
    החזר אמת
}

פונקציה מצא_חלקה_בנקודה(x, y) {
    משתנה i = חלקות.גודל() - 1
    כל_עוד (i >= 0) {
        אם (נקודה_בחלקה(חלקות[i], x, y)) {
            החזר i
        }
        i = i - 1
    }
    החזר ריק
}

פונקציה במחנה(x, y) {
    אם (x < מחנה_x) {
        החזר שקר
    }
    אם (y < מחנה_y) {
        החזר שקר
    }
    אם (x > מחנה_x + מחנה_רחב) {
        החזר שקר
    }
    אם (y > מחנה_y + מחנה_גבה) {
        החזר שקר
    }
    החזר אמת
}

פונקציה ספור_שכנים_שייכים(אינדקס_חלקה, שחקן) {
    משתנה ח = חלקות[אינדקס_חלקה]
    משתנה ספירה = 0
    משתנה ש = ח["שכנים"]
    משתנה i = 0
    כל_עוד (i < ש.גודל()) {
        משתנה שכן = חלקות[ש[i]]
        אם (שכן["בעלים"] == שחקן) {
            ספירה = ספירה + 1
        }
        i = i + 1
    }
    החזר ספירה
}

פונקציה בחר_מכרז_שבועי() {
    משתנה פנויים = []
    משתנה i = 0
    כל_עוד (i < חלקות.גודל()) {
        אם (חלקות[i]["בעלים"] == ריק) {
            פנויים.הוסף: i
        }
        i = i + 1
    }
    אם (פנויים.גודל() == 0) {
        מכרז_אינדקס = ריק
        מכרז_הצעה = 0
        מכרז_מציע = ריק
        החזר ריק
    }
    משתנה בחירה = אקראי_בין: 0, פנויים.גודל() - 1
    מכרז_אינדקס = פנויים[בחירה]
    מכרז_הצעה = חלקות[מכרז_אינדקס]["מחיר_בסיס"]
    מכרז_מציע = ריק
}
