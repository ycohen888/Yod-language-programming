// ממשק.יוד — צייר עם כפתורי איקון (תמונות) + לוח ציור

משתנה צלמיות_כלי = []
משתנה דגמי_צבע = []
משתנה סרגל_עובי = ריק
משתנה מדרגת_עובי = ריק

פונקציה נתיב_איקון(שם)
  החזר "איקונים/" + שם + ".png"
סוף

פונקציה סמן_כלי_פעיל(שם)
  עבור צ בתוך צלמיות_כלי
    צ.קבע_פעיל(צ.שם_כלי == שם)
  סוף
סוף

פונקציה סמן_צבע_נבחר(א, י, כ)
  עבור ד בתוך דגמי_צבע
    ד.קבע_נבחר(ד.אדום == א וגם ד.ירוק == י וגם ד.כחול == כ)
  סוף
סוף

פונקציה הוסף_איקון_כלי(לוח_ס, x, y, קובץ, שם, רמז)
  משתנה צ = חדש כפתור_איקון: x, y, נתיב_איקון(קובץ)
  צ.שם_כלי = שם
  צ.קבע_רמז(רמז)
  צ.בלחיצה = פונקציה ()
    בחר_כלי(שם)
    סמן_כלי_פעיל(שם)
  סוף
  צלמיות_כלי.הוסף(צ)
  לוח_ס.הוסף(צ)
סוף

פונקציה הוסף_דגם(לוח_ס, x, y, שם, א, י, כ)
  משתנה ד = חדש דגם_צבע_משטח: x, y, 22, א, י, כ
  ד.שם_צבע = שם
  ד.קבע_רמז("צבע " + שם)
  ד.בלחיצה = פונקציה (ra, ga, ba)
    בחר_צבע(שם)
    סמן_צבע_נבחר(ra, ga, ba)
  סוף
  דגמי_צבע.הוסף(ד)
  לוח_ס.הוסף(ד)
סוף

פונקציה בנה_צייר()
  משתנה ח = חלונות.חלון: כותרת_צייר
  ח.קבע_גודל: רוחב_לוח + 108, גובה_לוח + 130
  ח.קבע_כהה: אמת

  צלמיות_כלי = []
  דגמי_צבע = []

  משתנה לוח_כלים = חדש לוח_רכיבים: 64, גובה_לוח
  לוח_כלים.רקע_א = 26
  לוח_כלים.רקע_י = 28
  לוח_כלים.רקע_כ = 34

  משתנה yy = 8
  הוסף_איקון_כלי(לוח_כלים, 16, yy, "pencil", "עיפרון", "עיפרון — ציור חופשי")
  yy = yy + 36
  הוסף_איקון_כלי(לוח_כלים, 16, yy, "eraser", "מחק", "מחק — מוחק בציור")
  yy = yy + 36
  הוסף_איקון_כלי(לוח_כלים, 16, yy, "line", "קו", "קו ישר")
  yy = yy + 36
  הוסף_איקון_כלי(לוח_כלים, 16, yy, "rect", "מלבן", "מלבן")
  yy = yy + 36
  הוסף_איקון_כלי(לוח_כלים, 16, yy, "circle", "עיגול", "עיגול")
  yy = yy + 36
  הוסף_איקון_כלי(לוח_כלים, 16, yy, "ellipse", "אליפסה", "אליפסה")
  yy = yy + 36
  הוסף_איקון_כלי(לוח_כלים, 16, yy, "fill", "מילוי", "מילוי אזור בצבע")
  yy = yy + 36
  הוסף_איקון_כלי(לוח_כלים, 16, yy, "eyedropper", "טפטפת", "טפטפת — דגימת צבע מהלוח")
  yy = yy + 40
  לוח_כלים.הוסף(חדש מפריד: 10, yy, 44)
  yy = yy + 12

  משתנה צ_בטל = חדש כפתור_איקון: 16, yy, נתיב_איקון("undo")
  צ_בטל.קבע_רמז("בטל — ביטול הפעולה האחרונה")
  צ_בטל.בלחיצה = פונקציה ()
    לוח.בטל()
  סוף
  לוח_כלים.הוסף(צ_בטל)
  yy = yy + 36

  משתנה צ_נקה = חדש כפתור_איקון: 16, yy, נתיב_איקון("clear")
  צ_נקה.קבע_רמז("נקה — מוחק את כל הלוח")
  צ_נקה.בלחיצה = פונקציה ()
    לוח.צלם()
    לוח.נקה()
  סוף
  לוח_כלים.הוסף(צ_נקה)
  yy = yy + 36

  משתנה צ_פתח = חדש כפתור_איקון: 16, yy, נתיב_איקון("open")
  צ_פתח.קבע_רמז("פתח תמונה")
  צ_פתח.בלחיצה = פונקציה ()
    משתנה נתיב = חלונות.בחר_פתיחה: "פתיחת תמונה"
    אם נתיב == ריק
      החזר ריק
    סוף
    לוח.צלם()
    לוח.טען: נתיב
  סוף
  לוח_כלים.הוסף(צ_פתח)
  yy = yy + 36

  משתנה צ_שמור = חדש כפתור_איקון: 16, yy, נתיב_איקון("save")
  צ_שמור.קבע_רמז("שמור ציור")
  צ_שמור.בלחיצה = פונקציה ()
    משתנה נתיב = חלונות.בחר_שמירה: "שמירת ציור"
    אם נתיב == ריק
      החזר ריק
    סוף
    לוח.שמור: נתיב
  סוף
  לוח_כלים.הוסף(צ_שמור)

  סמן_כלי_פעיל("עיפרון")
  לוח_כלים.רענון()

  לוח = חלונות.משטח: רוחב_לוח, גובה_לוח
  החל_צבע_נוכחי()
  לוח.בעכבר_למטה: על_עכבר_למטה
  לוח.בעכבר_גרירה: על_עכבר_גרירה
  לוח.בעכבר_למעלה: על_עכבר_למעלה

  משתנה אמצע = חלונות.מסגרת: "אופקי"
  אמצע.הוסף: לוח_כלים.משטח_גלוי()
  אמצע.הוסף: לוח

  משתנה לוח_תחת = חדש לוח_רכיבים: רוחב_לוח + 64, 88
  לוח_תחת.רקע_א = 24
  לוח_תחת.רקע_י = 26
  לוח_תחת.רקע_כ = 30

  סטטוס = חדש תווית_ציור: 12, 10, "עיפרון"
  סטטוס.קבע_צבע_rgb(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
  סטטוס.גודל = 12
  לוח_תחת.הוסף(סטטוס)

  לוח_תחת.הוסף(חדש תווית_ציור: 12, 36, "עובי")
  סרגל_עובי = חדש סליידר: 52, 34, 200, 1, 24, עובי
  סרגל_עובי.קבע_רמז("עובי קו / מברשת")
  סרגל_עובי.בשינוי = פונקציה (v)
    בחר_עובי(v.שלם())
    אם מדרגת_עובי != ריק
      מדרגת_עובי.קבע_ערך_שקט(v.שלם())
    סוף
  סוף
  לוח_תחת.הוסף(סרגל_עובי)

  מדרגת_עובי = חדש מספר_מדרגה: 266, 32, 1, 24, עובי
  מדרגת_עובי.קבע_רמז("עובי — שלב אחד למעלה או למטה")
  מדרגת_עובי.בשינוי = פונקציה (v)
    בחר_עובי(v.שלם())
    אם סרגל_עובי != ריק
      סרגל_עובי.קבע_ערך_שקט(v.שלם())
    סוף
  סוף
  לוח_תחת.הוסף(מדרגת_עובי)

  לוח_תחת.הוסף(חדש תווית_ציור: 380, 10, "צבע")
  הוסף_דגם(לוח_תחת, 380, 32, "שחור", 20, 20, 22)
  הוסף_דגם(לוח_תחת, 410, 32, "אדום", 220, 55, 55)
  הוסף_דגם(לוח_תחת, 440, 32, "ירוק", 40, 170, 90)
  הוסף_דגם(לוח_תחת, 470, 32, "כחול", 45, 110, 220)
  הוסף_דגם(לוח_תחת, 500, 32, "צהוב", 240, 200, 40)
  הוסף_דגם(לוח_תחת, 530, 32, "כתום", 240, 140, 40)
  הוסף_דגם(לוח_תחת, 560, 32, "סגול", 140, 70, 200)
  הוסף_דגם(לוח_תחת, 590, 32, "ורוד", 230, 90, 150)
  הוסף_דגם(לוח_תחת, 620, 32, "תכלת", 50, 190, 210)
  הוסף_דגם(לוח_תחת, 650, 32, "חום", 140, 90, 50)
  הוסף_דגם(לוח_תחת, 680, 32, "אפור", 140, 145, 150)
  הוסף_דגם(לוח_תחת, 710, 32, "לבן", 235, 235, 238)
  סמן_צבע_נבחר(20, 20, 22)

  לוח_תחת.רענון()

  ח.הוסף: אמצע
  ח.הוסף: לוח_תחת.משטח_גלוי()

  עדכן_סטטוס()
  החזר ח
סוף
