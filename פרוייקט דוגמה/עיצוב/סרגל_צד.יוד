// סרגל_צד.יוד — Sidebar / ניווט אנכי עם קבוצות מתקפלות (ילדים)
// אותו מודל פריטים כמו סרגל_עליון: מפריד, ריק, איקון, ילדים
כלול "פקד.יוד"

מחלקה סרגל_צד מרחיב פקד {
    פונקציה בנאי(כותרת, פריטים, נבחר = "", מזהה = "") {
        אם (כותרת == ריק) {
            כותרת = ""
        }
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (נבחר == ריק) {
            נבחר = ""
        }
        הורה(מזהה)
        זה.כותרת = כותרת
        זה.טקסט = כותרת
        זה.פריטים = פריטים
        זה.ערך = נבחר
        זה._לחץ = ריק
        זה._שינוי = ריק
        זה._צור("סרגל_צד", {
            "כותרת": כותרת,
            "פריטים": פריטים,
            "ערך": נבחר
        })
    }

    פונקציה קבע_כותרת(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.כותרת = ט
        זה.טקסט = ט
        זה._שלח_פקודה("קבע_כותרת", { "כותרת": ט })
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
