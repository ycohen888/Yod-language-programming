// נורית.יוד — נקודת סטטוס + תווית

מחלקה נורית מרחיב רכיב
  פונקציה בנאי(x, y, טקסט, דולקת)
    הורה(x, y, 160, 24)
    זה.טקסט = טקסט
    זה.דולקת = דולקת
  סוף

  פונקציה קבע_דולקת(v)
    זה.דולקת = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה cx = זה.x + 8
    משתנה cy = זה.y + זה.גבה / 2
    אם זה.דולקת
      משטח.קבע_מילוי(40, 180, 90)
      משטח.עיגול_מלא(cx, cy, 8)
      משטח.קבע_מילוי(120, 240, 160)
      משטח.עיגול_מלא(cx - 2, cy - 2, 3)
    אחרת
      משטח.קבע_מילוי(70, 50, 50)
      משטח.עיגול_מלא(cx, cy, 8)
      משטח.קבע_מילוי(120, 70, 70)
      משטח.עיגול_מלא(cx, cy, 5)
    סוף
    משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
    משטח.קבע_גודל_גופן(13)
    משטח.טקסט(זה.טקסט, זה.x + 22, זה.y + 4)
  סוף
סוף
