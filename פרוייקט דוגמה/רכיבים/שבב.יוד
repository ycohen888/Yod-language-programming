// שבב.יוד — שבב בחירה קטן (chip)

מחלקה שבב מרחיב רכיב
  פונקציה בנאי(x, y, טקסט, נבחר)
    הורה(x, y, 64, 22)
    זה.טקסט = טקסט
    זה.נבחר = נבחר
    זה.בשינוי = ריק
  סוף

  פונקציה קבע_נבחר(v)
    זה.נבחר = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    זה.רחב = 16 + אורך(זה.טקסט) * 7
    אם זה.רחב < 44
      זה.רחב = 44
    סוף
    אם זה.נבחר
      מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2, ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
      משטח.קבע_צבע(240, 250, 248)
    אחרת
      מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2, ערכה_גובה_א, ערכה_גובה_י, ערכה_גובה_כ)
      משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
    סוף
    משטח.קבע_גודל_גופן(11)
    משטח.טקסט(זה.טקסט, זה.x + 10, זה.y + 4)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.נבחר
      זה.נבחר = שקר
    אחרת
      זה.נבחר = אמת
    סוף
    זה.בקש_רענון()
    אם זה.בשינוי != ריק
      זה.בשינוי(זה.נבחר)
    סוף
    החזר אמת
  סוף
סוף
