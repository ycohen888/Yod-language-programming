// צבעים.יוד — בחירת צבעי קו ומילוי

פונקציה החל_צבע שם
  צבע_נוכחי = שם
  אם (לוח_ראשי != ריק)
    לוח_ראשי.קבע_צבע: שם
  סוף
  סטטוס_טקסט = "צבע קו: " + שם
סוף

פונקציה החל_מילוי שם
  מילוי_נוכחי = שם
  אם (לוח_ראשי != ריק)
    לוח_ראשי.קבע_מילוי: שם
  סוף
  סטטוס_טקסט = "מילוי: " + שם
סוף

פונקציה החל_עובי נ
  עובי_נוכחי = נ
  אם (לוח_ראשי != ריק)
    לוח_ראשי.קבע_עובי: נ
  סוף
  סטטוס_טקסט = "עובי: " + נ
סוף
