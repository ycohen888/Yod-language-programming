פונקציה רדיוס_בטוח(w, h, r)
  משתנה מ = r
  אם מ * 2 > h
    מ = h / 2
  סוף
  אם מ * 2 > w
    מ = w / 2
  סוף
  אם מ < 0
    החזר 0
  סוף
  החזר מ
סוף

// מילוי מלבן עם פינות מעוגלות (עיגולים + מלבנים)
פונקציה מלבן_מעוגל_מלא(משטח, x, y, w, h, r)
  משתנה rr = רדיוס_בטוח(w, h, r)
  אם rr <= 0
    משטח.מלבן_מלא(x, y, w, h)
    החזר ריק
  סוף
  משטח.מלבן_מלא(x + rr, y, w - 2 * rr, h)
  משטח.מלבן_מלא(x, y + rr, w, h - 2 * rr)
  משטח.עיגול_מלא(x + rr, y + rr, rr)
  משטח.עיגול_מלא(x + w - rr, y + rr, rr)
  משטח.עיגול_מלא(x + rr, y + h - rr, rr)
  משטח.עיגול_מלא(x + w - rr, y + h - rr, rr)
סוף

פונקציה קו_עליון_רך(משטח, x, y, w, h, r, א, י, כ)
  משתנה rr = רדיוס_בטוח(w, h, r)
  משטח.קבע_מילוי(א, י, כ)
  אם w - 2 * rr > 0
    משטח.מלבן_מלא(x + rr, y, w - 2 * rr, 1)
  סוף
סוף

פונקציה מלבן_מעוגל_עם_גבול(משטח, x, y, w, h, r, מא, מי, מכ)
  משטח.קבע_מילוי(ערכה_גבול_א, ערכה_גבול_י, ערכה_גבול_כ)
  מלבן_מעוגל_מלא(משטח, x, y, w, h, r)
  משטח.קבע_מילוי(מא, מי, מכ)
  אם w > 2 וגם h > 2
    מלבן_מעוגל_מלא(משטח, x + 1, y + 1, w - 2, h - 2, רדיוס_בטוח(w - 2, h - 2, r - 1))
  סוף
סוף
