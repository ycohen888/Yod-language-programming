// לוח_משחק.יוד — שטחים, קנייה/פיתוח ותורות

פונקציה אינדקס_תא x, y
  החזר y * גודל_לוח + x
סוף

פונקציה תא_ב x, y
  החזר תאים[אינדקס_תא(x, y)]
סוף

פונקציה גלגל_שטח()
  משתנה ר = אקראי() * 100
  אם ר < 30
    החזר 0
  סוף
  אם ר < 55
    החזר 1
  סוף
  אם ר < 75
    החזר 2
  סוף
  החזר 3
סוף

פונקציה זרע_לוח()
  תאים = []
  משתנה y = 0
  כל_עוד y < גודל_לוח
    משתנה x = 0
    כל_עוד x < גודל_לוח
      משתנה שטח = גלגל_שטח()
      משתנה משאב_מוכן = 0 - 1
      משתנה כמות_מוכנה = 0
      משתנה ערך = 0
      // מראש קובעים מה בתוך הנכס — והמחיר משקף את הערך
      משתנה גלגל = אקראי() * 100
      אם גלגל < סיכוי_שטח[שטח]
        משאב_מוכן = גלגל_סוג_משאב(שטח)
        כמות_מוכנה = גלגל_כמות(שטח)
        אם משאב_מוכן == 10
          כמות_מוכנה = אקראי_בין: 1, 4
        סוף
        אם משאב_מוכן == 15
          כמות_מוכנה = אקראי_בין: 1, 4
        סוף
        אם משאב_מוכן == 7
          כמות_מוכנה = אקראי_בין: 2, 6
        סוף
        אם משאב_מוכן == 9
          כמות_מוכנה = אקראי_בין: 1, 5
        סוף
        ערך = כמות_מוכנה * מחיר_לקילו[משאב_מוכן]
      סוף
      משתנה מחיר = חשב_מחיר_קנייה(ערך, שטח)
      משתנה תא_חדש = {
        "x": x,
        "y": y,
        "שטח": שטח,
        "חפור": שקר,
        "בעלים": 0 - 1,
        "משאב": 0 - 1,
        "כמות": 0,
        "משאב_מוכן": משאב_מוכן,
        "כמות_מוכנה": כמות_מוכנה,
        "ערך": ערך,
        "מחיר": מחיר
      }
      תאים.הוסף: תא_חדש
      x = x + 1
    סוף
    y = y + 1
  סוף
סוף

פונקציה צור_שחקן שם, מחשב
  משתנה ש = {
    "שם": שם,
    "כסף": כסף_התחלה,
    "מקדחה": 0,
    "פועלים": 0,
    "סהכ_רווח": 0,
    "מחשב": מחשב,
    "גלאי": שקר,
    "משאית": שקר,
    "דינמיט": 0
  }
  החזר ש
סוף

פונקציה עדכן_הודעת_תור()
  הודעה = "★ התור של " + שם_שחקן(תור) + " — לחצו על שטח לקנייה ופיתוח"
סוף

פונקציה התחל_משחק שני_שחקנים
  בטל_טיימר_AI()
  מצב_2_שחקנים = שני_שחקנים
  שחקנים = []
  שחקנים.הוסף: צור_שחקן("שחקן 1", שקר)
  אם שני_שחקנים
    שחקנים.הוסף: צור_שחקן("שחקן 2", שקר)
  אחרת
    שחקנים.הוסף: צור_שחקן("מחשב", אמת)
  סוף
  תור = 0
  חודש = 1
  יום = 1
  מהלכים_בחודש = 0
  מצב_דינמיט = שקר
  מעקב_x = 0 - 1
  מעקב_y = 0 - 1
  שורות_פתוחות = 6
  יומן = []
  אפס_סיכום_חודש()
  זרע_לוח()
  מצב_מסך = "משחק"
  עדכן_הודעת_תור()
  הוסף_ליומן: "המשחק התחיל! עברו עם העכבר על שטח לראות מחיר"
  צייר_הכל()
סוף

פונקציה סיום_חודש()
  לשלם_משכורות()
  מצב_מסך = "דוח"
  הודעה = "סיכום חודש " + חודש
  צייר_הכל()
סוף

פונקציה המשך_אחרי_דוח()
  אפס_סיכום_חודש()
  חודש = חודש + 1
  מהלכים_בחודש = 0
  מצב_מסך = "משחק"
  עדכן_הודעת_תור()
  בדוק_ניצחון()
  אם מצב_מסך == "משחק"
    אולי_מהלך_מחשב()
  סוף
  צייר_הכל()
סוף

פונקציה בדוק_ניצחון()
  משתנה א = שחקנים[0]
  משתנה ב = שחקנים[1]
  אם א["כסף"] < 0 או ב["כסף"] < 0
    מצב_מסך = "ניצחון"
    אם א["כסף"] >= ב["כסף"]
      הודעה = "ניצחון ל" + שם_שחקן(0) + "!"
    אחרת
      הודעה = "ניצחון ל" + שם_שחקן(1) + "!"
    סוף
    החזר ריק
  סוף
  אם חודש > 12
    מצב_מסך = "ניצחון"
    אם א["כסף"] + א["סהכ_רווח"] >= ב["כסף"] + ב["סהכ_רווח"]
      הודעה = "סיום עונה — ניצחון ל" + שם_שחקן(0)
    אחרת
      הודעה = "סיום עונה — ניצחון ל" + שם_שחקן(1)
    סוף
  סוף
סוף

פונקציה סיים_תור()
  יום = יום + 1
  מהלכים_בחודש = מהלכים_בחודש + 1
  מצב_דינמיט = שקר
  תור = 1 - תור

  אם מהלכים_בחודש >= מהלכים_לחודש
    סיום_חודש()
    החזר ריק
  סוף

  עדכן_הודעת_תור()
  אולי_מהלך_מחשב()
  צייר_הכל()
סוף

פונקציה חפור_בתא x, y
  אם מצב_מסך != "משחק"
    החזר ריק
  סוף
  אם y >= שורות_פתוחות
    הודעה = "השורה נעולה — הרחיבו את הלוח"
    צייר_הכל()
    החזר ריק
  סוף
  משתנה ת = תא_ב(x, y)
  אם ת["חפור"]
    הודעה = "הנכס כבר נרכש — בחרו שטח פנוי"
    צייר_הכל()
    החזר ריק
  סוף
  משתנה ש = שחקן_נוכחי()

  משתנה עלות = עלות_תא(ת)
  משתנה בונוס_כמות = 0
  אם מצב_דינמיט
    אם ש["דינמיט"] < 1
      מצב_דינמיט = שקר
      הודעה = "אין דינמיט במלאי"
      צייר_הכל()
      החזר ריק
    סוף
    ש["דינמיט"] = ש["דינמיט"] - 1
    בונוס_כמות = 2
    מצב_דינמיט = שקר
  סוף

  אם ש["כסף"] < עלות
    הודעה = "אין מספיק כסף — הנכס עולה " + מספרים.שלם(עלות) + "₪"
    צייר_הכל()
    החזר ריק
  סוף

  ש["כסף"] = ש["כסף"] - עלות
  ת["חפור"] = אמת
  ת["בעלים"] = תור

  אם ת["משאב_מוכן"] >= 0
    משתנה סוג = ת["משאב_מוכן"]
    משתנה כמות = ת["כמות_מוכנה"] + בונוס_כמות
    ת["משאב"] = סוג
    ת["כמות"] = כמות
    משתנה רווח_גולמי = כמות * מחיר_לקילו[סוג]
    משתנה רווח = רווח_גולמי
    אם ש["משאית"]
      רווח = (רווח_גולמי * 125 / 100).שלם()
    סוף
    ש["כסף"] = ש["כסף"] + רווח
    ש["סהכ_רווח"] = ש["סהכ_רווח"] + רווח
    חודש_קילו[סוג] = חודש_קילו[סוג] + כמות
    חודש_רווח[סוג] = חודש_רווח[סוג] + רווח
    משתנה רווח_נטו = רווח - עלות
    הוסף_ליומן: שם_שחקן(תור) + " קנה " + כמות + "× " + שמות_משאב[סוג] + " (שילם " + מספרים.שלם(עלות) + "₪, קיבל " + מספרים.שלם(רווח) + "₪)"
    אם רווח_נטו >= 0
      הודעה = "✓ " + שמות_משאב[סוג] + " · שילמתם " + מספרים.שלם(עלות) + "₪ · קיבלתם " + מספרים.שלם(רווח) + "₪"
    אחרת
      הודעה = "קנייה ביוקר: שילמתם " + מספרים.שלם(עלות) + "₪ · קיבלתם רק " + מספרים.שלם(רווח) + "₪"
    סוף
  אחרת
    הוסף_ליומן: שם_שחקן(תור) + " קנה " + שמות_שטח[ת["שטח"]] + " ריק תמורת " + מספרים.שלם(עלות) + "₪"
    הודעה = "נכס ריק נרכש ב־" + מספרים.שלם(עלות) + "₪"
  סוף

  סיים_תור()
סוף
