// סליידר.יוד — פס גרירה לבחירת ערך מספרי

מחלקה סליידר מרחיב רכיב
  פונקציה בנאי(x, y, רחב, מינ, מקס, ערך)
    הורה(x, y, רחב, 28)
    זה.מינ = מינ
    זה.מקס = מקס
    זה.ערך = הגבל(ערך, מינ, מקס)
    זה.בשינוי = ריק
    זה.גובה_מסלול = 6
    זה.רדיוס_ידית = 9
  סוף

  פונקציה קבע_ערך(v)
    משתנה קודם = זה.ערך
    זה.ערך = הגבל(v, זה.מינ, זה.מקס)
    אם זה.ערך != קודם
      זה.בקש_רענון()
      אם זה.בשינוי != ריק
        זה.בשינוי(זה.ערך)
      סוף
    סוף
  סוף

  פונקציה ערך_נוכחי()
    החזר זה.ערך
  סוף

  פונקציה ידית_x()
    משתנה טווח = זה.מקס - זה.מינ
    אם טווח <= 0
      החזר זה.x + זה.רדיוס_ידית
    סוף
    משתנה t = (זה.ערך - זה.מינ) / טווח
    החזר זה.x + זה.רדיוס_ידית + t * (זה.רחב - 2 * זה.רדיוס_ידית)
  סוף

  פונקציה ערך_ממיקום(mx)
    משתנה פנימי = זה.רחב - 2 * זה.רדיוס_ידית
    אם פנימי <= 0
      החזר זה.מינ
    סוף
    משתנה t = (mx - זה.x - זה.רדיוס_ידית) / פנימי
    t = הגבל(t, 0, 1)
    החזר זה.מינ + t * (זה.מקס - זה.מינ)
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה my = זה.y + זה.גבה / 2
    משתנה mx0 = זה.x + זה.רדיוס_ידית
    משתנה mw = זה.רחב - 2 * זה.רדיוס_ידית
    // מסלול
    משטח.קבע_מילוי(48, 50, 56)
    משטח.מלבן_מלא(mx0, my - זה.גובה_מסלול / 2, mw, זה.גובה_מסלול)
    // מילוי עד הידית
    משתנה hx = זה.ידית_x()
    משטח.קבע_מילוי(14, 124, 112)
    משטח.מלבן_מלא(mx0, my - זה.גובה_מסלול / 2, hx - mx0, זה.גובה_מסלול)
    // ידית
    משטח.קבע_מילוי(78, 201, 176)
    אם זה.לחוץ
      משטח.קבע_מילוי(120, 220, 200)
    סוף
    משטח.עיגול_מלא(hx, my, זה.רדיוס_ידית)
    משטח.קבע_צבע(20, 24, 28)
    משטח.קבע_עובי(1)
    משטח.עיגול(hx, my, זה.רדיוס_ידית)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.לחוץ = אמת
    זה.קבע_ערך(זה.ערך_ממיקום(mx))
    החזר אמת
  סוף

  פונקציה בעכבר_גרירה(mx, my, כפתור)
    אם זה.לחוץ
      זה.קבע_ערך(זה.ערך_ממיקום(mx))
    סוף
  סוף

  פונקציה בעכבר_למעלה(mx, my, כפתור)
    אם זה.לחוץ
      זה.לחוץ = שקר
      זה.בקש_רענון()
    סוף
  סוף
סוף
