// בורר_תאריך.יוד — תאריך (ריק מותר; כפתור לוח־שנה)
כלול "פקד.יוד"

מחלקה בורר_תאריך מרחיב פקד {
    פונקציה בנאי(ערך = "", סוג = "תאריך", מזהה = "") {
        אם (ערך == ריק) {
            ערך = ""
        }
        אם (סוג == ריק או סוג == "") {
            סוג = "תאריך"
        }
        הורה(מזהה)
        זה.ערך = ערך
        זה.סוג_שדה = סוג
        זה._שינוי = ריק
        זה._צור("בורר_תאריך", {
            "ערך": ערך,
            "סוג_שדה": סוג
        })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
