// ממשק.יוד — חלון, לחיצות ומעבר עכבר

פונקציה נקודה_במלבן mx, my, x, y, רחב, גבה
  אם mx < x או my < y
    החזר שקר
  סוף
  אם mx > x + רחב או my > y + גבה
    החזר שקר
  סוף
  החזר אמת
סוף

פונקציה תא_מעקב_מקורדינטות mx, my
  משתנה בסיס_x = שולי_לוח
  משתנה בסיס_y = גובה_כותרת + שולי_לוח
  אם mx < בסיס_x או my < בסיס_y
    החזר [0 - 1, 0 - 1]
  סוף
  משתנה cx = ((mx - בסיס_x) / גודל_תא).שלם()
  משתנה cy = ((my - בסיס_y) / גודל_תא).שלם()
  אם cx < 0 או cy < 0 או cx >= גודל_לוח או cy >= גודל_לוח
    החזר [0 - 1, 0 - 1]
  סוף
  החזר [cx, cy]
סוף

פונקציה על_הזזה mx, my, כפתור
  אם מצב_מסך != "משחק"
    החזר ריק
  סוף
  משתנה תאים_מ = תא_מעקב_מקורדינטות(mx, my)
  משתנה nx = תאים_מ[0]
  משתנה ny = תאים_מ[1]
  אם nx == מעקב_x וגם ny == מעקב_y
    החזר ריק
  סוף
  מעקב_x = nx
  מעקב_y = ny
  צייר_הכל()
סוף

פונקציה על_לחיצה mx, my, כפתור
  אם מצב_מסך == "תפריט"
    אם נקודה_במלבן(mx, my, 120, 310, 220, 48)
      התחל_משחק: שקר
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 370, 310, 200, 48)
      התחל_משחק: אמת
      החזר ריק
    סוף
    החזר ריק
  סוף

  אם מצב_מסך == "דוח"
    אם נקודה_במלבן(mx, my, רוחב_לוח_ציור - 200, 468, 150, 40)
      המשך_אחרי_דוח()
    סוף
    החזר ריק
  סוף

  אם מצב_מסך == "ניצחון"
    אם נקודה_במלבן(mx, my, 220, 290, 200, 40)
      בטל_טיימר_AI()
      מצב_מסך = "תפריט"
      הודעה = "בחרו מצב משחק"
      צייר_הכל()
    סוף
    החזר ריק
  סוף

  אם מצב_מסך == "חנות"
    אם נקודה_במלבן(mx, my, 80, 310, 130, 34)
      אם קנה_מקדחה(1)
        מצב_מסך = "משחק"
        סיים_תור()
      אחרת
        צייר_הכל()
      סוף
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 220, 310, 130, 34)
      אם קנה_מקדחה(2)
        מצב_מסך = "משחק"
        סיים_תור()
      אחרת
        צייר_הכל()
      סוף
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 360, 310, 120, 34)
      אם קנה_מקדחה(3)
        מצב_מסך = "משחק"
        סיים_תור()
      אחרת
        צייר_הכל()
      סוף
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 80, 360, 110, 34)
      אם קנה_גלאי()
        מצב_מסך = "משחק"
        סיים_תור()
      אחרת
        צייר_הכל()
      סוף
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 200, 360, 120, 34)
      אם קנה_משאית()
        מצב_מסך = "משחק"
        סיים_תור()
      אחרת
        צייר_הכל()
      סוף
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 330, 360, 120, 34)
      קנה_דינמיט()
      צייר_הכל()
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 520, 360, 110, 34)
      מצב_מסך = "משחק"
      עדכן_הודעת_תור()
      צייר_הכל()
    סוף
    החזר ריק
  סוף

  אם מצב_מסך != "משחק"
    החזר ריק
  סוף

  משתנה ש = שחקן_נוכחי()
  אם ש["מחשב"]
    הודעה = "זה תור המחשב — המתינו…"
    צייר_הכל()
    החזר ריק
  סוף

  משתנה py = גובה_כותרת + שולי_לוח + גודל_לוח * גודל_תא + גובה_מקרא_לוח + 14
  אם נקודה_במלבן(mx, my, שולי_לוח + 12, py + 58, 80, 28)
    מצב_מסך = "חנות"
    צייר_הכל()
    החזר ריק
  סוף
  אם נקודה_במלבן(mx, my, שולי_לוח + 100, py + 58, 100, 28)
    אם גייס_פועל()
      סיים_תור()
    אחרת
      צייר_הכל()
    סוף
    החזר ריק
  סוף
  אם נקודה_במלבן(mx, my, שולי_לוח + 210, py + 58, 100, 28)
    אם הרחב_לוח()
      סיים_תור()
    אחרת
      צייר_הכל()
    סוף
    החזר ריק
  סוף
  אם נקודה_במלבן(mx, my, שולי_לוח + 320, py + 58, 110, 28)
    אם ש["דינמיט"] < 1
      הודעה = "אין דינמיט — קנו בחנות"
      צייר_הכל()
      החזר ריק
    סוף
    אם מצב_דינמיט
      מצב_דינמיט = שקר
      עדכן_הודעת_תור()
    אחרת
      מצב_דינמיט = אמת
      הודעה = "דינמיט פעיל — לחצו על שטח לפיתוח משופר"
    סוף
    צייר_הכל()
    החזר ריק
  סוף
  אם נקודה_במלבן(mx, my, שולי_לוח + 440, py + 58, 120, 28)
    הוסף_ליומן: שם_שחקן(תור) + " העביר תור"
    הודעה = שם_שחקן(תור) + " העביר תור"
    סיים_תור()
    החזר ריק
  סוף

  משתנה תאים_מ = תא_מעקב_מקורדינטות(mx, my)
  אם תאים_מ[0] >= 0
    חפור_בתא: תאים_מ[0], תאים_מ[1]
  סוף
סוף

פונקציה בנה_מכרות()
  משתנה ח = חלונות.חלון: כותרת_משחק
  ח.קבע_גודל: רוחב_לוח_ציור + 28, גובה_לוח_ציור + 52
  ח.קבע_כהה: אמת
  ח.קבע_רקע: רקע_א, רקע_י, רקע_כ

  לוח = חלונות.משטח: רוחב_לוח_ציור, גובה_לוח_ציור
  לוח.קבע_יישור: "ימין"
  לוח.קבע_נעילת_גובה: אמת
  לוח.קבע_נעילת_רוחב: אמת
  לוח.קבע_מתיחה: 0
  לוח.בעכבר_למטה: על_לחיצה
  לוח.בעכבר_זוז: על_הזזה

  ח.הוסף: לוח
  ח.בהתחלה: פונקציה ()
    מצב_מסך = "תפריט"
    צייר_הכל()
    לוח.בקש_מיקוד()
  סוף
  החזר ח
סוף
