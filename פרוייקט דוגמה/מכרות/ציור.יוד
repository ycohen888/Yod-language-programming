פונקציה צייר_לוח_תאים()
  משתנה בסיס_x = שולי_לוח
  משתנה בסיס_y = גובה_כותרת + שולי_לוח
  לוח.קבע_מילוי: לוח_א, לוח_י, לוח_כ
  לוח.מלבן_מעוגל_מלא: בסיס_x - 6, בסיס_y - 6, גודל_לוח * גודל_תא + 12, גודל_לוח * גודל_תא + 12, 10

  משתנה y = 0
  כל_עוד y < גודל_לוח
    משתנה x = 0
    כל_עוד x < גודל_לוח
      משתנה px = בסיס_x + x * גודל_תא
      משתנה py = בסיס_y + y * גודל_תא
      אם y >= שורות_פתוחות
        לוח.קבע_מילוי: 18, 20, 26
        לוח.מלבן_מעוגל_מלא: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4, 5
        לוח.קבע_צבע: 50, 55, 65
        לוח.קבע_גודל_גופן: 14
        לוח.טקסט: "·", px + 12, py + 8
      אחרת
        משתנה ת = תא_ב(x, y)
        אם ת["חפור"]
          אם ת["משאב"] >= 0
            משתנה צ = צבע_דרגה(ת["דרגה"])
            לוח.קבע_מילוי: צ[0], צ[1], צ[2]
            לוח.מלבן_מעוגל_מלא: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4, 5
            לוח.תמונה: נתיבי_משאב[ת["משאב"]], px + 5, py + 4, 18, 18
            לוח.קבע_צבע: טקסט_א, טקסט_י, טקסט_כ
            לוח.קבע_גודל_גופן: 9
            לוח.טקסט: "" + ת["כמות"], px + 20, py + 18
          אחרת
            לוח.קבע_מילוי: 40, 44, 52
            לוח.מלבן_מעוגל_מלא: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4, 5
            לוח.קבע_צבע: משני_א, משני_י, משני_כ
            לוח.קבע_גודל_גופן: 9
            לוח.טקסט: "ריק", px + 6, py + 10
          סוף
          אם ת["בעלים"] == 0
            לוח.קבע_צבע: שחקן1_א, שחקן1_י, שחקן1_כ
          אחרת
            לוח.קבע_צבע: שחקן2_א, שחקן2_י, שחקן2_כ
          סוף
          לוח.קבע_עובי: 2
          לוח.מלבן: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4
        אחרת
          לוח.קבע_מילוי: 48, 54, 68
          לוח.מלבן_מעוגל_מלא: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4, 5
          לוח.קבע_צבע: 170, 178, 190
          לוח.קבע_גודל_גופן: 11
          לוח.טקסט: "?", px + 12, py + 8
        סוף
      סוף
      x = x + 1
    סוף
    y = y + 1
  סוף
סוף

