// שוק.יוד — מחירים, הפקה, תורות, דוח ואירועים
פונקציה אתחל_מחירי_שוק() {
    מחירי_שוק = []
    משתנה i = 0
    כל_עוד (i < מחיר_משאב_בסיס.גודל()) {
        מחירי_שוק.הוסף: מחיר_משאב_בסיס[i]
        i = i + 1
    }
    עדכן_משאב_חם()
}

פונקציה עדכן_משאב_חם() {
    משאב_חם = 0
    משתנה i = 1
    כל_עוד (i < מחירי_שוק.גודל()) {
        אם (מחירי_שוק[i] > מחירי_שוק[משאב_חם]) {
            משאב_חם = i
        }
        i = i + 1
    }
}

פונקציה הזז_בורסה() {
    משתנה i = 0
    כל_עוד (i < מחירי_שוק.גודל()) {
        משתנה שינוי = אקראי_בין: 0, 24
        שינוי = שינוי - 12
        משתנה מחיר = מחירי_שוק[i] + מחירי_שוק[i] * שינוי / 100
        אם (מחיר < מחיר_משאב_בסיס[i] / 2) {
            מחיר = מחיר_משאב_בסיס[i] / 2
        }
        מחירי_שוק[i] = מתמטיקה.עיגול(מחיר)
        i = i + 1
    }
    עדכן_משאב_חם()
}

פונקציה מחיר_לחישוב(ח, שחקן) {
    משתנה מחיר = ח["מחיר_בסיס"]
    משתנה ש = שחקנים[שחקן]
    אם (ש["קנה_ראשון"]) {
        מחיר = מחיר * מכפיל_אינפלציה
    }
    החזר מחיר
}

פונקציה הצג_הודעה(ט) {
    הודעה = ט
}

פונקציה התחל_משחק(מול_ai) {
    מול_מחשב = מול_ai
    תור = 0
    שבוע = 1
    מהלכים_בשבוע = 0
    חלקה_פתוחה = ריק
    ימי_שביתה = 0
    יום_סערה = שקר
    אירוע_קוד = "רגוע"
    הודעה = "העמק פתוח לתביעות"
    בנה_עמק()
    אתחל_שחקנים()
    אתחל_מחירי_שוק()
    בחר_מכרז_שבועי()
    מסך = "משחק"
}

פונקציה רכוש_חלקה(אינדקס) {
    אם (אינדקס == ריק) {
        החזר שקר
    }
    משתנה ח = חלקות[אינדקס]
    אם (ח["בעלים"] != ריק) {
        הודעה = "החלקה כבר בבעלות"
        החזר שקר
    }
    משתנה מחיר = מחיר_לחישוב(ח, תור)
    אם (מכרז_אינדקס == אינדקס) {
        וגם מכרז_הצעה > מחיר
        מחיר = מכרז_הצעה
    }
    משתנה ש = שחקנים[תור]
    אם (ש["כסף"] < מחיר) {
        הודעה = "אין מספיק מזומן לתביעה"
        החזר שקר
    }
    ש["כסף"] = ש["כסף"] - מחיר
    ח["בעלים"] = תור
    ח["נחשף"] = אמת
    ש["קנה_ראשון"] = אמת
    אם (מכרז_אינדקס == אינדקס) {
        מכרז_אינדקס = ריק
        מכרז_הצעה = 0
        מכרז_מציע = ריק
    }
    חלקה_פתוחה = ריק
    הודעה = שם_שחקן(תור) + " תפסה את " + ח["שם"]
    עדכן_מוניטין: תור
    סיים_תור()
    החזר אמת
}

פונקציה סקר_חלקה(אינדקס) {
    אם (אינדקס == ריק) {
        החזר שקר
    }
    משתנה ח = חלקות[אינדקס]
    אם (ח["בעלים"] != ריק) {
        הודעה = "אין צורך בסקר — החלקה כבר בבעלות"
        החזר שקר
    }
    אם (ח["נחשף"]) {
        הודעה = "החלקה כבר נחשפה"
        החזר שקר
    }
    משתנה ש = שחקנים[תור]
    אם (לא ש["סקר_השבוע"]) {
        הודעה = "כבר ביצעתם סקר השבוע"
        החזר שקר
    }
    ח["נחשף"] = אמת
    ש["סקר_השבוע"] = שקר
    חלקה_פתוחה = ריק
    הודעה = "סקר חשף: " + שמות_איכות[ח["איכות"]] + " · " + שמות_משאב[ח["משאב"]]
    סיים_תור()
    החזר אמת
}

פונקציה העמק_חלקה(אינדקס) {
    אם (אינדקס == ריק) {
        החזר שקר
    }
    משתנה ח = חלקות[אינדקס]
    אם (ח["בעלים"] != תור) {
        הודעה = "אפשר להעמיק רק במכרה שלכם"
        החזר שקר
    }
    אם (ח["העמקה_השבוע"]) {
        הודעה = "כבר העמקתם כאן השבוע"
        החזר שקר
    }
    משתנה ש = שחקנים[תור]
    אם (ש["כסף"] < מחיר_העמקה) {
        הודעה = "אין מספיק מזומן להעמקה"
        החזר שקר
    }
    ש["כסף"] = ש["כסף"] - מחיר_העמקה
    ח["העמקה_השבוע"] = אמת
    משתנה בונוס = כמות_הפקה(ח, תור) + 4
    משתנה מלאי = ש["מלאי"]
    משתנה מ = ח["משאב"]
    מלאי[מ] = מלאי[מ] + בונוס
    חלקה_פתוחה = ריק
    הודעה = "העמקה הניבה +" + בונוס + " " + שמות_משאב[מ]
    סיים_תור()
    החזר אמת
}

פונקציה הצע_במכרז() {
    אם (מכרז_אינדקס == ריק) {
        הודעה = "אין מכרז פתוח השבוע"
        החזר שקר
    }
    משתנה ח = חלקות[מכרז_אינדקס]
    אם (ח["בעלים"] != ריק) {
        הודעה = "המכרז כבר נסגר"
        החזר שקר
    }
    משתנה מינימום = מכרז_הצעה + מכרז_הצעה / 10
    אם (מינימום < ח["מחיר_בסיס"]) {
        מינימום = ח["מחיר_בסיס"]
    }
    משתנה ש = שחקנים[תור]
    אם (ש["כסף"] < מינימום) {
        הודעה = "אין מספיק מזומן להצעה"
        החזר שקר
    }
    מכרז_הצעה = מינימום
    מכרז_מציע = תור
    הודעה = "הצעה חדשה במכרז: " + מספרים.שלם(מכרז_הצעה) + "₪"
    סיים_תור()
    החזר אמת
}

פונקציה סגור_מכרז_אם_צריך() {
    אם (מכרז_אינדקס == ריק) {
        החזר ריק
    }
    אם (מהלכים_בשבוע < מהלכים_לשבוע / 2) {
        החזר ריק
    }
    אם (מכרז_מציע == ריק) {
        החזר ריק
    }
    משתנה ח = חלקות[מכרז_אינדקס]
    אם (ח["בעלים"] != ריק) {
        החזר ריק
    }
    משתנה זוכה = מכרז_מציע
    משתנה ש = שחקנים[זוכה]
    אם (ש["כסף"] < מכרז_הצעה) {
        הודעה = "הצעת המכרז בוטלה — אין כיסוי"
        מכרז_מציע = ריק
        החזר ריק
    }
    ש["כסף"] = ש["כסף"] - מכרז_הצעה
    ח["בעלים"] = זוכה
    ש["קנה_ראשון"] = אמת
    הודעה = שם_שחקן(זוכה) + " זכתה במכרז על " + ח["שם"]
    מכרז_אינדקס = ריק
    מכרז_הצעה = 0
    מכרז_מציע = ריק
    עדכן_מוניטין: זוכה
}

פונקציה כמות_הפקה(ח, שחקן) {
    משתנה ש = שחקנים[שחקן]
    משתנה כמות = תפוקה_איכות[ח["איכות"]]
    כמות = כמות + ש["פועלים"] * בונוס_פועל
    משתנה משאב = ח["משאב"]
    אם (משאב == 1) {
        או משאב == 2 או משאב == 3
        כמות = כמות + כמות * בונוס_מקדחה[ש["מקדחה"]] / 100
    }
    אם (ש["דינמיט"] > 0) {
        אם (משאב == 0) {
            כמות = כמות + 3
        }
        אם (משאב == 3) {
            כמות = כמות + 3
        }
    }
    משתנה שכנים = ספור_שכנים_שייכים_לחלקה(ח, שחקן)
    אם (שכנים > 0) {
        כמות = כמות + שכנים * 2
    }
    אם (אירוע_קוד == "בהלה") {
        וגם ח["איכות"] == 3
        כמות = כמות * 2
    }
    אם (ח["משאב"] == משאב_חם) {
        כמות = כמות + כמות / 5
    }
    אם (אירוע_קוד == "שביתה") {
        וגם ח["איכות"] == 0 וגם ימי_שביתה > 0
        כמות = 0
    }
    אם (יום_סערה) {
        כמות = 0
    }
    החזר מתמטיקה.עיגול(כמות)
}

פונקציה ספור_שכנים_שייכים_לחלקה(ח, שחקן) {
    משתנה ספירה = 0
    משתנה ש = ח["שכנים"]
    משתנה i = 0
    כל_עוד (i < ש.גודל()) {
        אם (חלקות[ש[i]]["בעלים"] == שחקן) {
            ספירה = ספירה + 1
        }
        i = i + 1
    }
    החזר ספירה
}

פונקציה הפק_יום() {
    משתנה i = 0
    כל_עוד (i < חלקות.גודל()) {
        משתנה ח = חלקות[i]
        אם (ח["בעלים"] != ריק) {
            משתנה בעלים = ח["בעלים"]
            משתנה ש = שחקנים[בעלים]
            משתנה כמות = כמות_הפקה(ח, בעלים)
            אם (כמות > 0) {
                משתנה מלאי = ש["מלאי"]
                משתנה מ = ח["משאב"]
                מלאי[מ] = מלאי[מ] + כמות
            }
        }
        i = i + 1
    }
    אם (ימי_שביתה > 0) {
        ימי_שביתה = ימי_שביתה - 1
    }
    יום_סערה = שקר
}

פונקציה בנה_שורות_דוח(שחקן) {
    משתנה שורות = []
    משתנה ש = שחקנים[שחקן]
    משתנה מלאי = ש["מלאי"]
    משתנה סהכ = 0
    משתנה i = 0
    כל_עוד (i < מלאי.גודל()) {
        אם (מלאי[i] > 0) {
            משתנה מחיר = מחירי_שוק[i]
            אם (אירוע_קוד == "קריסה") {
                וגם i == 1
                מחיר = מחיר * 70 / 100
            }
            אם (אירוע_קוד == "אורניום") {
                וגם i == 3
                מחיר = מחיר * 140 / 100
            }
            משתנה ערך = מלאי[i] * מחיר
            אם (ש["נתיב"]) {
                ערך = ערך + ערך * בונוס_נתיב_אחוז / 100
            }
            ערך = מתמטיקה.עיגול(ערך)
            סהכ = סהכ + ערך
            שורות.הוסף: שמות_משאב[i] + " × " + מלאי[i] + " = " + מספרים.שלם(ערך) + "₪"
            מלאי[i] = 0
        }
        i = i + 1
    }
    אם (אירוע_קוד == "סובסידיה") {
        סהכ = סהכ + 8000
        שורות.הוסף: "סובסידיה ממשלתית +8,000₪"
    }
    ש["ממתין"] = סהכ
    אם (שורות.גודל() == 0) {
        שורות.הוסף: "לא הופקו משאבים השבוע"
    }
    החזר שורות
}

פונקציה סגור_שבוע() {
    דוח_שורות0 = בנה_שורות_דוח(0)
    דוח_שורות1 = בנה_שורות_דוח(1)
    דוח_סכום0 = שחקנים[0]["ממתין"]
    דוח_סכום1 = שחקנים[1]["ממתין"]
    מסך = "דוח"
}

פונקציה הפקד_דוח_והמשך() {
    שחקנים[0]["כסף"] = שחקנים[0]["כסף"] + דוח_סכום0
    שחקנים[1]["כסף"] = שחקנים[1]["כסף"] + דוח_סכום1
    שחקנים[0]["ממתין"] = 0
    שחקנים[1]["ממתין"] = 0
    הגרל_אירוע_שבוע()
    מסך = "אירוע"
}

פונקציה הגרל_אירוע_שבוע() {
    משתנה ר = אקראי_בין: 1, 100
    יום_סערה = שקר
    ימי_שביתה = 0
    אם (ר <= 16) {
        אירוע_קוד = "קריסה"
        אירוע_כותרת = "קריסת שוק"
        אירוע_תיאור = "מחירי הזהב צונחים ב־30% השבוע."
        אירוע_אייקון = נתיב_קריסה
    } אחרת {
        אם (ר <= 32) {
            אירוע_קוד = "בהלה"
            אירוע_כותרת = "בהלה לזהב"
            אירוע_תיאור = "מכרות מעולות מפיקות פי שניים השבוע."
            אירוע_אייקון = נתיב_בהלה
        } אחרת {
            אם (ר <= 46) {
                אירוע_קוד = "שביתה"
                אירוע_כותרת = "שביתת פועלים"
                אירוע_תיאור = "מכרות חלשות לא מפיקות ביומיים הקרובים."
                ימי_שביתה = 2
                אירוע_אייקון = נתיב_שביתה
            } אחרת {
                אם (ר <= 60) {
                    אירוע_קוד = "אורניום"
                    אירוע_כותרת = "גילוי אורניום"
                    אירוע_תיאור = "ביקוש לאורניום מזניק את המחיר ב־40%."
                    אירוע_אייקון = "נכסים/אורניום.png"
                } אחרת {
                    אם (ר <= 72) {
                        אירוע_קוד = "סובסידיה"
                        אירוע_כותרת = "סובסידיה ממשלתית"
                        אירוע_תיאור = "שתי החברות מקבלות מענק קטן בסגירת השבוע."
                        אירוע_אייקון = נתיב_סובסידיה
                    } אחרת {
                        אם (ר <= 82) {
                            אירוע_קוד = "סערה"
                            אירוע_כותרת = "סערה במכרות"
                            אירוע_תיאור = "יום ההפקה הראשון בשבוע יבוטל לכולם."
                            יום_סערה = אמת
                            אירוע_אייקון = נתיב_סערה
                        } אחרת {
                            אירוע_קוד = "רגוע"
                            אירוע_כותרת = "שבוע רגוע"
                            אירוע_תיאור = "הבורסה זזה בעדינות. המשאב החם: " + שמות_משאב[משאב_חם] + "."
                            אירוע_אייקון = נתיב_שמש
                        }
                    }
                }
            }
        }
    }
}

פונקציה מכירה_חירום() {
    משתנה ש = שחקנים[תור]
    משתנה מלאי = ש["מלאי"]
    משתנה סהכ = 0
    משתנה i = 0
    כל_עוד (i < מלאי.גודל()) {
        אם (מלאי[i] > 0) {
            משתנה כמות = מלאי[i] / 2
            כמות = מתמטיקה.רצפה(כמות)
            אם (כמות < 1) {
                כמות = 1
            }
            אם (כמות > מלאי[i]) {
                כמות = מלאי[i]
            }
            משתנה ערך = כמות * מחירי_שוק[i] / 2
            ערך = מתמטיקה.עיגול(ערך)
            סהכ = סהכ + ערך
            מלאי[i] = מלאי[i] - כמות
        }
        i = i + 1
    }
    אם (סהכ <= 0) {
        הודעה = "אין מלאי למכירת חירום"
        החזר שקר
    }
    ש["כסף"] = ש["כסף"] + סהכ
    הודעה = "מכירת חירום בשוק האפור: +" + מספרים.שלם(סהכ) + "₪"
    סיים_תור()
    החזר אמת
}

פונקציה התחל_שבוע_חדש() {
    שבוע = שבוע + 1
    מהלכים_בשבוע = 0
    תור = 0
    שחקנים[0]["סקר_השבוע"] = אמת
    שחקנים[1]["סקר_השבוע"] = אמת
    משתנה i = 0
    כל_עוד (i < חלקות.גודל()) {
        חלקות[i]["העמקה_השבוע"] = שקר
        i = i + 1
    }
    הזז_בורסה()
    בחר_מכרז_שבועי()
    חלקה_פתוחה = ריק
    הודעה = "שבוע " + שבוע + " מתחיל · תור " + שם_שחקן(0)
    מסך = "משחק"
}

פונקציה סיים_תור() {
    הפק_יום()
    מהלכים_בשבוע = מהלכים_בשבוע + 1
    סגור_מכרז_אם_צריך()
    חלקה_פתוחה = ריק
    אם (מהלכים_בשבוע >= מהלכים_לשבוע) {
        סגור_שבוע()
        החזר ריק
    }
    תור = 1 - תור
    אם (מול_מחשב) {
        וגם תור == 1 וגם מסך == "משחק"
        אם (לא ai_רץ) {
            ai_רץ = אמת
            מהלך_AI()
            ai_רץ = שקר
        }
    }
}
