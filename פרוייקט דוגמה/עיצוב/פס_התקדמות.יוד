// פס_התקדמות.יוד — Progress bar
כלול "פקד.יוד"

מחלקה פס_התקדמות מרחיב פקד {
    פונקציה בנאי(אחוז = 0, מזהה = "") {
        אם (אחוז == ריק) {
            אחוז = 0
        }
        הורה(מזהה)
        זה.ערך = אחוז
        זה._צור("פס_התקדמות", { "ערך": אחוז })
    }

    פונקציה קבע_ערך(אחוז) {
        אם (אחוז == ריק) {
            אחוז = 0
        }
        זה.ערך = אחוז
        זה._שלח_פקודה("קבע_ערך", { "ערך": אחוז })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }
}
