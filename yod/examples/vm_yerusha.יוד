// ירושה במכונה
// yod מכונה examples\vm_yerusha.יוד
מחלקה חיה
    משתנה רעב = אמת
    פונקציה בנאי שם
        זה.שם = שם
    סוף
    פונקציה הצג
        הדפס: "חיה: " + זה.שם
    סוף
    פונקציה האכל
        זה.רעב = שקר
        הדפס: זה.שם + " אכל"
    סוף
סוף

מחלקה כלב מרחיב חיה
    פונקציה בנאי שם, גזע
        הורה(שם)
        זה.גזע = גזע
    סוף
    פונקציה הצג
        הורה.הצג()
        הדפס: "גזע: " + זה.גזע
    סוף
    פונקציה נבח
        הדפס: זה.שם + ": הב הב!"
    סוף
סוף

משתנה כלבון = חדש כלב: "רקס", "לברדור"
כלבון.הצג()
כלבון.נבח()
כלבון.האכל()
הדפס: "רעב אחרי האכלה: " + כלבון.רעב
