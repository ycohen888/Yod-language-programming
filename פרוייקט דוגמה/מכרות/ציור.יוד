            לוח.קבע_עובי: 1
            לוח.מלבן: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4
          סוף
          אם מעקב_x == x וגם מעקב_y == y
            לוח.קבע_צבע: זהב_א, זהב_י, זהב_כ
            לוח.קבע_עובי: 2
