        לוח.קבע_צבע: 70, 75, 88
        לוח.קבע_גודל_גופן: 9
        לוח.טקסט: "נעול", px + 6, py + 12
      אחרת
        משתנה ת = תא_ב(x, y)
        אם ת["חפור"]
          אם ת["משאב"] >= 0
            משתנה צ = צבע_דרגה(ת["דרגה"])
            לוח.קבע_מילוי: צ[0], צ[1], צ[2]
            לוח.מלבן_מעוגל_מלא: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4, 5
