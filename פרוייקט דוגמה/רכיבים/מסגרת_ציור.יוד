// מסגרת_ציור.יוד — כרטיס רקע עדין
מחלקה מסגרת_ציור מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, גבה) {
        הורה(x, y, רחב, גבה)
        זה.אדום = ערכה_משטח_א
        זה.ירוק = ערכה_משטח_י
        זה.כחול = ערכה_משטח_כ
        זה.רדיוס = 10
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        החזר שקר
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משטח.קבע_מילוי(14, 15, 18)
        מלבן_מעוגל_מלא(משטח, זה.x + 1, זה.y + 2, זה.רחב, זה.גבה, זה.רדיוס)
        משטח.קבע_מילוי(זה.אדום, זה.ירוק, זה.כחול)
        מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס)
    }
}
