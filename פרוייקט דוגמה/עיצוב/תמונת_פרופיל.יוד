// תמונת_פרופיל.יוד — Avatar
כלול "פקד.יוד"

מחלקה תמונת_פרופיל מרחיב פקד {
    פונקציה בנאי(שם = "", תמונה = "", גודל = "בינוני", מזהה = "") {
        אם (שם == ריק) {
            שם = ""
        }
        אם (תמונה == ריק) {
            תמונה = ""
        }
        אם (גודל == ריק או גודל == "") {
            גודל = "בינוני"
        }
        הורה(מזהה)
        זה.שם = שם
        זה.טקסט = שם
        זה.תמונה = תמונה
        זה.גודל = גודל
        זה._לחץ = ריק
        זה._צור("תמונת_פרופיל", {
            "שם": שם,
            "תמונה": תמונה,
            "גודל": גודל,
            "טקסט": שם
        })
    }

    פונקציה קבע_שם(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.שם = ט
        זה.טקסט = ט
        זה._שלח_פקודה("קבע_שם", { "שם": ט })
    }

    פונקציה קבע_תמונה(נתיב) {
        אם (נתיב == ריק) {
            נתיב = ""
        }
        זה.תמונה = נתיב
        זה._שלח_פקודה("קבע_תמונה", { "תמונה": נתיב })
    }

    פונקציה קבע_גודל(ג) {
        אם (ג == ריק או ג == "") {
            ג = "בינוני"
        }
        זה.גודל = ג
        זה._שלח_פקודה("קבע_גודל", { "גודל": ג })
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }
}
