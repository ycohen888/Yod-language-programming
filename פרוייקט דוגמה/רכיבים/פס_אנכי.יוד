// פס_אנכי.יוד — פס התקדמות אנכי דק

מחלקה פס_אנכי מרחיב רכיב
  פונקציה בנאי(x, y, גבה, אחוז)
    הורה(x, y, 8, גבה)
    זה.אחוז = הגבל(אחוז, 0, 100)
  סוף

  פונקציה קבע_אחוז(v)
    זה.אחוז = הגבל(v, 0, 100)
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משטח.קבע_מילוי(42, 46, 54)
    מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רחב / 2)
    משתנה מלא = (זה.גבה * זה.אחוז / 100).שלם()
    אם מלא >= זה.רחב
      משתנה py = זה.y + זה.גבה - מלא
      משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
      מלבן_מעוגל_מלא(משטח, זה.x, py, זה.רחב, מלא, זה.רחב / 2)
    סוף
  סוף
סוף
