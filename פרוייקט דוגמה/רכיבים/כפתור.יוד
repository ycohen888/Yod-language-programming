// כפתור.יוד — כפתור קומפקטי מעוגל
מחלקה כפתור_משטח מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, גבה, טקסט) {
        אם (גבה < 1) {
            גבה = 26
        }
        הורה(x, y, רחב, גבה)
        זה.טקסט = טקסט
        זה.ראשי = שקר
        זה.בלחיצה = ריק
        זה.רדיוס = 6
    }
    פונקציה קבע_ראשי(v) {
        זה.ראשי = v
        זה.בקש_רענון()
    }
    פונקציה קבע_טקסט(t) {
        זה.טקסט = t
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה מא = ערכה_גובה_א
        משתנה מי = ערכה_גובה_י
        משתנה מכ = ערכה_גובה_כ
        אם (זה.ראשי) {
            מא = ערכה_ראשי_א
            מי = ערכה_ראשי_י
            מכ = ערכה_ראשי_כ
        }
        אם (זה.לחוץ) {
            אם (זה.ראשי) {
                מא = ערכה_ראשי_כהה_א
                מי = ערכה_ראשי_כהה_י
                מכ = ערכה_ראשי_כהה_כ
            } אחרת {
                מא = 38
                מי = 40
                מכ = 46
            }
        }
        אם (זה.מושבת) {
            מא = 36
            מי = 38
            מכ = 42
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, מא, מי, מכ)
        אם (לא זה.לחוץ וגם לא זה.מושבת) {
            הדגשת_עליון(משטח, זה.x, זה.y, זה.רחב, זה.רדיוס, 62, 66, 74)
        }
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        אם (זה.מושבת) {
            משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
        }
        משטח.קבע_גודל_גופן(12)
        משתנה tx = זה.x + 10
        משתנה ty = זה.y + זה.גבה / 2 - 6
        משטח.טקסט(זה.טקסט, tx, ty)
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        זה.לחוץ = אמת
        זה.בקש_רענון()
        החזר אמת
    }
    פונקציה בעכבר_למעלה(mx, my, כפתור) {
        אם (לא זה.לחוץ) {
            החזר ריק
        }
        זה.לחוץ = שקר
        זה.בקש_רענון()
        אם (זה.מכיל(mx, my) וגם זה.בלחיצה != ריק) {
            זה.בלחיצה()
        }
    }
}
