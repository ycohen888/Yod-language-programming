// עמודים.יוד — Pagination
כלול "פקד.יוד"

מחלקה עמודים מרחיב פקד {
    פונקציה בנאי(סהכ = 5, נוכחי = 1, מזהה = "") {
        אם (סהכ == ריק או סהכ < 1) {
            סהכ = 5
        }
        אם (נוכחי == ריק או נוכחי < 1) {
            נוכחי = 1
        }
        הורה(מזהה)
        זה.סהכ = סהכ
        זה.ערך = נוכחי
        זה._שינוי = ריק
        זה._צור("עמודים", {
            "סהכ": סהכ,
            "ערך": נוכחי
        })
    }

    פונקציה קבע_ערך(מספר) {
        אם (מספר == ריק) {
            מספר = 1
        }
        זה.ערך = מספר
        זה._שלח_פקודה("קבע_ערך", { "ערך": מספר })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
