// דירוג.יוד — כוכבים
כלול "פקד.יוד"

מחלקה דירוג מרחיב פקד {
    פונקציה בנאי(מקס = 5, ערך = 0, מזהה = "") {
        אם (מקס == ריק או מקס < 1) {
            מקס = 5
        }
        אם (ערך == ריק) {
            ערך = 0
        }
        הורה(מזהה)
        זה.מקס = מקס
        זה.ערך = ערך
        זה._שינוי = ריק
        זה._צור("דירוג", {
            "מקס": מקס,
            "ערך": ערך
        })
    }

    פונקציה קבע_ערך(מספר) {
        אם (מספר == ריק) {
            מספר = 0
        }
        זה.ערך = מספר
        זה._שלח_פקודה("קבע_ערך", { "ערך": מספר })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
