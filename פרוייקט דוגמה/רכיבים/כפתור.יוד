// כפתור.יוד — כפתור מעוגל כהה על משטח

מחלקה כפתור_משטח מרחיב רכיב
  פונקציה בנאי(x, y, רחב, גבה, טקסט)
    הורה(x, y, רחב, גבה)
    זה.טקסט = טקסט
    זה.ראשי = שקר
    זה.בלחיצה = ריק
    זה.רדיוס = 10
  סוף

  פונקציה קבע_ראשי(v)
    זה.ראשי = v
    זה.בקש_רענון()
  סוף

  פונקציה קבע_טקסט(t)
    זה.טקסט = t
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה מא = ערכה_גובה_א
    משתנה מי = ערכה_גובה_י
    משתנה מכ = ערכה_גובה_כ
    אם זה.ראשי
      מא = ערכה_ראשי_א
      מי = ערכה_ראשי_י
      מכ = ערכה_ראשי_כ
    סוף
    אם זה.לחוץ
      אם זה.ראשי
        מא = ערכה_ראשי_כהה_א
        מי = ערכה_ראשי_כהה_י
        מכ = ערכה_ראשי_כהה_כ
      אחרת
        מא = 34
        מי = 36
        מכ = 42
      סוף
    סוף
    אם זה.מושבת
      מא = 36
      מי = 38
      מכ = 42
    סוף
    מלבן_מעוגל_עם_גבול(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, מא, מי, מכ)
    אם לא זה.לחוץ וגם לא זה.מושבת
      קו_עליון_רך(משטח, זה.x + 1, זה.y + 1, זה.רחב - 2, זה.גבה - 2, זה.רדיוס - 1, 70, 74, 82)
    סוף
    משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
    אם זה.מושבת
      משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
    סוף
    משטח.קבע_גודל_גופן(14)
    משתנה tx = זה.x + זה.רחב / 2 - אורך(זה.טקסט) * 4
    אם tx < זה.x + 10
      tx = זה.x + 10
    סוף
    משתנה ty = זה.y + זה.גבה / 2 - 7
    משטח.טקסט(זה.טקסט, tx, ty)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.לחוץ = אמת
    זה.בקש_רענון()
    החזר אמת
  סוף

  פונקציה בעכבר_למעלה(mx, my, כפתור)
    אם לא זה.לחוץ
      החזר ריק
    סוף
    זה.לחוץ = שקר
    זה.בקש_רענון()
    אם זה.מכיל(mx, my) וגם זה.בלחיצה != ריק
      זה.בלחיצה()
    סוף
  סוף
סוף
