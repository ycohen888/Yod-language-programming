// מספר_מדרגה.יוד — כפתורי − / + לערך מספרי שלם

מחלקה מספר_מדרגה מרחיב רכיב
  פונקציה בנאי(x, y, מינ, מקס, ערך)
    הורה(x, y, 110, 30)
    זה.מינ = מינ
    זה.מקס = מקס
    זה.צעד = 1
    זה.ערך = עגל_לצעד(הגבל(ערך, מינ, מקס), זה.צעד)
    זה.בשינוי = ריק
    זה.רחב_כפתור = 28
  סוף

  פונקציה נרמל(v)
    החזר עגל_לצעד(הגבל(v, זה.מינ, זה.מקס), זה.צעד)
  סוף

  פונקציה קבע_ערך(v)
    משתנה קודם = זה.ערך
    זה.ערך = זה.נרמל(v)
    אם זה.ערך != קודם
      זה.בקש_רענון()
      אם זה.בשינוי != ריק
        זה.בשינוי(זה.ערך)
      סוף
    סוף
  סוף

  פונקציה קבע_ערך_שקט(v)
    משתנה קודם = זה.ערך
    זה.ערך = זה.נרמל(v)
    אם זה.ערך != קודם
      זה.בקש_רענון()
    סוף
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה bw = זה.רחב_כפתור
    משטח.קבע_מילוי(50, 52, 56)
    משטח.מלבן_מלא(זה.x, זה.y, bw, זה.גבה)
    משטח.קבע_מילוי(36, 38, 42)
    משטח.מלבן_מלא(זה.x + bw, זה.y, זה.רחב - 2 * bw, זה.גבה)
    משטח.קבע_מילוי(50, 52, 56)
    משטח.מלבן_מלא(זה.x + זה.רחב - bw, זה.y, bw, זה.גבה)
    משטח.קבע_צבע(70, 74, 80)
    משטח.קבע_עובי(1)
    משטח.מלבן(זה.x, זה.y, זה.רחב, זה.גבה)
    משטח.קבע_צבע(220, 225, 230)
    משטח.קבע_גודל_גופן(14)
    משטח.טקסט("−", זה.x + 8, זה.y + 6)
    משטח.טקסט("" + זה.ערך.שלם(), זה.x + bw + 12, זה.y + 6)
    משטח.טקסט("+", זה.x + זה.רחב - bw + 8, זה.y + 6)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    משתנה bw = זה.רחב_כפתור
    אם mx < זה.x + bw
      זה.קבע_ערך(זה.ערך - זה.צעד)
    אחרת_אם mx >= זה.x + זה.רחב - bw
      זה.קבע_ערך(זה.ערך + זה.צעד)
    סוף
    החזר אמת
  סוף
סוף
