// פס_כלים.יוד — שורת רכיבים/כפתורים מדחוסה מצד ההתחלה
מחלקה פס_כלים מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, גבה) {
        אם (גבה < 1) {
            גבה = 36
        }
        הורה(x, y, רחב, גבה)
        זה.ילדים = []
        זה.רווח = 6
        זה.ריפוד = 4
        זה.רדיוס = 7
        זה.עם_רקע = אמת
    }
    פונקציה הוסף(ר) {
        זה.ילדים.הוסף(ר)
        אם (זה.לוח != ריק) {
            ר.לוח = זה.לוח
        }
        זה.דחוס_מהתחלה()
    }
    פונקציה דחוס_מהתחלה() {
        משתנה n = אורך(זה.ילדים)
        אם (n <= 0) {
            החזר ריק
        }
        אם (הוא_ימין(זה.כיוון())) {
            משתנה cx = זה.x + זה.רחב - זה.ריפוד
            משתנה i = 0
            כל_עוד (i < n) {
                משתנה ר = זה.ילדים[i]
                cx = cx - ר.רחב
                ר.x = cx
                ר.y = זה.y + (זה.גבה - ר.גבה) / 2
                cx = cx - זה.רווח
                i = i + 1
            }
        } אחרת {
            משתנה cx = זה.x + זה.ריפוד
            משתנה i = 0
            כל_עוד (i < n) {
                משתנה ר = זה.ילדים[i]
                ר.x = cx
                ר.y = זה.y + (זה.גבה - ר.גבה) / 2
                cx = cx + ר.רחב + זה.רווח
                i = i + 1
            }
        }
        זה.בקש_רענון()
    }
    פונקציה מכיל(mx, my) {
        החזר שקר
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        אם (זה.עם_רקע) {
            מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, 28, 30, 36)
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        החזר שקר
    }
}
