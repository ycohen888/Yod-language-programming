// רשימה.יוד — List group
כלול "פקד.יוד"

מחלקה רשימה מרחיב פקד {
    פונקציה בנאי(פריטים, מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה.ערך = ""
        זה._שינוי = ריק
        זה._העתקה = ריק
        זה._צור("רשימה", {
            "פריטים": פריטים
        })
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }

    פונקציה בהעתקה(פונק) {
        זה._העתקה = פונק
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }
}
