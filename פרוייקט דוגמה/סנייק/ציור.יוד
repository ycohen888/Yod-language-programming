// ציור.יוד — לוח משחק, נחש, מזון ומצבי מסך

פונקציה מלבן_לוח()
  החזר [
    שוליים,
    גובה_כותרת + שוליים,
    עמודות * גודל_תא,
    שורות * גודל_תא
  ]
סוף

פונקציה תא_לפיקסל x, y
  משתנה bx = שוליים + x * גודל_תא
  משתנה by = גובה_כותרת + שוליים + y * גודל_תא
  החזר [bx, by]
סוף

פונקציה צייר_רקע()
  לוח.נקה: רקע_א, רקע_י, רקע_כ

  לוח.קבע_מילוי: 18, 24, 32
  לוח.מלבן_מלא: 0, 0, רוחב_לוח, גובה_כותרת

  לוח.קבע_צבע: הדגש_א, הדגש_י, הדגש_כ
  לוח.קבע_גודל_גופן: 22
  לוח.טקסט: "סנייק", 18, 18

  לוח.קבע_צבע: משני_א, משני_י, משני_כ
  לוח.קבע_גודל_גופן: 12
  לוח.טקסט: "חצים / WASD  ·  רווח הפסקה  ·  R איפוס", 18, 42

  לוח.קבע_צבע: טקסט_א, טקסט_י, טקסט_כ
  לוח.קבע_גודל_גופן: 14
  משתנה מיקום_ניקוד = רוחב_לוח - 210
  לוח.טקסט: "ניקוד  " + ניקוד, מיקום_ניקוד, 14
  לוח.קבע_צבע: הדגש_א, הדגש_י, הדגש_כ
  לוח.טקסט: "שיא  " + שיא, מיקום_ניקוד, 36

  משתנה מ = מלבן_לוח()
  משתנה bx = מ[0] - 4
  משתנה by = מ[1] - 4
  משתנה bw = מ[2] + 8
  משתנה bh = מ[3] + 8
  לוח.קבע_מילוי: לוח_א, לוח_י, לוח_כ
  לוח.מלבן_מעוגל_מלא: bx, by, bw, bh, 10

  לוח.קבע_צבע: מסגרת_א, מסגרת_י, מסגרת_כ
  לוח.קבע_עובי: 2
  לוח.מלבן: bx, by, bw, bh

  משתנה י = 0
  כל_עוד י < שורות
    משתנה איקס = 0
    כל_עוד איקס < עמודות
      משתנה סכום = איקס + י
      משתנה חצי = סכום / 2
      אם חצי.שלם() * 2 == סכום
        משתנה p = תא_לפיקסל(איקס, י)
        לוח.קבע_מילוי: משבצת_א, משבצת_י, משבצת_כ
        לוח.מלבן_מלא: p[0], p[1], גודל_תא, גודל_תא
      סוף
      איקס = איקס + 1
    סוף
    י = י + 1
  סוף
סוף

פונקציה צייר_מזון()
  משתנה p = תא_לפיקסל(מזון_x, מזון_y)
  משתנה pad = 2
  משתנה גודל = גודל_תא - pad * 2
  לוח.תמונה: נתיב_תפוח, p[0] + pad, p[1] + pad, גודל, גודל
סוף

פונקציה צייר_נחש()
  משתנה n = גוף.גודל()
  משתנה זנב_אינדקס = n - 1
  משתנה i = זנב_אינדקס
  כל_עוד i >= 0
    משתנה ת = גוף[i]
    משתנה p = תא_לפיקסל(ת["x"], ת["y"])
    משתנה pad = 3
    משתנה רדיוס = 7
    לוח.קבע_מילוי: נחש_א, נחש_י, נחש_כ
    אם i == 0
      לוח.קבע_מילוי: ראש_א, ראש_י, ראש_כ
      pad = 2
      רדיוס = 8
    סוף
    אם i == זנב_אינדקס וגם i != 0
      לוח.קבע_מילוי: זנב_א, זנב_י, זנב_כ
      pad = 5
      רדיוס = 6
    סוף
    משתנה ריפוד2 = pad * 2
    לוח.מלבן_מעוגל_מלא: p[0] + pad, p[1] + pad, גודל_תא - ריפוד2, גודל_תא - ריפוד2, רדיוס

    אם i == 0
      לוח.קבע_מילוי: 12, 16, 22
      משתנה ex = p[0] + גודל_תא / 2
      משתנה ey = p[1] + גודל_תא / 2
      אם כיוון_x == ישר_אופק
        לוח.עיגול_מלא: ex + 4, ey - 4, 2
        לוח.עיגול_מלא: ex + 4, ey + 4, 2
      סוף
      אם כיוון_x == הפוך_אופק
        לוח.עיגול_מלא: ex - 4, ey - 4, 2
        לוח.עיגול_מלא: ex - 4, ey + 4, 2
      סוף
      אם כיוון_y == למעלה_כ
        לוח.עיגול_מלא: ex - 4, ey - 4, 2
        לוח.עיגול_מלא: ex + 4, ey - 4, 2
      סוף
      אם כיוון_y == למטה_כ
        לוח.עיגול_מלא: ex - 4, ey + 4, 2
        לוח.עיגול_מלא: ex + 4, ey + 4, 2
      סוף
    סוף
    i = i - 1
  סוף
סוף

פונקציה צייר_שכבת_מצב()
  אם מצב_משחק == "רץ"
    החזר ריק
  סוף

  משתנה מ = מלבן_לוח()
  משתנה כרטיס_x = מ[0] + 20
  משתנה כרטיס_y = מ[1] + מ[3] / 2 - 52
  משתנה כרטיס_ר = מ[2] - 40
  לוח.קבע_מילוי: 8, 10, 14
  לוח.מלבן_מעוגל_מלא: כרטיס_x, כרטיס_y, כרטיס_ר, 104, 14

  לוח.קבע_צבע: טקסט_א, טקסט_י, טקסט_כ
  לוח.קבע_גודל_גופן: 20
  משתנה כותרת = ""
  משתנה שורה = ""
  אם מצב_משחק == "מוכן"
    כותרת = "מוכנים?"
    שורה = "לחצו רווח או אנטר להתחלה"
  סוף
  אם מצב_משחק == "הפסקה"
    כותרת = "הפסקה"
    שורה = "רווח להמשך"
  סוף
  אם מצב_משחק == "נגמר"
    כותרת = "נגמר!"
    שורה = "ניקוד " + ניקוד + "  ·  R למשחק חדש"
  סוף
  משתנה טקסט_x = מ[0] + מ[2] / 2 - 48
  משתנה טקסט_y = מ[1] + מ[3] / 2 - 28
  לוח.טקסט: כותרת, טקסט_x, טקסט_y
  לוח.קבע_גודל_גופן: 13
  לוח.קבע_צבע: משני_א, משני_י, משני_כ
  לוח.טקסט: שורה, מ[0] + 48, מ[1] + מ[3] / 2 + 8
סוף

פונקציה צייר_הכל()
  אם לוח == ריק
    החזר ריק
  סוף
  צייר_רקע()
  צייר_מזון()
  צייר_נחש()
  צייר_שכבת_מצב()
  לוח.רענן()
סוף
