// רשימות ולולאת עבור
משתנה שמות = ["נועם", "דני", "מיכל"]
הדפס: "יש " + אורך(שמות) + " שמות"
עבור שם בתוך שמות
    הדפס: "שלום " + שם
סוף

שמות[1] = "יוסי"
הדפס: "אחרי שינוי: " + שמות[1]
הוסף(שמות, "רות")
הדפס: "אורך חדש: " + אורך(שמות)
עבור שם בתוך שמות
    אם שם == "יוסי"
        המשך
    סוף
    אם שם == "רות"
        עצור
    סוף
    הדפס: שם
סוף
