// תווית_ציור.יוד — טקסט; x = קצה שמאל גיאומטרי של הטקסט (לא מתהפך)
מחלקה תווית_ציור מרחיב רכיב {
    פונקציה בנאי(x, y, טקסט) {
        הורה(x, y, 320, 18)
        זה.טקסט = טקסט
        זה.אדום = ערכה_משני_א
        זה.ירוק = ערכה_משני_י
        זה.כחול = ערכה_משני_כ
        זה.גודל = 11
    }
    פונקציה קבע_טקסט(t) {
        זה.טקסט = t
        זה.בקש_רענון()
    }
    פונקציה קבע_צבע_rgb(א, י, כ) {
        זה.אדום = א
        זה.ירוק = י
        זה.כחול = כ
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משטח.קבע_צבע(זה.אדום, זה.ירוק, זה.כחול)
        משטח.קבע_גודל_גופן(זה.גודל)
        אם (הוא_ימין(זה.כיוון())) {
            משתנה w = אומדן_רוחב_טקסט(משטח, זה.טקסט)
            משטח.קבע_יישור("ימין")
            משטח.טקסט(זה.טקסט, זה.x + w, זה.y)
        } אחרת {
            משטח.קבע_יישור("שמאל")
            משטח.טקסט(זה.טקסט, זה.x, זה.y)
        }
        משטח.קבע_יישור("שמאל")
    }
}
