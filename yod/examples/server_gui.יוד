// שרת יוד — ממשק Windows לניהול שרת HTTP מקומי
// הרצה: yod הרץ examples\server_gui.יוד
// אריזה:  yod ארוז examples\server_gui.יוד

כלול "חלונות"
כלול "רשת"
כלול "זמן"

משתנה פורט_ברירת_מחדל = "8080"
משתנה שרת = ריק
משתנה בקשות = 0
משתנה התחיל_ב = ""

// —— ממשק (לפני הפונקציות שמשתמשות בו) ——
משתנה ח = חלונות.חלון: "שרת יוד"
ח.קבע_גודל: 420, 300

משתנה כותרת = חלונות.תווית: "ניהול שרת HTTP מקומי"
משתנה לד = חלונות.נורית()
משתנה סטטוס = חלונות.תווית: "בקשות: 0"
משתנה כתובת = חלונות.תווית: "—"
משתנה תווית_פורט = חלונות.תווית: "פורט:"
משתנה שדה_פורט = חלונות.שדה: פורט_ברירת_מחדל
משתנה כפתור_הפעל = חלונות.כפתור: "הפעל שרת"
משתנה כפתור_עצור = חלונות.כפתור: "עצור"
משתנה כפתור_רענון = חלונות.כפתור: "רענון"

פונקציה דף_בית(בקשה)
    בקשות = בקשות + 1
    משתנה html = "<!DOCTYPE html><html lang=\"he\" dir=\"rtl\"><head><meta charset=\"utf-8\">" +
        "<title>שרת יוד</title>" +
        "<style>body{font-family:Segoe UI,Arial,sans-serif;background:#0f172a;color:#e2e8f0;display:flex;" +
        "min-height:100vh;align-items:center;justify-content:center;margin:0}" +
        ".card{background:#1e293b;padding:2rem 2.5rem;border-radius:16px;max-width:420px;text-align:center;" +
        "box-shadow:0 20px 50px rgba(0,0,0,.35)}h1{margin:0 0 .5rem;color:#5eead4;font-size:1.8rem}" +
        "p{margin:.4rem 0;color:#94a3b8}a{color:#67e8f9}</style></head><body><div class=\"card\">" +
        "<h1>שרת יוד פעיל</h1>" +
        "<p>הבקשה הגיעה בהצלחה מהדפדפן.</p>" +
        "<p>שיטה: " + בקשה["שיטה"] + "</p>" +
        "<p><a href=\"/בריאות\">בדיקת בריאות</a> · <a href=\"/מידע\">מידע JSON</a></p>" +
        "</div></body></html>"
    החזר: {
        "קוד": 200,
        "כותרות": { "Content-Type": "text/html; charset=utf-8" },
        "גוף": html
    }
סוף

פונקציה דף_בריאות(בקשה)
    בקשות = בקשות + 1
    החזר: {
        "קוד": 200,
        "כותרות": { "Content-Type": "text/plain; charset=utf-8" },
        "גוף": "תקין"
    }
סוף

פונקציה דף_מידע(בקשה)
    בקשות = בקשות + 1
    משתנה גוף = "{" +
        "\"שם\":\"שרת יוד\"," +
        "\"בקשות\":" + בקשות + "," +
        "\"התחיל\":\"" + התחיל_ב + "\"" +
        "}"
    החזר: {
        "קוד": 200,
        "כותרות": { "Content-Type": "application/json; charset=utf-8" },
        "גוף": גוף
    }
סוף

פונקציה עדכן_סטטוס()
    אם שרת != ריק וגם שרת.פועל()
        לד.הדלק()
        סטטוס.קבע_טקסט("בקשות: " + בקשות)
        כתובת.קבע_טקסט(שרת.כתובת)
    אחרת
        לד.כבה()
        סטטוס.קבע_טקסט("בקשות: " + בקשות)
        כתובת.קבע_טקסט("—")
    סוף
סוף

פונקציה התחל_שרת()
    אם שרת != ריק
        אם שרת.פועל()
            עדכן_סטטוס()
            החזר ריק
        סוף
    סוף

    משתנה טקסט_פורט = שדה_פורט.קרא_טקסט().גזום()
    אם טקסט_פורט == ""
        טקסט_פורט = פורט_ברירת_מחדל
    סוף
    משתנה פורט = למספר(טקסט_פורט)
    אם פורט < 1 או פורט > 65535
        חלונות.הודעה: "שגיאה", "פורט לא תקין (1-65535)"
        החזר ריק
    סוף

    בקשות = 0
    התחיל_ב = זמן.שעה()
    שרת = רשת.שרת(פורט)
    שרת.מסלול("/", דף_בית)
    שרת.מסלול("/בריאות", דף_בריאות)
    שרת.מסלול("/מידע", דף_מידע)

    נסה
        שרת.הפעל_ברקע()
        עדכן_סטטוס()
    תפוס שגיאה
        שרת = ריק
        לד.כבה()
        חלונות.הודעה: "שגיאה", "" + שגיאה
        עדכן_סטטוס()
    סוף
סוף

פונקציה עצור_שרת()
    אם שרת == ריק
        לד.כבה()
        עדכן_סטטוס()
        החזר ריק
    סוף
    שרת.עצור()
    עדכן_סטטוס()
סוף

כפתור_הפעל.בלחיצה: פונקציה ()
    התחל_שרת()
סוף

כפתור_עצור.בלחיצה: פונקציה ()
    עצור_שרת()
סוף

כפתור_רענון.בלחיצה: פונקציה ()
    עדכן_סטטוס()
סוף

ח.הוסף: כותרת
ח.הוסף: לד
ח.הוסף: סטטוס
ח.הוסף: כתובת
ח.הוסף: תווית_פורט
ח.הוסף: שדה_פורט
ח.הוסף: כפתור_הפעל
ח.הוסף: כפתור_עצור
ח.הוסף: כפתור_רענון

ח.הצג()

אם שרת != ריק
    שרת.עצור()
סוף
