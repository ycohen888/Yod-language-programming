// תצוגת_עץ.יוד — Tree view
// פריט: { "טקסט", "ערך"?, "תת_כותרת"?, "איקון"?, "סגנון"?, "ילדים"? }
// סגנון: הצלחה | סכנה | אזהרה | מידע | משני
כלול "פקד.יוד"

מחלקה תצוגת_עץ מרחיב פקד {
    פונקציה בנאי(פריטים, נבחר = "", מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (נבחר == ריק) {
            נבחר = ""
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה.ערך = נבחר
        זה._לחץ = ריק
        זה._שינוי = ריק
        זה._לחיצה_כפולה = ריק
        זה._צור("תצוגת_עץ", {
            "פריטים": פריטים,
            "ערך": נבחר
        })
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }

    פונקציה בלחיצה_כפולה(פונק) {
        זה._לחיצה_כפולה = פונק
    }
}
