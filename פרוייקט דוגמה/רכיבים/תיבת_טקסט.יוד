// תיבת_טקסט.יוד — הקלדה רב־שורות עם גלילה אנכית פשוטה
כלול "לוח"

מחלקה תיבת_טקסט מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, גבה, טקסט) {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        אם (גבה < 40) {
            גבה = 80
        }
        הורה(x, y, רחב, גבה)
        זה.טקסט = טקסט
        זה.מקום_שמור = ""
        זה.ממוקד = שקר
        זה.סמן = אורך(טקסט)
        זה.בח_מ = -1
        זה.בח_ע = -1
        זה.בשינוי = ריק
        זה.רדיוס = 6
        זה.גובה_שורה = 16
        זה.גלילה = 0
        זה.ריפוד = 8
    }
    פונקציה מקבל_מיקוד() {
        החזר אמת
    }
    פונקציה קבע_מיקוד(v) {
        זה.ממוקד = v
        אם (לא v) {
            זה.נקה_בחירה()
        }
        זה.בקש_רענון()
    }
    פונקציה אורך_טקסט() {
        אם (זה.טקסט == ריק או זה.טקסט == "") {
            החזר 0
        }
        החזר זה.טקסט.אורך()
    }
    פונקציה הגבל_סמן(i) {
        משתנה ל = זה.אורך_טקסט()
        אם (i < 0) {
            החזר 0
        }
        אם (i > ל) {
            החזר ל
        }
        החזר i
    }
    פונקציה יש_בחירה() {
        החזר זה.בח_מ >= 0 וגם זה.בח_ע >= 0 וגם זה.בח_מ != זה.בח_ע
    }
    פונקציה בחירה_ממוינת() {
        אם (זה.בח_מ > זה.בח_ע) {
            החזר [זה.בח_ע, זה.בח_מ]
        }
        החזר [זה.בח_מ, זה.בח_ע]
    }
    פונקציה נקה_בחירה() {
        זה.בח_מ = -1
        זה.בח_ע = -1
    }
    פונקציה בחר_הכל() {
        משתנה ל = זה.אורך_טקסט()
        אם (ל <= 0) {
            החזר ריק
        }
        זה.בח_מ = 0
        זה.בח_ע = ל
        זה.סמן = ל
        זה.בקש_רענון()
    }
    פונקציה קבע_טקסט(t) {
        אם (t == ריק) {
            t = ""
        }
        זה.טקסט = t
        זה.סמן = זה.אורך_טקסט()
        זה.נקה_בחירה()
        זה.בקש_רענון()
    }
    פונקציה קרא_טקסט() {
        אם (זה.טקסט == ריק) {
            החזר ""
        }
        החזר זה.טקסט
    }
    פונקציה קבע_מקום_שמור(t) {
        אם (t == ריק) {
            זה.מקום_שמור = ""
        } אחרת {
            זה.מקום_שמור = t
        }
        זה.בקש_רענון()
    }
    פונקציה דווח_שינוי() {
        אם (זה.בשינוי != ריק) {
            זה.בשינוי(זה.טקסט)
        }
    }
    פונקציה החלף_טווח(מ_א, מ_ב, t) {
        אם (t == ריק) {
            t = ""
        }
        t = t.החלף("\r\n", "\n")
        t = t.החלף("\r", "\n")
        משתנה ל = זה.אורך_טקסט()
        אם (מ_א < 0) {
            מ_א = 0
        }
        אם (מ_ב > ל) {
            מ_ב = ל
        }
        משתנה לפני = ""
        משתנה אחרי = ""
        אם (מ_א > 0) {
            לפני = זה.טקסט.חתוך(0, מ_א)
        }
        אם (מ_ב < ל) {
            אחרי = זה.טקסט.חתוך(מ_ב)
        }
        זה.טקסט = לפני + t + אחרי
        משתנה ל_t = 0
        אם (t != "") {
            ל_t = t.אורך()
        }
        זה.סמן = זה.הגבל_סמן(מ_א + ל_t)
        זה.נקה_בחירה()
        זה.ודא_גלילה()
        זה.בקש_רענון()
        זה.דווח_שינוי()
    }
    פונקציה הכנס_בסמן(t) {
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            זה.החלף_טווח(ר[0], ר[1], t)
        } אחרת {
            זה.החלף_טווח(זה.סמן, זה.סמן, t)
        }
    }
    פונקציה מחק_אחורה() {
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            זה.החלף_טווח(ר[0], ר[1], "")
            החזר ריק
        }
        אם (זה.סמן <= 0) {
            החזר ריק
        }
        זה.החלף_טווח(זה.סמן - 1, זה.סמן, "")
    }
    פונקציה מחק_קדימה() {
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            זה.החלף_טווח(ר[0], ר[1], "")
            החזר ריק
        }
        אם (זה.סמן >= זה.אורך_טקסט()) {
            החזר ריק
        }
        זה.החלף_טווח(זה.סמן, זה.סמן + 1, "")
    }
    פונקציה העתק() {
        משתנה t = זה.קרא_טקסט()
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            t = זה.טקסט.חתוך(ר[0], ר[1])
        }
        אם (t != "") {
            לוח.כתוב(t)
        }
    }
    פונקציה הדבק() {
        משתנה t = לוח.קרא()
        אם (t == ריק או t == "") {
            החזר ריק
        }
        זה.הכנס_בסמן(t)
    }
    פונקציה גזור() {
        זה.העתק()
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            זה.החלף_טווח(ר[0], ר[1], "")
        }
    }
    פונקציה שורות() {
        משתנה t = זה.קרא_טקסט()
        אם (t == "") {
            החזר [""]
        }
        החזר t.פצל("\n")
    }
    פונקציה שורה_ועמודה() {
        משתנה שורות = זה.שורות()
        משתנה נותר = זה.סמן
        משתנה i = 0
        כל_עוד (i < אורך(שורות)) {
            משתנה ל = אורך(שורות[i])
            אם (נותר <= ל) {
                החזר [i, נותר]
            }
            נותר = נותר - ל - 1
            i = i + 1
        }
        משתנה אחרון = אורך(שורות) - 1
        אם (אחרון < 0) {
            החזר [0, 0]
        }
        החזר [אחרון, אורך(שורות[אחרון])]
    }
    פונקציה אינדקס_משורה(שורה, עמודה) {
        משתנה שורות = זה.שורות()
        משתנה i = 0
        משתנה pos = 0
        כל_עוד (i < שורה וגם i < אורך(שורות)) {
            pos = pos + אורך(שורות[i]) + 1
            i = i + 1
        }
        אם (שורה >= אורך(שורות)) {
            החזר זה.אורך_טקסט()
        }
        אם (עמודה > אורך(שורות[שורה])) {
            עמודה = אורך(שורות[שורה])
        }
        אם (עמודה < 0) {
            עמודה = 0
        }
        החזר pos + עמודה
    }
    פונקציה מספר_שורות_גלוי() {
        משתנה h = זה.גבה - 2 * זה.ריפוד
        משתנה n = (h / זה.גובה_שורה).שלם()
        אם (n < 1) {
            החזר 1
        }
        החזר n
    }
    פונקציה ודא_גלילה() {
        משתנה se = זה.שורה_ועמודה()
        משתנה שורה = se[0]
        משתנה g = זה.מספר_שורות_גלוי()
        אם (שורה < זה.גלילה) {
            זה.גלילה = שורה
        }
        אם (שורה >= זה.גלילה + g) {
            זה.גלילה = שורה - g + 1
        }
        אם (זה.גלילה < 0) {
            זה.גלילה = 0
        }
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה מא = 28
        משתנה מי = 30
        משתנה מכ = 36
        אם (זה.ממוקד) {
            מא = 34
            מי = 38
            מכ = 48
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, מא, מי, מכ)
        אם (זה.ממוקד) {
            משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
            מלבן_מעוגל_מלא(משטח, זה.x + 3, זה.y + זה.גבה - 2, זה.רחב - 6, 2, 1)
        }
        משטח.קבע_גודל_גופן(11)
        משתנה שורות = זה.שורות()
        משתנה g = זה.מספר_שורות_גלוי()
        אם (זה.טקסט == "" או זה.טקסט == ריק) {
            אם (זה.מקום_שמור != "" וגם זה.מקום_שמור != ריק) {
                משטח.קבע_צבע(100, 108, 118)
                צייר_טקסט_ברכיב(משטח, זה, זה.מקום_שמור, זה.y + זה.ריפוד, זה.ריפוד)
            }
        } אחרת {
            משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
            משתנה i = 0
            כל_עוד (i < g) {
                משתנה idx = זה.גלילה + i
                אם (idx >= אורך(שורות)) {
                    עצור
                }
                משתנה ty = זה.y + זה.ריפוד + i * זה.גובה_שורה
                צייר_טקסט_ברכיב(משטח, זה, שורות[idx], ty, זה.ריפוד)
                i = i + 1
            }
        }
        אם (זה.ממוקד) {
            משתנה se = זה.שורה_ועמודה()
            משתנה שורה = se[0]
            משתנה עמודה = se[1]
            אם (שורה >= זה.גלילה וגם שורה < זה.גלילה + g) {
                משתנה שורות2 = זה.שורות()
                משתנה ש = ""
                אם (שורה < אורך(שורות2)) {
                    ש = שורות2[שורה]
                }
                משתנה לפני = ""
                אם (עמודה > 0 וגם ש != "") {
                    לפני = ש.חתוך(0, עמודה)
                }
                משתנה w = אומדן_רוחב_טקסט(משטח, לפני)
                משתנה cx = זה.x + זה.ריפוד + w
                אם (הוא_ימין(זה.כיוון())) {
                    cx = זה.x + זה.רחב - זה.ריפוד - w
                }
                משתנה cy = זה.y + זה.ריפוד + (שורה - זה.גלילה) * זה.גובה_שורה
                משטח.קבע_צבע(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
                משטח.קבע_עובי(1)
                משטח.קו(cx, cy, cx, cy + זה.גובה_שורה - 2)
            }
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        זה.ממוקד = אמת
        משתנה שורה = זה.גלילה + ((my - זה.y - זה.ריפוד) / זה.גובה_שורה).שלם()
        אם (שורה < 0) {
            שורה = 0
        }
        משתנה שורות = זה.שורות()
        אם (שורה >= אורך(שורות)) {
            שורה = אורך(שורות) - 1
        }
        אם (שורה < 0) {
            שורה = 0
        }
        משתנה ש = ""
        אם (שורה < אורך(שורות)) {
            ש = שורות[שורה]
        }
        משתנה עמודה = אורך(ש)
        אם (זה.לוח != ריק) {
            משתנה best = 0
            משתנה best_d = 99999
            משתנה i = 0
            כל_עוד (i <= אורך(ש)) {
                משתנה לפני = ""
                אם (i > 0) {
                    לפני = ש.חתוך(0, i)
                }
                משתנה w = אומדן_רוחב_טקסט(זה.לוח.משטח, לפני)
                משתנה cx = זה.x + זה.ריפוד + w
                אם (הוא_ימין(זה.כיוון())) {
                    cx = זה.x + זה.רחב - זה.ריפוד - w
                }
                משתנה d = mx - cx
                אם (d < 0) {
                    d = 0 - d
                }
                אם (d < best_d) {
                    best_d = d
                    best = i
                }
                i = i + 1
            }
            עמודה = best
        }
        זה.סמן = זה.אינדקס_משורה(שורה, עמודה)
        זה.נקה_בחירה()
        זה.ודא_גלילה()
        זה.בקש_רענון()
        החזר אמת
    }
    פונקציה בעת_תו(תו) {
        אם (זה.מושבת או לא זה.ממוקד) {
            החזר ריק
        }
        אם (תו == ריק או תו == "") {
            החזר ריק
        }
        זה.הכנס_בסמן(תו)
    }
    פונקציה הזז_סמן(delta) {
        זה.סמן = זה.הגבל_סמן(זה.סמן + delta)
        זה.נקה_בחירה()
        זה.ודא_גלילה()
        זה.בקש_רענון()
    }
    פונקציה בעת_מקש(שם) {
        אם (זה.מושבת או לא זה.ממוקד) {
            החזר ריק
        }
        אם (שם == "מחיקה") {
            זה.מחק_אחורה()
        } אחרת_אם (שם == "מחק") {
            זה.מחק_קדימה()
        } אחרת_אם (שם == "בחר_הכל") {
            זה.בחר_הכל()
        } אחרת_אם (שם == "העתק") {
            זה.העתק()
        } אחרת_אם (שם == "הדבק") {
            זה.הדבק()
        } אחרת_אם (שם == "גזור") {
            זה.גזור()
        } אחרת_אם (שם == "אנטר") {
            זה.הכנס_בסמן("\n")
        } אחרת_אם (שם == "בריחה") {
            זה.נקה_בחירה()
            זה.בקש_רענון()
        } אחרת_אם (שם == "התחלה") {
            משתנה se = זה.שורה_ועמודה()
            זה.סמן = זה.אינדקס_משורה(se[0], 0)
            זה.נקה_בחירה()
            זה.בקש_רענון()
        } אחרת_אם (שם == "סוף") {
            משתנה se = זה.שורה_ועמודה()
            משתנה שורות = זה.שורות()
            משתנה ל = 0
            אם (se[0] < אורך(שורות)) {
                ל = אורך(שורות[se[0]])
            }
            זה.סמן = זה.אינדקס_משורה(se[0], ל)
            זה.נקה_בחירה()
            זה.בקש_רענון()
        } אחרת_אם (שם == "שמאלה") {
            זה.הזז_סמן(צעד_חץ_אופקי(זה.כיוון(), אמת))
        } אחרת_אם (שם == "ימינה") {
            זה.הזז_סמן(צעד_חץ_אופקי(זה.כיוון(), שקר))
        } אחרת_אם (שם == "למעלה") {
            משתנה se = זה.שורה_ועמודה()
            אם (se[0] > 0) {
                זה.סמן = זה.אינדקס_משורה(se[0] - 1, se[1])
                זה.נקה_בחירה()
                זה.ודא_גלילה()
                זה.בקש_רענון()
            }
        } אחרת_אם (שם == "למטה") {
            משתנה se = זה.שורה_ועמודה()
            זה.סמן = זה.אינדקס_משורה(se[0] + 1, se[1])
            זה.נקה_בחירה()
            זה.ודא_גלילה()
            זה.בקש_רענון()
        }
    }
}
