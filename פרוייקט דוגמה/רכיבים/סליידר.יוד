// סליידר.יוד — מילוי וידית מכיוון ההתחלה
מחלקה סליידר מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, מינ, מקס, ערך) {
        הורה(x, y, רחב, 20)
        זה.מינ = מינ
        זה.מקס = מקס
        זה.צעד = 1
        זה.ערך = עגל_לצעד(הגבל(ערך, מינ, מקס), זה.צעד)
        זה.בשינוי = ריק
        זה.גובה_מסלול = 4
        זה.רדיוס_ידית = 7
    }
    פונקציה נרמל(v) {
        החזר עגל_לצעד(הגבל(v, זה.מינ, זה.מקס), זה.צעד)
    }
    פונקציה קבע_ערך(v) {
        משתנה קודם = זה.ערך
        זה.ערך = זה.נרמל(v)
        אם (זה.ערך != קודם) {
            זה.בקש_רענון()
            אם (זה.בשינוי != ריק) {
                זה.בשינוי(זה.ערך)
            }
        }
    }
    פונקציה קבע_ערך_שקט(v) {
        משתנה קודם = זה.ערך
        זה.ערך = זה.נרמל(v)
        אם (זה.ערך != קודם) {
            זה.בקש_רענון()
        }
    }
    פונקציה ערך_נוכחי() {
        החזר זה.ערך
    }
    פונקציה ידית_x() {
        משתנה טווח = זה.מקס - זה.מינ
        משתנה mx0 = זה.x + זה.רדיוס_ידית
        משתנה פנימי = זה.רחב - 2 * זה.רדיוס_ידית
        אם (טווח <= 0 או פנימי <= 0) {
            אם (הוא_ימין(זה.כיוון())) {
                החזר זה.x + זה.רחב - זה.רדיוס_ידית
            }
            החזר mx0
        }
        משתנה t = (זה.ערך - זה.מינ) / טווח
        אם (הוא_ימין(זה.כיוון())) {
            החזר זה.x + זה.רחב - זה.רדיוס_ידית - t * פנימי
        }
        החזר mx0 + t * פנימי
    }
    פונקציה ערך_ממיקום(mx) {
        משתנה פנימי = זה.רחב - 2 * זה.רדיוס_ידית
        אם (פנימי <= 0) {
            החזר זה.מינ
        }
        משתנה t = 0
        אם (הוא_ימין(זה.כיוון())) {
            t = (זה.x + זה.רחב - זה.רדיוס_ידית - mx) / פנימי
        } אחרת {
            t = (mx - זה.x - זה.רדיוס_ידית) / פנימי
        }
        t = הגבל(t, 0, 1)
        החזר זה.נרמל(זה.מינ + t * (זה.מקס - זה.מינ))
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה my = זה.y + זה.גבה / 2
        משתנה mx0 = זה.x + זה.רדיוס_ידית
        משתנה mw = זה.רחב - 2 * זה.רדיוס_ידית
        משתנה th = זה.גובה_מסלול
        משטח.קבע_מילוי(48, 52, 60)
        מלבן_מעוגל_מלא(משטח, mx0, my - th / 2, mw, th, th / 2)
        משתנה hx = זה.ידית_x()
        משתנה טווח = זה.מקס - זה.מינ
        משתנה t = 0
        אם (טווח > 0) {
            t = (זה.ערך - זה.מינ) / טווח
        }
        משתנה fill_w = t * mw
        אם (fill_w > 0) {
            משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
            אם (הוא_ימין(זה.כיוון())) {
                מלבן_מעוגל_מלא(משטח, mx0 + mw - fill_w, my - th / 2, fill_w, th, th / 2)
            } אחרת {
                מלבן_מעוגל_מלא(משטח, mx0, my - th / 2, fill_w, th, th / 2)
            }
        }
        משטח.קבע_מילוי(14, 16, 20)
        משטח.עיגול_מלא(hx, my + 1, זה.רדיוס_ידית)
        משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
        אם (זה.לחוץ) {
            משטח.קבע_מילוי(130, 230, 210)
        }
        משטח.עיגול_מלא(hx, my, זה.רדיוס_ידית)
        משטח.קבע_מילוי(250, 252, 255)
        משטח.עיגול_מלא(hx - 2, my - 2, 2)
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        זה.לחוץ = אמת
        זה.קבע_ערך(זה.ערך_ממיקום(mx))
        החזר אמת
    }
    פונקציה בעכבר_גרירה(mx, my, כפתור) {
        אם (זה.לחוץ) {
            זה.קבע_ערך(זה.ערך_ממיקום(mx))
        }
    }
    פונקציה בעכבר_למעלה(mx, my, כפתור) {
        אם (זה.לחוץ) {
            זה.לחוץ = שקר
            זה.בקש_רענון()
        }
    }
}
