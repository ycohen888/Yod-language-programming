// מרווח.יוד — Spacer אנכי
כלול "פקד.יוד"

מחלקה מרווח מרחיב פקד {
    פונקציה בנאי(גובה = 16, מזהה = "") {
        אם (גובה == ריק או גובה < 0) {
            גובה = 16
        }
        הורה(מזהה)
        זה.גובה = גובה
        זה._צור("מרווח", { "גובה": גובה })
    }

    פונקציה קבע_גובה(ג) {
        אם (ג == ריק או ג < 0) {
            ג = 16
        }
        זה.גובה = ג
        זה._שלח_פקודה("קבע_גובה", { "גובה": ג })
    }
}
