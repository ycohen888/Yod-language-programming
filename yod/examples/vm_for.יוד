// עבור / עצור / המשך במכונה
// yod מכונה examples\vm_for.יוד
משתנה שמות = ["נועם", "דני", "מיכל", "רות"]
הדפס: "יש " + אורך(שמות) + " שמות"
עבור שם בתוך שמות
    אם שם == "דני"
        המשך
    סוף
    אם שם == "רות"
        עצור
    סוף
    הדפס: "שלום " + שם
סוף

משתנה אדם = { "א": 1, "ב": 2 }
עבור מפתח בתוך אדם
    הדפס: "מפתח: " + מפתח + " = " + אדם[מפתח]
סוף
