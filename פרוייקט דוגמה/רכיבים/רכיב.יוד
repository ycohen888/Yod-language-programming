// רכיב.יוד — בסיס לכל רכיב מצויר על משטח
מחלקה רכיב {
    פונקציה אתחל_בסיס(x, y, רחב, גבה) {
        זה.x = x
        זה.y = y
        זה.רחב = רחב
        זה.גבה = גבה
        זה.גלוי = אמת
        זה.מושבת = שקר
        זה.לחוץ = שקר
        זה.לוח = ריק
        זה.רמז = ""
        זה.כיוון_מקומי = ריק
        זה.נעוץ = שקר
    }
    פונקציה בנאי(x, y, רחב, גבה) {
        זה.אתחל_בסיס(x, y, רחב, גבה)
    }
    פונקציה קבע_רמז(t) {
        אם (t == ריק) {
            זה.רמז = ""
        } אחרת {
            זה.רמז = t
        }
    }
    פונקציה קבע_כיוון(כ) {
        אם (כ == ריק או כ == "") {
            זה.כיוון_מקומי = ריק
        } אחרת {
            זה.כיוון_מקומי = נרמל_כיוון(כ)
        }
        זה.בקש_רענון()
    }
    פונקציה כיוון() {
        אם (זה.כיוון_מקומי != ריק וגם זה.כיוון_מקומי != "") {
            החזר נרמל_כיוון(זה.כיוון_מקומי)
        }
        אם (זה.לוח != ריק) {
            החזר נרמל_כיוון(זה.לוח.כיוון)
        }
        החזר "ימין"
    }
    פונקציה מקבל_מיקוד() {
        החזר שקר
    }
    פונקציה קבע_מיקוד(v) {
    }
    פונקציה בעת_תו(תו) {
    }
    פונקציה בעת_מקש(שם) {
    }
    פונקציה מכיל(mx, my) {
        אם (!זה.גלוי) {
            החזר שקר
        }
        החזר נקודה_במלבן(mx, my, זה.x, זה.y, זה.רחב, זה.גבה)
    }
    פונקציה צייר(משטח) {
        // נדרס במחלקות יורשות
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        החזר שקר
    }
    פונקציה בעכבר_גרירה(mx, my, כפתור) {
    }
    פונקציה בעכבר_למעלה(mx, my, כפתור) {
    }
    פונקציה בקש_רענון() {
        אם (זה.לוח != ריק) {
            זה.לוח.סמן_רענון_רכיב(זה)
        }
    }
}
