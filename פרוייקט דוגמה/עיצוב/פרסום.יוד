// פרסום.יוד — מנהל פרסומות מרוחקות לשימוש חוזר (ספרייה)
// מושך רשימת פרסומות משרת (JSON) בבקשת HTTP אסינכרונית (לא חוסמת),
// ומנהל את מכונת-המצבים של החיבור לאינטרנט:
//   • עלייה עם אינטרנט → שליפה מצליחה → הכרזה מופיעה.
//   • עלייה בלי אינטרנט → הכרזה מקופלת (לא תופסת מקום); ניסיון חוזר כל ~30 שנ'.
//   • אחרי שהוצגה פרסומת ואבד האינטרנט → הכרזה נשארת (לא מתחלפת).
//   • כשיש אינטרנט → מתחלפת כל 5 דקות.
כלול "רשת"
// ספריית העיצוב מגדירה מחלקה בשם «רשת» — לכן שומרים את מודול הרשת בזמן הטעינה.
// חשוב: יש לכלול קובץ זה *לפני* «עיצוב_הכל.יוד» כדי ש-«רשת» עדיין יצביע למודול.
משתנה _פרסום_רשת = רשת
כלול "JSON"
כלול "טיימרים"
כלול "מערכת"

// —— קבועים ניתנים לשינוי (מלאו את כתובת השרת האמיתית שלכם) ——
משתנה כתובת_שרת_פרסום = "https://servxx.com/ads/ads.json"
משתנה מרווח_החלפה_דקות = 5
משתנה מרווח_ניסיון_ראשוני_שניות = 30

// —— מצב פנימי ——
משתנה _פרסום_באנר = ריק
משתנה _פרסום_רשימה = []
משתנה _פרסום_אינדקס = 0
משתנה _פרסום_הוצג_אי_פעם = שקר
משתנה _פרסום_פעיל = שקר
משתנה _פרסום_מזהה_טיימר = ריק

// אתחל_פרסום — מקשר באנר קיים, מחבר קולבק קליק ומתחיל שליפה ראשונה
פונקציה אתחל_פרסום(באנר) {
    _פרסום_באנר = באנר
    _פרסום_פעיל = אמת
    אם (באנר != ריק) {
        באנר.בלחיצה(פונקציה(קישור) {
            פתח_קישור_פרסום(קישור)
        })
    }
    _פרסום_נסה_עכשיו()
}

// עצירת מערכת הפרסום (לדוגמה בסגירת התוכנה)
פונקציה עצור_פרסום() {
    _פרסום_פעיל = שקר
    אם (_פרסום_מזהה_טיימר != ריק) {
        נסה {
            טיימרים.עצור(_פרסום_מזהה_טיימר)
        } תפוס שגיאה {
        }
        _פרסום_מזהה_טיימר = ריק
    }
}

// פתיחת קישור הפרסומת בדפדפן ברירת המחדל של המערכת
פונקציה פתח_קישור_פרסום(קישור) {
    אם (קישור == ריק או קישור == "") {
        החזר ריק
    }
    נסה {
        מערכת.הפעל_ברקע("explorer", קישור)
    } תפוס שגיאה {
    }
}

// —— ליבת השליפה האסינכרונית ——
פונקציה _פרסום_נסה_עכשיו() {
    אם (לא _פרסום_פעיל) {
        החזר ריק
    }
    משתנה בקשה = ריק
    נסה {
        בקשה = _פרסום_רשת.גש_התחל(כתובת_שרת_פרסום)
    } תפוס שגיאה {
        בקשה = ריק
    }
    אם (בקשה == ריק או בקשה.מזהה == ריק) {
        _פרסום_סיים_מחזור(שקר)
        החזר ריק
    }
    _פרסום_בדוק_בקשה(בקשה.מזהה)
}

// פוללינג לא-חוסם — בודק את מצב הבקשה כל 150ms עד סיום
פונקציה _פרסום_בדוק_בקשה(מזהה_בקשה) {
    אם (לא _פרסום_פעיל) {
        החזר ריק
    }
    משתנה מצב = ריק
    נסה {
        מצב = _פרסום_רשת.מצב_בקשה(מזהה_בקשה)
    } תפוס שגיאה {
        מצב = ריק
    }
    אם (מצב == ריק) {
        _פרסום_סיים_מחזור(שקר)
        החזר ריק
    }
    אם (לא מצב.הסתיים) {
        טיימרים.אחרי(150, פונקציה() {
            _פרסום_בדוק_בקשה(מזהה_בקשה)
        })
        החזר ריק
    }
    אם (לא מצב.הצליח) {
        _פרסום_סיים_מחזור(שקר)
        החזר ריק
    }
    משתנה הצליח = _פרסום_עבד_תשובה(מצב.גוף)
    _פרסום_סיים_מחזור(הצליח)
}

// עיבוד גוף התשובה (JSON) → עדכון רשימה והצגה. מחזיר אמת בהצלחה.
פונקציה _פרסום_עבד_תשובה(גוף) {
    משתנה נתונים = ריק
    נסה {
        נתונים = JSON.פרסר(גוף)
    } תפוס שגיאה {
        נתונים = ריק
    }
    אם (נתונים == ריק) {
        החזר שקר
    }
    אם (נתונים.יש("מרווח_דקות")) {
        משתנה מ = נתונים.מרווח_דקות
        אם (מ != ריק וגם מ > 0) {
            מרווח_החלפה_דקות = מ
        }
    }
    משתנה רשימה = []
    אם (נתונים.יש("פרסומות") וגם נתונים.פרסומות != ריק) {
        רשימה = נתונים.פרסומות
    }
    אם (רשימה.גודל() == 0) {
        החזר שקר
    }
    _פרסום_רשימה = רשימה
    // אם כבר הצגנו — מקדמים לפרסומת הבאה (רוטציה)
    אם (_פרסום_הוצג_אי_פעם) {
        _פרסום_אינדקס = (_פרסום_אינדקס + 1) % _פרסום_רשימה.גודל()
    } אחרת {
        אם (_פרסום_אינדקס >= _פרסום_רשימה.גודל()) {
            _פרסום_אינדקס = 0
        }
    }
    _פרסום_הצג_נוכחי()
    _פרסום_הוצג_אי_פעם = אמת
    החזר אמת
}

// הצגת הפרסומת הנוכחית לפי האינדקס
פונקציה _פרסום_הצג_נוכחי() {
    אם (_פרסום_באנר == ריק) {
        החזר ריק
    }
    אם (_פרסום_רשימה.גודל() == 0) {
        החזר ריק
    }
    משתנה אינד = _פרסום_אינדקס % _פרסום_רשימה.גודל()
    משתנה פרסומת = _פרסום_רשימה[אינד]
    משתנה תמונה = ""
    משתנה קישור = ""
    משתנה כותרת = ""
    אם (פרסומת.יש("תמונה")) {
        תמונה = פרסומת.תמונה
    }
    אם (פרסומת.יש("קישור")) {
        קישור = פרסומת.קישור
    }
    אם (פרסומת.יש("כותרת")) {
        כותרת = פרסומת.כותרת
    }
    _פרסום_באנר.קבע_פרסומת(תמונה, קישור, כותרת)
    _פרסום_באנר.הצג()
}

// סיום מחזור — תזמון הניסיון הבא לפי מצב החיבור:
//   • טרם הוצגה פרסומת → ניסיון חוזר כל ~30 שנ' (לתפוס חזרת אינטרנט מהר).
//   • אחרי הצגה → טיק החלפה/רענון כל 5 דק'.
פונקציה _פרסום_סיים_מחזור(הצליח) {
    אם (לא _פרסום_פעיל) {
        החזר ריק
    }
    משתנה מילישניות = 0
    אם (_פרסום_הוצג_אי_פעם) {
        מילישניות = מרווח_החלפה_דקות * 60 * 1000
    } אחרת {
        מילישניות = מרווח_ניסיון_ראשוני_שניות * 1000
    }
    _פרסום_תזמן(מילישניות)
}

פונקציה _פרסום_תזמן(מילישניות) {
    אם (_פרסום_מזהה_טיימר != ריק) {
        נסה {
            טיימרים.עצור(_פרסום_מזהה_טיימר)
        } תפוס שגיאה {
        }
        _פרסום_מזהה_טיימר = ריק
    }
    _פרסום_מזהה_טיימר = טיימרים.אחרי(מילישניות, פונקציה() {
        _פרסום_מזהה_טיימר = ריק
        _פרסום_נסה_עכשיו()
    })
}
