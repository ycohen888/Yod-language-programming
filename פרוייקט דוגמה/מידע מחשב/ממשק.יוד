// ממשק.יוד — לוח בקרה כהה · פריסה גמישה ביחס לגודל החלון

פונקציה צבע_תוויות()
  אם תווית_תהליכים_כ != ריק
    תווית_תהליכים_כ.קבע_צבע: 230, 237, 243
  סוף
  אם תווית_סיכום != ריק
    תווית_סיכום.קבע_צבע: 148, 163, 184
  סוף
סוף

פונקציה ייצא_תהליכים()
  משתנה נתיב = חלונות.בחר_שמירה("שמירת תהליכים כ־CSV")
  אם נתיב == ריק
    החזר ריק
  סוף
  רשימת_תה.ייצא_csv: נתיב
  חלונות.הודעה: "ייצוא", "הקובץ נשמר:\n" + נתיב
סוף

פונקציה סנן_תהליכים()
  משתנה ט = ""
  אם שדה_סינון != ריק
    ט = שדה_סינון.קרא_טקסט()
  סוף
  רשימת_תה.סנן: ט
סוף

פונקציה פרוס_כותרת(רחב, גבה)
  אם טבעת_זיכרון != ריק
    טבעת_זיכרון.x = רחב - 52
  סוף
  אם פס_מעבד != ריק
    פס_מעבד.x = רחב - 220
    אם פס_מעבד.x < 620
      פס_מעבד.x = 620
    סוף
  סוף
  אם תווית_התראה != ריק
    תווית_התראה.x = 400
  סוף
סוף

פונקציה פרוס_פעולות(רחב, גבה)
  אם שדה_סינון != ריק
    משתנה w = רחב - 300
    אם w < 120
      w = 120
    סוף
    אם w > 420
      w = 420
    סוף
    שדה_סינון.רחב = w
    שדה_סינון.x = 290
  סוף
  אם כפתור_סנן_משטח != ריק
    כפתור_סנן_משטח.x = שדה_סינון.x + שדה_סינון.רחב + 8
  סוף
סוף

משתנה כפתור_סנן_משטח = ריק

פונקציה בנה_חלון_מידע()
  משתנה ח = חלונות.חלון: "מידע מחשב · יוד"
  ח.קבע_גודל: 1080, 720
  ח.קבע_כהה: אמת

  ח.קבע_תפריט: [
    {
      "שם": "קובץ",
      "פריטים": [
        {"שם": "רענון", "פעולה": רענן_מידע},
        {"שם": "ייצוא CSV…", "פעולה": ייצא_תהליכים},
        {"שם": "-"},
        {"שם": "יציאה", "פעולה": סגור_חלון_הודעה}
      ]
    }
  ]

  // —— כותרת (רוחב גמיש, גובה קבוע) ——
  לוח_כותרת = חדש לוח_רכיבים: 800, 52
  לוח_כותרת.רקע_א = 22
  לוח_כותרת.רקע_י = 27
  לוח_כותרת.רקע_כ = 34
  לוח_כותרת.בפריסה = פרוס_כותרת

  תווית_מותג = חדש תווית_ציור: 14, 8, "מידע מחשב"
  תווית_מותג.קבע_צבע_rgb(56, 189, 248)
  תווית_מותג.גודל = 14
  לוח_כותרת.הוסף(תווית_מותג)

  תג_מצב = חדש תג: 120, 8, "חי"
  לוח_כותרת.הוסף(תג_מצב)

  נור_מצב = חדש נורית: 172, 10, "מחובר", אמת
  לוח_כותרת.הוסף(נור_מצב)

  תווית_עלייה = חדש תווית_ציור: 280, 8, "…"
  תווית_עלייה.קבע_צבע_rgb(167, 243, 208)
  לוח_כותרת.הוסף(תווית_עלייה)

  תווית_כותרת = חדש תווית_ציור: 14, 30, "טוען…"
  תווית_כותרת.קבע_צבע_rgb(160, 168, 178)
  לוח_כותרת.הוסף(תווית_כותרת)

  תווית_התראה = חדש תווית_ציור: 400, 30, ""
  תווית_התראה.קבע_צבע_rgb(251, 146, 60)
  לוח_כותרת.הוסף(תווית_התראה)

  פס_מעבד = חדש פס_התקדמות: 580, 14, 150, 0
  לוח_כותרת.הוסף(פס_מעבד)
  טבעת_זיכרון = חדש מחוון_טבעת: 748, 6, 40, 0
  לוח_כותרת.הוסף(טבעת_זיכרון)
  לוח_כותרת.רענון()

  // —— גרפים (מתרחבים עם החלון) ——
  גרף_מעבד = גרפים.קו()
  גרף_מעבד.קבע_כותרת: "מעבד"
  גרף_מעבד.קבע_תת_כותרת: "טוען…"
  גרף_מעבד.קבע_ציר_Y: "%"
  גרף_מעבד.קבע_טווח_Y: 0, 100
  גרף_מעבד.קבע_מקרא: שקר
  גרף_מעבד.קבע_גובה: 140

  גרף_זיכרון = גרפים.עוגה()
  גרף_זיכרון.קבע_כותרת: "זיכרון"
  גרף_זיכרון.קבע_תת_כותרת: "טוען…"
  גרף_זיכרון.קבע_גובה: 140

  גרף_כוננים = גרפים.עמודות()
  גרף_כוננים.קבע_כותרת: "כוננים"
  גרף_כוננים.קבע_תת_כותרת: "טוען…"
  גרף_כוננים.קבע_ציר_Y: "מגה"
  גרף_כוננים.קבע_גובה: 140

  משתנה שורת_גרפים = חלונות.מסגרת: "אופקי"
  שורת_גרפים.קבע_רקע: 22, 27, 34
  שורת_גרפים.קבע_מתיחה: 2
  שורת_גרפים.הוסף: גרף_מעבד
  שורת_גרפים.הוסף: גרף_זיכרון
  שורת_גרפים.הוסף: גרף_כוננים

  // —— סרגל פעולות ——
  לוח_פעולות = חדש לוח_רכיבים: 800, 40
  לוח_פעולות.רקע_א = 30
  לוח_פעולות.רקע_י = 37
  לוח_פעולות.רקע_כ = 46
  לוח_פעולות.בפריסה = פרוס_פעולות

  משתנה כפ_רענון = חדש כפתור_משטח: 10, 6, 84, 28, "רענון"
  כפ_רענון.קבע_ראשי(אמת)
  כפ_רענון.בלחיצה = פונקציה ()
    רענן_מידע()
  סוף
  לוח_פעולות.הוסף(כפ_רענון)

  משתנה כפ_סיום = חדש כפתור_משטח: 102, 6, 104, 28, "סיים תהליך"
  כפ_סיום.בלחיצה = פונקציה ()
    סיים_נבחר()
  סוף
  לוח_פעולות.הוסף(כפ_סיום)

  משתנה כפ_ייצוא = חדש כפתור_משטח: 214, 6, 64, 28, "CSV"
  כפ_ייצוא.בלחיצה = פונקציה ()
    ייצא_תהליכים()
  סוף
  לוח_פעולות.הוסף(כפ_ייצוא)

  שדה_סינון = חדש קלט_טקסט: 290, 6, 200, ""
  שדה_סינון.קבע_מקום_שמור("סינון תהליך…")
  שדה_סינון.קבע_רמז("הקלידו חלק משם תהליך")
  שדה_סינון.בשינוי = פונקציה (ט)
    רשימת_תה.סנן: ט
  סוף
  שדה_סינון.באנטר = פונקציה (ט)
    רשימת_תה.סנן: ט
  סוף
  לוח_פעולות.הוסף(שדה_סינון)

  כפתור_סנן_משטח = חדש כפתור_משטח: 500, 6, 64, 28, "סנן"
  כפתור_סנן_משטח.בלחיצה = פונקציה ()
    סנן_תהליכים()
  סוף
  כפתור_סנן_משטח.קבע_רמז("סנן את רשימת התהליכים")
  לוח_פעולות.הוסף(כפתור_סנן_משטח)
  לוח_פעולות.רענון()

  // —— תהליכים (תופס את רוב הגובה שנשאר) ——
  תווית_תהליכים_כ = חלונות.תווית: "תהליכים"
  תווית_סיכום = חלונות.תווית: "טוען…"
  תווית_סינון = ריק

  רשימת_תה = חלונות.טבלה()
  רשימת_תה.קבע_שדות: [
    {"שם": "שם", "רוחב": 260},
    {"שם": "מזהה", "רוחב": 80},
    {"שם": "זיכרון", "רוחב": 120},
    {"שם": "נתיב", "רוחב": 340}
  ]
  רשימת_תה.קבע_גובה: 120

  משתנה סרגל_כותרת_תה = חלונות.מסגרת: "אופקי"
  סרגל_כותרת_תה.קבע_רקע: 22, 27, 34
  סרגל_כותרת_תה.קבע_מתיחה: 0
  סרגל_כותרת_תה.הוסף: תווית_תהליכים_כ
  סרגל_כותרת_תה.הוסף: תווית_סיכום

  משתנה כרטיס_תהליכים = חלונות.מסגרת: "אנכי"
  כרטיס_תהליכים.קבע_רקע: 22, 27, 34
  כרטיס_תהליכים.קבע_מתיחה: 5
  כרטיס_תהליכים.הוסף: סרגל_כותרת_תה
  כרטיס_תהליכים.הוסף: לוח_פעולות.משטח_גלוי()
  כרטיס_תהליכים.הוסף: רשימת_תה

  ח.הוסף: לוח_כותרת.משטח_גלוי()
  ח.הוסף: שורת_גרפים
  ח.הוסף: כרטיס_תהליכים

  צבע_תוויות()

  ח.בהתחלה: פונקציה ()
    צבע_תוויות()
    רענן_מידע()
    מזהה_טיימר = טיימרים.כל_כמה: 2, רענן_מידע
  סוף

  ח.הצג()
סוף

פונקציה סגור_חלון_הודעה()
  חלונות.הודעה: "יציאה", "סגרו את החלון עם כפתור ×"
סוף
