}

// המרת "YYYY-MM-DD HH:MM:SS" ל-"DD/MM" לתצוגה
פונקציה תאריך_קצר(ט) {
    אם (ט == ריק או ט == "") {
        החזר ""
    }
    נסה {
        משתנה חלק = ט.פצל(" ")[0]
        משתנה חלקים = חלק.פצל("-")
        אם (חלקים.גודל() >= 3) {
            החזר חלקים[2] + "/" + חלקים[1]
        }
    } תפוס שגיאה {
    }
    החזר ט
}

// ——— בניית הממשק (רץ בתוך עיצוב_בעת_מוכן) ———
פונקציה בנה_ממשק_עיצוב() {
    אם (ממשק_מוכן) {
        החזר ריק
    }
    ממשק_מוכן = אמת

    עיצוב_קבע_נושא(נושא_ממשק)
    טוסט = חדש הודעה_קופצת: "", "הצלחה"

    // סרגל עליון: כותרת + לוגו הפרויקט, החלפת נושא (ירח) ותפריט (⋮)
    משתנה לוגו = נתיב_לוגו_מטלות()
    סרגל = חדש סרגל_עליון: "מטלות", [
        { "טקסט": "", "איקון": "moon", "ערך": "נושא" },
        { "טקסט": "", "איקון": "dots", "ילדים": [
            { "טקסט": "אודות", "ערך": "אודות" }
        ] }
    ], "", לוגו
    סרגל.בלחיצה(פונקציה(פ) {
        על_פעולת_סרגל(פ)
    })

    // כרטיס הוספה — שורה אחת: מה צריך | עדיפות | הוסף (גובה אחיד)
    משתנה כרטיס_הוספה = חדש כרטיס: "הוספת מטלה", ""
    עיצוב_בתוך(כרטיס_הוספה, פונקציה() {
        משתנה שורת_הוספה = חדש מכל: "שורה"
        עיצוב_בתוך(שורת_הוספה, פונקציה() {
            שדה_כותרת = חדש שדה: "מה צריך לעשות?"
            שדה_כותרת.בכניסה(פונקציה(ע) {
                על_הוספה()
            })
            בחירת_עדיפות = חדש תיבת_בחירה: [
                { "טקסט": "גבוהה", "ערך": "גבוהה" },
                { "טקסט": "בינונית", "ערך": "בינונית" },
                { "טקסט": "רגילה", "ערך": "רגילה" },
                { "טקסט": "נמוכה", "ערך": "נמוכה" }
            ], "רגילה"
            משתנה כפתור_הוסף = חדש כפתור: "הוסף", "ראשי"
            כפתור_הוסף.בלחיצה(פונקציה() {
                על_הוספה()
            })
        })
    })

    // כרטיס הרשימה + רשת נתונים
    משתנה כרטיס_רשימה = חדש כרטיס: "המטלות שלי", ""
    עיצוב_בתוך(כרטיס_רשימה, פונקציה() {
        רשת_מטלות = חדש רשת_נתונים: עמודות_רשת(), [], {
            "תפריט_שורה": [ { "תווית": "מחק", "פעולה": "מחק" } ],
            "שטוח": אמת
        }
        רשת_מטלות.בעריכה(פונקציה(מזהה_שורה, שדה, ערך) {
            על_עריכה(מזהה_שורה, שדה, ערך)
        })
        רשת_מטלות.בתפריט(פונקציה(פעולה, מזהה_שורה) {
            על_תפריט(פעולה, מזהה_שורה)
        })
    })

    // פוטר: סטטוס למעלה; פס התקדמות + מחק + נקה בשורה אחת בגובה שווה
    משתנה פוטר = חדש מכל: "יומן"
    עיצוב_בתוך(פוטר, פונקציה() {
        תווית_סטטוס = חדש תווית: "0 מתוך 0 הושלמו", "משני"
        משתנה שורת_פוטר = חדש מכל: "שורה"
        עיצוב_בתוך(שורת_פוטר, פונקציה() {
            פס_סטטוס = חדש פס_התקדמות: 0
            משתנה כפתור_מחק_בוצעו = חדש כפתור: "מחק שהושלמו", "קווי"
            כפתור_מחק_בוצעו.בלחיצה(פונקציה() {
                מחק_שהושלמו()
                רענן_רשת()
                הודעה("המטלות שהושלמו נמחקו")
            })
            משתנה כפתור_נקה = חדש כפתור: "נקה הכול", "קווי"
            כפתור_נקה.בלחיצה(פונקציה() {
                נקה_הכול()
                רענן_רשת()
                הודעה("כל המטלות נוקו")
            })
        })
    })

    רענן_רשת()
}

// ——— מטפלי אירועים ———
פונקציה על_הוספה() {
    משתנה כותרת = שדה_כותרת.קבל_ערך()
    אם (כותרת == ריק או כותרת.גזום() == "") {
        הודעה("יש להקליד מטלה")
        החזר ריק
    }
    משתנה עדיפות = בחירת_עדיפות.קבל_ערך()
    הוסף_מטלה(כותרת, עדיפות)
    שדה_כותרת.קבע_ערך("")
    רענן_רשת()
    הודעה("מטלה נוספה")
}

פונקציה על_עריכה(מזהה_שורה, שדה, ערך) {
    אם (שדה == "הושלם") {
        משתנה ה = 0
        אם (ערך == אמת או ערך == 1 או ערך == "true" או ערך == "אמת") {
            ה = 1
        }
        עדכן_שדה(מזהה_שורה, "הושלם", ה)
    } אחרת {
        עדכן_שדה(מזהה_שורה, שדה, ערך)
    }
    רענן_רשת()
}

פונקציה על_תפריט(פעולה, מזהה_שורה) {
    אם (פעולה == "מחק") {
        מחק_מטלה(מזהה_שורה)
        רענן_רשת()
        הודעה("מטלה נמחקה")
    }
}

פונקציה על_פעולת_סרגל(פ) {
    אם (פ == "נושא") {
        החלף_נושא()
    } אחרת_אם (פ == "אודות") {
        הודעה("מנהל מטלות — דוגמה פתוחת קוד שנבנתה כולה בשפת יוד")
    }
}

// ——— רענון ותצוגה ———
פונקציה רענן_רשת() {
    אם (רשת_מטלות == ריק) {
        החזר ריק
    }
    משתנה שורות = שלוף_מטלות()
    משתנה מעובדות = []
    משתנה סהכ = 0
    משתנה בוצעו = 0
    עבור ש בתוך שורות {
        סהכ = סהכ + 1
        משתנה בוצע = (ש["הושלם"] == 1)
        אם (בוצע) {
            בוצעו = בוצעו + 1
        }
        משתנה שורה = {
            "מזהה": ש["מזהה"],
            "כותרת": ש["כותרת"],
            "עדיפות": ש["עדיפות"],
            "הושלם": בוצע,
            "נוצר": תאריך_קצר(ש["נוצר"])
        }
        אם (בוצע) {
            שורה._מחלקה = "yod-row-done"
        }
        מעובדות.הוסף(שורה)
    }
    רשת_מטלות.קבע_שורות(מעובדות)
    עדכן_סטטוס(סהכ, בוצעו)
}

פונקציה עדכן_סטטוס(סהכ, בוצעו) {
    אם (תווית_סטטוס != ריק) {
        תווית_סטטוס.קבע_טקסט(בוצעו.למחרוזת() + " מתוך " + סהכ.למחרוזת() + " הושלמו")
    }
    אם (פס_סטטוס != ריק) {
        משתנה אחוז = 0
        אם (סהכ > 0) {
            אחוז = (בוצעו / סהכ) * 100
        }
        פס_סטטוס.קבע_ערך(אחוז)
    }
}

// ——— נושא ———
פונקציה החלף_נושא() {
    אם (נושא_ממשק == "כהה") {
        נושא_ממשק = "בהיר"
    } אחרת {
        נושא_ממשק = "כהה"
    }
    עיצוב_קבע_נושא(נושא_ממשק)
    אם (חלון_ראשי != ריק) {
        חלון_ראשי.קבע_כהה(נושא_ממשק == "כהה")
        אם (נושא_ממשק == "כהה") {
            חלון_ראשי.קבע_רקע(14, 17, 22)
        } אחרת {
            חלון_ראשי.קבע_רקע(245, 247, 250)
        }
    }
}

פונקציה הודעה(ט) {
    אם (טוסט != ריק) {
        טוסט.קבע_טקסט(ט)
        טוסט.הצג()
    }
}
