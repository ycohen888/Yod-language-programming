// כיוון.יוד — עזרי RTL (ימין) / LTR (שמאל) לרכיבי משטח
// "התחלה" = צד ההתחלה של הכיוון (RTL→ימין, LTR→שמאל)

פונקציה נרמל_כיוון(כ) {
    אם (כ == "שמאל" או כ == "ltr" או כ == "LTR") {
        החזר "שמאל"
    }
    החזר "ימין"
}

פונקציה הוא_ימין(כ) {
    החזר נרמל_כיוון(כ) == "ימין"
}

פונקציה צעד_חץ_אופקי(כיוון, שמאלה) {
    // ב־RTL חץ שמאלה מגדיל אינדקס (לעבר סוף ויזואלי משמאל)
    אם (הוא_ימין(כיוון)) {
        אם (שמאלה) {
            החזר 1
        }
        החזר 0 - 1
    }
    אם (שמאלה) {
        החזר 0 - 1
    }
    החזר 1
}

פונקציה יישור_טקסט(כ) {
    החזר נרמל_כיוון(כ)
}

פונקציה אומדן_רוחב_טקסט(משטח, טקסט) {
    אם (טקסט == ריק או טקסט == "") {
        החזר 0
    }
    אם (משטח != ריק) {
        משתנה w = משטח.רוחב_טקסט(טקסט)
        אם (w != ריק) {
            החזר w
        }
    }
    החזר אורך(טקסט) * 7
}

// x של קצה שמאל של פריט ברוחב `רוחב_פריט` במרחק `הזחה` מצד ההתחלה
פונקציה x_מהתחלה(רכיב, הזחה) {
    אם (הוא_ימין(רכיב.כיוון())) {
        החזר רכיב.x + רכיב.רחב - הזחה
    }
    החזר רכיב.x + הזחה
}

// x (קצה שמאל) של פריט ברוחב נתון, מוצמד לצד ההתחלה עם ריפוד
פונקציה x_פריט_מהתחלה(רכיב, ריפוד, רוחב_פריט) {
    אם (הוא_ימין(רכיב.כיוון())) {
        החזר רכיב.x + רכיב.רחב - ריפוד - רוחב_פריט
    }
    החזר רכיב.x + ריפוד
}

// x של עוגן טקסט לפי כיוון (עם קבע_יישור מתאים במשטח)
פונקציה x_טקסט_ברכיב(רכיב, ריפוד) {
    אם (הוא_ימין(רכיב.כיוון())) {
        החזר רכיב.x + רכיב.רחב - ריפוד
    }
    החזר רכיב.x + ריפוד
}

פונקציה צייר_טקסט_ברכיב(משטח, רכיב, טקסט, y, ריפוד) {
    אם (טקסט == ריק) {
        טקסט = ""
    }
    משטח.קבע_יישור(יישור_טקסט(רכיב.כיוון()))
    משטח.טקסט(טקסט, x_טקסט_ברכיב(רכיב, ריפוד), y)
    משטח.קבע_יישור("שמאל")
}

פונקציה צייר_טקסט_ממורכז(משטח, רכיב, טקסט, y) {
    אם (טקסט == ריק) {
        טקסט = ""
    }
    משטח.קבע_יישור("מרכז")
    משטח.טקסט(טקסט, רכיב.x + רכיב.רחב / 2, y)
    משטח.קבע_יישור("שמאל")
}

// מיקום x ורוחב של מילוי אופקי מאחוז (0–100) — מילוי מכיוון ההתחלה
פונקציה x_מילוי_אופקי(רכיב, אחוז) {
    משתנה מלא = (רכיב.רחב * אחוז / 100).שלם()
    אם (מלא < 0) {
        מלא = 0
    }
    אם (מלא > רכיב.רחב) {
        מלא = רכיב.רחב
    }
    אם (הוא_ימין(רכיב.כיוון())) {
        החזר רכיב.x + רכיב.רחב - מלא
    }
    החזר רכיב.x
}

פונקציה רוחב_מילוי_אופקי(רכיב, אחוז) {
    משתנה מלא = (רכיב.רחב * אחוז / 100).שלם()
    אם (מלא < 0) {
        החזר 0
    }
    אם (מלא > רכיב.רחב) {
        החזר רכיב.רחב
    }
    החזר מלא
}

// עוגן רכיב לקצה ההתחלה של הלוח (לדמוים / בפריסה)
פונקציה עגן_לקצה(לוח, רחב_רכיב, שוליים) {
    אם (לוח == ריק) {
        החזר שוליים
    }
    אם (הוא_ימין(לוח.כיוון)) {
        החזר לוח.רחב - שוליים - רחב_רכיב
    }
    החזר שוליים
}
