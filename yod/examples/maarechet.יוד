// מידע ממערכת ההפעלה
כלול "מערכת"

הדפס: "מחשב: " + מערכת.שם_מחשב()
הדפס: "מערכת: " + מערכת.מערכת_הפעלה() + " — " + מערכת.גרסת_הפעלה()
הדפס: "ארכיטקטורה: " + מערכת.ארכיטקטורה()
הדפס: "משתמש: " + מערכת.משתמש()
הדפס: "בית: " + מערכת.בית()

משתנה מעבד = מערכת.מעבד()
הדפס: "מעבד: " + מעבד["שם"] + " (" + מעבד["ליבות"] + " ליבות)"

משתנה זיכרון = מערכת.זיכרון()
הדפס: "זיכרון: " + זיכרון["בשימוש_מגה"] + " / " + זיכרון["סהכ_מגה"] + " מגה"

הדפס: "כתובות IP:"
עבור איפי בתוך מערכת.איפי()
    הדפס: "  " + איפי
סוף
