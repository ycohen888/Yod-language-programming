// אירועי_ציור.יוד — לוגיקת ציור לפי כלי וכפתור עכבר (יוד בלבד)
פונקציה כלי_צורה() {
    אם (כלי == "קו") {
        החזר אמת
    }
    אם (כלי == "מלבן") {
        החזר אמת
    }
    אם (כלי == "עיגול") {
        החזר אמת
    }
    אם (כלי == "אליפסה") {
        החזר אמת
    }
    החזר שקר
}

פונקציה טפטפת_בנקודה(x, y) {
    משתנה פיקסל = לוח.קרא_צבע: x, y
    בחר_צבע_rgb: פיקסל["אדום"], פיקסל["ירוק"], פיקסל["כחול"]
}

פונקציה על_עכבר_למטה(x, y, כפתור) {
    x_התחלה = x
    y_התחלה = y
    x_קודם = x
    y_קודם = y
    // ימין — תמיד טפטפת (כמו בצייר)
    אם (כפתור == עכבר.ימין) {
        טפטפת_בנקודה: x, y
        החזר ריק
    }
    // אמצע — מילוי מהיר
    אם (כפתור == עכבר.אמצע) {
        לוח.צלם()
        החל_צבע_נוכחי()
        לוח.מלא_באזור: x, y
        החזר ריק
    }
    אם (כפתור != עכבר.שמאל) {
        החזר ריק
    }
    אם (כלי == "טפטפת") {
        טפטפת_בנקודה: x, y
        החזר ריק
    }
    לוח.צלם()
    אם (כלי == "מילוי") {
        החל_צבע_נוכחי()
        לוח.מלא_באזור: x, y
        החזר ריק
    }
    אם (כלי_צורה()) {
        לוח.גיבוי()
        החזר ריק
    }
    אם (כלי == "עיפרון") {
        החל_צבע_נוכחי()
        לוח.נקודה: x, y
        החזר ריק
    }
    אם (כלי == "מחק") {
        לוח.קבע_צבע: "לבן"
        משתנה ע = עובי
        אם (ע < 6) {
            ע = 6
        }
        לוח.קבע_עובי: ע
        לוח.נקודה: x, y
    }
}

פונקציה על_עכבר_גרירה(x, y, כפתור) {
    אם (כפתור != עכבר.שמאל) {
        החזר ריק
    }
    אם (כלי_צורה()) {
        לוח.שחזר()
        צייר_צורה: x_התחלה, y_התחלה, x, y
        החזר ריק
    }
    אם (כלי == "עיפרון") {
        החל_צבע_נוכחי()
        לוח.קו: x_קודם, y_קודם, x, y
        x_קודם = x
        y_קודם = y
        החזר ריק
    }
    אם (כלי == "מחק") {
        לוח.קבע_צבע: "לבן"
        משתנה ע = עובי
        אם (ע < 6) {
            ע = 6
        }
        לוח.קבע_עובי: ע
        לוח.קו: x_קודם, y_קודם, x, y
        x_קודם = x
        y_קודם = y
    }
}

פונקציה על_עכבר_למעלה(x, y, כפתור) {
    אם (כפתור != עכבר.שמאל) {
        החזר ריק
    }
    אם (כלי_צורה()) {
        לוח.שחזר()
        צייר_צורה: x_התחלה, y_התחלה, x, y
    }
}
