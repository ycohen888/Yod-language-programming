// סרגל_עליון.יוד — Navbar עליון + תפריט מקונן (ילדים / מפריד / איקון / רוחב_מלא)
// פריט שטוח: "שם"  |  מקונן: { "טקסט", "ערך"?, "איקון"?, "ילדים"?, "רוחב_מלא"?, "סוג"? }
// סוג: פריט | מפריד | ריק | כותרת   | קיצור מפריד: "-" / "מפריד"   | ריק: "" / "ריק"
כלול "פקד.יוד"

מחלקה סרגל_עליון מרחיב פקד {
    פונקציה בנאי(כותרת, פריטים, נבחר = "", איקון = "", מזהה = "") {
        אם (כותרת == ריק) {
            כותרת = ""
        }
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (נבחר == ריק) {
            נבחר = ""
        }
        אם (איקון == ריק) {
            איקון = ""
        }
        הורה(מזהה)
        זה.כותרת = כותרת
        זה.טקסט = כותרת
        זה.פריטים = פריטים
        זה.ערך = נבחר
        זה.איקון = איקון
        זה._לחץ = ריק
        זה._שינוי = ריק
        זה._צור("סרגל_עליון", {
            "כותרת": כותרת,
            "פריטים": פריטים,
            "ערך": נבחר,
            "איקון": איקון
        })
    }

    פונקציה קבע_כותרת(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.כותרת = ט
        זה.טקסט = ט
        זה._שלח_פקודה("קבע_כותרת", { "כותרת": ט })
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
