// מתודות למחרוזת, מספר, בוליאני וריק

משתנה שם = "  יוד  "
הדפס: "גזום: [" + שם.גזום() + "]"
הדפס: "אורך: " + שם.גזום().אורך()
הדפס: "מכיל י? " + שם.מכיל("י")
הדפס: "הפוך: " + "אבג".הפוך()
הדפס: "פצל: " + "א,ב,ג".פצל(",").הצטרף(" | ")

משתנה נ = -4.7
הדפס: "מוחלט: " + נ.מוחלט()
הדפס: "עיגול: " + נ.עיגול()
הדפס: "רצפה: " + נ.רצפה()
הדפס: "זוגי 8? " + 8.זוגי()
הדפס: "2^10: " + 2.חזקה(10)
הדפס: "בין 1–10? " + 7.בין(1, 10)

הדפס: "לא אמת: " + אמת.לא()
הדפס: "שקר למספר: " + שקר.למספר()
הדפס: "ריק? " + ריק.ריק()

משתנה ציונים = [90, 80, 100]
הדפס: "סכום: " + ציונים.סכום()
הדפס: "ממוצע: " + ציונים.ממוצע()
הדפס: "מקס: " + ציונים.מקסימום()
