// התחל.יוד — דמו מעוצב: רכיבי משטח כהים
// פתחו את התיקייה בעורך יוד ← F5

כלול "חלונות"
כלול "עכבר"
כלול "רכיבים.יוד"

משתנה עובי = 3
משתנה צבע_א = 78
משתנה צבע_י = 201
משתנה צבע_כ = 176
משתנה מצב_אוטומט = אמת
משתנה תווית_מצב = ריק
משתנה סרגל = ריק
משתנה פס = ריק
משתנה ד1 = ריק
משתנה ד2 = ריק
משתנה ד3 = ריק
משתנה ד4 = ריק
משתנה ד5 = ריק
משתנה מדרגה = ריק
משתנה שדה = ריק
משתנה נור = ריק
משתנה תג_מצב = ריק
משתנה צל1 = ריק
משתנה צל2 = ריק
משתנה צל3 = ריק

פונקציה רענון_מצב()
  אם תווית_מצב == ריק
    החזר ריק
  סוף
  תווית_מצב.קבע_טקסט("עובי " + עובי.שלם() + " · RGB(" + צבע_א + "," + צבע_י + "," + צבע_כ + ")")
סוף

פונקציה נקה_בחירת_צבע()
  ד1.קבע_נבחר(שקר)
  ד2.קבע_נבחר(שקר)
  ד3.קבע_נבחר(שקר)
  ד4.קבע_נבחר(שקר)
  ד5.קבע_נבחר(שקר)
סוף

פונקציה בחר_כלי_צל(שם)
  צל1.קבע_פעיל(שם == "ק")
  צל2.קבע_פעיל(שם == "מ")
  צל3.קבע_פעיל(שם == "ע")
  אם שדה != ריק
    שדה.קבע_טקסט("כלי: " + שם)
  סוף
סוף

פונקציה בנה_חלון()
  משתנה ח = חלונות.חלון: "רכיבי משטח · יוד"
  ח.קבע_גודל(580, 760)
  ח.קבע_כהה: אמת

  משתנה לוח = חדש לוח_רכיבים: 540, 680
  לוח.הוסף(חדש מסגרת_ציור: 10, 10, 520, 660)

  משתנה כותרת = חדש תווית_ציור: 28, 28, "רכיבי משטח"
  כותרת.קבע_צבע_rgb(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
  כותרת.גודל = 18
  לוח.הוסף(כותרת)

  תג_מצב = חדש תג: 160, 26, "כהה"
  לוח.הוסף(תג_מצב)

  נור = חדש נורית: 400, 28, "מחובר", אמת
  לוח.הוסף(נור)

  תווית_מצב = חדש תווית_ציור: 28, 58, ""
  לוח.הוסף(תווית_מצב)

  משתנה לשו = חדש לשוניות: 28, 88, 484, ["כלים", "צבע", "רשימה"]
  לשו.בשינוי = פונקציה (i, שם)
    אם תג_מצב != ריק
      תג_מצב.קבע_טקסט(שם)
    סוף
  סוף
  לוח.הוסף(לשו)

  צל1 = חדש כפתור_צלמית: 28, 140, "ק"
  צל1.קבע_פעיל(אמת)
  צל1.בלחיצה = פונקציה ()
    בחר_כלי_צל("ק")
  סוף
  לוח.הוסף(צל1)

  צל2 = חדש כפתור_צלמית: 72, 140, "מ"
  צל2.בלחיצה = פונקציה ()
    בחר_כלי_צל("מ")
  סוף
  לוח.הוסף(צל2)

  צל3 = חדש כפתור_צלמית: 116, 140, "ע"
  צל3.בלחיצה = פונקציה ()
    בחר_כלי_צל("ע")
  סוף
  לוח.הוסף(צל3)

  משתנה כפ_ראשי = חדש כפתור_משטח: 180, 140, 120, 36, "הרץ"
  כפ_ראשי.קבע_ראשי(אמת)
  כפ_ראשי.בלחיצה = פונקציה ()
    חלונות.הודעה("רכיבים", "עובי " + עובי.שלם())
  סוף
  לוח.הוסף(כפ_ראשי)

  משתנה כפ_משני = חדש כפתור_משטח: 312, 140, 120, 36, "איפוס"
  כפ_משני.בלחיצה = פונקציה ()
    עובי = 3
    סרגל.קבע_ערך_שקט(3)
    מדרגה.קבע_ערך_שקט(3)
    פס.קבע_אחוז(30)
    רענון_מצב()
  סוף
  לוח.הוסף(כפ_משני)

  לוח.הוסף(חדש מפריד: 28, 188, 484)

  לוח.הוסף(חדש תווית_ציור: 28, 204, "עובי קו")
  סרגל = חדש סליידר: 28, 228, 320, 1, 20, עובי
  סרגל.בשינוי = פונקציה (v)
    עובי = v.שלם()
    מדרגה.קבע_ערך_שקט(עובי)
    פס.קבע_אחוז(עובי * 5)
    רענון_מצב()
  סוף
  לוח.הוסף(סרגל)

  מדרגה = חדש מספר_מדרגה: 370, 226, 1, 20, עובי
  מדרגה.בשינוי = פונקציה (v)
    עובי = v.שלם()
    סרגל.קבע_ערך_שקט(עובי)
    פס.קבע_אחוז(עובי * 5)
    רענון_מצב()
  סוף
  לוח.הוסף(מדרגה)

  פס = חדש פס_התקדמות: 28, 272, 484, עובי * 5
  לוח.הוסף(פס)

  לוח.הוסף(חדש מפריד: 28, 298, 484)

  לוח.הוסף(חדש תווית_ציור: 28, 314, "מצב אוטומטי")
  משתנה מת = חדש מתג: 150, 310, מצב_אוטומט
  מת.בשינוי = פונקציה (דלוק)
    מצב_אוטומט = דלוק
    נור.קבע_דולקת(דלוק)
  סוף
  לוח.הוסף(מת)

  משתנה סימון = חדש תיבת_סימון: 250, 312, "הצג רמזים", אמת
  סימון.בשינוי = פונקציה (מ)
    אם מ
      תווית_מצב.קבע_צבע_rgb(180, 185, 190)
    אחרת
      תווית_מצב.קבע_צבע_rgb(100, 105, 110)
    סוף
  סוף
  לוח.הוסף(סימון)

  לוח.הוסף(חדש מפריד: 28, 352, 484)

  שדה = חדש שדה_תצוגה: 28, 370, 240, "כלי: ק"
  שדה.מקום_שמור = "שם קובץ…"
  לוח.הוסף(שדה)

  משתנה רשימה = חדש רשימת_בחירה: 290, 370, 222, ["עיפרון", "מלבן", "עיגול", "מילוי"]
  רשימה.בשינוי = פונקציה (i, שם)
    שדה.קבע_טקסט("פריט: " + שם)
  סוף
  לוח.הוסף(רשימה)

  לוח.הוסף(חדש מפריד: 28, 510, 484)

  לוח.הוסף(חדש תווית_ציור: 28, 526, "מצב כלי")
  משתנה קב = חדש קבוצת_בורר
  משתנה ב1 = חדש בורר: 28, 552, "עיפרון", קב, "עיפרון"
  משתנה ב2 = חדש בורר: 160, 552, "מלבן", קב, "מלבן"
  משתנה ב3 = חדש בורר: 290, 552, "מילוי", קב, "מילוי"
  קב.הוסף(ב1)
  קב.הוסף(ב2)
  קב.הוסף(ב3)
  קב.הצב_נבחר("עיפרון")
  לוח.הוסף(ב1)
  לוח.הוסף(ב2)
  לוח.הוסף(ב3)

  לוח.הוסף(חדש תווית_ציור: 28, 592, "צבע")
  ד1 = חדש דגם_צבע_משטח: 28, 618, 30, 78, 201, 176
  ד2 = חדש דגם_צבע_משטח: 68, 618, 30, 239, 68, 68
  ד3 = חדש דגם_צבע_משטח: 108, 618, 30, 37, 99, 235
  ד4 = חדש דגם_צבע_משטח: 148, 618, 30, 250, 204, 21
  ד5 = חדש דגם_צבע_משטח: 188, 618, 30, 230, 230, 230

  ד1.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד1.קבע_נבחר(אמת)
    תג_מצב.קבע_צבע_rgb(א, י, כ)
    רענון_מצב()
  סוף
  ד2.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד2.קבע_נבחר(אמת)
    תג_מצב.קבע_צבע_rgb(א, י, כ)
    רענון_מצב()
  סוף
  ד3.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד3.קבע_נבחר(אמת)
    תג_מצב.קבע_צבע_rgb(א, י, כ)
    רענון_מצב()
  סוף
  ד4.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד4.קבע_נבחר(אמת)
    תג_מצב.קבע_צבע_rgb(א, י, כ)
    רענון_מצב()
  סוף
  ד5.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד5.קבע_נבחר(אמת)
    תג_מצב.קבע_צבע_rgb(א, י, כ)
    רענון_מצב()
  סוף
  ד1.קבע_נבחר(אמת)

  לוח.הוסף(ד1)
  לוח.הוסף(ד2)
  לוח.הוסף(ד3)
  לוח.הוסף(ד4)
  לוח.הוסף(ד5)

  רענון_מצב()
  לוח.רענון()
  ח.הוסף(לוח.משטח_גלוי())
  ח.הצג()
סוף

בנה_חלון()
