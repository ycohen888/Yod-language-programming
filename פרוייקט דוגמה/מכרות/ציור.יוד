    כל_עוד x < גודל_לוח
      משתנה px = בסיס_x + x * גודל_תא
      משתנה py = בסיס_y + y * גודל_תא
      אם y >= שורות_פתוחות
        לוח.קבע_מילוי: 16, 18, 24
