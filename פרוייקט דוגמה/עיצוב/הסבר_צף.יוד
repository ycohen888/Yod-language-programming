// הסבר_צף.יוד — Tooltip עם tippy.js
כלול "פקד.יוד"

מחלקה הסבר_צף מרחיב פקד {
    פונקציה בנאי(תוכן, טקסט_טריגר = "?", מזהה = "") {
        אם (תוכן == ריק) {
            תוכן = ""
        }
        אם (טקסט_טריגר == ריק או טקסט_טריגר == "") {
            טקסט_טריגר = "?"
        }
        הורה(מזהה)
        זה.תוכן = תוכן
        זה.טקסט = טקסט_טריגר
        זה.יעד = ""
        זה._צור("הסבר_צף", {
            "תוכן": תוכן,
            "טקסט": טקסט_טריגר
        })
    }

    פונקציה קבע_תוכן(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.תוכן = ט
        זה._שלח_פקודה("קבע_תוכן", { "תוכן": ט })
    }

    פונקציה קבע_יעד(מזהה_יעד) {
        אם (מזהה_יעד == ריק) {
            מזהה_יעד = ""
        }
        זה.יעד = מזהה_יעד
        זה._שלח_פקודה("קבע_יעד", { "יעד": מזהה_יעד })
    }
}
