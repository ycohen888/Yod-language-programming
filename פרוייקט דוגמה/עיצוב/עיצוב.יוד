// עיצוב.יוד — מעטפת UI ב־WebView2 + Bootstrap 5 (גשר JSON כמו תלת)
כלול "JSON"
כלול "קבצים"
כלול "מערכת"

משתנה _עיצוב_דפדפן = ריק
משתנה _עיצוב_מוכן_קב = ריק
משתנה _עיצוב_אתחל = שקר
משתנה _עיצוב_מוכן_דגל = שקר
משתנה _עיצוב_פקדים = {}
משתנה _עיצוב_מונה = 0
משתנה _עיצוב_תיק = ""
משתנה _עיצוב_תור = []
משתנה _עיצוב_הורה_נוכחי = ""

פונקציה _עיצוב_נתיב_מלא(נתיב) {
    אם (נתיב == ריק או נתיב == "") {
        החזר נתיב
    }
    אם (נתיב.מתחיל_ב("http") או נתיב.מתחיל_ב("file:")) {
        החזר נתיב
    }
    אם (נתיב.אורך() >= 2 וגם נתיב.תו(1) == ":") {
        החזר נתיב
    }
    משתנה בסיס = _עיצוב_תיק
    אם (בסיס == ריק או בסיס == "") {
        בסיס = מערכת.תיקייה()
    }
    החזר בסיס + "\\" + נתיב
}

פונקציה _עיצוב_רוקן_תור() {
    משתנה תור = _עיצוב_תור
    _עיצוב_תור = []
    עבור פריט בתוך תור {
        אם (_עיצוב_דפדפן != ריק) {
            _עיצוב_דפדפן.שלח(פריט)
        }
    }
}

פונקציה _עיצוב_שלח(שם, ערכים) {
    אם (_עיצוב_דפדפן == ריק) {
        החזר ריק
    }
    אם (ערכים == ריק) {
        ערכים = {}
    }
    משתנה מטען = JSON.מחרוזת({
        "סוג": "פקודה",
        "שם": שם,
        "ערכים": ערכים
    })
    אם (לא _עיצוב_מוכן_דגל) {
        _עיצוב_תור.הוסף(מטען)
        החזר ריק
    }
    _עיצוב_דפדפן.שלח(מטען)
}

פונקציה _עיצוב_מזהה_חדש() {
    _עיצוב_מונה = _עיצוב_מונה + 1
    // ASCII בלבד — מזהה עברי שובר name של radio ו־Bootstrap
    החזר "yod_" + _עיצוב_מונה
}

פונקציה _עיצוב_רשום(מופע) {
    אם (מופע == ריק) {
        החזר ריק
    }
    _עיצוב_פקדים[מופע.מזהה] = מופע
}

פונקציה _עיצוב_בטל_רישום(מזהה) {
    אם (_עיצוב_פקדים.יש(מזהה)) {
        _עיצוב_פקדים.מחק(מזהה)
    }
}

פונקציה _עיצוב_מצא(מזהה) {
    אם (_עיצוב_פקדים.יש(מזהה)) {
        החזר _עיצוב_פקדים[מזהה]
    }
    החזר ריק
}

פונקציה _עיצוב_על_הודעה(טקסט) {
    נסה {
        אם (טקסט == ריק או טקסט == "") {
            החזר ריק
        }
        משתנה מ = JSON.פרסר(טקסט)
        // אם התקבלה מחרוזת JSON עטופה — מפרסרים שוב; אם כבר מילון, JSON.פרסר זורק ומתעלמים
        נסה {
            מ = JSON.פרסר(מ)
        } תפוס שגיאה {
        }
        נסה {
            אם (מ.סוג != "אירוע") {
                החזר ריק
            }
        } תפוס שגיאה {
            החזר ריק
        }
        אם (מ.שם == "מוכן") {
            אם (_עיצוב_אתחל) {
                החזר ריק
            }
            _עיצוב_אתחל = אמת
            _עיצוב_מוכן_דגל = אמת
            _עיצוב_רוקן_תור()
            נסה {
                אם (_עיצוב_מוכן_קב != ריק) {
                    _עיצוב_מוכן_קב()
                }
            } תפוס שגיאה {
            }
            // אחרי בניית הממשק — מסך הטעינה נעלם (גם אם הבנייה נכשלה)
            _עיצוב_שלח("הסתר_טעינה", {})
            החזר ריק
        }
        אם (מ.שם == "לחיצה") {
            אם (מ.ערכים == ריק או לא מ.ערכים.יש("מזהה")) {
                החזר ריק
            }
            משתנה מזהה = מ.ערכים.מזהה
            משתנה פ = _עיצוב_מצא(מזהה)
            אם (פ != ריק וגם פ._לחץ != ריק) {
                אם (מ.ערכים.יש("ערך")) {
                    פ.ערך = מ.ערכים.ערך
                    פ._לחץ(מ.ערכים.ערך)
                } אחרת {
                    פ._לחץ()
                }
            }
            החזר ריק
        }
        אם (מ.שם == "לחיצה_כפולה") {
            אם (מ.ערכים == ריק או לא מ.ערכים.יש("מזהה")) {
                החזר ריק
            }
            משתנה מזהה_כ = מ.ערכים.מזהה
            משתנה פ_כ = _עיצוב_מצא(מזהה_כ)
            אם (פ_כ != ריק וגם פ_כ._לחיצה_כפולה != ריק) {
                אם (מ.ערכים.יש("ערך")) {
                    פ_כ.ערך = מ.ערכים.ערך
                    פ_כ._לחיצה_כפולה(מ.ערכים.ערך)
                } אחרת {
                    פ_כ._לחיצה_כפולה()
                }
            }
            החזר ריק
        }
        אם (מ.שם == "שינוי") {
            משתנה מזהה2 = מ.ערכים.מזהה
            משתנה פ2 = _עיצוב_מצא(מזהה2)
            אם (פ2 != ריק) {
                פ2.ערך = מ.ערכים.ערך
                אם (מ.ערכים.יש("מסומן")) {
                    פ2.מסומן = מ.ערכים.מסומן
                    פ2.ערך = מ.ערכים.מסומן
                } אחרת {
                    פ2.טקסט = מ.ערכים.ערך
                }
                אם (מ.ערכים.יש("שמות")) {
                    פ2.שמות = מ.ערכים.שמות
                }
                אם (פ2._שינוי != ריק) {
                    אם (מ.ערכים.יש("מסומן")) {
                        פ2._שינוי(מ.ערכים.מסומן)
                    } אחרת {
                        פ2._שינוי(מ.ערכים.ערך)
                    }
                }
            }
            החזר ריק
        }
        אם (מ.שם == "העתקה") {
            אם (מ.ערכים == ריק או לא מ.ערכים.יש("מזהה")) {
                החזר ריק
            }
            משתנה מזהה_ה = מ.ערכים.מזהה
            משתנה פ_ה = _עיצוב_מצא(מזהה_ה)
            אם (פ_ה != ריק וגם פ_ה._העתקה != ריק) {
                משתנה פעולה_ה = "שורה"
                אם (מ.ערכים.יש("פעולה") וגם מ.ערכים.פעולה != ריק) {
                    פעולה_ה = מ.ערכים.פעולה
                }
                משתנה טקסט_ה = ""
                אם (מ.ערכים.יש("טקסט") וגם מ.ערכים.טקסט != ריק) {
                    טקסט_ה = מ.ערכים.טקסט
                }
                משתנה ערך_ה = ""
                אם (מ.ערכים.יש("ערך") וגם מ.ערכים.ערך != ריק) {
                    ערך_ה = מ.ערכים.ערך
                }
                פ_ה._העתקה(פעולה_ה, טקסט_ה, ערך_ה)
            }
            החזר ריק
        }
        אם (מ.שם == "עריכה") {
            משתנה מזהה_ע = מ.ערכים.מזהה
            משתנה פ_ע = _עיצוב_מצא(מזהה_ע)
            אם (פ_ע != ריק וגם פ_ע._עריכה != ריק) {
                משתנה שדה_ע = ""
                אם (מ.ערכים.יש("שדה")) {
                    שדה_ע = מ.ערכים.שדה
                }
                משתנה ערך_ע = ""
                אם (מ.ערכים.יש("ערך")) {
                    ערך_ע = מ.ערכים.ערך
                }
                משתנה שורה_ע = ""
                אם (מ.ערכים.יש("מזהה_שורה")) {
                    שורה_ע = מ.ערכים.מזהה_שורה
                }
                פ_ע._עריכה(שורה_ע, שדה_ע, ערך_ע)
            }
            החזר ריק
        }
        אם (מ.שם == "בחירה") {
            משתנה מזהה_ב = מ.ערכים.מזהה
            משתנה פ_ב = _עיצוב_מצא(מזהה_ב)
            אם (פ_ב != ריק וגם פ_ב._בחירה != ריק) {
                משתנה מזהימים = []
                אם (מ.ערכים.יש("מזהים")) {
                    מזהימים = מ.ערכים.מזהים
                }
                פ_ב._בחירה(מזהימים)
            }
            החזר ריק
        }
        אם (מ.שם == "תפריט") {
            משתנה מזהה_ת = מ.ערכים.מזהה
            משתנה פ_ת = _עיצוב_מצא(מזהה_ת)
            אם (פ_ת != ריק וגם פ_ת._תפריט != ריק) {
                משתנה פעולה_ת = ""
                אם (מ.ערכים.יש("פעולה")) {
                    פעולה_ת = מ.ערכים.פעולה
                }
                משתנה שורה_ת = ""
                אם (מ.ערכים.יש("מזהה_שורה")) {
                    שורה_ת = מ.ערכים.מזהה_שורה
                }
                פ_ת._תפריט(פעולה_ת, שורה_ת)
            }
            החזר ריק
        }
        אם (מ.שם == "ייצוא") {
            משתנה מזהה_י = מ.ערכים.מזהה
            משתנה פ_י = _עיצוב_מצא(מזהה_י)
            אם (פ_י != ריק) {
                נסה {
                    פ_י._ייצוא_מערכת(מ.ערכים)
                } תפוס שגיאה {
                }
            }
            החזר ריק
        }
        אם (מ.שם == "כניסה") {
            משתנה מזהה3 = מ.ערכים.מזהה
            משתנה פ3 = _עיצוב_מצא(מזהה3)
            אם (פ3 != ריק) {
                פ3.ערך = מ.ערכים.ערך
                פ3.טקסט = מ.ערכים.ערך
                אם (פ3._כניסה != ריק) {
                    פ3._כניסה(מ.ערכים.ערך)
                }
            }
            החזר ריק
        }
        אם (מ.שם == "פתיחה") {
            אם (מ.ערכים == ריק או לא מ.ערכים.יש("מזהה")) {
                החזר ריק
            }
            משתנה מזהה_פ = מ.ערכים.מזהה
            משתנה פ_פ = _עיצוב_מצא(מזהה_פ)
            אם (פ_פ != ריק וגם פ_פ._פתיחה != ריק) {
                אם (מ.ערכים.יש("ערך")) {
                    פ_פ._פתיחה(מ.ערכים.ערך)
                } אחרת {
                    פ_פ._פתיחה()
                }
            }
            החזר ריק
        }
        אם (מ.שם == "סגירה") {
            משתנה מזהה4 = מ.ערכים.מזהה
            משתנה פ4 = _עיצוב_מצא(מזהה4)
            אם (פ4 != ריק וגם פ4._סגירה != ריק) {
                פ4._סגירה()
            }
            החזר ריק
        }
        אם (מ.שם == "פעולה") {
            משתנה מזהה_פע = מ.ערכים.מזהה
            משתנה פ_פע = _עיצוב_מצא(מזהה_פע)
            אם (פ_פע != ריק וגם פ_פע._פעולה != ריק) {
                פ_פע._פעולה()
            }
            החזר ריק
        }
    } תפוס שגיאה {
    }
}

פונקציה _עיצוב_הטמע_קליפה(תיק) {
    משתנה html = קבצים.קרא(תיק + "\\קליפה.html")
    משתנה css_rtl = קבצים.קרא(תיק + "\\bootstrap\\bootstrap.rtl.min.css")
    משתנה css_ltr = קבצים.קרא(תיק + "\\bootstrap\\bootstrap.min.css")
    משתנה css_tippy = קבצים.קרא(תיק + "\\tippy\\tippy.css")
    משתנה css_tippy_theme = קבצים.קרא(תיק + "\\tippy\\light-border.css")
    משתנה css_theme = קבצים.קרא(תיק + "\\ערכות.css")
    משתנה css_tabulator = קבצים.קרא(תיק + "\\tabulator\\tabulator.min.css")
    משתנה js_bs = קבצים.קרא(תיק + "\\bootstrap\\bootstrap.bundle.min.js")
    משתנה js_popper = קבצים.קרא(תיק + "\\tippy\\popper.min.js")
    משתנה js_tippy = קבצים.קרא(תיק + "\\tippy\\tippy-bundle.umd.min.js")
    משתנה js_tabulator = קבצים.קרא(תיק + "\\tabulator\\tabulator.min.js")
    משתנה js_eng = קבצים.קרא(תיק + "\\מנוע.js")
    משתנה לוגו_b64 = ""
    אם (קבצים.קיים(תיק + "\\לוגו-יוד.b64")) {
        לוגו_b64 = קבצים.קרא(תיק + "\\לוגו-יוד.b64").גזום()
    }

    html = html.החלף(
        "<link rel=\"stylesheet\" href=\"bootstrap/bootstrap.rtl.min.css\" id=\"bs-rtl\"/>",
        "<style id=\"bs-rtl\">\n" + css_rtl + "\n</style>"
    )
    html = html.החלף(
        "<link rel=\"stylesheet\" href=\"bootstrap/bootstrap.min.css\" id=\"bs-ltr\" disabled/>",
        "<style id=\"bs-ltr\" media=\"none\" disabled>\n" + css_ltr + "\n</style>"
    )
    html = html.החלף(
        "<link rel=\"stylesheet\" href=\"tippy/tippy.css\"/>",
        "<style id=\"yod-tippy\">\n" + css_tippy + "\n</style>"
    )
    html = html.החלף(
        "<link rel=\"stylesheet\" href=\"tippy/light-border.css\"/>",
        "<style id=\"yod-tippy-theme\">\n" + css_tippy_theme + "\n</style>"
    )
    html = html.החלף(
        "<link rel=\"stylesheet\" href=\"tabulator/tabulator.min.css\"/>",
        "<style id=\"yod-tabulator\">\n" + css_tabulator + "\n</style>"
    )
    html = html.החלף(
        "<link rel=\"stylesheet\" href=\"ערכות.css\"/>",
        "<style id=\"yod-themes\">\n" + css_theme + "\n</style>"
    )
    html = html.החלף(
        "<script src=\"bootstrap/bootstrap.bundle.min.js\"></script>",
        "<script>\n" + js_bs + "\n</script>"
    )
    html = html.החלף(
        "<script src=\"tippy/popper.min.js\"></script>",
        "<script>\n" + js_popper + "\n</script>"
    )
    html = html.החלף(
        "<script src=\"tippy/tippy-bundle.umd.min.js\"></script>",
        "<script>\n" + js_tippy + "\n</script>"
    )
    html = html.החלף(
        "<script src=\"tabulator/tabulator.min.js\"></script>",
        "<script>\n" + js_tabulator + "\n</script>"
    )
    אם (לוגו_b64 != "" וגם לוגו_b64 != ריק) {
        משתנה לוגו_uri = "data:image/png;base64," + לוגו_b64
        html = html.החלף(
            "<!--YOD_EARLY_LOGO-->",
            "<script>window.__יוד_לוגו=\"" + לוגו_uri + "\";</script>"
        )
        html = html.החלף(
            "src=\"לוגו-יוד.png\"",
            "src=\"" + לוגו_uri + "\""
        )
        html = html.החלף(
            "<script src=\"מנוע.js\"></script>",
            "<script>\n" + js_eng + "\n</script>"
        )
    } אחרת {
        html = html.החלף("<!--YOD_EARLY_LOGO-->", "")
        html = html.החלף(
            "<script src=\"מנוע.js\"></script>",
            "<script>\n" + js_eng + "\n</script>"
        )
    }
    החזר html
}

פונקציה עיצוב_פתח(דפדפן, תיק = "") {
    _עיצוב_דפדפן = דפדפן
    _עיצוב_אתחל = שקר
    _עיצוב_מוכן_דגל = שקר
    _עיצוב_פקדים = {}
    _עיצוב_מונה = 0
    _עיצוב_תור = []
    _עיצוב_הורה_נוכחי = ""
    אם (תיק == ריק או תיק == "") {
        _עיצוב_תיק = מערכת.תיקייה()
    } אחרת {
        _עיצוב_תיק = תיק
    }
    משתנה html = _עיצוב_הטמע_קליפה(_עיצוב_תיק)
    דפדפן.בהודעה(_עיצוב_על_הודעה)
    דפדפן.קבע_html(html)
}

// יוצר פקדים בתוך מכל/כרטיס קיים (הורה נשמר עד סוף גוף)
פונקציה עיצוב_בתוך(הורה_פקד, גוף) {
    משתנה קודם = _עיצוב_הורה_נוכחי
    אם (הורה_פקד != ריק) {
        _עיצוב_הורה_נוכחי = הורה_פקד.מזהה
    } אחרת {
        _עיצוב_הורה_נוכחי = ""
    }
    אם (גוף != ריק) {
        גוף()
    }
    _עיצוב_הורה_נוכחי = קודם
}

פונקציה עיצוב_בעת_מוכן(פונק) {
    _עיצוב_מוכן_קב = פונק
    אם (_עיצוב_מוכן_דגל וגם פונק != ריק) {
        פונק()
    }
}

פונקציה עיצוב_קבע_נושא(נושא) {
    אם (נושא == ריק או נושא == "") {
        נושא = "כהה"
    }
    _עיצוב_שלח("קבע_נושא", { "נושא": נושא })
}

פונקציה עיצוב_קבע_כיוון(כיוון, שפה = "") {
    אם (כיוון == ריק או כיוון == "") {
        כיוון = "ימין_לשמאל"
    }
    משתנה ערכים = { "כיוון": כיוון }
    אם (שפה != ריק וגם שפה != "") {
        ערכים.שפה = שפה
    }
    _עיצוב_שלח("קבע_כיוון", ערכים)
}

פונקציה עיצוב_נקה() {
    _עיצוב_פקדים = {}
    _עיצוב_שלח("נקה", {})
}

// מסך טעינה מקצועי (לוגו + ספינר) — מוצג אוטומטית בפתיחה; אפשר גם לטעינות ארוכות באמצע הריצה
פונקציה עיצוב_הצג_טעינה(טקסט = "טוען…") {
    אם (טקסט == ריק או טקסט == "") {
        טקסט = "טוען…"
    }
    _עיצוב_שלח("הצג_טעינה", { "טקסט": טקסט })
}

פונקציה עיצוב_הסתר_טעינה() {
    _עיצוב_שלח("הסתר_טעינה", {})
}

פונקציה עיצוב_שלח_תרגום(מידע) {
    אם (מידע == ריק) {
        החזר ריק
    }
    _עיצוב_שלח("קבע_תרגום", מידע)
    משתנה כיוון = מידע.כיוון
    משתנה שפה = מידע.שפה
    אם (כיוון == "rtl") {
        עיצוב_קבע_כיוון("ימין_לשמאל", שפה)
    } אחרת_אם (כיוון == "ltr") {
        עיצוב_קבע_כיוון("שמאל_לימין", שפה)
    }
}

// עיצוב_חבר_תרגום — לקרוא אחרי כלול "תרגום"; מחבר שינויי שפה למנוע ה־UI
פונקציה עיצוב_חבר_תרגום() {
    נסה {
        תרגום.בעת_שינוי(פונקציה(מידע) {
            עיצוב_שלח_תרגום(מידע)
        })
        תרגום.רענן_ממשק()
    } תפוס שגיאה {
    }
}

