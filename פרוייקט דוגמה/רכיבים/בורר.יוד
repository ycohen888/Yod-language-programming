// בורר.יוד — אפשרות יחידה מתוך קבוצה (רדיו)

מחלקה בורר מרחיב רכיב
  פונקציה בנאי(x, y, טקסט, קבוצה, מזהה)
    הורה(x, y, 220, 26)
    זה.טקסט = טקסט
    זה.קבוצה = קבוצה
    זה.מזהה = מזהה
    זה.נבחר = שקר
    זה.בשינוי = ריק
    זה.רדיוס = 8
  סוף

  פונקציה קבע_נבחר(v)
    זה.נבחר = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה cx = זה.x + זה.רדיוס
    משתנה cy = זה.y + זה.גבה / 2
    משטח.קבע_מילוי(36, 38, 42)
    משטח.עיגול_מלא(cx, cy, זה.רדיוס)
    משטח.קבע_צבע(90, 96, 104)
    משטח.קבע_עובי(1)
    משטח.עיגול(cx, cy, זה.רדיוס)
    אם זה.נבחר
      משטח.קבע_מילוי(78, 201, 176)
      משטח.עיגול_מלא(cx, cy, זה.רדיוס - 3)
    סוף
    משטח.קבע_צבע(210, 214, 220)
    משטח.קבע_גודל_גופן(13)
    משטח.טקסט(זה.טקסט, זה.x + זה.רדיוס * 2 + 10, זה.y + 5)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.קבוצה != ריק
      זה.קבוצה.הצב_נבחר(זה.מזהה)
    סוף
    החזר אמת
  סוף
סוף

מחלקה קבוצת_בורר
  פונקציה בנאי()
    זה.אפשרויות = []
    זה.נבחר = ריק
    זה.בשינוי = ריק
  סוף

  פונקציה הוסף(ב)
    ב.קבוצה = זה
    זה.אפשרויות.הוסף(ב)
  סוף

  פונקציה הצב_נבחר(מזהה)
    זה.נבחר = מזהה
    עבור ב בתוך זה.אפשרויות
      ב.קבע_נבחר(ב.מזהה == מזהה)
    סוף
    אם זה.בשינוי != ריק
      זה.בשינוי(מזהה)
    סוף
  סוף
סוף
