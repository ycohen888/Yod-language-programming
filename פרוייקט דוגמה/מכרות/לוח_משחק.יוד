// לוח_משחק.יוד — זריעת מכרות, חפירה ותורות

פונקציה אינדקס_תא x, y
  החזר y * גודל_לוח + x
סוף

פונקציה תא_ב x, y
  החזר תאים[אינדקס_תא(x, y)]
סוף

פונקציה גלגל_דרגה()
  משתנה ר = אקראי() * 100
  אם ר < 35
    החזר 1
  סוף
  אם ר < 60
    החזר 2
  סוף
  אם ר < 80
    החזר 3
  סוף
  אם ר < 93
    החזר 4
  סוף
  החזר 5
סוף

פונקציה זרע_לוח()
  תאים = []
  משתנה y = 0
  כל_עוד y < גודל_לוח
    משתנה x = 0
    כל_עוד x < גודל_לוח
      משתנה דרגה = גלגל_דרגה()
      משתנה תא_חדש = {
        "x": x,
        "y": y,
        "דרגה": דרגה,
        "חפור": שקר,
        "בעלים": 0 - 1,
        "משאב": 0 - 1,
        "כמות": 0
      }
      תאים.הוסף: תא_חדש
      x = x + 1
    סוף
    y = y + 1
  סוף
סוף

פונקציה צור_שחקן שם, מחשב
  משתנה ש = {
    "שם": שם,
    "כסף": כסף_התחלה,
    "מקדחה": 0,
    "פועלים": 0,
    "סהכ_רווח": 0,
    "מחשב": מחשב
  }
  החזר ש
סוף

פונקציה התחל_משחק שני_שחקנים
  מצב_2_שחקנים = שני_שחקנים
  שחקנים = []
  שחקנים.הוסף: צור_שחקן("אתם", שקר)
  אם שני_שחקנים
    שחקנים.הוסף: צור_שחקן("שחקן ב", שקר)
  אחרת
    שחקנים.הוסף: צור_שחקן("מחשב", אמת)
  סוף
  תור = 0
  חודש = 1
  יום = 1
  שורות_פתוחות = 6
  יומן = []
  אפס_סיכום_חודש()
  זרע_לוח()
  מצב_מסך = "משחק"
  הודעה = "תור של " + שם_שחקן(תור) + " — לחצו על מכרה סגור לחפירה"
  הוסף_ליומן: "המשחק התחיל — בהצלחה במכרות!"
  צייר_הכל()
סוף

פונקציה סיום_חודש()
  לשלם_משכורות()
  מצב_מסך = "דוח"
  הודעה = "סיכום חודש " + חודש
  צייר_הכל()
סוף

פונקציה המשך_אחרי_דוח()
  אפס_סיכום_חודש()
  חודש = חודש + 1
  מצב_מסך = "משחק"
  הודעה = "חודש " + חודש + " — תור של " + שם_שחקן(תור)
  בדוק_ניצחון()
  אם מצב_מסך == "משחק"
    אולי_מהלך_מחשב()
  סוף
  צייר_הכל()
סוף

פונקציה בדוק_ניצחון()
  // מנצח: הכי עשיר אחרי 12 חודשים, או יריב בפשיטת רגל
  משתנה א = שחקנים[0]
  משתנה ב = שחקנים[1]
  אם א["כסף"] < 0 או ב["כסף"] < 0
    מצב_מסך = "ניצחון"
    אם א["כסף"] >= ב["כסף"]
      הודעה = "ניצחון ל" + שם_שחקן(0) + "!"
    אחרת
      הודעה = "ניצחון ל" + שם_שחקן(1) + "!"
    סוף
    החזר ריק
  סוף
  אם חודש > 12
    מצב_מסך = "ניצחון"
    אם א["כסף"] + א["סהכ_רווח"] >= ב["כסף"] + ב["סהכ_רווח"]
      הודעה = "סיום עונה — ניצחון ל" + שם_שחקן(0)
    אחרת
      הודעה = "סיום עונה — ניצחון ל" + שם_שחקן(1)
    סוף
  סוף
סוף

פונקציה סיים_תור()
  יום = יום + 1
  תור = 1 - תור
  // אחרי ששני השחקנים שיחקו בחודש (יום זוגי בתחילת תור 0) — דוח
  // נסמן: כל 2 ימים = סוף חודש
  משתנה מחזור = יום - 1
  אם מחזור > 0
    משתנה חצי = מחזור / 2
    אם חצי.שלם() * 2 == מחזור וגם תור == 0
      סיום_חודש()
      החזר ריק
    סוף
  סוף
  הודעה = "תור של " + שם_שחקן(תור)
  אולי_מהלך_מחשב()
  צייר_הכל()
סוף

פונקציה חפור_בתא x, y
  אם מצב_מסך != "משחק"
    החזר ריק
  סוף
  אם y >= שורות_פתוחות
    הודעה = "האזור עדיין סגור — הרחיבו את הלוח"
    צייר_הכל()
    החזר ריק
  סוף
  משתנה ת = תא_ב(x, y)
  אם ת["חפור"]
    הודעה = "המכרה כבר נחפר"
    צייר_הכל()
    החזר ריק
  סוף
  משתנה ש = שחקן_נוכחי()
  משתנה עלות = עלות_חפירה + ת["דרגה"] * 40
  אם ש["כסף"] < עלות
    הודעה = "אין מספיק כסף לחפירה (" + מספרים.שלם(עלות) + "₪)"
    צייר_הכל()
    החזר ריק
  סוף

  ש["כסף"] = ש["כסף"] - עלות
  ת["חפור"] = אמת
  ת["בעלים"] = תור

  משתנה סיכוי = סיכוי_מציאה(ש, ת["דרגה"])
  משתנה גלגל = אקראי() * 100
  אם גלגל < סיכוי
    משתנה סוג = גלגל_סוג_משאב(ת["דרגה"])
    משתנה כמות = גלגל_כמות(ת["דרגה"])
    // יהלום — כמויות קטנות יותר
    אם סוג == 6
      כמות = אקראי_בין: 1, 3
    סוף
    ת["משאב"] = סוג
    ת["כמות"] = כמות
    משתנה רווח = כמות * מחיר_לקילו[סוג]
    ש["כסף"] = ש["כסף"] + רווח
    ש["סהכ_רווח"] = ש["סהכ_רווח"] + רווח
    חודש_קילו[סוג] = חודש_קילו[סוג] + כמות
    חודש_רווח[סוג] = חודש_רווח[סוג] + רווח
    הוסף_ליומן: שם_שחקן(תור) + " מצא " + כמות + "ק״ג " + שמות_משאב[סוג] + " (+" + מספרים.שלם(רווח) + "₪)"
    הודעה = "מצאתם " + שמות_משאב[סוג] + "! +" + מספרים.שלם(רווח) + "₪"
  אחרת
    הוסף_ליומן: שם_שחקן(תור) + " חפר מכרה " + שמות_דרגה[ת["דרגה"] - 1] + " — ריק"
    הודעה = "המכרה ריק הפעם… המשיכו לחפש"
  סוף

  סיים_תור()
סוף
