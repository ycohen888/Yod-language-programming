// קלט_טקסט.יוד — שדה הקלדה עם caret, בחירה ו־RTL/LTR
כלול "לוח"

מחלקה קלט_טקסט מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, טקסט) {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        // אתחל_בסיס במקום הורה — מונע לולאה כששדה_סיסמה מרחיב קלט (הורה ישן)
        זה.אתחל_בסיס(x, y, רחב, 28)
        זה.טקסט = טקסט
        זה.מקום_שמור = ""
        זה.ממוקד = שקר
        זה.סמן = אורך(טקסט)
        זה.בח_מ = -1
        זה.בח_ע = -1
        זה.בשינוי = ריק
        זה.באנטר = ריק
        זה.רדיוס = 6
        זה.מוסתר = שקר
    }
    פונקציה מקבל_מיקוד() {
        החזר אמת
    }
    פונקציה קבע_מיקוד(v) {
        זה.ממוקד = v
        אם (לא v) {
            זה.נקה_בחירה()
        }
        זה.בקש_רענון()
    }
    פונקציה אורך_טקסט() {
        אם (זה.טקסט == ריק או זה.טקסט == "") {
            החזר 0
        }
        החזר זה.טקסט.אורך()
    }
    פונקציה הגבל_סמן(i) {
        משתנה ל = זה.אורך_טקסט()
        אם (i < 0) {
            החזר 0
        }
        אם (i > ל) {
            החזר ל
        }
        החזר i
    }
    פונקציה יש_בחירה() {
        החזר זה.בח_מ >= 0 וגם זה.בח_ע >= 0 וגם זה.בח_מ != זה.בח_ע
    }
    פונקציה בחירה_ממוינת() {
        משתנה a = זה.בח_מ
        משתנה b = זה.בח_ע
        אם (a > b) {
            החזר [b, a]
        }
        החזר [a, b]
    }
    פונקציה נקה_בחירה() {
        זה.בח_מ = -1
        זה.בח_ע = -1
    }
    פונקציה בחר_הכל() {
        משתנה ל = זה.אורך_טקסט()
        אם (ל <= 0) {
            זה.נקה_בחירה()
            החזר ריק
        }
        זה.בח_מ = 0
        זה.בח_ע = ל
        זה.סמן = ל
        זה.בקש_רענון()
    }
    פונקציה קבע_טקסט(t) {
        אם (t == ריק) {
            t = ""
        }
        זה.טקסט = t
        זה.סמן = זה.אורך_טקסט()
        זה.נקה_בחירה()
        זה.בקש_רענון()
    }
    פונקציה קרא_טקסט() {
        אם (זה.טקסט == ריק) {
            החזר ""
        }
        החזר זה.טקסט
    }
    פונקציה קבע_מקום_שמור(t) {
        אם (t == ריק) {
            זה.מקום_שמור = ""
        } אחרת {
            זה.מקום_שמור = t
        }
        זה.בקש_רענון()
    }
    פונקציה דווח_שינוי() {
        אם (זה.בשינוי != ריק) {
            זה.בשינוי(זה.טקסט)
        }
    }
    פונקציה טקסט_לתצוגה() {
        אם (לא זה.מוסתר) {
            החזר זה.קרא_טקסט()
        }
        משתנה ל = זה.אורך_טקסט()
        משתנה s = ""
        משתנה i = 0
        כל_עוד (i < ל) {
            s = s + "•"
            i = i + 1
        }
        החזר s
    }
    פונקציה טקסט_נבחר() {
        אם (לא זה.יש_בחירה()) {
            החזר זה.קרא_טקסט()
        }
        משתנה ר = זה.בחירה_ממוינת()
        החזר זה.טקסט.חתוך(ר[0], ר[1])
    }
    פונקציה החלף_טווח(מ_א, מ_ב, t) {
        אם (t == ריק) {
            t = ""
        }
        t = t.החלף("\r\n", " ")
        t = t.החלף("\n", " ")
        t = t.החלף("\r", " ")
        משתנה ל = זה.אורך_טקסט()
        אם (מ_א < 0) {
            מ_א = 0
        }
        אם (מ_ב > ל) {
            מ_ב = ל
        }
        משתנה לפני = ""
        משתנה אחרי = ""
        אם (מ_א > 0) {
            לפני = זה.טקסט.חתוך(0, מ_א)
        }
        אם (מ_ב < ל) {
            אחרי = זה.טקסט.חתוך(מ_ב)
        }
        זה.טקסט = לפני + t + אחרי
        משתנה ל_t = 0
        אם (t != "") {
            ל_t = t.אורך()
        }
        זה.סמן = זה.הגבל_סמן(מ_א + ל_t)
        זה.נקה_בחירה()
        זה.בקש_רענון()
        זה.דווח_שינוי()
    }
    פונקציה החלף_בטקסט(t) {
        זה.החלף_טווח(0, זה.אורך_טקסט(), t)
    }
    פונקציה הכנס_בסמן(t) {
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            זה.החלף_טווח(ר[0], ר[1], t)
        } אחרת {
            זה.החלף_טווח(זה.סמן, זה.סמן, t)
        }
    }
    פונקציה מחק_אחורה() {
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            זה.החלף_טווח(ר[0], ר[1], "")
            החזר ריק
        }
        אם (זה.סמן <= 0) {
            החזר ריק
        }
        זה.החלף_טווח(זה.סמן - 1, זה.סמן, "")
    }
    פונקציה מחק_קדימה() {
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            זה.החלף_טווח(ר[0], ר[1], "")
            החזר ריק
        }
        אם (זה.סמן >= זה.אורך_טקסט()) {
            החזר ריק
        }
        זה.החלף_טווח(זה.סמן, זה.סמן + 1, "")
    }
    פונקציה העתק() {
        משתנה t = זה.טקסט_נבחר()
        אם (t != "") {
            לוח.כתוב(t)
        }
    }
    פונקציה הדבק() {
        משתנה t = לוח.קרא()
        אם (t == ריק) {
            t = ""
        }
        אם (t == "") {
            החזר ריק
        }
        זה.הכנס_בסמן(t)
    }
    פונקציה גזור() {
        זה.העתק()
        אם (זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            זה.החלף_טווח(ר[0], ר[1], "")
        } אחרת {
            זה.החלף_בטקסט("")
        }
    }
    פונקציה x_עוגן_טקסט() {
        החזר x_טקסט_ברכיב(זה, 8)
    }
    פונקציה caret_x(משטח) {
        משתנה תצוגה = זה.טקסט_לתצוגה()
        משתנה לפני = ""
        אם (זה.סמן > 0 וגם תצוגה != "") {
            לפני = תצוגה.חתוך(0, זה.סמן)
        }
        משתנה w_לפני = אומדן_רוחב_טקסט(משטח, לפני)
        משתנה pad = 8
        אם (הוא_ימין(זה.כיוון())) {
            // RTL: תחילת המחרוזת מימין — הסמן זז שמאלה כשגדל האינדקס
            החזר זה.x + זה.רחב - pad - w_לפני
        }
        החזר זה.x + pad + w_לפני
    }
    פונקציה סמן_ממיקום(משטח, mx) {
        משתנה תצוגה = זה.טקסט_לתצוגה()
        משתנה ל = זה.אורך_טקסט()
        אם (ל <= 0) {
            החזר 0
        }
        משתנה best = 0
        משתנה best_d = 99999
        משתנה i = 0
        כל_עוד (i <= ל) {
            משתנה שמור = זה.סמן
            זה.סמן = i
            משתנה cx = זה.caret_x(משטח)
            זה.סמן = שמור
            משתנה d = mx - cx
            אם (d < 0) {
                d = 0 - d
            }
            אם (d < best_d) {
                best_d = d
                best = i
            }
            i = i + 1
        }
        החזר best
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה מא = 28
        משתנה מי = 30
        משתנה מכ = 36
        אם (זה.ממוקד) {
            מא = 34
            מי = 38
            מכ = 48
        }
        אם (זה.מושבת) {
            מא = 26
            מי = 28
            מכ = 32
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, מא, מי, מכ)
        אם (זה.ממוקד) {
            משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
            מלבן_מעוגל_מלא(משטח, זה.x + 3, זה.y + זה.גבה - 2, זה.רחב - 6, 2, 1)
        }
        משטח.קבע_גודל_גופן(11)
        משתנה ty = זה.y + 7
        משתנה תצוגה = זה.טקסט_לתצוגה()
        משתנה יש_טקסט = תצוגה != "" וגם תצוגה != ריק
        אם (יש_טקסט וגם זה.יש_בחירה()) {
            משתנה ר = זה.בחירה_ממוינת()
            משתנה שמור = זה.סמן
            זה.סמן = ר[0]
            משתנה x0 = זה.caret_x(משטח)
            זה.סמן = ר[1]
            משתנה x1 = זה.caret_x(משטח)
            זה.סמן = שמור
            אם (x1 < x0) {
                משתנה tmp = x0
                x0 = x1
                x1 = tmp
            }
            משטח.קבע_מילוי(56, 120, 200)
            מלבן_מעוגל_מלא(משטח, x0 - 1, זה.y + 4, x1 - x0 + 2, זה.גבה - 8, 3)
        }
        אם (לא יש_טקסט) {
            אם (זה.מקום_שמור != "" וגם זה.מקום_שמור != ריק) {
                משטח.קבע_צבע(100, 108, 118)
                צייר_טקסט_ברכיב(משטח, זה, זה.מקום_שמור, ty, 8)
            }
        } אחרת {
            אם (זה.יש_בחירה()) {
                משטח.קבע_צבע(255, 255, 255)
            } אחרת {
                משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
            }
            צייר_טקסט_ברכיב(משטח, זה, תצוגה, ty, 8)
        }
        אם (זה.ממוקד וגם לא זה.יש_בחירה()) {
            משטח.קבע_צבע(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
            משתנה cx = זה.caret_x(משטח)
            אם (cx < זה.x + 4) {
                cx = זה.x + 4
            }
            אם (cx > זה.x + זה.רחב - 4) {
                cx = זה.x + זה.רחב - 4
            }
            משטח.קבע_עובי(1)
            משטח.קו(cx, זה.y + 5, cx, זה.y + זה.גבה - 5)
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        זה.ממוקד = אמת
        אם (זה.לוח != ריק) {
            זה.סמן = זה.סמן_ממיקום(זה.לוח.משטח, mx)
        } אחרת {
            זה.סמן = זה.אורך_טקסט()
        }
        זה.נקה_בחירה()
        זה.בקש_רענון()
        החזר אמת
    }
    פונקציה בעת_תו(תו) {
        אם (זה.מושבת או לא זה.ממוקד) {
            החזר ריק
        }
        אם (תו == ריק או תו == "") {
            החזר ריק
        }
        זה.הכנס_בסמן(תו)
    }
    פונקציה הזז_סמן(delta) {
        זה.סמן = זה.הגבל_סמן(זה.סמן + delta)
        זה.נקה_בחירה()
        זה.בקש_רענון()
    }
    פונקציה בעת_מקש(שם) {
        אם (זה.מושבת או לא זה.ממוקד) {
            החזר ריק
        }
        אם (שם == "מחיקה") {
            זה.מחק_אחורה()
        } אחרת_אם (שם == "מחק") {
            זה.מחק_קדימה()
        } אחרת_אם (שם == "בחר_הכל") {
            זה.בחר_הכל()
        } אחרת_אם (שם == "העתק") {
            זה.העתק()
        } אחרת_אם (שם == "הדבק") {
            זה.הדבק()
        } אחרת_אם (שם == "גזור") {
            זה.גזור()
        } אחרת_אם (שם == "אנטר") {
            זה.נקה_בחירה()
            אם (זה.באנטר != ריק) {
                זה.באנטר(זה.טקסט)
            }
        } אחרת_אם (שם == "בריחה") {
            זה.נקה_בחירה()
            זה.בקש_רענון()
        } אחרת_אם (שם == "התחלה") {
            זה.סמן = 0
            זה.נקה_בחירה()
            זה.בקש_רענון()
        } אחרת_אם (שם == "סוף") {
            זה.סמן = זה.אורך_טקסט()
            זה.נקה_בחירה()
            זה.בקש_רענון()
        } אחרת_אם (שם == "שמאלה") {
            זה.הזז_סמן(צעד_חץ_אופקי(זה.כיוון(), אמת))
        } אחרת_אם (שם == "ימינה") {
            זה.הזז_סמן(צעד_חץ_אופקי(זה.כיוון(), שקר))
        }
    }
}
