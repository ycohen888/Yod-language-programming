// קלט_טקסט.יוד — שדה הקלדה על משטח (בחירה, לוח, מחיקה חוזרת)

כלול "לוח"

מחלקה קלט_טקסט מרחיב רכיב
  פונקציה בנאי(x, y, רחב, טקסט)
    אם טקסט == ריק
      טקסט = ""
    סוף
    הורה(x, y, רחב, 28)
    זה.טקסט = טקסט
    זה.מקום_שמור = ""
    זה.ממוקד = שקר
    זה.בחירה = שקר
    זה.בשינוי = ריק
    זה.באנטר = ריק
    זה.רדיוס = 6
  סוף

  פונקציה מקבל_מיקוד()
    החזר אמת
  סוף

  פונקציה קבע_מיקוד(v)
    זה.ממוקד = v
    אם לא v
      זה.בחירה = שקר
    סוף
    זה.בקש_רענון()
  סוף

  פונקציה קבע_טקסט(t)
    אם t == ריק
      זה.טקסט = ""
    אחרת
      זה.טקסט = t
    סוף
    זה.בחירה = שקר
    זה.בקש_רענון()
  סוף

  פונקציה קרא_טקסט()
    אם זה.טקסט == ריק
      החזר ""
    סוף
    החזר זה.טקסט
  סוף

  פונקציה קבע_מקום_שמור(t)
    אם t == ריק
      זה.מקום_שמור = ""
    אחרת
      זה.מקום_שמור = t
    סוף
    זה.בקש_רענון()
  סוף

  פונקציה דווח_שינוי()
    אם זה.בשינוי != ריק
      זה.בשינוי(זה.טקסט)
    סוף
  סוף

  פונקציה בחר_הכל()
    אם זה.טקסט != "" וגם זה.טקסט != ריק
      זה.בחירה = אמת
      זה.בקש_רענון()
    סוף
  סוף

  פונקציה נקה_בחירה()
    אם זה.בחירה
      זה.בחירה = שקר
      זה.בקש_רענון()
    סוף
  סוף

  פונקציה החלף_בטקסט(t)
    אם t == ריק
      t = ""
    סוף
    // שדה בשורה אחת — בלי מעברי שורה
    t = t.החלף("\r\n", " ")
    t = t.החלף("\n", " ")
    t = t.החלף("\r", " ")
    זה.טקסט = t
    זה.בחירה = שקר
    זה.בקש_רענון()
    זה.דווח_שינוי()
  סוף

  פונקציה טקסט_נבחר()
    אם זה.בחירה
      החזר זה.קרא_טקסט()
    סוף
    החזר זה.קרא_טקסט()
  סוף

  פונקציה העתק()
    משתנה t = זה.טקסט_נבחר()
    אם t != ""
      לוח.כתוב(t)
    סוף
  סוף

  פונקציה הדבק()
    משתנה t = לוח.קרא()
    אם t == ריק
      t = ""
    סוף
    אם t == ""
      החזר ריק
    סוף
    אם זה.בחירה או זה.טקסט == "" או זה.טקסט == ריק
      זה.החלף_בטקסט(t)
    אחרת
      זה.החלף_בטקסט(זה.טקסט + t)
    סוף
  סוף

  פונקציה גזור()
    זה.העתק()
    זה.החלף_בטקסט("")
  סוף

  פונקציה מחק_אחורה()
    אם זה.בחירה
      זה.החלף_בטקסט("")
      החזר ריק
    סוף
    משתנה ל = זה.טקסט.אורך()
    אם ל > 0
      זה.טקסט = זה.טקסט.חתוך(0, ל - 1)
      זה.בקש_רענון()
      זה.דווח_שינוי()
    סוף
  סוף

  פונקציה מחק_קדימה()
    // סמן בסוף — Delete מוחק בחירה בלבד
    אם זה.בחירה
      זה.החלף_בטקסט("")
    סוף
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה מא = 28
    משתנה מי = 30
    משתנה מכ = 36
    אם זה.ממוקד
      מא = 34
      מי = 38
      מכ = 48
    סוף
    אם זה.מושבת
      מא = 26
      מי = 28
      מכ = 32
    סוף
    מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, מא, מי, מכ)
    אם זה.ממוקד
      משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
      מלבן_מעוגל_מלא(משטח, זה.x + 3, זה.y + זה.גבה - 2, זה.רחב - 6, 2, 1)
    סוף

    משטח.קבע_גודל_גופן(11)
    משתנה tx = זה.x + 8
    משתנה ty = זה.y + 7
    משתנה יש_טקסט = זה.טקסט != "" וגם זה.טקסט != ריק

    אם יש_טקסט וגם זה.בחירה
      משתנה sw = משטח.רוחב_טקסט(זה.טקסט)
      אם sw > זה.רחב - 16
        sw = זה.רחב - 16
      סוף
      משטח.קבע_מילוי(56, 120, 200)
      מלבן_מעוגל_מלא(משטח, tx - 2, זה.y + 4, sw + 4, זה.גבה - 8, 3)
    סוף

    אם לא יש_טקסט
      אם זה.מקום_שמור != "" וגם זה.מקום_שמור != ריק
        משטח.קבע_צבע(100, 108, 118)
        משטח.טקסט(זה.מקום_שמור, tx, ty)
      סוף
    אחרת
      אם זה.בחירה
        משטח.קבע_צבע(255, 255, 255)
      אחרת
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
      סוף
      משטח.טקסט(זה.טקסט, tx, ty)
    סוף

    אם זה.ממוקד וגם לא זה.בחירה
      משטח.קבע_צבע(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
      משתנה caret_x = tx
      אם יש_טקסט
        caret_x = tx + משטח.רוחב_טקסט(זה.טקסט)
        אם caret_x > זה.x + זה.רחב - 8
          caret_x = זה.x + זה.רחב - 8
        סוף
      סוף
      משטח.קבע_עובי(1)
      משטח.קו(caret_x, זה.y + 5, caret_x, זה.y + זה.גבה - 5)
    סוף
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.ממוקד = אמת
    זה.בחירה = שקר
    זה.בקש_רענון()
    החזר אמת
  סוף

  פונקציה בעת_תו(תו)
    אם זה.מושבת או לא זה.ממוקד
      החזר ריק
    סוף
    אם תו == ריק או תו == ""
      החזר ריק
    סוף
    אם זה.בחירה
      זה.החלף_בטקסט(תו)
    אחרת
      זה.החלף_בטקסט(זה.טקסט + תו)
    סוף
  סוף

  פונקציה בעת_מקש(שם)
    אם זה.מושבת או לא זה.ממוקד
      החזר ריק
    סוף
    אם שם == "מחיקה"
      זה.מחק_אחורה()
    אחרת_אם שם == "מחק"
      זה.מחק_קדימה()
    אחרת_אם שם == "בחר_הכל"
      זה.בחר_הכל()
    אחרת_אם שם == "העתק"
      זה.העתק()
    אחרת_אם שם == "הדבק"
      זה.הדבק()
    אחרת_אם שם == "גזור"
      זה.גזור()
    אחרת_אם שם == "אנטר"
      זה.נקה_בחירה()
      אם זה.באנטר != ריק
        זה.באנטר(זה.טקסט)
      סוף
    אחרת_אם שם == "בריחה"
      זה.נקה_בחירה()
    אחרת_אם שם == "התחלה" או שם == "סוף" או שם == "שמאלה" או שם == "ימינה"
      זה.נקה_בחירה()
    סוף
  סוף
סוף
