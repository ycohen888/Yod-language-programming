// AI.יוד — שחקן מחשב

פונקציה בטל_טיימר_AI()
  אם מזהה_AI != ריק
    טיימרים.עצור: מזהה_AI
    מזהה_AI = ריק
  סוף
סוף

פונקציה אולי_מהלך_מחשב()
  אם מצב_מסך != "משחק"
    החזר ריק
  סוף
  משתנה ש = שחקן_נוכחי()
  אם לא ש["מחשב"]
    החזר ריק
  סוף
  הודעה = "תור המחשב — חושב…"
  צייר_הכל()
  בטל_טיימר_AI()
  מזהה_AI = טיימרים.אחרי: 500, מהלך_מחשב
סוף

פונקציה מהלך_מחשב()
  מזהה_AI = ריק
  אם מצב_מסך != "משחק"
    החזר ריק
  סוף
  משתנה ש = שחקן_נוכחי()
  אם לא ש["מחשב"]
    החזר ריק
  סוף

  משתנה ר = אקראי() * 100
  אם ר < 14 וגם ש["מקדחה"] < 3 וגם ש["כסף"] > מחיר_מקדחה[ש["מקדחה"] + 1] + 700
    קנה_מקדחה: ש["מקדחה"] + 1
    סיים_תור()
    החזר ריק
  סוף
  אם ר < 22 וגם לא ש["גלאי"] וגם ש["כסף"] > מחיר_גלאי + 900
    קנה_גלאי()
    סיים_תור()
    החזר ריק
  סוף
  אם ר < 28 וגם לא ש["משאית"] וגם ש["כסף"] > מחיר_משאית + 1100
    קנה_משאית()
    סיים_תור()
    החזר ריק
  סוף
  אם ר < 34 וגם ש["פועלים"] < 4 וגם ש["כסף"] > עלות_פועל + 800
    גייס_פועל()
    סיים_תור()
    החזר ריק
  סוף
  אם שורות_פתוחות < גודל_לוח וגם ר < 14 וגם ש["כסף"] > עלות_הרחבה + 1000
    הרחב_לוח()
    סיים_תור()
    החזר ריק
  סוף

  משתנה יעד_x = 0 - 1
  משתנה יעד_y = 0 - 1
  משתנה ציון_מקס = 0 - 100000
  משתנה y = 0
  כל_עוד y < שורות_פתוחות
    משתנה x = 0
    כל_עוד x < גודל_לוח
      משתנה ת = תא_ב(x, y)
      אם לא ת["חפור"]
        משתנה עלות = עלות_תא(ת)
        אם ש["כסף"] >= עלות
          // מעדיף רווח נטו גבוה (ערך אחרי מכירה פחות מחיר)
          משתנה צפי = ת["ערך"]
          אם ש["משאית"]
            צפי = (צפי * 125 / 100).שלם()
          סוף
          משתנה ציון = צפי - עלות + אקראי_בין: 0, 40
          // לא לקנות ריק אם יש חלופות טובות — ריק מקבל ציון נמוך
          אם ת["ערך"] <= 0
            ציון = 0 - עלות + אקראי_בין: 0, 10
          סוף
          אם ציון > ציון_מקס
            ציון_מקס = ציון
            יעד_x = x
            יעד_y = y
          סוף
        סוף
      סוף
      x = x + 1
    סוף
    y = y + 1
  סוף

  אם יעד_x >= 0
    חפור_בתא: יעד_x, יעד_y
  אחרת
    אם ש["כסף"] >= עלות_פועל
      גייס_פועל()
    סוף
    סיים_תור()
  סוף
סוף
