// תיבת_סימון.יוד — תיבת סימון מצוירת

מחלקה תיבת_סימון מרחיב רכיב
  פונקציה בנאי(x, y, טקסט, מסומן)
    הורה(x, y, 200, 26)
    זה.טקסט = טקסט
    זה.מסומן = מסומן
    זה.בשינוי = ריק
    זה.גודל_תיבה = 18
  סוף

  פונקציה קבע_מסומן(v)
    זה.מסומן = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה bx = זה.x
    משתנה by = זה.y + (זה.גבה - זה.גודל_תיבה) / 2
    משטח.קבע_מילוי(36, 38, 42)
    משטח.מלבן_מלא(bx, by, זה.גודל_תיבה, זה.גודל_תיבה)
    משטח.קבע_צבע(90, 96, 104)
    משטח.קבע_עובי(1)
    משטח.מלבן(bx, by, זה.גודל_תיבה, זה.גודל_תיבה)
    אם זה.מסומן
      משטח.קבע_מילוי(78, 201, 176)
      משטח.מלבן_מלא(bx + 4, by + 4, זה.גודל_תיבה - 8, זה.גודל_תיבה - 8)
    סוף
    משטח.קבע_צבע(210, 214, 220)
    משטח.קבע_גודל_גופן(13)
    משטח.טקסט(זה.טקסט, bx + זה.גודל_תיבה + 10, זה.y + 5)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.מסומן
      זה.מסומן = שקר
    אחרת
      זה.מסומן = אמת
    סוף
    זה.בקש_רענון()
    אם זה.בשינוי != ריק
      זה.בשינוי(זה.מסומן)
    סוף
    החזר אמת
  סוף
סוף
