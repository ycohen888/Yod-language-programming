// ממשק.יוד — חלון, לחיצות עכבר ומצבי מסך

פונקציה נקודה_במלבן mx, my, x, y, רחב, גבה
  אם mx < x או my < y
    החזר שקר
  סוף
  אם mx > x + רחב או my > y + גבה
    החזר שקר
  סוף
  החזר אמת
סוף

פונקציה על_לחיצה mx, my, כפתור
  אם מצב_מסך == "תפריט"
    אם נקודה_במלבן(mx, my, 150, 230, 200, 44)
      התחל_משחק: שקר
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 370, 230, 200, 44)
      התחל_משחק: אמת
      החזר ריק
    סוף
    החזר ריק
  סוף

  אם מצב_מסך == "דוח"
    אם נקודה_במלבן(mx, my, 480, 370, 140, 36)
      המשך_אחרי_דוח()
    סוף
    החזר ריק
  סוף

  אם מצב_מסך == "ניצחון"
    אם נקודה_במלבן(mx, my, 220, 270, 200, 40)
      בטל_טיימר_AI()
      מצב_מסך = "תפריט"
      הודעה = "בחרו מצב משחק"
      צייר_הכל()
    סוף
    החזר ריק
  סוף

  אם מצב_מסך == "חנות"
    אם נקודה_במלבן(mx, my, 120, 290, 160, 36)
      אם קנה_מקדחה(1)
        מצב_מסך = "משחק"
        סיים_תור()
      אחרת
        צייר_הכל()
      סוף
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 300, 290, 180, 36)
      אם קנה_מקדחה(2)
        מצב_מסך = "משחק"
        סיים_תור()
      אחרת
        צייר_הכל()
      סוף
      החזר ריק
    סוף
    אם נקודה_במלבן(mx, my, 500, 290, 120, 36)
      מצב_מסך = "משחק"
      צייר_הכל()
    סוף
    החזר ריק
  סוף

  אם מצב_מסך != "משחק"
    החזר ריק
  סוף

  משתנה ש = שחקן_נוכחי()
  אם ש["מחשב"]
    החזר ריק
  סוף

  משתנה py = גובה_כותרת + שולי_לוח + גודל_לוח * גודל_תא + 10
  אם נקודה_במלבן(mx, my, שולי_לוח + 12, py + 50, 110, 28)
    מצב_מסך = "חנות"
    צייר_הכל()
    החזר ריק
  סוף
  אם נקודה_במלבן(mx, my, שולי_לוח + 136, py + 50, 130, 28)
    אם גייס_פועל()
      סיים_תור()
    אחרת
      צייר_הכל()
    סוף
    החזר ריק
  סוף
  אם נקודה_במלבן(mx, my, שולי_לוח + 280, py + 50, 130, 28)
    אם הרחב_לוח()
      סיים_תור()
    אחרת
      צייר_הכל()
    סוף
    החזר ריק
  סוף

  משתנה בסיס_x = שולי_לוח
  משתנה בסיס_y = גובה_כותרת + שולי_לוח
  אם mx >= בסיס_x וגם my >= בסיס_y
    משתנה cx = ((mx - בסיס_x) / גודל_תא).שלם()
    משתנה cy = ((my - בסיס_y) / גודל_תא).שלם()
    אם cx >= 0 וגם cy >= 0 וגם cx < גודל_לוח וגם cy < גודל_לוח
      חפור_בתא: cx, cy
    סוף
  סוף
סוף

פונקציה בנה_מכרות()
  משתנה ח = חלונות.חלון: כותרת_משחק
  ח.קבע_גודל: רוחב_לוח_ציור + 28, גובה_לוח_ציור + 52
  ח.קבע_כהה: אמת
  ח.קבע_רקע: רקע_א, רקע_י, רקע_כ

  לוח = חלונות.משטח: רוחב_לוח_ציור, גובה_לוח_ציור
  לוח.קבע_נעילת_גובה: אמת
  לוח.קבע_נעילת_רוחב: אמת
  לוח.קבע_מתיחה: 0
  לוח.בעכבר_למטה: על_לחיצה

  ח.הוסף: לוח
  ח.בהתחלה: פונקציה ()
    מצב_מסך = "תפריט"
    צייר_הכל()
    לוח.בקש_מיקוד()
  סוף
  החזר ח
סוף
