// אזור_טקסט.יוד — קלט רב־שורות
כלול "פקד.יוד"

מחלקה אזור_טקסט מרחיב פקד {
    פונקציה בנאי(רמז = "", שורות = 4, מזהה = "") {
        אם (רמז == ריק) {
            רמז = ""
        }
        אם (שורות == ריק או שורות < 1) {
            שורות = 4
        }
        הורה(מזהה)
        זה.רמז = רמז
        זה.שורות = שורות
        זה.ערך = ""
        זה._שינוי = ריק
        זה._צור("אזור_טקסט", {
            "רמז": רמז,
            "שורות": שורות,
            "ערך": ""
        })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה.טקסט = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה קבע_רמז(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.רמז = ט
        זה._שלח_פקודה("קבע_רמז", { "רמז": ט })
    }

    פונקציה קבע_שורות(מספר) {
        אם (מספר == ריק או מספר < 1) {
            מספר = 4
        }
        זה.שורות = מספר
        זה._שלח_פקודה("קבע_שורות", { "שורות": מספר })
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
