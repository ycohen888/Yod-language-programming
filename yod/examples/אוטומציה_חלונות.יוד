# דוגמה: אוטומציה — רשימת חלונות והמתנה (Windows)
כלול "אוטומציה"

משתנה רשימה = אוטומציה.רשימת_חלונות("*")
הדפס("חלונות גלויים: " + רשימה.גודל())

משתנה i = 0
כל_עוד (i < רשימה.גודל() וגם i < 5)
  משתנה ח = רשימה[i]
  הדפס("  " + ח["כותרת"])
  i = i + 1
סוף

# המתן עד 2 שניות לחלון שמכיל "Notepad" / "פתק"
משתנה נ = אוטומציה.המתן_עד_חלון("*Notepad*", 2000)
אם נ != ריק
  הדפס("נמצא: " + נ["כותרת"])
  אוטומציה.הפעל_חלון(נ)
  אוטומציה.המתן(300)
  אוטומציה.קיצור(["בקרה", "s"])
סוף

אוטומציה.צלם_מסך_לקובץ("צילום_אוטומציה.jpg")
