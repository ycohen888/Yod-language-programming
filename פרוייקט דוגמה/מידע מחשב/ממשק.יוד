// ממשק.יוד — לוח בקרה כהה · כותרת ורכיבי משטח + גרפים/טבלה

פונקציה צבע_תוויות()
  אם תווית_תהליכים_כ != ריק
    תווית_תהליכים_כ.קבע_צבע: 230, 237, 243
  סוף
  אם תווית_סיכום != ריק
    תווית_סיכום.קבע_צבע: 148, 163, 184
  סוף
  אם תווית_סינון != ריק
    תווית_סינון.קבע_צבע: 148, 163, 184
  סוף
סוף

פונקציה ייצא_תהליכים()
  משתנה נתיב = חלונות.בחר_שמירה("שמירת תהליכים כ־CSV")
  אם נתיב == ריק
    החזר ריק
  סוף
  רשימת_תה.ייצא_csv: נתיב
  חלונות.הודעה: "ייצוא", "הקובץ נשמר:\n" + נתיב
סוף

פונקציה סנן_תהליכים()
  רשימת_תה.סנן: שדה_סינון.קרא_טקסט()
סוף

פונקציה בנה_חלון_מידע()
  משתנה ח = חלונות.חלון: "מידע מחשב · יוד"
  ח.קבע_גודל: 1180, 920
  ח.קבע_כהה: אמת

  ח.קבע_תפריט: [
    {
      "שם": "קובץ",
      "פריטים": [
        {"שם": "רענון", "פעולה": רענן_מידע},
        {"שם": "ייצוא CSV…", "פעולה": ייצא_תהליכים},
        {"שם": "-"},
        {"שם": "יציאה", "פעולה": סגור_חלון_הודעה}
      ]
    }
  ]

  // —— כותרת ברכיבי משטח ——
  לוח_כותרת = חדש לוח_רכיבים: 1140, 78
  לוח_כותרת.רקע_א = 22
  לוח_כותרת.רקע_י = 27
  לוח_כותרת.רקע_כ = 34

  תווית_מותג = חדש תווית_ציור: 16, 12, "מידע מחשב"
  תווית_מותג.קבע_צבע_rgb(56, 189, 248)
  תווית_מותג.גודל = 15
  לוח_כותרת.הוסף(תווית_מותג)

  תג_מצב = חדש תג: 130, 12, "חי"
  לוח_כותרת.הוסף(תג_מצב)

  נור_מצב = חדש נורית: 190, 14, "מחובר", אמת
  לוח_כותרת.הוסף(נור_מצב)

  תווית_כותרת = חדש תווית_ציור: 16, 38, "טוען…"
  תווית_כותרת.קבע_צבע_rgb(160, 168, 178)
  לוח_כותרת.הוסף(תווית_כותרת)

  תווית_עלייה = חדש תווית_ציור: 520, 14, "…"
  תווית_עלייה.קבע_צבע_rgb(167, 243, 208)
  לוח_כותרת.הוסף(תווית_עלייה)

  תווית_התראה = חדש תווית_ציור: 520, 40, ""
  תווית_התראה.קבע_צבע_rgb(251, 146, 60)
  לוח_כותרת.הוסף(תווית_התראה)

  פס_מעבד = חדש פס_התקדמות: 900, 18, 200, 0
  לוח_כותרת.הוסף(פס_מעבד)
  טבעת_זיכרון = חדש מחוון_טבעת: 1080, 12, 48, 0
  לוח_כותרת.הוסף(טבעת_זיכרון)
  לוח_כותרת.רענון()

  // —— גרפים ——
  גרף_מעבד = גרפים.קו()
  גרף_מעבד.קבע_כותרת: "מעבד"
  גרף_מעבד.קבע_תת_כותרת: "טוען…"
  גרף_מעבד.קבע_ציר_Y: "%"
  גרף_מעבד.קבע_טווח_Y: 0, 100
  גרף_מעבד.קבע_מקרא: שקר
  גרף_מעבד.קבע_גובה: 260

  גרף_זיכרון = גרפים.עוגה()
  גרף_זיכרון.קבע_כותרת: "זיכרון"
  גרף_זיכרון.קבע_תת_כותרת: "טוען…"
  גרף_זיכרון.קבע_גובה: 260

  משתנה שורת_גרפים = חלונות.מסגרת: "אופקי"
  שורת_גרפים.הוסף: גרף_מעבד
  שורת_גרפים.הוסף: גרף_זיכרון

  גרף_כוננים = גרפים.עמודות()
  גרף_כוננים.קבע_כותרת: "כוננים"
  גרף_כוננים.קבע_תת_כותרת: "טוען…"
  גרף_כוננים.קבע_ציר_Y: "מגה"
  גרף_כוננים.קבע_גובה: 220

  משתנה כרטיס_כוננים = חלונות.מסגרת: "אנכי"
  כרטיס_כוננים.קבע_רקע: 22, 27, 34
  כרטיס_כוננים.הוסף: גרף_כוננים

  // —— סרגל פעולות ברכיבי משטח ——
  לוח_פעולות = חדש לוח_רכיבים: 1140, 44
  לוח_פעולות.רקע_א = 30
  לוח_פעולות.רקע_י = 37
  לוח_פעולות.רקע_כ = 46

  משתנה כפ_רענון = חדש כפתור_משטח: 12, 8, 90, 28, "רענון"
  כפ_רענון.קבע_ראשי(אמת)
  כפ_רענון.בלחיצה = פונקציה ()
    רענן_מידע()
  סוף
  לוח_פעולות.הוסף(כפ_רענון)

  משתנה כפ_סיום = חדש כפתור_משטח: 112, 8, 110, 28, "סיים תהליך"
  כפ_סיום.בלחיצה = פונקציה ()
    סיים_נבחר()
  סוף
  לוח_פעולות.הוסף(כפ_סיום)

  משתנה כפ_ייצוא = חדש כפתור_משטח: 232, 8, 70, 28, "CSV"
  כפ_ייצוא.בלחיצה = פונקציה ()
    ייצא_תהליכים()
  סוף
  לוח_פעולות.הוסף(כפ_ייצוא)

  משתנה כפ_סנן = חדש כפתור_משטח: 560, 8, 70, 28, "סנן"
  כפ_סנן.בלחיצה = פונקציה ()
    סנן_תהליכים()
  סוף
  לוח_פעולות.הוסף(כפ_סנן)
  לוח_פעולות.רענון()

  // —— תהליכים (טבלה + שדה הקלדה נשארים Win32) ——
  תווית_תהליכים_כ = חלונות.תווית: "תהליכים"
  תווית_סיכום = חלונות.תווית: "טוען…"
  תווית_סינון = חלונות.תווית: "סינון:"
  שדה_סינון = חלונות.שדה: ""
  שדה_סינון.קבע_רמז: "הקלדו חלק משם תהליך"

  רשימת_תה = חלונות.טבלה()
  רשימת_תה.קבע_שדות: [
    {"שם": "שם", "רוחב": 280},
    {"שם": "מזהה", "רוחב": 90},
    {"שם": "זיכרון", "רוחב": 140},
    {"שם": "נתיב", "רוחב": 360}
  ]
  רשימת_תה.קבע_גובה: 260

  משתנה סרגל_סינון = חלונות.מסגרת: "אופקי"
  סרגל_סינון.קבע_רקע: 30, 37, 46
  סרגל_סינון.הוסף: תווית_סינון
  סרגל_סינון.הוסף: שדה_סינון

  משתנה כרטיס_תהליכים = חלונות.מסגרת: "אנכי"
  כרטיס_תהליכים.קבע_רקע: 22, 27, 34
  כרטיס_תהליכים.הוסף: תווית_תהליכים_כ
  כרטיס_תהליכים.הוסף: תווית_סיכום
  כרטיס_תהליכים.הוסף: לוח_פעולות.משטח_גלוי()
  כרטיס_תהליכים.הוסף: סרגל_סינון
  כרטיס_תהליכים.הוסף: רשימת_תה

  ח.הוסף: לוח_כותרת.משטח_גלוי()
  ח.הוסף: שורת_גרפים
  ח.הוסף: כרטיס_כוננים
  ח.הוסף: כרטיס_תהליכים

  צבע_תוויות()

  ח.בהתחלה: פונקציה ()
    צבע_תוויות()
    רענן_מידע()
    מזהה_טיימר = טיימרים.כל_כמה: 2, רענן_מידע
  סוף

  ח.הצג()
סוף

פונקציה סגור_חלון_הודעה()
  חלונות.הודעה: "יציאה", "סגרו את החלון עם כפתור ×"
סוף
