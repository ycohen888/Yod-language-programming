// כרטיס.יוד — מסגרת כותרת + אזור תוכן; כותרת בצד ההתחלה
מחלקה כרטיס מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, גבה, כותרת) {
        אם (כותרת == ריק) {
            כותרת = ""
        }
        הורה(x, y, רחב, גבה)
        זה.כותרת = כותרת
        זה.רדיוס = 8
        זה.גובה_כותרת = 28
    }
    פונקציה קבע_כותרת(t) {
        אם (t == ריק) {
            t = ""
        }
        זה.כותרת = t
        זה.בקש_רענון()
    }
    פונקציה מכיל(mx, my) {
        החזר שקר
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, ערכה_משטח_א, ערכה_משטח_י, ערכה_משטח_כ)
        אם (זה.כותרת != "" וגם זה.כותרת != ריק) {
            משטח.קבע_מילוי(28, 30, 36)
            מלבן_מעוגל_מלא(משטח, זה.x + 1, זה.y + 1, זה.רחב - 2, זה.גובה_כותרת, זה.רדיוס - 1)
            משטח.קבע_צבע(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
            משטח.קבע_גודל_גופן(12)
            צייר_טקסט_ברכיב(משטח, זה, זה.כותרת, זה.y + 8, 12)
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        החזר שקר
    }
}
