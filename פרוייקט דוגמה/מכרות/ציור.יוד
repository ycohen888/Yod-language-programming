          לוח.מלבן: px + מרווח_תאים, py + מרווח_תאים, גודל_תא - מרווח_תאים * 2, גודל_תא - מרווח_תאים * 2
        אחרת
          צייר_שטח_פתוח: px, py, ת["שטח"]

          // דירוג מחיר — מסגרת עדינה
