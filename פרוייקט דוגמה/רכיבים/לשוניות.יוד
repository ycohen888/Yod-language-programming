// לשוניות.יוד — סרגל לשוניות לבחירת עמוד

מחלקה לשוניות מרחיב רכיב
  פונקציה בנאי(x, y, רחב, שמות)
    הורה(x, y, רחב, 36)
    זה.שמות = שמות
    זה.נבחר = 0
    זה.בשינוי = ריק
  סוף

  פונקציה קבע_נבחר(i)
    אם i < 0 או i >= אורך(זה.שמות)
      החזר ריק
    סוף
    זה.נבחר = i
    זה.בקש_רענון()
    אם זה.בשינוי != ריק
      זה.בשינוי(i, זה.שמות[i])
    סוף
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משטח.קבע_מילוי(26, 28, 34)
    מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 10)
    משתנה n = אורך(זה.שמות)
    אם n <= 0
      החזר ריק
    סוף
    משתנה tw = זה.רחב / n
    משתנה i = 0
    כל_עוד i < n
      משתנה tx = זה.x + i * tw
      אם i == זה.נבחר
        משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
        מלבן_מעוגל_מלא(משטח, tx + 3, זה.y + 3, tw - 6, זה.גבה - 6, 8)
        משטח.קבע_צבע(240, 250, 248)
      אחרת
        משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
      סוף
      משטח.קבע_גודל_גופן(13)
      משטח.טקסט(זה.שמות[i], tx + 14, זה.y + 10)
      i = i + 1
    סוף
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    משתנה n = אורך(זה.שמות)
    אם n <= 0
      החזר אמת
    סוף
    משתנה tw = זה.רחב / n
    משתנה i = ((mx - זה.x) / tw).שלם()
    אם i < 0
      i = 0
    סוף
    אם i >= n
      i = n - 1
    סוף
    זה.קבע_נבחר(i)
    החזר אמת
  סוף
סוף
