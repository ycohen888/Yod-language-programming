// אקורדיון.יוד — Accordion
כלול "פקד.יוד"

מחלקה אקורדיון מרחיב פקד {
    פונקציה בנאי(פריטים, מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה._צור("אקורדיון", {
            "פריטים": פריטים
        })
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }
}
