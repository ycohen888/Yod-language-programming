// יכולות חדשות — מפה/סנן, טווח, אקראי, JSON, זמן

משתנה מספרים = [10, 2, 30, 2]
מספרים.מיין
הדפס: "ממוין: " + מספרים.הצטרף(", ")

משתנה כפולים = מספרים.מפה(פונקציה(x)
  החזר x * 2
סוף)
הדפס: "מפה ×2: " + כפולים.הצטרף(", ")

משתנה גדולים = מספרים.סנן(פונקציה(x)
  החזר x >= 10
סוף)
הדפס: "סנן >=10: " + גדולים.הצטרף(", ")

הדפס: "מצא: " + מספרים.מצא(פונקציה(x)
  החזר x == 30
סוף)

הדפס: "ייחודי: " + [1, 2, 2, 3].ייחודי().הצטרף(",")
הדפס: "שטח: " + [[1, 2], [3]].שטח().הצטרף(",")

עבור i בתוך טווח(3)
  הדפס: "טווח " + i
סוף

הדפס: "אקראי_בין: " + אקראי_בין(1, 6)
הדפס: "פורמט: " + "שלום {0}, גיל {1}".פורמט("נועם", 30)
הדפס: "התאם ספרות? " + "abc123".התאם("\\d+")
הדפס: "שם קובץ: " + "תיקיה/קובץ.יוד".שם_קובץ()

כלול "JSON"
משתנה נתונים = JSON.פרסר("{\"שם\":\"יוד\",\"גרסה\":0.34}")
הדפס: "JSON שם: " + נתונים.שם
הדפס: "JSON מחרוזת: " + JSON.מחרוזת(נתונים)

כלול "זמן"
הדפס: "עכשיו: " + זמן.עכשיו()
הדפס: "תאריך: " + זמן.תאריך()
