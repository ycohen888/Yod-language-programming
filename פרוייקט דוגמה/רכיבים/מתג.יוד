// מתג.יוד — מתג הפעלה מעוגל בסגנון iOS

מחלקה מתג מרחיב רכיב
  פונקציה בנאי(x, y, דלוק)
    הורה(x, y, 54, 30)
    זה.דלוק = דלוק
    זה.בשינוי = ריק
  סוף

  פונקציה קבע_דלוק(v)
    זה.דלוק = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה מא = 55
    משתנה מי = 58
    משתנה מכ = 66
    אם זה.דלוק
      מא = ערכה_ראשי_א
      מי = ערכה_ראשי_י
      מכ = ערכה_ראשי_כ
    סוף
    משטח.קבע_מילוי(מא, מי, מכ)
    מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2)
    משתנה kr = (זה.גבה - 8) / 2
    משתנה kx = זה.x + 4 + kr
    אם זה.דלוק
      kx = זה.x + זה.רחב - 4 - kr
    סוף
    משטח.קבע_מילוי(16, 18, 22)
    משטח.עיגול_מלא(kx + 1, זה.y + זה.גבה / 2 + 1, kr)
    משטח.קבע_מילוי(245, 247, 250)
    משטח.עיגול_מלא(kx, זה.y + זה.גבה / 2, kr)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.דלוק
      זה.דלוק = שקר
    אחרת
      זה.דלוק = אמת
    סוף
    זה.בקש_רענון()
    אם זה.בשינוי != ריק
      זה.בשינוי(זה.דלוק)
    סוף
    החזר אמת
  סוף
סוף
