// פס_התקדמות.יוד — פס התקדמות מעוגל

מחלקה פס_התקדמות מרחיב רכיב
  פונקציה בנאי(x, y, רחב, אחוז)
    הורה(x, y, רחב, 12)
    זה.אחוז = הגבל(אחוז, 0, 100)
  סוף

  פונקציה קבע_אחוז(v)
    זה.אחוז = הגבל(v, 0, 100)
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משטח.קבע_מילוי(40, 44, 52)
    מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2)
    משתנה מלא = זה.רחב * זה.אחוז / 100
    אם מלא >= זה.גבה
      משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
      מלבן_מעוגל_מלא(משטח, זה.x, זה.y, מלא, זה.גבה, זה.גבה / 2)
      קו_עליון_רך(משטח, זה.x, זה.y, מלא, זה.גבה, זה.גבה / 2, 90, 220, 200)
    סוף
  סוף
סוף
