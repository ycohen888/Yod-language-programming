// ממשק.יוד — בניית החלון והממשק (ספריית עיצוב) + מטפלי אירועים
כלול "חלונות"
כלול "קבצים"
כלול "מערכת"

// ——— מצב גלובלי ———
משתנה חלון_ראשי = ריק
משתנה דפדפן_עיצוב = ריק
משתנה נושא_ממשק = "כהה"
משתנה ממשק_מוכן = שקר

משתנה רשת_מטלות = ריק
משתנה שדה_כותרת = ריק
משתנה בחירת_עדיפות = ריק
משתנה תווית_סטטוס = ריק
משתנה פס_סטטוס = ריק
משתנה טוסט = ריק
משתנה סרגל = ריק
משתנה תיקיית_פרויקט_מטלות = ""

פונקציה תיקיית_פרויקט() {
    משתנה תיק = מערכת.תיקיית_הרצה()
    אם (תיק == ריק או תיק == "") {
        תיק = מערכת.תיקייה()
    }
    אם (קבצים.קיים(תיק + "\\ממשק.יוד") או קבצים.קיים(תיק + "\\app.ico") או קבצים.קיים(תיק + "\\לוגו.png")) {
        החזר תיק
    }
    אם (קבצים.קיים(תיק + "\\מטלות\\ממשק.יוד")) {
        החזר תיק + "\\מטלות"
    }
    החזר תיק
}

פונקציה לנתיב_file(נתיב) {
    משתנה פ = "" + נתיב
    פ = פ.החלף("\\", "/")
    החזר "file:///" + פ
}

פונקציה נתיב_לוגו_מטלות() {
    משתנה תיק = תיקיית_פרויקט_מטלות
    אם (תיק == "" או תיק == ריק) {
        תיק = תיקיית_פרויקט()
    }
    אם (קבצים.קיים(תיק + "\\לוגו.png")) {
        החזר לנתיב_file(תיק + "\\לוגו.png")
    }
    אם (קבצים.קיים(תיק + "\\נכסים\\לוגו.png")) {
        החזר לנתיב_file(תיק + "\\נכסים\\לוגו.png")
    }
    החזר ""
}

// ——— בניית החלון (Bootstrap של WebView) ———
פונקציה בנה_חלון_מטלות() {
    משתנה ח = חלונות.חלון("מנהל מטלות")
    חלון_ראשי = ח
    // גודל קבוע שמתאים לפקדים (לא רוחב מסך מלא)
    ח.קבע_גודל(720, 560)
    ח.מרכז()
    ח.קבע_כהה(נושא_ממשק == "כהה")
    אם (נושא_ממשק == "כהה") {
        ח.קבע_רקע(14, 17, 22)
    } אחרת {
        ח.קבע_רקע(245, 247, 250)
    }

    תיקיית_פרויקט_מטלות = תיקיית_פרויקט()
    נסה {
        אם (קבצים.קיים(תיקיית_פרויקט_מטלות + "\\app.ico")) {
            ח.קבע_איקון(תיקיית_פרויקט_מטלות + "\\app.ico")
        } אחרת_אם (קבצים.קיים(תיקיית_פרויקט_מטלות + "\\נכסים\\app.ico")) {
            ח.קבע_איקון(תיקיית_פרויקט_מטלות + "\\נכסים\\app.ico")
        }
    } תפוס שגיאה {
    }

    דפדפן_עיצוב = חלונות.דפדפן()
    נסה {
        דפדפן_עיצוב.קבע_מתיחה(-1)
    } תפוס שגיאה {
    }

    // איתור תיקיית ספריית העיצוב (יחסית לתיקיית ההרצה / הפרויקט)
    משתנה תיק = תיקיית_פרויקט_מטלות
    אם (תיק == ריק או תיק == "") {
        תיק = מערכת.תיקיית_הרצה()
        אם (תיק == ריק או תיק == "") {
            תיק = מערכת.תיקייה()
        }
    }
    משתנה תיק_עיצוב = תיק + "\\עיצוב"
    אם (לא קבצים.קיים(תיק_עיצוב) או לא קבצים.האם_תיקייה(תיק_עיצוב)) {
        תיק_עיצוב = תיק + "\\..\\עיצוב"
    }
    אם (לא קבצים.קיים(תיק_עיצוב) או לא קבצים.האם_תיקייה(תיק_עיצוב)) {
        תיק_עיצוב = תיק + "\\..\\..\\פרוייקט דוגמה\\עיצוב"
    }
    אם (לא קבצים.קיים(תיק_עיצוב) או לא קבצים.האם_תיקייה(תיק_עיצוב)) {
        תיק_עיצוב = מערכת.תיקייה() + "\\פרוייקט דוגמה\\עיצוב"
    }

    עיצוב_פתח(דפדפן_עיצוב, תיק_עיצוב)
    עיצוב_בעת_מוכן(פונקציה() {
        נסה {
            בנה_ממשק_עיצוב()
        } תפוס שגיאה {
        }
    })

    ח.הוסף(דפדפן_עיצוב)
    ח.הצג()
}

