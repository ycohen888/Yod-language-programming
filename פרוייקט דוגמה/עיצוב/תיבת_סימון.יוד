// תיבת_סימון.יוד — Checkbox
כלול "פקד.יוד"

מחלקה תיבת_סימון מרחיב פקד {
    פונקציה בנאי(טקסט, מסומן = שקר, מזהה = "") {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        אם (מסומן == ריק) {
            מסומן = שקר
        }
        הורה(מזהה)
        זה.טקסט = טקסט
        זה.מסומן = מסומן
        זה.ערך = מסומן
        זה._שינוי = ריק
        זה._צור("תיבת_סימון", {
            "טקסט": טקסט,
            "מסומן": מסומן
        })
    }

    פונקציה קבע_מסומן(ערך) {
        זה.מסומן = ערך
        זה.ערך = ערך
        זה._שלח_פקודה("קבע_מסומן", { "מסומן": ערך })
    }

    פונקציה האם_מסומן() {
        החזר זה.מסומן
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
