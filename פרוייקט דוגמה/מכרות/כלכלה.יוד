    אם (שטח == 0) {
        אם (ר < 30) {
            החזר 2
        }
        החזר 1
    }
    אם (שטח == 1) {
        אם (ר < 45) {
            החזר 2
        }
        אם (ר < 85) {
            החזר 1
        }
        החזר 3
    }
    אם (שטח == 2) {
        אם (ר < 35) {
            החזר 3
        }
        אם (ר < 80) {
            החזר 2
        }
        החזר 1
    }
    אם (ר < 40) {
        החזר 2
    }
    החזר 1
}

פונקציה גלגל_סוג_יבשה(שטח) {
