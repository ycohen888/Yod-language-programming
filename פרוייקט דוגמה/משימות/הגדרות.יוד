// הגדרות.יוד — כותרת, גודל, נתיבים וצבעי עדיפות
משתנה כותרת_חלון = "משימות · יוד"

משתנה רוחב_חלון = 760

משתנה גובה_חלון = 640

משתנה תיקיית_נתונים = "נתונים"

משתנה שם_קובץ_נתונים = "משימות.json"

משתנה גובה_שורה = 44

משתנה רווח_שורה = 8

משתנה עדיפות_נוכחית = "רגילה"

פונקציה נתיב_נתונים() {
    החזר קבצים.צרף(תיקיית_נתונים, שם_קובץ_נתונים)
}

פונקציה צבע_עדיפות(שם) {
    אם (שם == "גבוהה") {
        החזר [251, 146, 60]
    }
    אם (שם == "נמוכה") {
        החזר [100, 108, 118]
    }
    החזר [ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ]
}

פונקציה תווית_עדיפות(שם) {
    אם (שם == "גבוהה") {
        החזר "גבוהה"
    }
    אם (שם == "נמוכה") {
        החזר "נמוכה"
    }
    החזר "רגילה"
}
