// רשימת_בחירה.יוד — רשימת פריטים לבחירה יחידה

מחלקה רשימת_בחירה מרחיב רכיב
  פונקציה בנאי(x, y, רחב, פריטים)
    הורה(x, y, רחב, 8 + אורך(פריטים) * 30)
    זה.פריטים = פריטים
    זה.נבחר = 0
    זה.גובה_שורה = 30
    זה.בשינוי = ריק
  סוף

  פונקציה קבע_נבחר(i)
    אם i < 0 או i >= אורך(זה.פריטים)
      החזר ריק
    סוף
    זה.נבחר = i
    זה.בקש_רענון()
    אם זה.בשינוי != ריק
      זה.בשינוי(i, זה.פריטים[i])
    סוף
  סוף

  פונקציה ערך_נבחר()
    אם אורך(זה.פריטים) == 0
      החזר ריק
    סוף
    החזר זה.פריטים[זה.נבחר]
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    מלבן_מעוגל_עם_גבול(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 10, 28, 30, 36)
    משתנה i = 0
    כל_עוד i < אורך(זה.פריטים)
      משתנה sy = זה.y + 4 + i * זה.גובה_שורה
      אם i == זה.נבחר
        משטח.קבע_מילוי(ערכה_ראשי_כהה_א, ערכה_ראשי_כהה_י, ערכה_ראשי_כהה_כ)
        מלבן_מעוגל_מלא(משטח, זה.x + 4, sy, זה.רחב - 8, זה.גובה_שורה - 2, 6)
        משטח.קבע_צבע(230, 245, 240)
      אחרת
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
      סוף
      משטח.קבע_גודל_גופן(13)
      משטח.טקסט(זה.פריטים[i], זה.x + 14, sy + 6)
      i = i + 1
    סוף
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    משתנה i = ((my - זה.y - 4) / זה.גובה_שורה).שלם()
    אם i < 0
      i = 0
    סוף
    אם i >= אורך(זה.פריטים)
      i = אורך(זה.פריטים) - 1
    סוף
    זה.קבע_נבחר(i)
    החזר אמת
  סוף
סוף
