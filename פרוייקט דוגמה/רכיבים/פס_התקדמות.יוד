// פס_התקדמות.יוד — פס התקדמות (תצוגה בלבד)

מחלקה פס_התקדמות מרחיב רכיב
  פונקציה בנאי(x, y, רחב, אחוז)
    הורה(x, y, רחב, 14)
    זה.אחוז = הגבל(אחוז, 0, 100)
  סוף

  פונקציה קבע_אחוז(v)
    זה.אחוז = הגבל(v, 0, 100)
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משטח.קבע_מילוי(42, 45, 50)
    משטח.מלבן_מלא(זה.x, זה.y, זה.רחב, זה.גבה)
    משתנה מלא = זה.רחב * זה.אחוז / 100
    משטח.קבע_מילוי(14, 124, 112)
    משטח.מלבן_מלא(זה.x, זה.y, מלא, זה.גבה)
    משטח.קבע_צבע(70, 74, 80)
    משטח.קבע_עובי(1)
    משטח.מלבן(זה.x, זה.y, זה.רחב, זה.גבה)
  סוף
סוף
