// נתונים.יוד — מצב ורענון

משתנה תווית_כותרת = ריק
משתנה תווית_מעבד = ריק
משתנה תווית_זיכרון = ריק
משתנה תווית_עלייה = ריק
משתנה תווית_כוננים = ריק
משתנה תווית_סיכום = ריק
משתנה שדה_סינון = ריק
משתנה רשימת_תה = ריק
משתנה מזהים_מוצגים = []

פונקציה רענן_מידע()
  משתנה מעבד = מספר_שלם: מערכת.שימוש_מעבד()
  משתנה ז = מערכת.זיכרון()
  משתנה אחוז_ז = מספר_שלם: ז["אחוז"]

  תווית_כותרת.קבע_טקסט: מערכת.שם_מחשב() + " · " + מערכת.משתמש() + " · " + מערכת.גרסת_הפעלה()
  תווית_מעבד.קבע_טקסט: "מעבד: " + מעבד + "%  ·  " + מערכת.מעבד()["שם"]
  תווית_זיכרון.קבע_טקסט: "זיכרון: " + אחוז_ז + "%  ·  " + מספר_שלם(ז["בשימוש_מגה"]) + " / " + מספר_שלם(ז["סהכ_מגה"]) + " מגה"
  תווית_עלייה.קבע_טקסט: "זמן פעיל: " + פורמט_זמן_פעיל(מערכת.זמן_פעיל())

  משתנה שורות_כונן = []
  עבור כ בתוך מערכת.כוננים()
    שורות_כונן.הוסף: שורת_כונן(כ)
  סוף
  אם שורות_כונן.גודל() == 0
    תווית_כוננים.קבע_טקסט: "כוננים: אין נתונים"
  אחרת
    תווית_כוננים.קבע_טקסט: "כוננים: " + שורות_כונן.הצטרף("   |   ")
  סוף

  משתנה סינון = ""
  אם שדה_סינון != ריק
    סינון = שדה_סינון.קרא_טקסט()
  סוף

  משתנה שורות = []
  מזהים_מוצגים = []
  עבור פ בתוך מערכת.תהליכים()
    אם פ["מזהה"] == 0
      המשך
    סוף
    אם סינון != ""
      אם פ["שם"].מכיל: סינון
        // מתאים
      אחרת
        המשך
      סוף
    סוף
    שורות.הוסף: שורת_תהליך(פ)
    מזהים_מוצגים.הוסף: פ["מזהה"]
  סוף

  רשימת_תה.קבע_פריטים: שורות
  תווית_סיכום.קבע_טקסט: "תהליכים מוצגים: " + שורות.גודל() + "  (ממוין לפי זיכרון)"
סוף

פונקציה סיים_נבחר()
  משתנה אינדקס = רשימת_תה.קרא_אינדקס()
  אם אינדקס < 0
    חלונות.הודעה: "סיום תהליך", "בחרו תהליך מהרשימה."
    החזר ריק
  סוף
  אם אינדקס >= מזהים_מוצגים.גודל()
    חלונות.הודעה: "סיום תהליך", "הבחירה לא תקפה — לחצו רענון."
    החזר ריק
  סוף

  משתנה מזהה = מזהים_מוצגים[אינדקס]
  משתנה שם = רשימת_תה.קרא_פריט()
  אם !חלונות.שאל("סיום תהליך", "להפסיק את התהליך?\n\n" + שם)
    החזר ריק
  סוף

  משתנה תוצאה = מערכת.סיים_תהליך: מזהה
  אם תוצאה["הצלחה"]
    רענן_מידע()
    החזר ריק
  סוף
  חלונות.הודעה: "שגיאה", תוצאה["שגיאה"]
  רענן_מידע()
סוף
