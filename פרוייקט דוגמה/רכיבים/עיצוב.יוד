פונקציה רדיוס_בטוח(w, h, r)
  משתנה מ = r.שלם()
  אם מ * 2 > h
    מ = (h / 2).שלם()
  סוף
  אם מ * 2 > w
    מ = (w / 2).שלם()
  סוף
  אם מ < 0
    החזר 0
  סוף
  החזר מ
סוף

// מילוי אטום — בלי קווי מתאר (שמופיעים כנקודות על משטח בלי אנטי־אליאסינג)
פונקציה מלבן_מעוגל_מלא(משטח, x, y, w, h, r)
  משתנה xx = x.שלם()
  משתנה yy = y.שלם()
  משתנה ww = w.שלם()
  משתנה hh = h.שלם()
  משתנה rr = רדיוס_בטוח(ww, hh, r)
  אם ww <= 0 או hh <= 0
    החזר ריק
  סוף
  אם rr <= 0
    משטח.מלבן_מלא(xx, yy, ww, hh)
    החזר ריק
  סוף
  // חפיפה מלאה בין עיגולים למלבנים — בלי פערים בפינות
  משטח.מלבן_מלא(xx + rr, yy, ww - 2 * rr, hh)
  משטח.מלבן_מלא(xx, yy + rr, ww, hh - 2 * rr)
  משטח.עיגול_מלא(xx + rr, yy + rr, rr)
  משטח.עיגול_מלא(xx + ww - rr, yy + rr, rr)
  משטח.עיגול_מלא(xx + rr, yy + hh - rr, rr)
  משטח.עיגול_מלא(xx + ww - rr, yy + hh - rr, rr)
סוף

// גוף רכיב: צל רך + מילוי (בלי טבעת גבול דקה שנראית מנוקדת)
פונקציה מלבן_מעוגל_רך(משטח, x, y, w, h, r, מא, מי, מכ)
  משטח.קבע_מילוי(16, 17, 20)
  מלבן_מעוגל_מלא(משטח, x, y + 1, w, h, r)
  משטח.קבע_מילוי(מא, מי, מכ)
  מלבן_מעוגל_מלא(משטח, x, y, w, h, r)
סוף

פונקציה הדגשת_עליון(משטח, x, y, w, r, א, י, כ)
  משתנה rr = רדיוס_בטוח(w, 8, r)
  משטח.קבע_מילוי(א, י, כ)
  אם w - 2 * rr > 2
    משטח.מלבן_מלא(x + rr, y, w - 2 * rr, 1)
  סוף
סוף

// תואם ישן — עכשיו בלי טבעת, רק מילוי רך
פונקציה מלבן_מעוגל_עם_גבול(משטח, x, y, w, h, r, מא, מי, מכ)
  מלבן_מעוגל_רך(משטח, x, y, w, h, r, מא, מי, מכ)
סוף

פונקציה קו_עליון_רך(משטח, x, y, w, h, r, א, י, כ)
  הדגשת_עליון(משטח, x, y, w, r, א, י, כ)
סוף
