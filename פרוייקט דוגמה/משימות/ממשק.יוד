// ממשק.יוד — שדות הקלדה Win32 (חלקים) + רשימה RTL במשטח
משתנה לוח_כותרת = ריק

משתנה לוח_כלים = ריק

משתנה לוח_רשימה = ריק

משתנה רשימת_כרטיסים = ריק

משתנה שדה_כותרת = ריק

משתנה שדה_חיפוש = ריק

משתנה תג_הכל = ריק

משתנה תג_פתוח = ריק

משתנה תג_בוצע = ריק

משתנה תווית_סיכום = ריק

משתנה נור_שמירה = ריק

משתנה לשו_מסנן = ריק

משתנה שבב_נמוכה = ריק

משתנה שבב_רגילה = ריק

משתנה שבב_גבוהה = ריק

משתנה מזהה_טיימר_שמירה = ריק

משתנה מזהה_טיימר_חיפוש = ריק

פונקציה רענן_רשימה() {
    אם (לוח_רשימה != ריק) {
        לוח_רשימה.רענון()
    }
}

פונקציה רענן_כותרת() {
    אם (לוח_כותרת != ריק) {
        לוח_כותרת.רענון()
    }
}

פונקציה רענן_כלים() {
    אם (לוח_כלים != ריק) {
        לוח_כלים.רענון()
    }
}

פונקציה סמן_נשמר() {
    אם (נור_שמירה != ריק) {
        נור_שמירה.קבע_דולקת(אמת)
        נור_שמירה.טקסט = "נשמר"
    }
    אם (מזהה_טיימר_שמירה != ריק) {
        טיימרים.עצור(מזהה_טיימר_שמירה)
    }
    מזהה_טיימר_שמירה = טיימרים.אחרי: 1800, פונקציה() {
        אם (נור_שמירה != ריק) {
            נור_שמירה.קבע_דולקת(שקר)
            נור_שמירה.טקסט = "שמירה"
        }
        רענן_כותרת()
    }
    רענן_כותרת()
}

פונקציה שמור_ורענן() {
    שמור_משימות()
    סמן_נשמר()
    רענן_סטטיסטיקה()
    רענן_רשימה()
}

פונקציה רענן_סטטיסטיקה() {
    משתנה סהכ = משימות.גודל()
    משתנה בוצעו = ספור_בוצעו()
    משתנה פתוחות = ספור_פתוחות()
    אם (תג_הכל != ריק) {
        תג_הכל.קבע_טקסט("הכל " + סהכ)
    }
    אם (תג_פתוח != ריק) {
        תג_פתוח.קבע_טקסט("פתוח " + פתוחות)
        תג_פתוח.קבע_צבע_rgb(56, 189, 248)
    }
    אם (תג_בוצע != ריק) {
        תג_בוצע.קבע_טקסט("בוצע " + בוצעו)
        תג_בוצע.קבע_צבע_rgb(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
    }
    אם (תווית_סיכום != ריק) {
        תווית_סיכום.קבע_טקסט(בוצעו + " מתוך " + סהכ + " בוצעו · " + אחוז_השלמה() + "%")
    }
    רענן_כותרת()
}

פונקציה בחר_עדיפות_שבב(שם) {
    עדיפות_נוכחית = שם
    אם (שבב_נמוכה != ריק) {
        שבב_נמוכה.קבע_נבחר(שם == "נמוכה")
    }
    אם (שבב_רגילה != ריק) {
        שבב_רגילה.קבע_נבחר(שם == "רגילה")
    }
    אם (שבב_גבוהה != ריק) {
        שבב_גבוהה.קבע_נבחר(שם == "גבוהה")
    }
    רענן_כלים()
}

פונקציה קרא_כותרת_שדה() {
    אם (שדה_כותרת == ריק) {
        החזר ""
    }
    החזר שדה_כותרת.קרא_טקסט()
}

פונקציה קבע_כותרת_שדה(ט) {
    אם (שדה_כותרת != ריק) {
        שדה_כותרת.קבע_טקסט(ט)
    }
}

פונקציה בחר_משימה(מזהה) {
    מזהה_נבחר = מזהה
    משתנה מ = מצא_משימה(מזהה)
    אם (מ == ריק) {
        מצב_עריכה = שקר
        החזר ריק
    }
    מצב_עריכה = אמת
    קבע_כותרת_שדה(מ.כותרת)
    בחר_עדיפות_שבב(מ.עדיפות)
    רענן_רשימה()
}

פונקציה נקה_טופס() {
    מצב_עריכה = שקר
    מזהה_נבחר = ריק
    קבע_כותרת_שדה("")
    בחר_עדיפות_שבב("רגילה")
    רענן_רשימה()
}

פונקציה הוסף_או_שמור() {
    משתנה כותרת = קרא_כותרת_שדה()
    אם (כותרת == ריק או כותרת == "") {
        חלונות.הודעה("משימות", "כתבו כותרת למשימה")
        החזר ריק
    }
    משתנה עכשיו = זמן.עכשיו()
    אם (מצב_עריכה וגם מזהה_נבחר != ריק) {
        משתנה מ = מצא_משימה(מזהה_נבחר)
        אם (מ != ריק) {
            מ.כותרת = כותרת
            מ.עדיפות = עדיפות_נוכחית
            מ.עודכן = עכשיו
        }
    } אחרת {
        משתנה חדשה = {
            "מזהה": מזהה_הבא,
            "כותרת": כותרת,
            "בוצע": שקר,
            "עדיפות": עדיפות_נוכחית,
            "נוצר": עכשיו,
            "עודכן": עכשיו
        }
        מזהה_הבא = מזהה_הבא + 1
        משימות.הוסף(חדשה)
    }
    נקה_טופס()
    שמור_ורענן()
}

פונקציה החלף_בוצע(מזהה) {
    משתנה מ = מצא_משימה(מזהה)
    אם (מ == ריק) {
        החזר ריק
    }
    אם (מ.בוצע) {
        מ.בוצע = שקר
    } אחרת {
        מ.בוצע = אמת
    }
    מ.עודכן = זמן.עכשיו()
    שמור_ורענן()
}

פונקציה מחק_נבחרת() {
    אם (מזהה_נבחר == ריק) {
        חלונות.הודעה("משימות", "בחרו משימה למחיקה")
        החזר ריק
    }
    משתנה מ = מצא_משימה(מזהה_נבחר)
    משתנה שם = ""
    אם (מ != ריק) {
        שם = מ.כותרת
    }
    אם (לא חלונות.שאל("מחיקה", "למחוק את המשימה?\n\n" + שם)) {
        החזר ריק
    }
    משתנה i = אינדקס_משימה(מזהה_נבחר)
    אם (i >= 0) {
        משימות.הסר(i)
    }
    נקה_טופס()
    שמור_ורענן()
}

פונקציה נקה_בוצעו() {
    משתנה כמה = ספור_בוצעו()
    אם (כמה == 0) {
        חלונות.הודעה("משימות", "אין משימות שבוצעו")
        החזר ריק
    }
    אם (לא חלונות.שאל("ניקוי", "למחוק " + כמה + " משימות שבוצעו?")) {
        החזר ריק
    }
    משתנה חדשות = []
    עבור מ בתוך משימות {
        אם (לא מ.בוצע) {
            חדשות.הוסף(מ)
        }
    }
    משימות = חדשות
    נקה_טופס()
    שמור_ורענן()
}

פונקציה החל_מסנן(שם) {
    מסנן = שם
    רענן_רשימה()
}

פונקציה החל_חיפוש(ט) {
    אם (ט == ריק) {
        טקסט_חיפוש = ""
    } אחרת {
        טקסט_חיפוש = ט
    }
    רענן_רשימה()
}

פונקציה בדוק_חיפוש() {
    אם (שדה_חיפוש == ריק) {
        החזר ריק
    }
    משתנה ט = שדה_חיפוש.קרא_טקסט()
    אם (ט == ריק) {
        ט = ""
    }
    אם (ט != טקסט_חיפוש) {
        החל_חיפוש(ט)
    }
}

פונקציה פרוס_כותרת(רחב, גבה) {
    אם (תווית_סיכום != ריק) {
        תווית_סיכום.x = 16
    }
    אם (נור_שמירה != ריק) {
        נור_שמירה.x = רחב - 120
    }
}

פונקציה פרוס_כלים(רחב, גבה) {
    אם (לשו_מסנן != ריק) {
        לשו_מסנן.רחב = רחב - 32
        לשו_מסנן.x = 16
    }
    אם (שבב_גבוהה != ריק) {
        שבב_גבוהה.x = רחב - 80
        שבב_רגילה.x = רחב - 154
        שבב_נמוכה.x = רחב - 228
    }
}

פונקציה פרוס_רשימה(רחב, גבה) {
    אם (רחב < 200) {
        רחב = 200
    }
    אם (גבה < 120) {
        גבה = 120
    }
    אם (רשימת_כרטיסים != ריק) {
        רשימת_כרטיסים.x = 8
        רשימת_כרטיסים.y = 8
        רשימת_כרטיסים.רחב = רחב - 16
        רשימת_כרטיסים.גבה = גבה - 16
    }
}

פונקציה בנה_חלון_משימות() {
    טען_משימות()
    משתנה ח = חלונות.חלון: כותרת_חלון
    ח.קבע_גודל: רוחב_חלון, גובה_חלון
    ח.קבע_כהה: אמת
    ח.קבע_תפריט: [{ "שם": "קובץ", "פריטים": [{ "שם": "ייצוא JSON…", "פעולה": ייצא_משימות},{ "שם": "נקה בוצעו", "פעולה": נקה_בוצעו},{ "שם": "-"},{ "שם": "יציאה", "פעולה": סגור_חלון_משימות}]}]
    // —— כותרת קלה (בלי הקלדה) ——
    לוח_כותרת = חדש לוח_רכיבים: רוחב_חלון - 16, 52
    לוח_כותרת.רקע_א = ערכה_רקע_א
    לוח_כותרת.רקע_י = ערכה_רקע_י
    לוח_כותרת.רקע_כ = ערכה_רקע_כ
    לוח_כותרת.בפריסה = פרוס_כותרת
    לוח_כותרת.משטח_גלוי().קבע_מתיחה: 0
    לוח_כותרת.משטח_גלוי().קבע_נעילת_גובה: אמת
    משתנה מותג = חדש תווית_ציור: רוחב_חלון - 120, 10, "משימות"
    מותג.קבע_צבע_rgb(56, 189, 248)
    מותג.גודל = 16
    לוח_כותרת.הוסף(מותג)
    משתנה תג_יוד = חדש תג: רוחב_חלון - 180, 12, "יוד"
    תג_יוד.קבע_צבע_rgb(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
    לוח_כותרת.הוסף(תג_יוד)
    תג_הכל = חדש תג: רוחב_חלון - 280, 12, "הכל 0"
    תג_הכל.קבע_צבע_rgb(70, 78, 90)
    לוח_כותרת.הוסף(תג_הכל)
    תג_פתוח = חדש תג: רוחב_חלון - 370, 12, "פתוח 0"
    לוח_כותרת.הוסף(תג_פתוח)
    תג_בוצע = חדש תג: רוחב_חלון - 470, 12, "בוצע 0"
    לוח_כותרת.הוסף(תג_בוצע)
    נור_שמירה = חדש נורית: 16, 14, "שמירה", שקר
    לוח_כותרת.הוסף(נור_שמירה)
    תווית_סיכום = חדש תווית_ציור: 120, 16, ""
    תווית_סיכום.קבע_צבע_rgb(148, 163, 184)
    לוח_כותרת.הוסף(תווית_סיכום)
    // —— שורת הקלדה Win32 (מהיר, בלי אותיות שנבלעות) ——
    שדה_כותרת = חלונות.שדה("")
    שדה_כותרת.קבע_כהה(אמת)
    שדה_כותרת.קבע_רמז("משימה חדשה…")
    שדה_חיפוש = חלונות.שדה("")
    שדה_חיפוש.קבע_כהה(אמת)
    שדה_חיפוש.קבע_רמז("חיפוש…")
    משתנה כפ_הוסף = חלונות.כפתור("הוסף / שמור")
    כפ_הוסף.קבע_כהה(אמת)
    כפ_הוסף.קבע_רמז("הוספה או שמירת עריכה")
    כפ_הוסף.בלחיצה(פונקציה() {
        הוסף_או_שמור()
    })
    משתנה כפ_מחק = חלונות.כפתור("מחק")
    כפ_מחק.קבע_כהה(אמת)
    כפ_מחק.בלחיצה(פונקציה() {
        מחק_נבחרת()
    })
    משתנה כפ_נקה = חלונות.כפתור("נקה בוצעו")
    כפ_נקה.קבע_כהה(אמת)
    כפ_נקה.בלחיצה(פונקציה() {
        נקה_בוצעו()
    })
    משתנה שורת_קלט = חלונות.מסגרת("אופקי")
    שורת_קלט.קבע_רקע(22, 24, 28)
    שורת_קלט.קבע_מתיחה(0)
    שורת_קלט.הוסף(שדה_חיפוש)
    שורת_קלט.הוסף(כפ_נקה)
    שורת_קלט.הוסף(כפ_מחק)
    שורת_קלט.הוסף(כפ_הוסף)
    שורת_קלט.הוסף(שדה_כותרת)
    // —— לשוניות + עדיפות (משטח קל, בלי הקלדה) ——
    לוח_כלים = חדש לוח_רכיבים: רוחב_חלון - 16, 64
    לוח_כלים.רקע_א = ערכה_רקע_א
    לוח_כלים.רקע_י = ערכה_רקע_י
    לוח_כלים.רקע_כ = ערכה_רקע_כ
    לוח_כלים.בפריסה = פרוס_כלים
    לוח_כלים.משטח_גלוי().קבע_מתיחה: 0
    לוח_כלים.משטח_גלוי().קבע_נעילת_גובה: אמת
    לשו_מסנן = חדש לשוניות: 16, 6, רוחב_חלון - 48, ["בוצעו", "פתוחות", "הכל"]
    לשו_מסנן.בשינוי = פונקציה(i, שם) {
        החל_מסנן(שם)
    }
    לשו_מסנן.קבע_נבחר(2)
    לוח_כלים.הוסף(לשו_מסנן)
    שבב_גבוהה = חדש שבב: רוחב_חלון - 96, 38, "גבוהה", שקר
    שבב_גבוהה.בשינוי = פונקציה(v) {
        בחר_עדיפות_שבב("גבוהה")
    }
    לוח_כלים.הוסף(שבב_גבוהה)
    שבב_רגילה = חדש שבב: רוחב_חלון - 170, 38, "רגילה", אמת
    שבב_רגילה.בשינוי = פונקציה(v) {
        בחר_עדיפות_שבב("רגילה")
    }
    לוח_כלים.הוסף(שבב_רגילה)
    שבב_נמוכה = חדש שבב: רוחב_חלון - 244, 38, "נמוכה", שקר
    שבב_נמוכה.בשינוי = פונקציה(v) {
        בחר_עדיפות_שבב("נמוכה")
    }
    לוח_כלים.הוסף(שבב_נמוכה)
    משתנה תווית_עדי = חדש תווית_ציור: רוחב_חלון - 320, 40, "עדיפות"
    תווית_עדי.קבע_צבע_rgb(120, 128, 138)
    לוח_כלים.הוסף(תווית_עדי)
    // —— רשימה ——
    לוח_רשימה = חדש לוח_רכיבים: רוחב_חלון - 16, 360
    לוח_רשימה.רקע_א = ערכה_רקע_א
    לוח_רשימה.רקע_י = ערכה_רקע_י
    לוח_רשימה.רקע_כ = ערכה_רקע_כ
    לוח_רשימה.בפריסה = פרוס_רשימה
    לוח_רשימה.משטח_גלוי().קבע_מתיחה: 1
    לוח_רשימה.משטח_גלוי().קבע_נעילת_גובה: שקר
    רשימת_כרטיסים = חדש כרטיסי_משימות: 8, 8, רוחב_חלון - 32, 340
    רשימת_כרטיסים.בשינוי_בחירה = פונקציה(מזהה) {
        בחר_משימה(מזהה)
    }
    רשימת_כרטיסים.בסימון = פונקציה(מזהה) {
        החלף_בוצע(מזהה)
    }
    לוח_רשימה.הוסף(רשימת_כרטיסים)
    בחר_עדיפות_שבב("רגילה")
    רענן_סטטיסטיקה()
    לוח_כותרת.רענון()
    לוח_כלים.רענון()
    לוח_רשימה.רענון()
    ח.הוסף(לוח_כותרת.משטח_גלוי())
    ח.הוסף(שורת_קלט)
    ח.הוסף(לוח_כלים.משטח_גלוי())
    ח.הוסף(לוח_רשימה.משטח_גלוי())
    ח.בהתחלה: פונקציה() {
        מזהה_טיימר_חיפוש = טיימרים.טיימר: 200, בדוק_חיפוש
    }
    ח.הצג()
