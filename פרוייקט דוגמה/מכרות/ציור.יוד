  משתנה ש = שחקן_נוכחי()
  משתנה יש_גלאי = ש["גלאי"]

  משתנה y = 0
  כל_עוד y < גודל_לוח
    משתנה x = 0
    כל_עוד x < גודל_לוח
      משתנה px = בסיס_x + x * גודל_תא
      משתנה py = בסיס_y + y * גודל_תא
      אם y >= שורות_פתוחות
        לוח.קבע_מילוי: 16, 18, 24
