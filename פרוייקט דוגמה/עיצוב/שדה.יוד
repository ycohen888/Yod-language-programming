// שדה.יוד — קלט שורה אחת (טקסט / אימייל / סיסמה וכו')
כלול "פקד.יוד"

מחלקה שדה מרחיב פקד {
    פונקציה בנאי(רמז = "", סוג = "טקסט", מזהה = "") {
        אם (רמז == ריק) {
            רמז = ""
        }
        אם (סוג == ריק או סוג == "") {
            סוג = "טקסט"
        }
        הורה(מזהה)
        זה.רמז = רמז
        זה.סוג_שדה = סוג
        זה.ערך = ""
        זה._שינוי = ריק
        זה._כניסה = ריק
        זה._צור("שדה", {
            "רמז": רמז,
            "סוג_שדה": סוג,
            "ערך": ""
        })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה.טקסט = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה קבע_רמז(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.רמז = ט
        זה._שלח_פקודה("קבע_רמז", { "רמז": ט })
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }

    פונקציה בכניסה(פונק) {
        זה._כניסה = פונק
    }
}
