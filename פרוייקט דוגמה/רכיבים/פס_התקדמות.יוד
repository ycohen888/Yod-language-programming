// פס_התקדמות.יוד — מילוי מכיוון ההתחלה
מחלקה פס_התקדמות מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, אחוז) {
        הורה(x, y, רחב, 7)
        זה.אחוז = הגבל(אחוז, 0, 100)
    }
    פונקציה קבע_אחוז(v) {
        זה.אחוז = הגבל(v, 0, 100)
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משטח.קבע_מילוי(42, 46, 54)
        מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2)
        משתנה מלא = רוחב_מילוי_אופקי(זה, זה.אחוז)
        אם (מלא >= זה.גבה) {
            משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
            מלבן_מעוגל_מלא(משטח, x_מילוי_אופקי(זה, זה.אחוז), זה.y, מלא, זה.גבה, זה.גבה / 2)
        }
    }
}
