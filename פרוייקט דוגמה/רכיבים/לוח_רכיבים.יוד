// לוח_רכיבים.יוד — מנהל משטח + פיזור אירועי עכבר לרכיבים

מחלקה לוח_רכיבים
  פונקציה בנאי(רוחב, גובה)
    זה.משטח = חלונות.משטח(רוחב, גובה)
    זה.רחב = רוחב
    זה.גבה = גובה
    זה.רכיבים = []
    זה.פעיל = ריק
    זה.רקע_א = 28
    זה.רקע_י = 29
    זה.רקע_כ = 33
    זה.השהה_רענון = שקר
    זה.מלוכלך = שקר

    // עטיפה — בעכבר_* מצפה לפונקציה, לא למתודה
    משתנה עצמי = זה
    זה.משטח.בעכבר_למטה: פונקציה (x, y, כפתור)
      עצמי.על_למטה(x, y, כפתור)
    סוף
    זה.משטח.בעכבר_גרירה: פונקציה (x, y, כפתור)
      עצמי.על_גרירה(x, y, כפתור)
    סוף
    זה.משטח.בעכבר_למעלה: פונקציה (x, y, כפתור)
      עצמי.על_למעלה(x, y, כפתור)
    סוף
  סוף

  פונקציה משטח_גלוי()
    החזר זה.משטח
  סוף

  פונקציה הוסף(ר)
    ר.לוח = זה
    זה.רכיבים.הוסף(ר)
    זה.רענון()
  סוף

  פונקציה סמן_רענון()
    אם זה.השהה_רענון
      זה.מלוכלך = אמת
    אחרת
      זה.רענון()
    סוף
  סוף

  פונקציה רענון()
    זה.משטח.נקה(זה.רקע_א, זה.רקע_י, זה.רקע_כ)
    עבור ר בתוך זה.רכיבים
      ר.צייר(זה.משטח)
    סוף
    זה.משטח.רענן()
    זה.מלוכלך = שקר
  סוף

  פונקציה עם_אצווה(פעולה)
    זה.השהה_רענון = אמת
    פעולה()
    זה.השהה_רענון = שקר
    אם זה.מלוכלך
      זה.רענון()
    סוף
  סוף

  פונקציה על_למטה(x, y, כפתור)
    משתנה עצמי = זה
    זה.עם_אצווה(פונקציה ()
      עצמי.פעיל = ריק
      משתנה i = אורך(עצמי.רכיבים) - 1
      כל_עוד i >= 0
        משתנה ר = עצמי.רכיבים[i]
        אם ר.בעכבר_למטה(x, y, כפתור)
          עצמי.פעיל = ר
          החזר ריק
        סוף
        i = i - 1
      סוף
    סוף)
  סוף

  פונקציה על_גרירה(x, y, כפתור)
    משתנה עצמי = זה
    זה.עם_אצווה(פונקציה ()
      אם עצמי.פעיל != ריק
        עצמי.פעיל.בעכבר_גרירה(x, y, כפתור)
      סוף
    סוף)
  סוף

  פונקציה על_למעלה(x, y, כפתור)
    משתנה עצמי = זה
    זה.עם_אצווה(פונקציה ()
      אם עצמי.פעיל != ריק
        עצמי.פעיל.בעכבר_למעלה(x, y, כפתור)
        עצמי.פעיל = ריק
      סוף
    סוף)
  סוף
סוף
