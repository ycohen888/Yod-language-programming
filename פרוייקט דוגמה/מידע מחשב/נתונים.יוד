// נתונים.יוד — מצב, רענון וגרפים (מדדים בתוך הגרף)

משתנה תווית_מותג = ריק
משתנה תווית_כותרת = ריק
משתנה תווית_עלייה = ריק
משתנה תווית_התראה = ריק
משתנה תווית_תהליכים_כ = ריק
משתנה תווית_סיכום = ריק
משתנה תווית_סינון = ריק
משתנה שדה_סינון = ריק
משתנה רשימת_תה = ריק
משתנה גרף_מעבד = ריק
משתנה גרף_זיכרון = ריק
משתנה גרף_כוננים = ריק
משתנה לוח_כותרת = ריק
משתנה לוח_פעולות = ריק
משתנה נור_מצב = ריק
משתנה תג_מצב = ריק
משתנה פס_מעבד = ריק
משתנה טבעת_זיכרון = ריק
משתנה היסטוריית_מעבד = []
משתנה מזהה_טיימר = ריק
משתנה סף_מעבד = 85
משתנה סף_זיכרון = 90

פונקציה רענן_מידע()
  נסה
    בצע_רענון()
  תפוס שגיאה
    אם תווית_סיכום != ריק
      תווית_סיכום.קבע_טקסט: "שגיאה ברענון: " + שגיאה
      תווית_סיכום.קבע_צבע: 248, 113, 113
    סוף
  סוף
סוף

פונקציה בצע_רענון()
  משתנה מעבד = מתמטיקה.עיגול: מערכת.שימוש_מעבד()
  משתנה ז = מערכת.זיכרון()
  משתנה אחוז_ז = מתמטיקה.עיגול: ז["אחוז"]
  משתנה מעבד_מידע = מערכת.מעבד()

  תווית_כותרת.קבע_טקסט: מערכת.שם_מחשב() + "  ·  " + מערכת.משתמש() + "  ·  " + מערכת.גרסת_הפעלה()
  תווית_עלייה.קבע_טקסט: "פעיל " + פורמט_זמן_פעיל(מערכת.זמן_פעיל())

  משתנה התראות = []
  אם מעבד >= סף_מעבד
    התראות.הוסף: "מעבד גבוה " + מספרים.אחוז(מעבד)
  סוף
  אם אחוז_ז >= סף_זיכרון
    התראות.הוסף: "זיכרון גבוה " + מספרים.אחוז(אחוז_ז)
  סוף
  אם התראות.גודל() == 0
    תווית_התראה.קבע_טקסט: ""
    אם נור_מצב != ריק
      נור_מצב.קבע_דולקת(אמת)
    סוף
    אם תג_מצב != ריק
      תג_מצב.קבע_טקסט("חי")
      תג_מצב.קבע_צבע_rgb(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
    סוף
  אחרת
    תווית_התראה.קבע_טקסט: "! " + התראות.הצטרף(" · ")
    תווית_התראה.קבע_צבע_rgb(251, 146, 60)
    אם נור_מצב != ריק
      נור_מצב.קבע_דולקת(שקר)
    סוף
    אם תג_מצב != ריק
      תג_מצב.קבע_טקסט("עומס")
      תג_מצב.קבע_צבע_rgb(220, 100, 50)
    סוף
  סוף

  אם פס_מעבד != ריק
    פס_מעבד.קבע_אחוז(מעבד)
  סוף
  אם טבעת_זיכרון != ריק
    טבעת_זיכרון.קבע_אחוז(אחוז_ז)
  סוף

  משתנה סיכום_כונן = []
  משתנה תוויות_כונן = []
  משתנה ערכי_בשימוש = []
  משתנה ערכי_פנוי = []
  עבור כ בתוך מערכת.כוננים()
    סיכום_כונן.הוסף: שורת_כונן(כ)
    תוויות_כונן.הוסף: כ["אות"] + ":"
    ערכי_בשימוש.הוסף: כ["בשימוש_בתים"]
    ערכי_פנוי.הוסף: כ["פנוי_בתים"]
  סוף

  היסטוריית_מעבד.הוסף: מעבד
  כל_עוד היסטוריית_מעבד.גודל() > 36
    היסטוריית_מעבד.הסר_ראשון()
  סוף
  משתנה תוויות_מ = []
  עבור ערך בתוך היסטוריית_מעבד
    תוויות_מ.הוסף: ""
  סוף

  אם גרף_מעבד != ריק
    גרף_מעבד.קבע_כותרת: "מעבד"
    גרף_מעבד.קבע_תת_כותרת: מספרים.אחוז(מעבד) + "  ·  ממוצע " + מספרים.אחוז(ממוצע_רשימה(היסטוריית_מעבד)) + "  ·  " + מעבד_מידע["שם"]
    גרף_מעבד.קבע_תוויות: תוויות_מ
    גרף_מעבד.קבע_סדרות: [
      {"שם": "מעבד", "ערכים": היסטוריית_מעבד, "צבע": "תכלת"}
    ]
  סוף

  אם גרף_זיכרון != ריק
    משתנה פנוי = ז["סהכ_בתים"] - ז["בשימוש_בתים"]
    אם פנוי < 0
      פנוי = 0
    סוף
    גרף_זיכרון.קבע_כותרת: "זיכרון"
    גרף_זיכרון.קבע_תת_כותרת: מספרים.אחוז(אחוז_ז) + "  ·  " + מספרים.בתים(ז["בשימוש_בתים"]) + " / " + מספרים.בתים(ז["סהכ_בתים"])
    גרף_זיכרון.קבע_נתונים: [
      {"שם": "בשימוש", "ערך": ז["בשימוש_בתים"], "צבע": "כתום"},
      {"שם": "פנוי", "ערך": פנוי, "צבע": "תכלת"}
    ]
  סוף

  אם גרף_כוננים != ריק
    אם תוויות_כונן.גודל() > 0
      גרף_כוננים.קבע_כותרת: "כוננים"
      גרף_כוננים.קבע_תת_כותרת: סיכום_כונן.הצטרף("   ·   ")
      גרף_כוננים.קבע_תוויות: תוויות_כונן
      גרף_כוננים.קבע_סדרות: [
        {"שם": "בשימוש", "ערכים": ערכי_בשימוש, "צבע": "כתום"},
        {"שם": "פנוי", "ערכים": ערכי_פנוי, "צבע": "תכלת"}
      ]
    אחרת
      גרף_כוננים.קבע_תת_כותרת: "אין נתוני כוננים"
    סוף
  סוף

  משתנה סינון = ""
  אם שדה_סינון != ריק
    סינון = שדה_סינון.קרא_טקסט()
  סוף

  משתנה שורות = []
  עבור פ בתוך מערכת.תהליכים()
    אם פ["מזהה"] == 0
      המשך
    סוף
    שורות.הוסף: שורת_תהליך_טבלה(פ)
  סוף

  רשימת_תה.קבע_שורות: שורות
  רשימת_תה.מיין: "זיכרון", "יורד"
  אם סינון != ""
    רשימת_תה.סנן: סינון
  סוף
  תווית_סיכום.קבע_טקסט: מספרים.שלם(שורות.גודל()) + " תהליכים  ·  מיון לפי זיכרון  ·  CSV מהתפריט או מהכפתור"
  תווית_סיכום.קבע_צבע: 148, 163, 184
סוף

פונקציה ממוצע_רשימה רשימה
  אם רשימה.גודל() == 0
    החזר 0
  סוף
  משתנה סכום = 0
  עבור ערך בתוך רשימה
    סכום = סכום + ערך
  סוף
  החזר מתמטיקה.עיגול: סכום / רשימה.גודל()
סוף

פונקציה סיים_נבחר()
  משתנה אינדקס = רשימת_תה.קרא_אינדקס()
  אם אינדקס < 0
    חלונות.הודעה: "סיום תהליך", "בחרו תהליך מהטבלה."
    החזר ריק
  סוף

  משתנה שורה = רשימת_תה.קרא_שורה()
  משתנה מזהה = שורה["מזהה"]
  משתנה שם = שורה["שם"]
  אם מזהה == ריק
    חלונות.הודעה: "סיום תהליך", "הבחירה לא תקפה — לחצו רענון."
    החזר ריק
  סוף

  אם !חלונות.שאל("סיום תהליך", "להפסיק את התהליך?\n\n" + שם + "  (מזהה " + מספרים.שלם(מזהה) + ")")
    החזר ריק
  סוף

  משתנה תוצאה = מערכת.סיים_תהליך: מזהה
  אם תוצאה["הצלחה"]
    רענן_מידע()
    החזר ריק
  סוף
  חלונות.הודעה: "שגיאה", תוצאה["שגיאה"]
  רענן_מידע()
סוף
