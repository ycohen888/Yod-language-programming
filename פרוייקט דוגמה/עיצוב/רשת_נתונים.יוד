// רשת_נתונים.יוד — DataGrid (מבוסס Tabulator): טבלה מתקדמת
// יכולות: מיון, סינון, עימוד, בחירה מרובה, עריכה, מעצבים, גרף זעיר, קיבוץ,
// חישובים, הקפאת עמודה, עץ, תפריט הקשר, ייצוא, העתקה, כיוון תא ועיצוב מותנה.
כלול "פקד.יוד"
כלול "גיליון"

מחלקה רשת_נתונים מרחיב פקד {
    פונקציה בנאי(עמודות, שורות = [], אפשרויות = {}) {
        אם (עמודות == ריק) {
            עמודות = []
        }
        אם (שורות == ריק) {
            שורות = []
        }
        אם (אפשרויות == ריק) {
            אפשרויות = {}
        }
        משתנה מזהה = ""
        אם (אפשרויות.יש("מזהה")) {
            מזהה = אפשרויות.מזהה
        }
        הורה(מזהה)
        זה.עמודות = עמודות
        זה.שורות = שורות
        זה.ערך = ""
        זה._לחץ = ריק
        זה._שינוי = ריק
        זה._עריכה = ריק
        זה._בחירה = ריק
        זה._תפריט = ריק
        זה._ייצוא = ריק
        משתנה נתונים = { "עמודות": עמודות, "שורות": שורות }
        אם (אפשרויות.יש("נושא")) {
            נתונים.נושא = אפשרויות.נושא
        }
        אם (אפשרויות.יש("בחירה_מרובה")) {
            נתונים.בחירה_מרובה = אפשרויות.בחירה_מרובה
        }
        אם (אפשרויות.יש("עימוד")) {
            נתונים.עימוד = אפשרויות.עימוד
        }
        אם (אפשרויות.יש("גודל_עמוד")) {
            נתונים.גודל_עמוד = אפשרויות.גודל_עמוד
        }
        אם (אפשרויות.יש("סינון")) {
            נתונים.סינון = אפשרויות.סינון
        }
        אם (אפשרויות.יש("קבץ_לפי")) {
            נתונים.קבץ_לפי = אפשרויות.קבץ_לפי
        }
        אם (אפשרויות.יש("הזזת_עמודות")) {
            נתונים.הזזת_עמודות = אפשרויות.הזזת_עמודות
        }
        אם (אפשרויות.יש("רספונסיבי")) {
            נתונים.רספונסיבי = אפשרויות.רספונסיבי
        }
        אם (אפשרויות.יש("עץ")) {
            נתונים.עץ = אפשרויות.עץ
        }
        אם (אפשרויות.יש("תפריט_שורה")) {
            נתונים.תפריט_שורה = אפשרויות.תפריט_שורה
        }
        אם (אפשרויות.יש("צבע_שורה")) {
            נתונים.צבע_שורה = אפשרויות.צבע_שורה
        }
        אם (אפשרויות.יש("גובה")) {
            נתונים.גובה = אפשרויות.גובה
        }
        אם (אפשרויות.יש("שטוח")) {
            נתונים.שטוח = אפשרויות.שטוח
        }
        זה._צור("רשת_נתונים", נתונים)
    }

    פונקציה קבע_עמודות(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.עמודות = רשימה
        זה._שלח_פקודה("קבע_עמודות", { "עמודות": רשימה })
    }

    פונקציה קבע_שורות(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.שורות = רשימה
        זה._שלח_פקודה("קבע_שורות", { "שורות": רשימה })
    }

    פונקציה הוסף_שורה(שורה) {
        זה.שורות.הוסף(שורה)
        זה._שלח_פקודה("הוסף_שורה", { "שורה": שורה })
    }

    פונקציה נקה() {
        זה.שורות = []
        זה._שלח_פקודה("נקה_שורות", {})
    }

    פונקציה קבע_גובה(ג) {
        זה._שלח_פקודה("קבע_גובה", { "גובה": ג })
    }

    פונקציה קבע_נושא(נושא) {
        אם (נושא == ריק) {
            נושא = "אוטומטי"
        }
        זה._שלח_פקודה("רשת_נושא", { "נושא": נושא })
    }

    פונקציה סנן(שדה, ערך) {
        זה._שלח_פקודה("רשת_סנן", { "שדה": שדה, "ערך": ערך })
    }

    פונקציה סנן_גלובלי(טקסט) {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        זה._שלח_פקודה("רשת_סנן_גלובלי", { "טקסט": טקסט })
    }

    פונקציה נקה_סינון() {
        זה._שלח_פקודה("רשת_נקה_סינון", {})
    }

    פונקציה קבץ_לפי(שדה) {
        אם (שדה == ריק) {
            שדה = ""
        }
        זה._שלח_פקודה("רשת_קבץ", { "שדה": שדה })
    }

    פונקציה העתק() {
        זה._שלח_פקודה("רשת_העתק", {})
    }

    פונקציה ייצא(פורמט, נתיב = "") {
        אם (פורמט == ריק) {
            פורמט = "csv"
        }
        אם (נתיב == ריק) {
            נתיב = ""
        }
        זה._שלח_פקודה("רשת_ייצא", { "פורמט": פורמט, "נתיב": נתיב })
    }

    פונקציה עדכן_תא(מזהה_שורה, שדה, ערך) {
        זה._שלח_פקודה("רשת_עדכן_תא", { "מזהה_שורה": מזהה_שורה, "שדה": שדה, "ערך": ערך })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }

    פונקציה בעריכה(פונק) {
        זה._עריכה = פונק
    }

    פונקציה בבחירה(פונק) {
        זה._בחירה = פונק
    }

    פונקציה בתפריט(פונק) {
        זה._תפריט = פונק
    }

    פונקציה בעת_ייצוא(פונק) {
        זה._ייצוא = פונק
    }

    // טיפול ברירת מחדל בייצוא: שמירת הקובץ + קריאה לקולבק המשתמש
    פונקציה _ייצוא_מערכת(ערכים) {
        אם (ערכים == ריק) {
            החזר ריק
        }
        משתנה פורמט = ""
        אם (ערכים.יש("פורמט")) {
            פורמט = ערכים.פורמט
        }
        משתנה נתיב = ""
        אם (ערכים.יש("נתיב")) {
            נתיב = ערכים.נתיב
        }
        אם (נתיב != ריק וגם נתיב != "") {
            אם (פורמט == "xlsx") {
                זה._ייצא_xlsx(ערכים, נתיב)
            } אחרת {
                משתנה תוכן = ""
                אם (ערכים.יש("תוכן")) {
                    תוכן = ערכים.תוכן
                }
                נסה {
                    קבצים.כתוב(נתיב, תוכן)
                } תפוס שגיאה {
                }
            }
        }
        אם (זה._ייצוא != ריק) {
            זה._ייצוא(פורמט, נתיב)
        }
    }

    פונקציה _ייצא_xlsx(ערכים, נתיב) {
        אם (לא ערכים.יש("תאים")) {
            החזר ריק
        }
        משתנה תאים = ערכים.תאים
        נסה {
            משתנה גל = גיליון.חדש()
            עבור תא בתוך תאים {
                גל.קבע_תא(תא.תא, תא.ערך)
            }
            גל.שמור_כ(נתיב)
            גל.סגור()
        } תפוס שגיאה {
        }
    }
}
