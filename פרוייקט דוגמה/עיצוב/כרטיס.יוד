// כרטיס.יוד — Card
כלול "פקד.יוד"

מחלקה כרטיס מרחיב פקד {
    פונקציה בנאי(כותרת, גוף = "", מזהה = "") {
        אם (כותרת == ריק) {
            כותרת = ""
        }
        אם (גוף == ריק) {
            גוף = ""
        }
        הורה(מזהה)
        זה.כותרת = כותרת
        זה.גוף = גוף
        זה.טקסט = כותרת
        זה._צור("כרטיס", {
            "כותרת": כותרת,
            "גוף": גוף
        })
    }

    פונקציה קבע_כותרת(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.כותרת = ט
        זה._שלח_פקודה("קבע_כותרת", { "כותרת": ט })
    }

    פונקציה קבע_גוף(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.גוף = ט
        זה._שלח_פקודה("קבע_גוף", { "גוף": ט })
    }
}
