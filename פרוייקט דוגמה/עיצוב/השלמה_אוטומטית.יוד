// השלמה_אוטומטית.יוד — Autocomplete / Typeahead
כלול "פקד.יוד"

מחלקה השלמה_אוטומטית מרחיב פקד {
    פונקציה בנאי(פריטים, רמז = "הקלד לחיפוש…", ערך = "", מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (רמז == ריק) {
            רמז = "הקלד לחיפוש…"
        }
        אם (ערך == ריק) {
            ערך = ""
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה.רמז = רמז
        זה.ערך = ערך
        זה._שינוי = ריק
        זה._צור("השלמה_אוטומטית", {
            "פריטים": פריטים,
            "רמז": רמז,
            "ערך": ערך
        })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
