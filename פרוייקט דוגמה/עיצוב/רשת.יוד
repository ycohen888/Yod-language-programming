// רשת.יוד — Grid row of columns text
כלול "פקד.יוד"

מחלקה רשת מרחיב פקד {
    פונקציה בנאי(עמודות = 2, תאים = [], מזהה = "") {
        אם (עמודות == ריק או עמודות < 1) {
            עמודות = 2
        }
        אם (תאים == ריק) {
            תאים = []
        }
        הורה(מזהה)
        זה.עמודות = עמודות
        זה.תאים = תאים
        זה._צור("רשת", {
            "עמודות": עמודות,
            "תאים": תאים
        })
    }

    פונקציה קבע_תאים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.תאים = רשימה
        זה._שלח_פקודה("קבע_תאים", { "תאים": רשימה })
    }
}
