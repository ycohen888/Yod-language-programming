// עזר.יוד — עיצוב טקסט ומספרים
פונקציה פורמט_זמן_פעיל(שניות) {
    משתנה ש = מתמטיקה.עיגול: שניות
    משתנה ימים = מתמטיקה.רצפה: ש / 86400
    ש = ש - ימים * 86400
    משתנה שעות = מתמטיקה.רצפה: ש / 3600
    ש = ש - שעות * 3600
    משתנה דקות = מתמטיקה.רצפה: ש / 60
    משתנה שנ = ש - דקות * 60
    אם (ימים > 0) {
        החזר מספרים.שלם(ימים) + "י " + מספרים.שלם(שעות) + "ש " + מספרים.שלם(דקות) + "ד"
    }
    אם (שעות > 0) {
        החזר מספרים.שלם(שעות) + "ש " + מספרים.שלם(דקות) + "ד " + מספרים.שלם(שנ) + "שנ"
    }
    החזר מספרים.שלם(דקות) + "ד " + מספרים.שלם(שנ) + "שנ"
}

פונקציה שורת_תהליך_טבלה(פ) {
    משתנה נתיב = פ["נתיב"]
    אם (נתיב == ריק) {
        נתיב = ""
    }
    החזר{ "שם": פ["שם"], "מזהה": פ["מזהה"], "זיכרון": מספרים.בתים(פ["זיכרון_בתים"]), "נתיב": נתיב, "מיון":{ "זיכרון": פ["זיכרון_בתים"], "מזהה": פ["מזהה"]}}
}

פונקציה שורת_כונן(כ) {
    משתנה אות = כ["אות"]
    משתנה סהכ = כ["סהכ_בתים"]
    משתנה בשימוש = כ["בשימוש_בתים"]
    משתנה פנוי = כ["פנוי_בתים"]
    משתנה אחוז = 0
    אם (סהכ > 0) {
        אחוז = מתמטיקה.עיגול: (בשימוש * 100) / סהכ
    }
    החזר אות + ": " + מספרים.בתים(בשימוש) + " / " + מספרים.בתים(סהכ) + " (" + מספרים.שלם(אחוז) + "%) · פנוי " + מספרים.בתים(פנוי)
}
