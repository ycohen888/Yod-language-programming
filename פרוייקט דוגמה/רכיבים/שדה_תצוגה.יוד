// שדה_תצוגה.יוד — שדה לקריאה בלבד; יישור לפי כיוון
מחלקה שדה_תצוגה מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, טקסט) {
        הורה(x, y, רחב, 26)
        זה.טקסט = טקסט
        זה.מקום_שמור = "…"
        זה.ממוקד = שקר
        זה.בלחיצה = ריק
    }
    פונקציה קבע_טקסט(t) {
        זה.טקסט = t
        זה.בקש_רענון()
    }
    פונקציה קרא_טקסט() {
        החזר זה.טקסט
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה מא = 28
        משתנה מי = 30
        משתנה מכ = 36
        אם (זה.ממוקד) {
            מא = 32
            מי = 36
            מכ = 44
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 6, מא, מי, מכ)
        אם (זה.ממוקד) {
            משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
            מלבן_מעוגל_מלא(משטח, זה.x + 4, זה.y + זה.גבה - 2, זה.רחב - 8, 2, 1)
        }
        משטח.קבע_גודל_גופן(11)
        אם (זה.טקסט == "" או זה.טקסט == ריק) {
            משטח.קבע_צבע(100, 108, 118)
            צייר_טקסט_ברכיב(משטח, זה, זה.מקום_שמור, זה.y + 6, 8)
        } אחרת {
            משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
            צייר_טקסט_ברכיב(משטח, זה, זה.טקסט, זה.y + 6, 8)
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        זה.ממוקד = אמת
        זה.בקש_רענון()
        אם (זה.בלחיצה != ריק) {
            זה.בלחיצה()
        }
        החזר אמת
    }
}
