// חלון_מודאלי.יוד — Modal / Dialog
כלול "פקד.יוד"

מחלקה חלון_מודאלי מרחיב פקד {
    פונקציה בנאי(כותרת, גוף = "", מזהה = "") {
        אם (כותרת == ריק) {
            כותרת = ""
        }
        אם (גוף == ריק) {
            גוף = ""
        }
        הורה(מזהה)
        זה.כותרת = כותרת
        זה.גוף = גוף
        זה.טקסט = כותרת
        זה.כפתור_פעולה = ""
        זה._סגירה = ריק
        זה._פעולה = ריק
        זה._צור("חלון_מודאלי", {
            "כותרת": כותרת,
            "גוף": גוף
        })
    }

    פונקציה הצג() {
        זה._שלח_פקודה("הצג", {})
    }

    פונקציה הסתר() {
        זה._שלח_פקודה("הסתר", {})
    }

    פונקציה קבע_כותרת(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.כותרת = ט
        זה._שלח_פקודה("קבע_כותרת", { "כותרת": ט })
    }

    פונקציה קבע_גוף(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.גוף = ט
        זה._שלח_פקודה("קבע_גוף", { "גוף": ט })
    }

    פונקציה קבע_כפתור_פעולה(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.כפתור_פעולה = ט
        זה._שלח_פקודה("קבע_כפתור_פעולה", { "טקסט": ט })
    }

    פונקציה בסגירה(פונק) {
        זה._סגירה = פונק
    }

    פונקציה בפעולה(פונק) {
        זה._פעולה = פונק
    }
}
