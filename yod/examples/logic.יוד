// יוד 0.35 — לוגיקה, השמה מורכבת, צמצם, מתמטיקה

משתנה א = 5
א += 3
הדפס: "א אחרי += : " + א

אם א > 5 וגם א < 20
  הדפס "וגם עובד"
סוף

אם שקר או אמת
  הדפס "או עובד"
סוף

הדפס: "לא שקר = " + לא שקר

משתנה ר = [1, 2, 3, 4]
הדפס: "צמצם: " + ר.צמצם(0, פונקציה(ס, x)
  החזר ס + x
סוף)
הדפס: "כל >0? " + ר.כל(פונקציה(x) החזר x > 0; סוף)
הדפס: "יש_כל זוגי? " + ר.יש_כל(פונקציה(x) החזר x % 2 == 0; סוף)
הדפס: "ספור זוגיים: " + ר.ספור(פונקציה(x) החזר x % 2 == 0; סוף)

משתנה מ = { "א": 1, "ב": 10, "ג": 5 }
הדפס: "סנן מילון: " + מ.סנן(פונקציה(v) החזר v >= 5; סוף).שמות().הצטרף(",")

כלול "מתמטיקה"
הדפס: "פי≈ " + מתמטיקה.פי.עשרוניות(4)
הדפס: "סינוס(פי/2)≈ " + מתמטיקה.סינוס(מתמטיקה.פי / 2).עשרוניות(4)
