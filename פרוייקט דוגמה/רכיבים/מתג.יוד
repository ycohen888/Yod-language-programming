// מתג.יוד — מתג הפעלה/כיבוי מצויר

מחלקה מתג מרחיב רכיב
  פונקציה בנאי(x, y, דלוק)
    הורה(x, y, 52, 28)
    זה.דלוק = דלוק
    זה.בשינוי = ריק
  סוף

  פונקציה קבע_דלוק(v)
    זה.דלוק = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה מא = 48
    משתנה מי = 50
    משתנה מכ = 56
    אם זה.דלוק
      מא = 14
      מי = 124
      מכ = 112
    סוף
    משטח.קבע_מילוי(מא, מי, מכ)
    משטח.מלבן_מלא(זה.x, זה.y, זה.רחב, זה.גבה)
    משטח.קבע_מילוי(230, 230, 230)
    משתנה kx = זה.x + 4
    אם זה.דלוק
      kx = זה.x + זה.רחב - זה.גבה + 4
    סוף
    משטח.עיגול_מלא(kx + (זה.גבה - 8) / 2, זה.y + זה.גבה / 2, (זה.גבה - 8) / 2)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.דלוק
      זה.דלוק = שקר
    אחרת
      זה.דלוק = אמת
    סוף
    זה.בקש_רענון()
    אם זה.בשינוי != ריק
      זה.בשינוי(זה.דלוק)
    סוף
    החזר אמת
  סוף
סוף
