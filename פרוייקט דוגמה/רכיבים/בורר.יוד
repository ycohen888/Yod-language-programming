// בורר.יוד — רדיו קומפקטי (עיגולים מלאים בלבד)
מחלקה בורר מרחיב רכיב {
    פונקציה בנאי(x, y, טקסט, קבוצה, מזהה) {
        הורה(x, y, 120, 22)
        זה.טקסט = טקסט
        זה.קבוצה = קבוצה
        זה.מזהה = מזהה
        זה.נבחר = שקר
        זה.בשינוי = ריק
        זה.רדיוס = 7
    }
    פונקציה קבע_נבחר(v) {
        זה.נבחר = v
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה cx = זה.x + זה.רדיוס
        משתנה cy = זה.y + זה.גבה / 2
        משטח.קבע_מילוי(52, 56, 64)
        משטח.עיגול_מלא(cx, cy, זה.רדיוס)
        משטח.קבע_מילוי(34, 36, 42)
        משטח.עיגול_מלא(cx, cy, זה.רדיוס - 2)
        אם (זה.נבחר) {
            משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
            משטח.עיגול_מלא(cx, cy, זה.רדיוס - 4)
        }
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        משטח.קבע_גודל_גופן(12)
        משטח.טקסט(זה.טקסט, זה.x + זה.רדיוס * 2 + 8, זה.y + 4)
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        אם (זה.קבוצה != ריק) {
            זה.קבוצה.הצב_נבחר(זה.מזהה)
        }
        החזר אמת
    }
}

מחלקה קבוצת_בורר {
    פונקציה בנאי() {
        זה.אפשרויות = []
        זה.נבחר = ריק
        זה.בשינוי = ריק
    }
    פונקציה הוסף(ב) {
        ב.קבוצה = זה
        זה.אפשרויות.הוסף(ב)
    }
    פונקציה הצב_נבחר(מזהה) {
        זה.נבחר = מזהה
        עבור (ב בתוך זה.אפשרויות) {
            ב.קבע_נבחר(ב.מזהה == מזהה)
        }
        אם (זה.בשינוי != ריק) {
            זה.בשינוי(מזהה)
        }
    }
}
