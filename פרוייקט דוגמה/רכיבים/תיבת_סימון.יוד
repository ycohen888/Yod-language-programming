// תיבת_סימון.יוד — תיבת סימון מעוגלת

מחלקה תיבת_סימון מרחיב רכיב
  פונקציה בנאי(x, y, טקסט, מסומן)
    הורה(x, y, 220, 28)
    זה.טקסט = טקסט
    זה.מסומן = מסומן
    זה.בשינוי = ריק
    זה.גודל_תיבה = 20
  סוף

  פונקציה קבע_מסומן(v)
    זה.מסומן = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה bx = זה.x
    משתנה by = זה.y + (זה.גבה - זה.גודל_תיבה) / 2
    אם זה.מסומן
      משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
      מלבן_מעוגל_מלא(משטח, bx, by, זה.גודל_תיבה, זה.גודל_תיבה, 5)
      משטח.קבע_צבע(240, 250, 248)
      משטח.קבע_עובי(2)
      משטח.קו(bx + 4, by + 10, bx + 8, by + 14)
      משטח.קו(bx + 8, by + 14, bx + 15, by + 5)
    אחרת
      מלבן_מעוגל_עם_גבול(משטח, bx, by, זה.גודל_תיבה, זה.גודל_תיבה, 5, 36, 38, 44)
    סוף
    משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
    משטח.קבע_גודל_גופן(13)
    משטח.טקסט(זה.טקסט, bx + זה.גודל_תיבה + 10, זה.y + 6)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.מסומן
      זה.מסומן = שקר
    אחרת
      זה.מסומן = אמת
    סוף
    זה.בקש_רענון()
    אם זה.בשינוי != ריק
      זה.בשינוי(זה.מסומן)
    סוף
    החזר אמת
  סוף
סוף
