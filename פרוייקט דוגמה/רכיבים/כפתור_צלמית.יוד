// כפתור_צלמית.יוד — כפתור כלים; סמל ממורכז
מחלקה כפתור_צלמית מרחיב רכיב {
    פונקציה בנאי(x, y, סמל) {
        הורה(x, y, 28, 28)
        זה.סמל = סמל
        זה.פעיל = שקר
        זה.בלחיצה = ריק
    }
    פונקציה קבע_פעיל(v) {
        זה.פעיל = v
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה מא = ערכה_גובה_א
        משתנה מי = ערכה_גובה_י
        משתנה מכ = ערכה_גובה_כ
        אם (זה.פעיל) {
            מא = ערכה_ראשי_א
            מי = ערכה_ראשי_י
            מכ = ערכה_ראשי_כ
        }
        אם (זה.לחוץ) {
            מא = 36
            מי = 38
            מכ = 44
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 6, מא, מי, מכ)
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        משטח.קבע_גודל_גופן(12)
        צייר_טקסט_ממורכז(משטח, זה, זה.סמל, זה.y + 6)
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        זה.לחוץ = אמת
        זה.בקש_רענון()
        החזר אמת
    }
    פונקציה בעכבר_למעלה(mx, my, כפתור) {
        אם (לא זה.לחוץ) {
            החזר ריק
        }
        זה.לחוץ = שקר
        זה.בקש_רענון()
        אם (זה.מכיל(mx, my) וגם זה.בלחיצה != ריק) {
            זה.בלחיצה()
        }
    }
}
