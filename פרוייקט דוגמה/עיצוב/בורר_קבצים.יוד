// בורר_קבצים.יוד — בחירת קובץ/ים (input type=file)
כלול "פקד.יוד"

מחלקה בורר_קבצים מרחיב פקד {
    פונקציה בנאי(רמז = "בחר קובץ…", מקבל = "", מרובה = שקר, מזהה = "") {
        אם (רמז == ריק) {
            רמז = "בחר קובץ…"
        }
        אם (מקבל == ריק) {
            מקבל = ""
        }
        אם (מרובה == ריק) {
            מרובה = שקר
        }
        הורה(מזהה)
        זה.רמז = רמז
        זה.מקבל = מקבל
        זה.מרובה = מרובה
        זה.ערך = ""
        זה.שמות = []
        זה._שינוי = ריק
        זה._צור("בורר_קבצים", {
            "רמז": רמז,
            "מקבל": מקבל,
            "מרובה": מרובה
        })
    }

    פונקציה קבע_מקבל(סוגים) {
        אם (סוגים == ריק) {
            סוגים = ""
        }
        זה.מקבל = סוגים
        זה._שלח_פקודה("קבע_מקבל", { "מקבל": סוגים })
    }

    פונקציה קבע_מרובה(ערך) {
        זה.מרובה = ערך
        זה._שלח_פקודה("קבע_מרובה", { "מרובה": ערך })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה קבל_שמות() {
        החזר זה.שמות
    }

    פונקציה פתח() {
        זה._שלח_פקודה("פתח", {})
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
