# דוגמה: סגנון וגרף בגיליון
כלול "גיליון"

משתנה ד = גיליון.חדש()
ד.קבע_תא("A1", "חודש")
ד.קבע_תא("B1", "מכירות")
ד.קבע_תא("A2", "א")
ד.קבע_תא("B2", 10)
ד.קבע_תא("A3", "ב")
ד.קבע_תא("B3", 25)
ד.קבע_סגנון("A1", { מודגש: אמת, רקע: "#1F4E79", צבע: "#FFFFFF", יישור: "מרכז" })
ד.גרף({ סוג: "עמודות", נתונים: "A1:B3", מיקום: "E2", כותרת: "מכירות" })
ד.שמור_כ("דוגמת_גרף.xlsx")
ד.סגור()
הדפס("נשמר דוגמת_גרף.xlsx")
