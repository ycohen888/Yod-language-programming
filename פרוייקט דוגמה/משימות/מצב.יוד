// מצב.יוד — רשימת משימות, מסנן, חיפוש ובחירה
משתנה משימות = []

משתנה מזהה_הבא = 1

משתנה מסנן = "הכל"

משתנה טקסט_חיפוש = ""

משתנה מזהה_נבחר = ריק

משתנה מצב_עריכה = שקר

משתנה רחף_מזהה = ריק

פונקציה ספור_בוצעו() {
    משתנה n = 0
    עבור מ בתוך משימות {
        אם (מ.בוצע) {
            n = n + 1
        }
    }
    החזר n
}

פונקציה ספור_פתוחות() {
    החזר משימות.גודל() - ספור_בוצעו()
}

פונקציה אחוז_השלמה() {
    אם (משימות.גודל() == 0) {
        החזר 0
    }
    החזר ((ספור_בוצעו() * 100) / משימות.גודל()).שלם()
}

פונקציה מצא_משימה(מזהה) {
    עבור מ בתוך משימות {
        אם (מ.מזהה == מזהה) {
            החזר מ
        }
    }
    החזר ריק
}

פונקציה אינדקס_משימה(מזהה) {
    משתנה i = 0
    כל_עוד (i < משימות.גודל()) {
        אם (משימות[i].מזהה == מזהה) {
            החזר i
        }
        i = i + 1
    }
    החזר -1
}

פונקציה מתאימה_למסנן(מ) {
    אם (מסנן == "פתוחות" וגם מ.בוצע) {
        החזר שקר
    }
    אם (מסנן == "בוצעו" וגם לא מ.בוצע) {
        החזר שקר
    }
    אם (טקסט_חיפוש != "" וגם טקסט_חיפוש != ריק) {
        אם (לא מ.כותרת.מכיל(טקסט_חיפוש)) {
            החזר שקר
        }
    }
    החזר אמת
}

פונקציה משימות_לתצוגה() {
    משתנה תוצאה = []
    עבור מ בתוך משימות {
        אם (מתאימה_למסנן(מ)) {
            תוצאה.הוסף(מ)
        }
    }
    החזר תוצאה
}
