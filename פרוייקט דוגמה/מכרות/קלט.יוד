// קלט.יוד — לחיצות והעברת עכבר (hover)
פונקציה נקודה_במלבן(x, y, rx, ry, rw, rh) {
    אם (x < rx) {
        החזר שקר
    }
    אם (y < ry) {
        החזר שקר
    }
    אם (x > rx + rw) {
        החזר שקר
    }
    אם (y > ry + rh) {
        החזר שקר
    }
    החזר אמת
}

פונקציה קבע_hover(סוג, ערך) {
    אם (hover_סוג == סוג) {
        וגם hover_ערך == ערך
        החזר שקר
    }
    hover_סוג = סוג
    hover_ערך = ערך
    החזר אמת
}

פונקציה נקה_hover() {
    אם (hover_סוג == "") {
        וגם hover_ערך == ריק
        החזר שקר
    }
    hover_סוג = ""
    hover_ערך = ריק
    החזר אמת
}

פונקציה חשב_hover_משחק(x, y) {
    אם (חלקה_פתוחה != ריק) {
        אם (נקודה_במלבן(x, y, 230, 400, 170, 48)) {
            החזר קבע_hover("כפתור", "כרטיס_תביעה")
        }
        אם (נקודה_במלבן(x, y, 420, 400, 160, 48)) {
            החזר קבע_hover("כפתור", "כרטיס_סקר")
        }
        אם (נקודה_במלבן(x, y, 230, 400, 220, 48)) {
            החזר קבע_hover("כפתור", "כרטיס_העמקה")
        }
        אם (נקודה_במלבן(x, y, 620, 400, 140, 48)) {
            החזר קבע_hover("כפתור", "כרטיס_סגור")
        }
        החזר נקה_hover()
    }
    משתנה y_מעגן = גובה_לוח - גובה_מעגן
    אם (נקודה_במלבן(x, y, 20, y_מעגן + 12, 130, 44)) {
        החזר קבע_hover("כפתור", "מעגן_מחנה")
    }
    אם (נקודה_במלבן(x, y, 160, y_מעגן + 12, 140, 44)) {
        החזר קבע_hover("כפתור", "מעגן_ציוד")
    }
    אם (נקודה_במלבן(x, y, 310, y_מעגן + 12, 150, 44)) {
        החזר קבע_hover("כפתור", "מעגן_מכרז")
    }
    אם (נקודה_במלבן(x, y, רוחב_לוח - 200, y_מעגן + 12, 180, 44)) {
        החזר קבע_hover("כפתור", "מעגן_סיום")
    }
    אם (במחנה(x, y)) {
        החזר קבע_hover("כפתור", "מפה_מחנה")
    }
    אם (נקודה_במלבן(x, y, רוחב_לוח - 450, 2, 210, 50)) {
        החזר קבע_hover("תג", 0)
    }
    אם (נקודה_במלבן(x, y, רוחב_לוח - 230, 2, 210, 50)) {
        החזר קבע_hover("תג", 1)
    }
    משתנה אינדקס = מצא_חלקה_בנקודה(x, y)
    אם (אינדקס != ריק) {
        החזר קבע_hover("חלקה", אינדקס)
    }
    החזר נקה_hover()
}

פונקציה על_הזזה(x, y, כפתור) {
    משתנה השתנה = שקר
    אם (מסך == "פתיחה") {
        אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 120, 340, 240, 56)) {
            השתנה = קבע_hover("כפתור", "פתיחה_התחל")
        } אחרת {
            השתנה = נקה_hover()
        } אחרת {
            אם (מסך == "לובי") {
                אם (נקודה_במלבן(x, y, 160, 180, 300, 120)) {
                    השתנה = קבע_hover("כפתור", "לובי_ai")
                } אחרת {
                    אם (נקודה_במלבן(x, y, 540, 180, 300, 120)) {
                        השתנה = קבע_hover("כפתור", "לובי_2p")
                    } אחרת {
                        אם (נקודה_במלבן(x, y, 350, 360, 300, 56)) {
                            השתנה = קבע_hover("כפתור", "לובי_כללים")
                        } אחרת {
                            השתנה = נקה_hover()
                        }
                    }
                } אחרת {
                    אם (מסך == "כללים") {
                        אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 90, 470, 180, 48)) {
                            השתנה = קבע_hover("כפתור", "כללים_חזרה")
                        } אחרת {
                            השתנה = נקה_hover()
                        } אחרת {
                            אם (מסך == "משחק") {
                                השתנה = חשב_hover_משחק(x, y)
                            } אחרת {
                                אם (מסך == "מחנה") {
                                    השתנה = חשב_hover_מחנה(x, y)
                                } אחרת {
                                    אם (מסך == "ציוד") {
                                        אם (נקודה_במלבן(x, y, 110, 510, 220, 44)) {
                                            השתנה = קבע_hover("כפתור", "ציוד_חירום")
                                        } אחרת {
                                            אם (נקודה_במלבן(x, y, 400, 510, 180, 44)) {
                                                השתנה = קבע_hover("כפתור", "ציוד_חזרה")
                                            } אחרת {
                                                השתנה = נקה_hover()
                                            }
                                        } אחרת {
                                            אם (מסך == "דוח") {
                                                אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 110, 540, 220, 52)) {
                                                    השתנה = קבע_hover("כפתור", "דוח_המשך")
                                                } אחרת {
                                                    השתנה = נקה_hover()
                                                } אחרת {
                                                    אם (מסך == "אירוע") {
                                                        אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 110, 380, 220, 50)) {
                                                            השתנה = קבע_hover("כפתור", "אירוע_המשך")
                                                        } אחרת {
                                                            השתנה = נקה_hover()
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        אם (השתנה) {
                            צייר_הכל()
                        }
                    }
                    פונקציה חשב_hover_מחנה(x, y) {
                        אם (נקודה_במלבן(x, y, 110, 220, 170, 42)) {
                            החזר קבע_hover("כפתור", "חנות_מקדחה1")
                        }
                        אם (נקודה_במלבן(x, y, 300, 220, 190, 42)) {
                            החזר קבע_hover("כפתור", "חנות_מקדחה2")
                        }
                        אם (נקודה_במלבן(x, y, 510, 220, 180, 42)) {
                            החזר קבע_hover("כפתור", "חנות_מקדחה3")
                        }
                        אם (נקודה_במלבן(x, y, 160, 290, 200, 42)) {
                            החזר קבע_hover("כפתור", "חנות_פועל")
                        }
                        אם (נקודה_במלבן(x, y, 160, 350, 200, 42)) {
                            החזר קבע_hover("כפתור", "חנות_גלאי")
                        }
                        אם (נקודה_במלבן(x, y, 450, 350, 200, 42)) {
                            החזר קבע_hover("כפתור", "חנות_דינמיט")
                        }
                        אם (נקודה_במלבן(x, y, 160, 420, 260, 42)) {
                            החזר קבע_hover("כפתור", "חנות_נתיב")
                        }
                        אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 80, 520, 160, 46)) {
                            החזר קבע_hover("כפתור", "חנות_חזרה")
                        }
                        החזר נקה_hover()
                    }
                    פונקציה על_לחיצה_פתיחה(x, y) {
                        אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 120, 340, 240, 56)) {
                            מסך = "לובי"
                        }
                    }
                    פונקציה על_לחיצה_לובי(x, y) {
                        אם (נקודה_במלבן(x, y, 160, 180, 300, 120)) {
                            התחל_משחק: אמת
                            החזר ריק
                        }
                        אם (נקודה_במלבן(x, y, 540, 180, 300, 120)) {
                            התחל_משחק: שקר
                            החזר ריק
                        }
                        אם (נקודה_במלבן(x, y, 350, 360, 300, 56)) {
                            מסך = "כללים"
                        }
                    }
                    פונקציה על_לחיצה_כללים(x, y) {
                        אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 90, 470, 180, 48)) {
                            מסך = "לובי"
                        }
                    }
                    פונקציה על_לחיצה_כרטיס(x, y) {
                        משתנה ח = חלקות[חלקה_פתוחה]
                        אם (ח["בעלים"] == ריק) {
                            וגם נקודה_במלבן(x, y, 230, 400, 170, 48)
                            רכוש_חלקה: חלקה_פתוחה
                            החזר ריק
                        }
                        אם (ח["בעלים"] == ריק) {
                            וגם לא ח["נחשף"] וגם שחקנים[תור]["סקר_השבוע"] וגם נקודה_במלבן(x, y, 420, 400, 160, 48)
                            סקר_חלקה: חלקה_פתוחה
                            החזר ריק
                        }
                        אם (ח["בעלים"] == תור) {
                            וגם נקודה_במלבן(x, y, 230, 400, 220, 48)
                            העמק_חלקה: חלקה_פתוחה
                            החזר ריק
                        }
                        אם (נקודה_במלבן(x, y, 620, 400, 140, 48)) {
                            חלקה_פתוחה = ריק
                        }
                    }
                    פונקציה על_לחיצה_משחק(x, y) {
                        אם (חלקה_פתוחה != ריק) {
                            על_לחיצה_כרטיס: x, y {
                                החזר ריק
                            }
                            משתנה y_מעגן = גובה_לוח - גובה_מעגן
                            אם (נקודה_במלבן(x, y, 20, y_מעגן + 12, 130, 44)) {
                                מסך = "מחנה"
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 160, y_מעגן + 12, 140, 44)) {
                                מסך = "ציוד"
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 310, y_מעגן + 12, 150, 44)) {
                                הצע_במכרז()
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, רוחב_לוח - 200, y_מעגן + 12, 180, 44)) {
                                הודעה = שם_שחקן(תור) + " סיימה תור"
                                סיים_תור()
                                החזר ריק
                            }
                            אם (במחנה(x, y)) {
                                מסך = "מחנה"
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, רוחב_לוח - 450, 2, 210, 50)) {
                                אם (תור == 0) {
                                    מסך = "ציוד"
                                }
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, רוחב_לוח - 230, 2, 210, 50)) {
                                אם (תור == 1) {
                                    מסך = "ציוד"
                                }
                                החזר ריק
                            }
                            משתנה אינדקס = מצא_חלקה_בנקודה(x, y)
                            אם (אינדקס != ריק) {
                                חלקה_פתוחה = אינדקס
                            }
                        }
                        פונקציה קנה_במחנה_וסיים(הצלחה) {
                            אם (הצלחה) {
                                מסך = "משחק"
                                סיים_תור()
                            }
                        }
                        פונקציה על_לחיצה_מחנה(x, y) {
                            אם (נקודה_במלבן(x, y, 110, 220, 170, 42)) {
                                קנה_במחנה_וסיים: קנה_מקדחה(1)
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 300, 220, 190, 42)) {
                                קנה_במחנה_וסיים: קנה_מקדחה(2)
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 510, 220, 180, 42)) {
                                קנה_במחנה_וסיים: קנה_מקדחה(3)
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 160, 290, 200, 42)) {
                                קנה_במחנה_וסיים: גייס_פועל()
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 160, 350, 200, 42)) {
                                קנה_במחנה_וסיים: קנה_גלאי()
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 450, 350, 200, 42)) {
                                קנה_במחנה_וסיים: קנה_דינמיט()
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 160, 420, 260, 42)) {
                                קנה_במחנה_וסיים: קנה_נתיב()
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 80, 520, 160, 46)) {
                                מסך = "משחק"
                            }
                        }
                        פונקציה על_לחיצה_ציוד(x, y) {
                            אם (נקודה_במלבן(x, y, 110, 510, 220, 44)) {
                                מכירה_חירום()
                                מסך = "משחק"
                                החזר ריק
                            }
                            אם (נקודה_במלבן(x, y, 400, 510, 180, 44)) {
                                מסך = "משחק"
                            }
                        }
                        פונקציה על_לחיצה_דוח(x, y) {
                            אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 110, 540, 220, 52)) {
                                הפקד_דוח_והמשך()
                            }
                        }
                        פונקציה על_לחיצה_אירוע(x, y) {
                            אם (נקודה_במלבן(x, y, רוחב_לוח / 2 - 110, 380, 220, 50)) {
                                התחל_שבוע_חדש()
                            }
                        }
                        פונקציה על_לחיצה(x, y, כפתור) {
                            אם (מסך == "פתיחה") {
                                על_לחיצה_פתיחה: x, y {
                                } אחרת {
                                    אם (מסך == "לובי") {
                                        על_לחיצה_לובי: x, y {
                                        } אחרת {
                                            אם (מסך == "כללים") {
                                                על_לחיצה_כללים: x, y {
                                                } אחרת {
                                                    אם (מסך == "משחק") {
                                                        על_לחיצה_משחק: x, y {
                                                        } אחרת {
                                                            אם (מסך == "מחנה") {
                                                                על_לחיצה_מחנה: x, y {
                                                                } אחרת {
                                                                    אם (מסך == "ציוד") {
                                                                        על_לחיצה_ציוד: x, y {
                                                                        } אחרת {
                                                                            אם (מסך == "דוח") {
                                                                                על_לחיצה_דוח: x, y {
                                                                                } אחרת {
                                                                                    אם (מסך == "אירוע") {
                                                                                        על_לחיצה_אירוע: x, y
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        צייר_הכל()
                                                    }
