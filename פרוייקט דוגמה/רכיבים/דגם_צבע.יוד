// דגם_צבע.יוד — ריבוע צבע מעוגל לחיץ

מחלקה דגם_צבע_משטח מרחיב רכיב
  פונקציה בנאי(x, y, גודל, אדום, ירוק, כחול)
    הורה(x, y, גודל, גודל)
    זה.אדום = אדום
    זה.ירוק = ירוק
    זה.כחול = כחול
    זה.נבחר = שקר
    זה.בלחיצה = ריק
  סוף

  פונקציה קבע_נבחר(v)
    זה.נבחר = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    אם זה.נבחר
      משטח.קבע_מילוי(255, 255, 255)
      מלבן_מעוגל_מלא(משטח, זה.x - 2, זה.y - 2, זה.רחב + 4, זה.גבה + 4, 8)
    סוף
    משטח.קבע_מילוי(זה.אדום, זה.ירוק, זה.כחול)
    מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 7)
    משטח.קבע_מילוי(0, 0, 0)
    // וינייטה קלה בתחתית
    משטח.קבע_מילוי(זה.אדום / 2, זה.ירוק / 2, זה.כחול / 2)
    מלבן_מעוגל_מלא(משטח, זה.x + 2, זה.y + זה.גבה - 8, זה.רחב - 4, 6, 3)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.בלחיצה != ריק
      זה.בלחיצה(זה.אדום, זה.ירוק, זה.כחול)
    סוף
    החזר אמת
  סוף
סוף
