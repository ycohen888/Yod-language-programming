// חלון_צף.יוד — Popover ליד טריגר
כלול "פקד.יוד"

מחלקה חלון_צף מרחיב פקד {
    פונקציה בנאי(כותרת, גוף = "", טקסט_טריגר = "מידע", מזהה = "") {
        אם (כותרת == ריק) {
            כותרת = ""
        }
        אם (גוף == ריק) {
            גוף = ""
        }
        אם (טקסט_טריגר == ריק או טקסט_טריגר == "") {
            טקסט_טריגר = "מידע"
        }
        הורה(מזהה)
        זה.כותרת = כותרת
        זה.גוף = גוף
        זה.טקסט = טקסט_טריגר
        זה.יעד = ""
        זה._סגירה = ריק
        זה._צור("חלון_צף", {
            "כותרת": כותרת,
            "גוף": גוף,
            "טקסט": טקסט_טריגר
        })
    }

    פונקציה הצג() {
        זה._שלח_פקודה("הצג", {})
    }

    פונקציה הסתר() {
        זה._שלח_פקודה("הסתר", {})
    }

    פונקציה קבע_כותרת(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.כותרת = ט
        זה._שלח_פקודה("קבע_כותרת", { "כותרת": ט })
    }

    פונקציה קבע_גוף(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.גוף = ט
        זה._שלח_פקודה("קבע_גוף", { "גוף": ט })
    }

    פונקציה קבע_יעד(מזהה_יעד) {
        אם (מזהה_יעד == ריק) {
            מזהה_יעד = ""
        }
        זה.יעד = מזהה_יעד
        זה._שלח_פקודה("קבע_יעד", { "יעד": מזהה_יעד })
    }

    פונקציה בסגירה(פונק) {
        זה._סגירה = פונק
    }
}
