// התחל.יוד — דמו עם תווית שם מעל כל פקד (לבדיקה)
כלול "חלונות"
כלול "קבצים"
כלול "מערכת"
כלול "עיצוב_הכל.יוד"

משתנה סטטוס = ריק
משתנה ד = ריק
משתנה כהה = אמת
משתנה ימין = אמת
משתנה מודל = ריק
משתנה טוסט = ריק

פונקציה שם_פקד(שם) {
    חדש תווית: שם, "משני"
}

פונקציה הפעל() {
    משתנה ח = חלונות.חלון("עיצוב · בדיקת פקדים")
    ח.קבע_גודל(980, 900)
    ח.קבע_כהה(אמת)

    סטטוס = חלונות.תווית("עיצוב")
    ד = חלונות.דפדפן()
    עיצוב_פתח(ד)

    עיצוב_בעת_מוכן(פונקציה() {
        סטטוס.קבע_טקסט("עיצוב")
    })

    חדש תווית: "גלריית פקדים (שם מעל כל אחד)", "כותרת"
    חדש תווית: "כותרת ותת־כותרת מתאימות ל־dark/בהיר ול־RTL/LTR", "תת_כותרת"
    חדש מפריד: ""

    שם_פקד("תווית — כותרת + תת_כותרת")
    חדש תווית: "ברוכים הבאים לספריית עיצוב", "כותרת"
    חדש תווית: "תת־כותרת לדוגמה — טקסט משני מתחת לכותרת", "תת_כותרת"
    חדש מפריד: ""

    שם_פקד("פירורי_לחם")
    חדש פירורי_לחם: ["ראשי", "עיצוב", "דמו"]

    שם_פקד("סרגל_עליון (תפריט מקונן + איקון + מפריד + רוחב_מלא)")
    משתנה עליון = חדש סרגל_עליון: "יוד", [
        "ראשי",
        {
            "טקסט": "קובץ",
            "איקון": "תיקיה",
            "ילדים": [
                { "טקסט": "חדש", "ערך": "קובץ.חדש", "איקון": "חדש" },
                {
                    "טקסט": "פתח",
                    "ערך": "קובץ.פתח",
                    "ילדים": [
                        { "טקסט": "מקומי", "ערך": "קובץ.פתח.מקומי" },
                        { "טקסט": "מרוחק", "ערך": "קובץ.פתח.מרוחק" }
                    ]
                },
                "-",
                { "טקסט": "שמור", "ערך": "קובץ.שמור", "איקון": "שמור" },
                { "טקסט": "מחק", "ערך": "קובץ.מחק", "איקון": "מחק" }
            ]
        },
        {
            "טקסט": "עריכה",
            "ילדים": [
                { "טקסט": "העתק", "ערך": "עריכה.העתק" },
                { "טקסט": "הדבק", "ערך": "עריכה.הדבק" },
                "ריק",
                { "טקסט": "נקה", "ערך": "עריכה.נקה", "איקון": "נקה" }
            ]
        },
        {
            "טקסט": "עזרה",
            "רוחב_מלא": אמת,
            "ילדים": [
                { "סוג": "כותרת", "טקסט": "מדריכים" },
                { "טקסט": "מדריך משתמש", "ערך": "עזרה.מדריך", "איקון": "מדריך" },
                { "טקסט": "קיצורי מקלדת", "ערך": "עזרה.קיצורים" },
                "ריק",
                { "סוג": "כותרת", "טקסט": "אודות" },
                { "טקסט": "גרסת ספריית עיצוב", "ערך": "עזרה.גרסה" },
                { "טקסט": "אודות יוד", "ערך": "עזרה.אודות" }
            ]
        },
        "הגדרות"
    ], "ראשי"
    עליון.בלחיצה(פונקציה(ע) {
        סטטוס.קבע_טקסט("עליון: " + ע)
    })

    שם_פקד("סרגל_צד (קבוצות מתקפלות)")
    משתנה צד = חדש סרגל_צד: "ניווט", [
        { "טקסט": "לוח בקרה", "ערך": "לוח בקרה", "איקון": "רשימה" },
        "-",
        {
            "טקסט": "קבצים",
            "איקון": "תיקיה",
            "ילדים": [
                { "טקסט": "מקומיים", "ערך": "קבצים.מקומי" },
                { "טקסט": "מרוחקים", "ערך": "קבצים.מרוחק" },
                { "טקסט": "ארכיון", "ערך": "קבצים.ארכיון" }
            ]
        },
        {
            "טקסט": "משתמשים",
            "ילדים": [
                { "טקסט": "רשימה", "ערך": "משתמשים.רשימה" },
                { "טקסט": "הרשאות", "ערך": "משתמשים.הרשאות" }
            ]
        },
        "ריק",
        { "טקסט": "יומן", "ערך": "יומן" },
        { "טקסט": "הגדרות", "ערך": "הגדרות" }
    ], "לוח בקרה"
    צד.בלחיצה(פונקציה(ע) {
        סטטוס.קבע_טקסט("צד: " + ע)
    })

    שם_פקד("הסבר_צף (tippy)")
    חדש הסבר_צף: "Tooltip מופעל עם tippy.js מקומי", "?"

    שם_פקד("כפתור + חלון_מודאלי + הודעה_קופצת")
    מודל = חדש חלון_מודאלי: "שלום", "זה חלון מודאלי מ־ספריית עיצוב"
    מודל.בסגירה(פונקציה() {
        סטטוס.קבע_טקסט("המודל נסגר")
    })
    טוסט = חדש הודעה_קופצת: "נשמר בהצלחה", "הצלחה"

    משתנה כ_מודל = חדש כפתור: "פתח מודל", "ראשי"
    כ_מודל.קשר_הצגה(מודל)
    כ_מודל.בלחיצה(פונקציה() {
        סטטוס.קבע_טקסט("פותח מודל…")
    })
    משתנה כ_טוסט = חדש כפתור: "הצג טוסט", "משני"
    כ_טוסט.קשר_הצגה(טוסט)
    כ_טוסט.בלחיצה(פונקציה() {
        סטטוס.קבע_טקסט("טוסט")
    })

    שם_פקד("חלון_צף (Popover)")
    משתנה צף = חדש חלון_צף: "עזרה", "חלון צף ליד הכפתור — נסגר בלחיצה בחוץ או ב־X", "מידע"
    צף.בסגירה(פונקציה() {
        סטטוס.קבע_טקסט("חלון צף נסגר")
    })
    משתנה כ_צף = חדש כפתור: "פתח חלון צף", "מידע"
    כ_צף.קשר_הצגה(צף)

    שם_פקד("בורר_קבצים")
    משתנה קבצים = חדש בורר_קבצים: "בחר קובץ…", "image/*,.txt,.pdf", שקר
    קבצים.בשינוי(פונקציה(שם) {
        סטטוס.קבע_טקסט("קובץ: " + שם)
    })

    שם_פקד("דוגם_צבע")
    משתנה דוגם = חדש דוגם_צבע: "בחירת צבע", "#0d6efd"
    דוגם.בשינוי(פונקציה(צבע) {
        סטטוס.קבע_טקסט("צבע: " + צבע)
    })

    שם_פקד("השלמה_אוטומטית")
    משתנה השלמה = חדש השלמה_אוטומטית: ["ירושלים", "תל אביב", "חיפה", "באר שבע", "נתניה", "אשדוד"], "עיר…"
    השלמה.בשינוי(פונקציה(ע) {
        סטטוס.קבע_טקסט("השלמה: " + ע)
    })

    שם_פקד("כפתור_מפוצל")
    משתנה מפוצל = חדש כפתור_מפוצל: "שמור", ["שמור בשם", "ייצוא", "שלח"], "ראשי"
    מפוצל.בלחיצה(פונקציה(ע) {
        אם (ע == ריק או ע == "") {
            סטטוס.קבע_טקסט("מפוצל: שמור")
        } אחרת {
            סטטוס.קבע_טקסט("מפוצל: " + ע)
        }
    })

    שם_פקד("מדריך_שלבים")
    חדש מדריך_שלבים: ["פרטים", "בחירה", "סיכום"], 1

    שם_פקד("לשוניות")
    חדש לשוניות: [
        { "טקסט": "טופס", "גוף": "כאן שדות בסיסיים" },
        { "טקסט": "תצוגה", "גוף": "כרטיסים ורשימות" }
    ], "טופס"

    שם_פקד("דירוג")
    משתנה דיר = חדש דירוג: 5, 3
    דיר.בשינוי(פונקציה(ע) {
        סטטוס.קבע_טקסט("דירוג: " + ע)
    })

    שם_פקד("קבוצת_כפתורים")
    חדש קבוצת_כפתורים: ["יום", "שבוע", "חודש"]

    שם_פקד("כפתור_איקון")
    משתנה איקון = חדש כפתור_איקון: "★", "אזהרה"
    איקון.בלחיצה(פונקציה() {
        סטטוס.קבע_טקסט("כפתור איקון")
    })

    שם_פקד("כרטיס")
    חדש כרטיס: "כרטיס לדוגמה", "תוכן קצר בכרטיס Bootstrap"

    שם_פקד("טבלה")
    משתנה טב = חדש טבלה: ["שם", "עיר"], [
        ["דני", "תל אביב"],
        ["נועה", "חיפה"],
        ["יוסי", "ירושלים"]
    ]
    טב.בלחיצה(פונקציה(ע) {
        סטטוס.קבע_טקסט("שורה: " + ע)
    })

    שם_פקד("רשת_נתונים (מיון/סינון/מעצבים/גרף/עיצוב מותנה)")
    משתנה רשת_נת = חדש רשת_נתונים: [
        { "מפתח": "שם", "טקסט": "שם", "סינון": אמת },
        { "מפתח": "עיר", "טקסט": "עיר", "סינון": אמת },
        { "מפתח": "גיל", "טקסט": "גיל", "סוג": "מספר", "יישור": "מרכז", "חישוב": "ממוצע" },
        { "מפתח": "מצב", "טקסט": "מצב", "מעצב": "מצב" },
        { "מפתח": "התקדמות", "טקסט": "התקדמות", "מעצב": "פס" },
        { "מפתח": "דירוג", "טקסט": "דירוג", "מעצב": "כוכבים", "מקסימום": 5 },
        { "מפתח": "מגמה", "טקסט": "מגמה", "מעצב": "גרף", "סוג_גרף": "קו" },
        { "מפתח": "ציון", "טקסט": "ציון", "סוג": "מספר", "צבע_מותנה": [
            { "מתי": "קטן", "ערך": 60, "מחלקה": "yod-cell-danger" },
            { "מתי": "בין", "ערך": 60, "ערך2": 85, "מחלקה": "yod-cell-warn" },
            { "מתי": "גדול_שווה", "ערך": 85, "מחלקה": "yod-cell-ok" }
        ] }
    ], [
        { "מזהה": "1", "שם": "דני", "עיר": "תל אביב", "גיל": 34, "מצב": "הצלחה", "התקדמות": 90, "דירוג": 5, "מגמה": [3, 5, 4, 7, 8], "ציון": 92 },
        { "מזהה": "2", "שם": "נועה", "עיר": "חיפה", "גיל": 27, "מצב": "אזהרה", "התקדמות": 60, "דירוג": 3, "מגמה": [6, 4, 5, 3, 4], "ציון": 74 },
        { "מזהה": "3", "שם": "יוסי", "עיר": "ירושלים", "גיל": 41, "מצב": "שגיאה", "התקדמות": 25, "דירוג": 2, "מגמה": [2, 2, 1, 3, 2], "ציון": 48 },
        { "מזהה": "4", "שם": "מאיה", "עיר": "באר שבע", "גיל": 22, "מצב": "הצלחה", "התקדמות": 100, "דירוג": 4, "מגמה": [1, 4, 6, 8, 9], "ציון": 88 }
    ], { "בחירה_מרובה": אמת, "עימוד": אמת, "גודל_עמוד": 3, "נושא": "אוטומטי" }
    רשת_נת.בלחיצה(פונקציה(ע) {
        סטטוס.קבע_טקסט("נבחר מזהה: " + ע)
    })
    רשת_נת.בבחירה(פונקציה(מזהים) {
        סטטוס.קבע_טקסט("נבחרו " + מזהים.אורך + " שורות")
    })

    שם_פקד("רשת_נתונים — כלים")
    משתנה נושא_כהה_רשת = שקר
    חדש כפתור_איקון: "📋", "משני"
    משתנה כ_העתק = חדש כפתור: "העתק ללוח", "משני"
    כ_העתק.בלחיצה(פונקציה() {
        רשת_נת.העתק()
        סטטוס.קבע_טקסט("הועתק ללוח")
    })
    משתנה כ_ייצוא = חדש כפתור: "ייצא CSV", "משני"
    כ_ייצוא.בלחיצה(פונקציה() {
        רשת_נת.ייצא("csv", "ייצוא_רשת.csv")
    })
    רשת_נת.בעת_ייצוא(פונקציה(פורמט, נתיב) {
        סטטוס.קבע_טקסט("יוצא " + פורמט + " אל " + נתיב)
    })
    משתנה כ_נושא = חדש כפתור: "נושא רשת: בהיר/כהה", "משני"
    כ_נושא.בלחיצה(פונקציה() {
        נושא_כהה_רשת = לא נושא_כהה_רשת
        אם (נושא_כהה_רשת) {
            רשת_נת.קבע_נושא("כהה")
        } אחרת {
            רשת_נת.קבע_נושא("בהיר")
        }
    })

    שם_פקד("תמונת_פרופיל")
    משתנה פרופיל = חדש תמונת_פרופיל: "דני כהן", "", "בינוני"
    פרופיל.בלחיצה(פונקציה() {
        סטטוס.קבע_טקסט("פרופיל נלחץ")
    })
    חדש תמונת_פרופיל: "נ", "", "קטן"
    חדש תמונת_פרופיל: "מנהל מערכת", "", "גדול"

    שם_פקד("רשימה א")
    חדש רשימה: ["פריט א", "פריט ב", "פריט ג"]

    שם_פקד("רשימה ב (נפרדת)")
    חדש רשימה: ["תפוח", "בננה", "תפוז"]

    שם_פקד("אקורדיון (כל פאנל בנפרד)")
    חדש אקורדיון: [
        { "כותרת": "שאלה 1", "גוף": "תשובה ראשונה — נפתחת לבד" },
        { "כותרת": "שאלה 2", "גוף": "תשובה שנייה — נפתחת לבד" }
    ]

    שם_פקד("תצוגת_עץ")
    משתנה עץ = חדש תצוגת_עץ: [
        {
            "טקסט": "פרויקטים",
            "ערך": "projects",
            "ילדים": [
                { "טקסט": "עיצוב", "ערך": "design" },
                { "טקסט": "גיבוי", "ערך": "backup" }
            ]
        },
        {
            "טקסט": "הגדרות",
            "ערך": "settings",
            "ילדים": [
                { "טקסט": "משתמש", "ערך": "user" },
                { "טקסט": "ערכת נושא", "ערך": "theme" }
            ]
        }
    ], ""
    עץ.בלחיצה(פונקציה(ע) {
        סטטוס.קבע_טקסט("עץ: " + ע)
    })

    שם_פקד("הצגת_קבצים (מקומי)")
    משתנה דפדפן_קבצים = חדש הצגת_קבצים: []
    דפדפן_קבצים.בלחיצה(פונקציה(ע) {
        סטטוס.קבע_טקסט("קובץ: " + ע)
    })
    נסה {
        דפדפן_קבצים.טען_מקומי(מערכת.תיקייה())
    } תפוס שגיאה {
        דפדפן_קבצים.קבע_פריטים([
            {
                "שם": "תיקיית_דוגמה",
                "ערך": "demo_dir",
                "סוג": "תיקיה",
                "גודל": 0,
                "תאריך": "",
                "ילדים": [],
                "יש_ילדים": אמת
            },
            {
                "שם": "readme.txt",
                "ערך": "demo_readme",
                "סוג": "קובץ",
                "סיומת": "txt",
                "גודל": 1200,
                "תאריך": "1700000000",
                "הרשאות": "-rw-r--r--",
                "בעלות": "יוד"
            }
        ])
    }

    שם_פקד("קרוסלה")
    משתנה קרו = חדש קרוסלה: [
        { "כותרת": "שקופית 1", "גוף": "ברוכים הבאים לספריית עיצוב" },
        { "כותרת": "שקופית 2", "גוף": "פקדים בעברית מעל Bootstrap" },
        { "כותרת": "שקופית 3", "גוף": "רצוי לנסות את החיצים והנקודות" }
    ], 0
    קרו.בשינוי(פונקציה(ע) {
        סטטוס.קבע_טקסט("קרוסלה: " + (ע + 1))
    })

    שם_פקד("רשת")
    חדש רשת: 2, ["עמודה א", "עמודה ב", "עמודה ג", "עמודה ד"]

    שם_פקד("שלד_טעינה")
    חדש שלד_טעינה: 3

    שם_פקד("עמודים")
    חדש עמודים: 5, 2

    שם_פקד("תג")
    חדש תג: "חדש", "הצלחה"

    שם_פקד("התרעה")
    חדש התרעה: "זו התרעה (Alert)", "מידע"

    שם_פקד("שדה")
    חדש שדה: "הקלד כאן…", "טקסט"

    שם_פקד("אזור_טקסט")
    חדש אזור_טקסט: "כמה שורות…", 3

    שם_פקד("תיבת_סימון א")
    חדש תיבת_סימון: "מסומן לדוגמה", שקר

    שם_פקד("תיבת_סימון ב (נפרדת)")
    חדש תיבת_סימון: "עוד תיבה", אמת

    שם_פקד("מתג א")
    חדש מתג: "התראות", אמת

    שם_פקד("מתג ב (נפרד)")
    חדש מתג: "מצב לילה", שקר

    שם_פקד("תיבת_בחירה")
    חדש תיבת_בחירה: ["אפשרות א", "אפשרות ב"], "אפשרות א"

    שם_פקד("לחצן_אפשרויות א")
    חדש לחצן_אפשרויות: ["אחד", "שתיים", "שלוש"], "אחד"

    שם_פקד("לחצן_אפשרויות ב (נפרד)")
    חדש לחצן_אפשרויות: ["אדום", "ירוק", "כחול"], "ירוק"

    שם_פקד("סרגל")
    חדש סרגל: 0, 100, 40

    שם_פקד("פס_התקדמות")
    חדש פס_התקדמות: 40

    שם_פקד("בורר_צבע")
    חדש בורר_צבע: "#0d6efd"

    שם_פקד("בורר_תאריך")
    משתנה תאריך = חדש בורר_תאריך: "", "תאריך"
    תאריך.בשינוי(פונקציה(ע) {
        סטטוס.קבע_טקסט("תאריך: " + ע)
    })

    שם_פקד("בורר_שעה")
    משתנה שעה = חדש בורר_שעה: "", שקר
    שעה.בשינוי(פונקציה(ע) {
        סטטוס.קבע_טקסט("שעה: " + ע)
    })

    שם_פקד("טעינה")
    חדש טעינה: "טוען…"

    שם_פקד("מכל")
    חדש מכל: "רגיל"

    שם_פקד("מפריד")
    חדש מפריד: ""

    שם_פקד("מרווח (16px)")
    חדש מרווח: 16

    משתנה כ_נושא = חלונות.כפתור("נושא")
    כ_נושא.בלחיצה(פונקציה() {
        כהה = לא כהה
        אם (כהה) {
            עיצוב_קבע_נושא("כהה")
            סטטוס.קבע_טקסט("עיצוב · כהה")
        } אחרת {
            עיצוב_קבע_נושא("בהיר")
            סטטוס.קבע_טקסט("עיצוב · בהיר")
        }
    })

    משתנה כ_כיוון = חלונות.כפתור("כיוון")
    כ_כיוון.בלחיצה(פונקציה() {
        ימין = לא ימין
        אם (ימין) {
            עיצוב_קבע_כיוון("ימין_לשמאל")
            סטטוס.קבע_טקסט("עיצוב · ימין ← שמאל")
        } אחרת {
            עיצוב_קבע_כיוון("שמאל_לימין")
            סטטוס.קבע_טקסט("עיצוב · שמאל → ימין")
        }
    })

    // סרגל עליון דק; הדפדפן ממלא את שאר הגובה בצמוד (בלי מסגרת נוספת סביב)
    משתנה סרגל_חוץ = חלונות.מסגרת("אופקי")
    סרגל_חוץ.קבע_מתיחה(0)
    סרגל_חוץ.הוסף(סטטוס)
    סרגל_חוץ.הוסף(כ_נושא)
    סרגל_חוץ.הוסף(כ_כיוון)

    ח.הוסף(סרגל_חוץ)
    ח.הוסף(ד)
    ח.הצג()
}

הפעל()
