// שרת HTTP בקונסול (בלי חלון).
// לחלון ניהול עם כפתורים ולד — הריצו: examples\server_gui.יוד

כלול "רשת"

משתנה שרת = רשת.שרת(8080)
שרת.מסלול("/", פונקציה(בקשה)
  החזר: "שלום משרת יוד! שיטה=" + בקשה["שיטה"]
סוף
)
שרת.מסלול("/בריאות", פונקציה(בקשה)
  החזר: { "קוד": 200, "גוף": "תקין" }
סוף
)

הדפס: "שרת רץ על " + שרת.כתובת
הדפס: "פתחו בדפדפן: http://127.0.0.1:8080"
הדפס: "עצרו עם Ctrl+C"
שרת.הפעל()
