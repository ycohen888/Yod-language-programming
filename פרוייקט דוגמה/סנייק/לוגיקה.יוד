// לוגיקה.יוד — תנועה, התנגשויות, מזון וטיימר
פונקציה תא_תפוס(x, y) {
    עבור (ת בתוך גוף) {
        אם (ת["x"] == x וגם ת["y"] == y) {
            החזר אמת
        }
    }
    החזר שקר
}

פונקציה הצב_מזון() {
    משתנה ניסיונות = 0
    משתנה מקס_x = עמודות - 1
    משתנה מקס_y = שורות - 1
    כל_עוד (ניסיונות < 400) {
        משתנה fx = אקראי_בין: 0, מקס_x
        משתנה fy = אקראי_בין: 0, מקס_y
        אם (לא תא_תפוס(fx, fy)) {
            מזון_x = fx
            מזון_y = fy
            החזר ריק
        }
        ניסיונות = ניסיונות + 1
    }
}

פונקציה אתחל_משחק() {
    גוף = [{ "x": 6, "y": 8},{ "x": 5, "y": 8},{ "x": 4, "y": 8}]
    כיוון_x = 1
    כיוון_y = 0
    תור_כיוון_x = 1
    תור_כיוון_y = 0
    ניקוד = 0
    אכל = שקר
    מצב_משחק = "מוכן"
    הצב_מזון()
    עצור_טיימר()
    צייר_הכל()
}

פונקציה עצור_טיימר() {
    אם (מזהה_טיימר != ריק) {
        טיימרים.עצור: מזהה_טיימר
        מזהה_טיימר = ריק
    }
}

פונקציה מהירות_נוכחית() {
    משתנה ms = מהירות_התחלה_ms - ניקוד * 2
    אם (ms < מהירות_מינימום_ms) {
        ms = מהירות_מינימום_ms
    }
    החזר ms
}

פונקציה הפעל_טיימר() {
    עצור_טיימר()
    משתנה ms = מהירות_נוכחית()
    מזהה_טיימר = טיימרים.טיימר: ms, צעד_משחק
}

פונקציה התחל_משחק() {
    אם (מצב_משחק == "רץ") {
        החזר ריק
    }
    אם (מצב_משחק == "נגמר" או מצב_משחק == "מוכן") {
        גוף = [{ "x": 6, "y": 8},{ "x": 5, "y": 8},{ "x": 4, "y": 8}]
        כיוון_x = 1
        כיוון_y = 0
        תור_כיוון_x = 1
        תור_כיוון_y = 0
        ניקוד = 0
        אכל = שקר
        הצב_מזון()
    }
    מצב_משחק = "רץ"
    הפעל_טיימר()
    צייר_הכל()
}

פונקציה החלף_הפסקה() {
    אם (מצב_משחק == "רץ") {
        מצב_משחק = "הפסקה"
        אם (מזהה_טיימר != ריק) {
            טיימרים.השהה: מזהה_טיימר
        }
        צייר_הכל()
        החזר ריק
    }
    אם (מצב_משחק == "הפסקה") {
        מצב_משחק = "רץ"
        אם (מזהה_טיימר != ריק) {
            טיימרים.המשך: מזהה_טיימר
        } אחרת {
            הפעל_טיימר()
        }
        צייר_הכל()
    }
}

פונקציה בקש_כיוון(dx, dy) {
    אם (מצב_משחק == "מוכן" או מצב_משחק == "נגמר") {
        התחל_משחק()
    }
    אם (מצב_משחק != "רץ" וגם מצב_משחק != "הפסקה") {
        החזר ריק
    }
    משתנה הפוך_x = 0 - כיוון_x
    משתנה הפוך_y = 0 - כיוון_y
    אם (dx == הפוך_x וגם dy == הפוך_y) {
        החזר ריק
    }
    אם (dx == 0 וגם dy == 0) {
        החזר ריק
    }
    תור_כיוון_x = dx
    תור_כיוון_y = dy
}

פונקציה סיים_משחק() {
    מצב_משחק = "נגמר"
    עצור_טיימר()
    אם (ניקוד > שיא) {
        שיא = ניקוד
    }
    צייר_הכל()
}

פונקציה צעד_משחק() {
    אם (מצב_משחק != "רץ") {
        החזר ריק
    }
    כיוון_x = תור_כיוון_x
    כיוון_y = תור_כיוון_y
    משתנה ראש = גוף[0]
    משתנה nx = ראש["x"] + כיוון_x
    משתנה ny = ראש["y"] + כיוון_y
    אם (nx < 0 או ny < 0 או nx >= עמודות או ny >= שורות) {
        סיים_משחק()
        החזר ריק
    }
    אם (תא_תפוס(nx, ny)) {
        סיים_משחק()
        החזר ריק
    }
    משתנה חדש_ראש ={ "x": nx, "y": ny}
    גוף.הוסף_בהתחלה: חדש_ראש
    אם (nx == מזון_x וגם ny == מזון_y) {
        ניקוד = ניקוד + 1
        אכל = אמת
        הצב_מזון()
        הפעל_טיימר()
    } אחרת {
        משתנה זנב_אינדקס = גוף.גודל() - 1
        גוף.הסר: זנב_אינדקס
    }
    צייר_הכל()
}

פונקציה על_מקש(שם) {
    אם (שם == "שמאלה" או שם == "A") {
        בקש_כיוון: הפוך_אופק, 0
    }
    אם (שם == "ימינה" או שם == "D") {
        בקש_כיוון: ישר_אופק, 0
    }
    אם (שם == "למעלה" או שם == "W") {
        בקש_כיוון: 0, למעלה_כ
    }
    אם (שם == "למטה" או שם == "S") {
        בקש_כיוון: 0, למטה_כ
    }
    אם (שם == "רווח" או שם == "P") {
        אם (מצב_משחק == "מוכן" או מצב_משחק == "נגמר") {
            התחל_משחק()
        } אחרת {
            החלף_הפסקה()
        }
    }
    אם (שם == "R") {
        אתחל_משחק()
    }
    אם (שם == "אנטר") {
        התחל_משחק()
    }
}
