// יוד 0.36 — בחר, ??, **, מתודות, מערכת

משתנה מצב = 2
בחר מצב
  מקרה 1
    הדפס "אחד"
  מקרה 2, 3
    הדפס "שניים או שלוש"
  ברירת_מחדל
    הדפס "אחר"
סוף

הדפס: "?? : " + (ריק ?? "ברירת מחדל")
הדפס: "2**10 = " + (2 ** 10)

משתנה ר = [1, 2, 3, 4, 5, 6]
הדפס: "לקח 3: " + ר.לקח(3).הצטרף(",")
הדפס: "חלק 2: " + ר.חלק(2).גודל()
הדפס: "הסר_ראשון: " + ר.הסר_ראשון()

הדפס: "ספור a: " + "banana".ספור_הופעות("a")
הדפס: "קוד א: " + "א".קוד_תו()

כלול "מערכת"
הדפס: "ארגומנטים: " + מערכת.ארגומנטים().גודל()
הדפס: "תיקייה מכילה יוד? " + מערכת.תיקייה().מכיל("yod")
