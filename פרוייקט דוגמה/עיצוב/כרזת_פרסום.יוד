// כרזת_פרסום.יוד — באנר פרסומת נעוץ בתחתית התוכנה
// מציג פרסומת בודדת (תמונה + קישור). ברירת מחדל מקופל (לא תופס מקום)
// עד שמגיעה פרסומת ראשונה. הרוטציה מנוהלת ביוד (ראו פרסום.יוד).
כלול "פקד.יוד"

מחלקה כרזת_פרסום מרחיב פקד {
    פונקציה בנאי(מזהה = "") {
        הורה(מזהה)
        זה._צור("כרזת_פרסום", {})
    }

    // מציג פרסומת אחת (תמונה + קישור) ומרחיב את הרצועה עם מעבר fade
    פונקציה קבע_פרסומת(תמונה, קישור, כותרת = "") {
        אם (כותרת == ריק) {
            כותרת = ""
        }
        זה._שלח_פקודה("קבע_פרסומת", { "תמונה": תמונה, "קישור": קישור, "כותרת": כותרת })
    }

    // הרחבת הרצועה (הצגה)
    פונקציה הצג() {
        זה._שלח_פקודה("הצג", {})
    }

    // קיפול הרצועה (בלי לתפוס מקום)
    פונקציה הסתר() {
        זה._שלח_פקודה("הסתר", {})
    }
}
