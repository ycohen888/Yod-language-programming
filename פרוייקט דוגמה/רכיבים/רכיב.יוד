// רכיב.יוד — בסיס לכל רכיב מצויר על משטח
מחלקה רכיב {
    פונקציה בנאי(x, y, רחב, גבה) {
        זה.x = x
        זה.y = y
        זה.רחב = רחב
        זה.גבה = גבה
        זה.גלוי = אמת
        זה.מושבת = שקר
        זה.לחוץ = שקר
        זה.לוח = ריק
        זה.רמז = ""
    }
    פונקציה קבע_רמז(t) {
        אם (t == ריק) {
            זה.רמז = ""
        } אחרת {
            זה.רמז = t
        }
    }
    פונקציה מקבל_מיקוד() {
        החזר שקר
    }
    פונקציה קבע_מיקוד(v) {
    }
    פונקציה בעת_תו(תו) {
    }
    פונקציה בעת_מקש(שם) {
    }
    פונקציה מכיל(mx, my) {
        אם (!זה.גלוי) {
            החזר שקר
        }
        החזר נקודה_במלבן(mx, my, זה.x, זה.y, זה.רחב, זה.גבה)
    }
    פונקציה צייר(משטח) {
        // נדרס במחלקות יורשות
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        החזר שקר
    }
    פונקציה בעכבר_גרירה(mx, my, כפתור) {
    }
    פונקציה בעכבר_למעלה(mx, my, כפתור) {
    }
    פונקציה בקש_רענון() {
        אם (זה.לוח != ריק) {
            זה.לוח.סמן_רענון()
        }
    }
}
