# דוגמה: רשת — שרת HTTP מקומי + לקוח
כלול "רשת"

רשת.קבע_זמן_קצוב(10)

משתנה שרת = רשת.שרת(8765)
שרת.מסלול("/api", פונקציה(בקשה)
  משתנה שם = "אורח"
  אם בקשה["שאילתה"]["שם"] != ריק
    שם = בקשה["שאילתה"]["שם"]
  סוף
  החזר: { "קוד": 200, "גוף": "שלום " + שם + "!" }
סוף
)

שרת.הפעל_ברקע()
הדפס("שרת: " + שרת.כתובת + "/api?שם=יוד")

זמן.המתן(0.3)

משתנה ת = רשת.גש(שרת.כתובת + "/api?שם=יוד")
הדפס("GET קוד=" + ת.קוד + " גוף=" + ת.גוף)

משתנה ת2 = רשת.פרסם_json(שרת.כתובת + "/api?שם=JSON", "{\"x\":1}")
הדפס("POST קוד=" + ת2.קוד)

שרת.עצור()
הדפס("סיום")
