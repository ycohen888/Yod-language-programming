פונקציה רענון_מצב() {
    אם (תווית_מצב == ריק) {
        החזר ריק
    }
    תווית_מצב.קבע_טקסט("עובי " + עובי.שלם() + " · RGB(" + צבע_א + "," + צבע_י + "," + צבע_כ + ")")
    אם (מונה != ריק) {
        מונה.קבע_ערך(עובי)
    }
    אם (טבעת != ריק) {
        טבעת.קבע_אחוז(עובי * 5)
    }
    אם (פס_א != ריק) {
        פס_א.קבע_אחוז(עובי * 5)
    }
}

פונקציה נקה_בחירת_צבע() {
    ד1.קבע_נבחר(שקר)
    ד2.קבע_נבחר(שקר)
    ד3.קבע_נבחר(שקר)
    ד4.קבע_נבחר(שקר)
    ד5.קבע_נבחר(שקר)
}

פונקציה בחר_כלי_צל(שם) {
    צל1.קבע_פעיל(שם == "ק")
    צל2.קבע_פעיל(שם == "מ")
    צל3.קבע_פעיל(שם == "ע")
    אם (שדה != ריק) {
        שדה.קבע_טקסט("כלי: " + שם)
    }
}

