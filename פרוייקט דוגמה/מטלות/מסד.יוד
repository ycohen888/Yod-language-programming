// מסד.יוד — שכבת נתונים (SQLite) למנהל המטלות
// כל הערכים מוזרקים דרך פרמטרים "?" בלבד — הגנה מפני SQL injection.
כלול "SQL"
כלול "קבצים"
כלול "זמן"
כלול "מערכת"

משתנה _מסד = ריק

// נתיב תיקיית הנתונים (ליד קבצי התוכנה) — נוצרת אוטומטית
פונקציה _תיקיית_נתונים() {
    משתנה בסיס = מערכת.תיקיית_הרצה()
    אם (בסיס == ריק או בסיס == "") {
        בסיס = מערכת.תיקייה()
    }
    החזר בסיס + "\\נתונים"
}

פונקציה פתח_מסד() {
    משתנה תיק = _תיקיית_נתונים()
    אם (לא קבצים.קיים(תיק)) {
        נסה {
            קבצים.צור_תיקייה(תיק)
        } תפוס שגיאה {
        }
    }
    משתנה נתיב = תיק + "\\מטלות.db"
    _מסד = SQL.התחבר(נתיב)
    _מסד.הפעל(
        "CREATE TABLE IF NOT EXISTS מטלות (" +
        "מזהה INTEGER PRIMARY KEY AUTOINCREMENT, " +
        "כותרת TEXT NOT NULL, " +
        "עדיפות TEXT NOT NULL DEFAULT 'רגילה', " +
        "הושלם INTEGER NOT NULL DEFAULT 0, " +
        "נוצר TEXT NOT NULL DEFAULT '')"
    )
    החזר _מסד
}

פונקציה הוסף_מטלה(כותרת, עדיפות) {
    אם (כותרת == ריק) {
        כותרת = ""
    }
    כותרת = כותרת.גזום()
    אם (כותרת == "") {
        החזר שקר
    }
    אם (עדיפות == ריק או עדיפות == "") {
        עדיפות = "רגילה"
    }
    _מסד.הפעל(
        "INSERT INTO מטלות (כותרת, עדיפות, הושלם, נוצר) VALUES (?, ?, 0, ?)",
        כותרת, עדיפות, זמן.עכשיו()
    )
    החזר אמת
}

// עדכון שדה בודד — שם השדה מוגבל לרשימה מאושרת; הערך תמיד דרך "?"
פונקציה עדכן_שדה(מזהה, שדה, ערך) {
    משתנה מותר = ["כותרת", "עדיפות", "הושלם"]
    אם (לא מותר.מכיל(שדה)) {
        החזר שקר
    }
    _מסד.הפעל("UPDATE מטלות SET " + שדה + " = ? WHERE מזהה = ?", ערך, מזהה)
    החזר אמת
}

פונקציה מחק_מטלה(מזהה) {
    _מסד.הפעל("DELETE FROM מטלות WHERE מזהה = ?", מזהה)
}

פונקציה מחק_שהושלמו() {
    _מסד.הפעל("DELETE FROM מטלות WHERE הושלם = 1")
}

פונקציה נקה_הכול() {
    _מסד.הפעל("DELETE FROM מטלות")
}

// מחזיר רשימת מילונים (כותרת/עדיפות/הושלם/נוצר/מזהה), החדשות למעלה
פונקציה שלוף_מטלות() {
    נסה {
        החזר _מסד.שלוף(
            "SELECT מזהה, כותרת, עדיפות, הושלם, נוצר FROM מטלות " +
            "ORDER BY הושלם ASC, מזהה DESC"
        )
    } תפוס שגיאה {
        החזר []
    }
}

פונקציה סגור_מסד() {
    אם (_מסד != ריק) {
        נסה {
            _מסד.סגור()
        } תפוס שגיאה {
        }
    }
}
