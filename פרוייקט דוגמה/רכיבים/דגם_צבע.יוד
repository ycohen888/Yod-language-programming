// דגם_צבע.יוד — דגימת צבע קטנה מעוגלת

מחלקה דגם_צבע_משטח מרחיב רכיב
  פונקציה בנאי(x, y, גודל, אדום, ירוק, כחול)
    הורה(x, y, גודל, גודל)
    זה.אדום = אדום
    זה.ירוק = ירוק
    זה.כחול = כחול
    זה.נבחר = שקר
    זה.בלחיצה = ריק
  סוף

  פונקציה קבע_נבחר(v)
    זה.נבחר = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    אם זה.נבחר
      משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
      מלבן_מעוגל_מלא(משטח, זה.x - 2, זה.y - 2, זה.רחב + 4, זה.גבה + 4, 6)
    סוף
    משטח.קבע_מילוי(זה.אדום, זה.ירוק, זה.כחול)
    מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 5)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.בלחיצה != ריק
      זה.בלחיצה(זה.אדום, זה.ירוק, זה.כחול)
    סוף
    החזר אמת
  סוף
סוף
