כלול "SQL"
משתנה מסד = SQL.התחבר("sqlite", "examples/demo.db")
מסד.הפעל("CREATE TABLE IF NOT EXISTS משתמשים (מזהה INTEGER, שם TEXT)")
מסד.הפעל("DELETE FROM משתמשים")
מסד.הפעל("INSERT INTO משתמשים VALUES (?, ?)", 1, "נועם")
מסד.הפעל("INSERT INTO משתמשים VALUES (?, ?)", 2, "דני")
משתנה שורות = מסד.שלוף("SELECT * FROM משתמשים ORDER BY מזהה")
הדפס: "מספר שורות: " + אורך(שורות)
עבור שורה בתוך שורות
    הדפס: שורה["מזהה"] + ": " + שורה["שם"]
סוף

מסד.סגור()
