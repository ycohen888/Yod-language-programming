// כפתור.יוד — כפתור Bootstrap בתוך ספריית עיצוב
כלול "פקד.יוד"

מחלקה כפתור מרחיב פקד {
    פונקציה בנאי(טקסט, סגנון = "ראשי", מזהה = "") {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        אם (סגנון == ריק או סגנון == "") {
            סגנון = "ראשי"
        }
        הורה(מזהה)
        זה.טקסט = טקסט
        זה.סגנון = סגנון
        זה.יעד_הצגה = ""
        זה._נוצר_בדומ = שקר
    }

    פונקציה _ודא_צור() {
        אם (זה._נוצר_בדומ) {
            החזר ריק
        }
        זה._נוצר_בדומ = אמת
        זה._צור("כפתור", {
            "טקסט": זה.טקסט,
            "סגנון": זה.סגנון,
            "יעד_הצגה": זה.יעד_הצגה
        })
    }

    // חיבור לפני יצירת DOM — כדי שהלחיצה הראשונה כבר תפתח
    פונקציה קשר_הצגה(פקד_יעד) {
        משתנה יעד = ""
        אם (פקד_יעד != ריק) {
            יעד = פקד_יעד.מזהה
        }
        זה.יעד_הצגה = יעד
        אם (זה._נוצר_בדומ) {
            זה._שלח_פקודה("קשר_הצגה", { "יעד": יעד })
        } אחרת {
            זה._ודא_צור()
        }
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
        זה._ודא_צור()
    }
}
