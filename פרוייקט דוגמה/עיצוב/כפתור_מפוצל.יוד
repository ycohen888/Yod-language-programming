// כפתור_מפוצל.יוד — Split button (פעולה ראשית + תפריט)
כלול "פקד.יוד"

מחלקה כפתור_מפוצל מרחיב פקד {
    פונקציה בנאי(טקסט, פריטים, סגנון = "ראשי", מזהה = "") {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (סגנון == ריק או סגנון == "") {
            סגנון = "ראשי"
        }
        הורה(מזהה)
        זה.טקסט = טקסט
        זה.פריטים = פריטים
        זה.סגנון = סגנון
        זה.ערך = ""
        זה._לחץ = ריק
        זה._שינוי = ריק
        זה._צור("כפתור_מפוצל", {
            "טקסט": טקסט,
            "פריטים": פריטים,
            "סגנון": סגנון
        })
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }
}
