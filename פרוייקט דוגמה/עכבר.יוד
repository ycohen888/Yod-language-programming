// עכבר.יוד — לוגיקת ציור לפי כלי (רק קוד יוד)

פונקציה על_עכבר_למטה x, y
  x_התחלה = x
  y_התחלה = y
  x_קודם = x
  y_קודם = y

  אם כלי == "מילוי"
    לוח.קבע_צבע: צבע
    לוח.מלא_באזור: x, y
    החזר ריק
  סוף

  אם כלי == "עיפרון"
    לוח.קבע_צבע: צבע
    לוח.קבע_עובי: עובי
    לוח.נקודה: x, y
    החזר ריק
  סוף

  אם כלי == "מחק"
    לוח.קבע_צבע: "לבן"
    לוח.קבע_עובי: עובי
    אם עובי < 6
      לוח.קבע_עובי: 6
    סוף
    לוח.נקודה: x, y
  סוף
סוף

פונקציה על_עכבר_גרירה x, y
  אם כלי == "עיפרון"
    לוח.קבע_צבע: צבע
    לוח.קבע_עובי: עובי
    לוח.קו: x_קודם, y_קודם, x, y
    x_קודם = x
    y_קודם = y
    החזר ריק
  סוף

  אם כלי == "מחק"
    לוח.קבע_צבע: "לבן"
    משתנה ע = עובי
    אם ע < 6
      ע = 6
    סוף
    לוח.קבע_עובי: ע
    לוח.קו: x_קודם, y_קודם, x, y
    x_קודם = x
    y_קודם = y
  סוף
סוף

פונקציה על_עכבר_למעלה x, y
  לוח.קבע_צבע: צבע
  לוח.קבע_עובי: עובי

  אם כלי == "קו"
    לוח.קו: x_התחלה, y_התחלה, x, y
    החזר ריק
  סוף

  אם כלי == "מלבן"
    משתנה mx = x_התחלה
    משתנה my = y_התחלה
    אם x < x_התחלה
      mx = x
    סוף
    אם y < y_התחלה
      my = y
    סוף
    משתנה rw = (x - x_התחלה).מוחלט()
    משתנה rh = (y - y_התחלה).מוחלט()
    לוח.מלבן: mx, my, rw, rh
    החזר ריק
  סוף

  אם כלי == "עיגול"
    משתנה cx = (x_התחלה + x) / 2
    משתנה cy = (y_התחלה + y) / 2
    משתנה rx = ((x - x_התחלה).מוחלט()) / 2
    משתנה ry = ((y - y_התחלה).מוחלט()) / 2
    משתנה רדיוס = rx
    אם ry > rx
      רדיוס = ry
    סוף
    אם רדיוס < 1
      רדיוס = 1
    סוף
    לוח.עיגול: cx, cy, רדיוס
  סוף
סוף
