// ממשק.יוד — חלון WebView שטוען את ממשק המחשבון (HTML מקומי)
כלול "חלונות"
כלול "קבצים"
כלול "מערכת"

משתנה חלון_ראשי = ריק
משתנה דפדפן_מחשבון = ריק

פונקציה תיקיית_פרויקט() {
    משתנה תיק = מערכת.תיקיית_הרצה()
    אם (תיק == ריק או תיק == "") {
        תיק = מערכת.תיקייה()
    }
    אם (קבצים.קיים(תיק + "\\ממשק.html")) {
        החזר תיק
    }
    אם (קבצים.קיים(תיק + "\\מחשבון\\ממשק.html")) {
        החזר תיק + "\\מחשבון"
    }
    החזר תיק
}

פונקציה לנתיב_file(נתיב) {
    משתנה פ = "" + נתיב
    פ = פ.החלף("\\", "/")
    החזר "file:///" + פ
}

פונקציה בנה_חלון_מחשבון() {
    משתנה ח = חלונות.חלון("מחשבון · יוד")
    חלון_ראשי = ח
    ח.קבע_גודל(380, 640)
    ח.קבע_גודל_קבוע(אמת)
    ח.מרכז()
    ח.קבע_כהה(אמת)
    ח.קבע_רקע(12, 14, 18)

    משתנה תיק = תיקיית_פרויקט()
    נסה {
        אם (קבצים.קיים(תיק + "\\app.ico")) {
            ח.קבע_איקון(תיק + "\\app.ico")
        } אחרת_אם (קבצים.קיים(תיק + "\\נכסים\\app.ico")) {
            ח.קבע_איקון(תיק + "\\נכסים\\app.ico")
        }
    } תפוס שגיאה {
    }

    דפדפן_מחשבון = חלונות.דפדפן()
    נסה {
        דפדפן_מחשבון.קבע_מתיחה(-1)
    } תפוס שגיאה {
    }

    משתנה קובץ = תיק + "\\ממשק.html"
    אם (לא קבצים.קיים(קובץ)) {
        חלונות.הודעה("מחשבון", "לא נמצא ממשק.html בתיקיית הפרויקט:\n" + תיק)
        החזר ריק
    }

    דפדפן_מחשבון.נווט(לנתיב_file(קובץ))
    ח.הוסף(דפדפן_מחשבון)
    ח.הצג()
}
