// אחסון.יוד — טעינה / שמירה / ייצוא JSON
פונקציה משימה_תקינה(מ) {
    אם (מ == ריק) {
        החזר שקר
    }
    אם (מ.מזהה == ריק או מ.כותרת == ריק) {
        החזר שקר
    }
    החזר אמת
}

פונקציה נרמל_משימה(מ) {
    אם (מ.בוצע == ריק) {
        מ.בוצע = שקר
    }
    אם (מ.עדיפות == ריק או מ.עדיפות == "") {
        מ.עדיפות = "רגילה"
    }
    אם (מ.נוצר == ריק) {
        מ.נוצר = ""
    }
    אם (מ.עודכן == ריק) {
        מ.עודכן = ""
    }
    החזר מ
}

פונקציה נתוני_דוגמה() {
    משתנה עכשיו = זמן.עכשיו()
    מזהה_הבא = 4
    משימות = [
        {
            "מזהה": 1,
            "כותרת": "לכתוב דוגמת יוד חדשה",
            "בוצע": שקר,
            "עדיפות": "גבוהה",
            "נוצר": עכשיו,
            "עודכן": עכשיו
        },
        {
            "מזהה": 2,
            "כותרת": "לבדוק שמירה ל־JSON",
            "בוצע": אמת,
            "עדיפות": "רגילה",
            "נוצר": עכשיו,
            "עודכן": עכשיו
        },
        {
            "מזהה": 3,
            "כותרת": "לסדר את שולחן העבודה",
            "בוצע": שקר,
            "עדיפות": "נמוכה",
            "נוצר": עכשיו,
            "עודכן": עכשיו
        }
    ]
}

פונקציה טען_משימות() {
    קבצים.צור_תיקייה(תיקיית_נתונים)
    משתנה נתיב = נתיב_נתונים()
    אם (לא קבצים.קיים(נתיב)) {
        נתוני_דוגמה()
        שמור_משימות()
        החזר ריק
    }
    נסה {
        משתנה גולמי = קבצים.קרא(נתיב)
        משתנה נתונים = JSON.פרסר(גולמי)
        אם (נתונים == ריק או נתונים.משימות == ריק) {
            נתוני_דוגמה()
            שמור_משימות()
            החזר ריק
        }
        משימות = []
        עבור מ בתוך נתונים.משימות {
            אם (משימה_תקינה(מ)) {
                משימות.הוסף(נרמל_משימה(מ))
            }
        }
        אם (נתונים.הבא != ריק) {
            מזהה_הבא = נתונים.הבא
        } אחרת {
            מזהה_הבא = משימות.גודל() + 1
        }
        אם (משימות.גודל() == 0) {
            נתוני_דוגמה()
            שמור_משימות()
        }
    } תפוס שגיאה {
        נתוני_דוגמה()
        שמור_משימות()
    }
}

פונקציה שמור_משימות() {
    קבצים.צור_תיקייה(תיקיית_נתונים)
    משתנה חבילה = {
        "גרסה": 1,
        "הבא": מזהה_הבא,
        "משימות": משימות
    }
    משתנה תוכן = JSON.מחרוזת(חבילה, אמת)
    קבצים.כתוב(נתיב_נתונים(), תוכן)
}

פונקציה ייצא_משימות() {
    משתנה נתיב = חלונות.בחר_שמירה("ייצוא משימות כ־JSON")
    אם (נתיב == ריק) {
        החזר ריק
    }
    משתנה חבילה = {
        "גרסה": 1,
        "הבא": מזהה_הבא,
        "משימות": משימות
    }
    קבצים.כתוב(נתיב, JSON.מחרוזת(חבילה, אמת))
    חלונות.הודעה("ייצוא", "הקובץ נשמר:\n" + נתיב)
}
