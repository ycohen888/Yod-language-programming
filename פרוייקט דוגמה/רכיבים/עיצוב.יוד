פונקציה רדיוס_בטוח(w, h, r) {
    משתנה מ = r.שלם()
    אם (מ * 2 > h) {
        מ = (h / 2).שלם()
    }
    אם (מ * 2 > w) {
        מ = (w / 2).שלם()
    }
    אם (מ < 0) {
        החזר 0
    }
    החזר מ
}
// מילוי מעוגל — מנוע יוד עם אנטי־אליאסינג (SDF)
פונקציה מלבן_מעוגל_מלא(משטח, x, y, w, h, r) {
    משתנה xx = x.שלם()
    משתנה yy = y.שלם()
    משתנה ww = w.שלם()
    משתנה hh = h.שלם()
    משתנה rr = רדיוס_בטוח(ww, hh, r)
    אם (ww <= 0 או hh <= 0) {
        החזר ריק
    }
    אם (rr <= 0) {
        משטח.מלבן_מלא(xx, yy, ww, hh)
        החזר ריק
    }
    משטח.מלבן_מעוגל_מלא(xx, yy, ww, hh, rr)
}

פונקציה מלבן_מעוגל_רך(משטח, x, y, w, h, r, מא, מי, מכ) {
    משטח.קבע_מילוי(14, 15, 18)
    מלבן_מעוגל_מלא(משטח, x, y + 1, w, h, r)
    משטח.קבע_מילוי(ערכה_גבול_א, ערכה_גבול_י, ערכה_גבול_כ)
    מלבן_מעוגל_מלא(משטח, x, y, w, h, r)
    משטח.קבע_מילוי(מא, מי, מכ)
    אם (w > 2 וגם h > 2) {
        מלבן_מעוגל_מלא(משטח, x + 1, y + 1, w - 2, h - 2, רדיוס_בטוח(w - 2, h - 2, r - 1))
    }
}

פונקציה הדגשת_עליון(משטח, x, y, w, r, א, י, כ) {
    משתנה rr = רדיוס_בטוח(w, 8, r)
    משטח.קבע_מילוי(א, י, כ)
    אם (w - 2 * rr > 2) {
        משטח.מלבן_מלא(x + rr, y, w - 2 * rr, 1)
    }
}

פונקציה מלבן_מעוגל_עם_גבול(משטח, x, y, w, h, r, מא, מי, מכ) {
    מלבן_מעוגל_רך(משטח, x, y, w, h, r, מא, מי, מכ)
}

פונקציה קו_עליון_רך(משטח, x, y, w, h, r, א, י, כ) {
    הדגשת_עליון(משטח, x, y, w, r, א, י, כ)
}
