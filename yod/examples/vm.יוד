// דוגמה למכונה וירטואלית (bytecode)
// הרצה: yod מכונה examples\vm.יוד
משתנה א = 10
משתנה ב = 32
הדפס("סכום: " +(א + ב))
אם (א < ב)
    הדפס("א קטן מ־ב")
אחרת
    הדפס("א גדול או שווה")
סוף

משתנה ס = 0
כל_עוד (ס < 3)
    הדפס("ספירה VM: " + ס)
    ס = ס + 1
סוף

משתנה רשימה =[1, 2, 3]
הדפס("איבר: " + רשימה[1])
הדפס("אורך: " + אורך(רשימה))
