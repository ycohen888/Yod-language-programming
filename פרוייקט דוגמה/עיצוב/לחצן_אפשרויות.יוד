// לחצן_אפשרויות.יוד — קבוצת Radio
כלול "פקד.יוד"

מחלקה לחצן_אפשרויות מרחיב פקד {
    פונקציה בנאי(פריטים, נבחר = "", מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (נבחר == ריק) {
            נבחר = ""
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה.ערך = נבחר
        זה._שינוי = ריק
        זה._צור("לחצן_אפשרויות", {
            "פריטים": פריטים,
            "ערך": נבחר
        })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
