// תג.יוד — באדג׳ קטן

מחלקה תג מרחיב רכיב
  פונקציה בנאי(x, y, טקסט)
    הורה(x, y, 56, 18)
    זה.טקסט = טקסט
    זה.אדום = ערכה_ראשי_א
    זה.ירוק = ערכה_ראשי_י
    זה.כחול = ערכה_ראשי_כ
  סוף

  פונקציה קבע_טקסט(t)
    זה.טקסט = t
    זה.בקש_רענון()
  סוף

  פונקציה קבע_צבע_rgb(א, י, כ)
    זה.אדום = א
    זה.ירוק = י
    זה.כחול = כ
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה rw = 14 + אורך(זה.טקסט) * 7
    אם rw < 32
      rw = 32
    סוף
    זה.רחב = rw
    משטח.קבע_מילוי(זה.אדום, זה.ירוק, זה.כחול)
    מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2)
    משטח.קבע_צבע(240, 250, 248)
    משטח.קבע_גודל_גופן(10)
    משטח.טקסט(זה.טקסט, זה.x + 8, זה.y + 3)
  סוף
סוף
