// בורר_צבע.יוד — Color picker
כלול "פקד.יוד"

מחלקה בורר_צבע מרחיב פקד {
    פונקציה בנאי(צבע = "#0d6efd", מזהה = "") {
        אם (צבע == ריק או צבע == "") {
            צבע = "#0d6efd"
        }
        הורה(מזהה)
        זה.ערך = צבע
        זה._שינוי = ריק
        זה._צור("בורר_צבע", {
            "ערך": צבע
        })
    }

    פונקציה קבע_ערך(צבע) {
        אם (צבע == ריק או צבע == "") {
            צבע = "#000000"
        }
        זה.ערך = צבע
        זה._שלח_פקודה("קבע_ערך", { "ערך": צבע })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
