// מתודות מילון ורשימה
משתנה אדם = { "שם": "נועם", "גיל": 30, עיר: "תל אביב" }

הדפס "=== הדפס_שמות ==="
אדם.הדפס_שמות

הדפס "=== הדפס_מידע ==="
אדם.הדפס_מידע

הדפס "=== הדפס_הכל ==="
אדם.הדפס_הכל

הדפס: "מפתחות: " + אדם.שמות().הצטרף(", ")
הדפס: "יש גיל? " + אדם.יש("גיל")
הדפס: "קבל מקצוע: " + אדם.קבל("מקצוע", "לא ידוע")

אדם.הגדר("מקצוע", "מתכנת")
אדם.הדפס_הכל

משתנה שמות = ["נועם", "דני", "מיכל"]
הדפס "=== רשימה ==="
שמות.הדפס_הכל
שמות.הוסף("רות")
הדפס: "אחרי הוסף: " + שמות.הצטרף(", ")
הדפס: "ראשון=" + שמות.ראשון() + " אחרון=" + שמות.אחרון()
הדפס: "מכיל דני? " + שמות.מכיל("דני")
שמות.מיין
הדפס: "ממוין: " + שמות.הצטרף(" | ")
