// תפריט_נפתח.יוד — בחירה מרשימה קומפקטית
מחלקה תפריט_נפתח מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, פריטים, נבחר) {
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (נבחר == ריק) {
            נבחר = 0
        }
        הורה(x, y, רחב, 28)
        זה.פריטים = פריטים
        זה.נבחר = נבחר
        זה.פתוח = שקר
        זה.בשינוי = ריק
        זה.גובה_שורה = 24
        זה.רדיוס = 6
        זה.גבה_סגור = 28
    }
    פונקציה קבע_נבחר(i) {
        אם (i < 0 או i >= אורך(זה.פריטים)) {
            החזר ריק
        }
        זה.נבחר = i
        זה.פתוח = שקר
        זה.גבה = זה.גבה_סגור
        זה.בקש_רענון()
        אם (זה.בשינוי != ריק) {
            זה.בשינוי(i, זה.פריטים[i])
        }
    }
    פונקציה ערך_נבחר() {
        אם (אורך(זה.פריטים) == 0) {
            החזר ריק
        }
        החזר זה.פריטים[זה.נבחר]
    }
    פונקציה סגור() {
        זה.פתוח = שקר
        זה.גבה = זה.גבה_סגור
        זה.בקש_רענון()
    }
    פונקציה פתח() {
        זה.פתוח = אמת
        זה.גבה = זה.גבה_סגור + 4 + אורך(זה.פריטים) * זה.גובה_שורה
        זה.בקש_רענון()
    }
    פונקציה טקסט_מוצג() {
        אם (אורך(זה.פריטים) == 0) {
            החזר "—"
        }
        אם (זה.נבחר < 0 או זה.נבחר >= אורך(זה.פריטים)) {
            החזר "—"
        }
        החזר זה.פריטים[זה.נבחר]
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה_סגור, זה.רדיוס, 28, 30, 36)
        אם (זה.פתוח) {
            משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
            מלבן_מעוגל_מלא(משטח, זה.x + 3, זה.y + זה.גבה_סגור - 2, זה.רחב - 6, 2, 1)
        }
        משטח.קבע_גודל_גופן(11)
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        צייר_טקסט_ברכיב(משטח, זה, זה.טקסט_מוצג(), זה.y + 7, 28)
        // חץ בצד הסוף
        משתנה ax = x_פריט_מהתחלה(זה, 8, 10)
        אם (הוא_ימין(זה.כיוון())) {
            ax = זה.x + 8
        } אחרת {
            ax = זה.x + זה.רחב - 18
        }
        משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
        אם (זה.פתוח) {
            משטח.טקסט("▴", ax, זה.y + 6)
        } אחרת {
            משטח.טקסט("▾", ax, זה.y + 6)
        }
        אם (זה.פתוח) {
            משתנה py = זה.y + זה.גבה_סגור + 2
            מלבן_מעוגל_רך(משטח, זה.x, py, זה.רחב, אורך(זה.פריטים) * זה.גובה_שורה + 4, 6, 32, 34, 40)
            משתנה i = 0
            כל_עוד (i < אורך(זה.פריטים)) {
                משתנה sy = py + 2 + i * זה.גובה_שורה
                אם (i == זה.נבחר) {
                    משטח.קבע_מילוי(ערכה_ראשי_כהה_א, ערכה_ראשי_כהה_י, ערכה_ראשי_כהה_כ)
                    מלבן_מעוגל_מלא(משטח, זה.x + 3, sy, זה.רחב - 6, זה.גובה_שורה - 2, 4)
                    משטח.קבע_צבע(230, 245, 240)
                } אחרת {
                    משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
                }
                משטח.קבע_גודל_גופן(11)
                צייר_טקסט_ברכיב(משטח, זה, זה.פריטים[i], sy + 4, 10)
                i = i + 1
            }
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        אם (לא זה.פתוח) {
            זה.פתח()
            החזר אמת
        }
        אם (my <= זה.y + זה.גבה_סגור) {
            זה.סגור()
            החזר אמת
        }
        משתנה py = זה.y + זה.גבה_סגור + 2
        משתנה i = ((my - py - 2) / זה.גובה_שורה).שלם()
        אם (i < 0) {
            i = 0
        }
        אם (i >= אורך(זה.פריטים)) {
            i = אורך(זה.פריטים) - 1
        }
        זה.קבע_נבחר(i)
        החזר אמת
    }
}
