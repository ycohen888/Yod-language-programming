// רשימה.יוד — כרטיסים ב־RTL: סימון וימין, טקסט מימין, פס עדיפות בימין
מחלקה כרטיסי_משימות מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, גבה) {
        הורה(x, y, רחב, גבה)
        זה.רדיוס = 12
        זה.בשינוי_בחירה = ריק
        זה.בסימון = ריק
        זה.רמז = "לחצו לסימון או לבחירה · מחק למחיקה"
        זה.איקון_בוצע = "איקונים/check_box.png"
        זה.איקון_פתוח = "איקונים/check_box_outline_blank.png"
    }
    פונקציה מקבל_מיקוד() {
        החזר אמת
    }
    פונקציה קבע_מיקוד(v) {
    }
    פונקציה כרטיס_x() {
        החזר זה.x + 12
    }
    פונקציה כרטיס_רחב() {
        החזר זה.רחב - 24
    }
    פונקציה כרטיס_y0() {
        החזר זה.y + 14
    }
    פונקציה y_של_אינדקס(i) {
        החזר זה.כרטיס_y0() + i * (גובה_שורה + רווח_שורה)
    }
    פונקציה כמה_נכנסים() {
        משתנה פנוי = זה.גבה - 28
        אם (פנוי < גובה_שורה) {
            החזר 0
        }
        החזר ((פנוי + רווח_שורה) / (גובה_שורה + רווח_שורה)).שלם()
    }
    פונקציה מכיל(mx, my) {
        אם (!זה.גלוי) {
            החזר שקר
        }
        משתנה בפנים = נקודה_במלבן(mx, my, זה.x, זה.y, זה.רחב, זה.גבה)
        אם (בפנים) {
            זה.עדכן_רחף(mx, my)
        } אחרת_אם (רחף_מזהה != ריק) {
            רחף_מזהה = ריק
            זה.בקש_רענון()
        }
        החזר בפנים
    }
    פונקציה עדכן_רחף(mx, my) {
        משתנה תצוגה = משימות_לתצוגה()
        משתנה מקס = זה.כמה_נכנסים()
        משתנה i = 0
        משתנה נמצא = ריק
        כל_עוד (i < תצוגה.גודל() וגם i < מקס) {
            משתנה yy = זה.y_של_אינדקס(i)
            אם (נקודה_במלבן(mx, my, זה.כרטיס_x(), yy, זה.כרטיס_רחב(), גובה_שורה)) {
                נמצא = תצוגה[i].מזהה
                עצור
            }
            i = i + 1
        }
        אם (נמצא != רחף_מזהה) {
            רחף_מזהה = נמצא
            זה.בקש_רענון()
        }
    }
    פונקציה צייר_רקע(משטח) {
        משטח.קבע_מילוי(ערכה_משטח_א, ערכה_משטח_י, ערכה_משטח_כ)
        מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס)
    }
    פונקציה צייר_מצב_ריק(משטח) {
        משטח.קבע_יישור("מרכז")
        משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
        משטח.קבע_גודל_גופן(14)
        משטח.טקסט("אין משימות בתצוגה", זה.x + זה.רחב / 2, זה.y + זה.גבה / 2 - 12)
        משטח.קבע_גודל_גופן(11)
        משטח.טקסט("הוסיפו משימה למעלה, או שנו מסנן / חיפוש", זה.x + זה.רחב / 2, זה.y + זה.גבה / 2 + 10)
        משטח.קבע_יישור("ימין")
    }
    פונקציה צייר_שורה(משטח, מ, yy) {
        משתנה xx = זה.כרטיס_x()
        משתנה ww = זה.כרטיס_רחב()
        משתנה מא = 30
        משתנה מי = 33
        משתנה מכ = 40
        אם (מ.מזהה == מזהה_נבחר) {
            מא = ערכה_ראשי_כהה_א
            מי = ערכה_ראשי_כהה_י
            מכ = ערכה_ראשי_כהה_כ
        } אחרת_אם (מ.מזהה == רחף_מזהה) {
            מא = ערכה_גובה_א
            מי = ערכה_גובה_י
            מכ = ערכה_גובה_כ
        }
        משטח.קבע_מילוי(מא, מי, מכ)
        מלבן_מעוגל_מלא(משטח, xx, yy, ww, גובה_שורה, 8)
        // פס עדיפות — צד ימין
        משתנה צ = צבע_עדיפות(מ.עדיפות)
        משטח.קבע_מילוי(צ[0], צ[1], צ[2])
        מלבן_מעוגל_מלא(משטח, xx + ww - 6, yy + 8, 4, גובה_שורה - 16, 2)
        // צ׳קבוקס — צד ימין (ליד הפס)
        משתנה ix = xx + ww - 36
        משתנה iy = yy + 11
        אם (מ.בוצע) {
            משטח.תמונה(זה.איקון_בוצע, ix, iy, 22, 22)
        } אחרת {
            משטח.תמונה(זה.איקון_פתוח, ix, iy, 22, 22)
        }
        // כותרת צמודה לימין (ליד הצ׳קבוקס) — כמו במכרות
        משטח.קבע_יישור("ימין")
        אם (מ.בוצע) {
            משטח.קבע_צבע(110, 118, 128)
        } אחרת {
            משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        }
        משטח.קבע_גודל_גופן(13)
        משתנה קצה_ימין = xx + ww - 42
        משטח.טקסט(מ.כותרת, קצה_ימין, yy + 8)
        משטח.קבע_גודל_גופן(10)
        משטח.קבע_צבע(צ[0], צ[1], צ[2])
        משטח.טקסט(תווית_עדיפות(מ.עדיפות), קצה_ימין, yy + 26)
        אם (מ.עודכן != ריק וגם מ.עודכן != "") {
            משטח.קבע_יישור("שמאל")
            משטח.קבע_צבע(90, 98, 108)
            משטח.טקסט(מ.עודכן, xx + 14, yy + 26)
            משטח.קבע_יישור("ימין")
        }
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משטח.קבע_יישור("ימין")
        זה.צייר_רקע(משטח)
        משתנה תצוגה = משימות_לתצוגה()
        אם (תצוגה.גודל() == 0) {
            זה.צייר_מצב_ריק(משטח)
            החזר ריק
        }
        משתנה מקס = זה.כמה_נכנסים()
        משתנה i = 0
        כל_עוד (i < תצוגה.גודל() וגם i < מקס) {
            זה.צייר_שורה(משטח, תצוגה[i], זה.y_של_אינדקס(i))
            i = i + 1
        }
        אם (תצוגה.גודל() > מקס) {
            משטח.קבע_יישור("ימין")
            משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
            משטח.קבע_גודל_גופן(10)
            משטח.טקסט_בתיבה("+" + (תצוגה.גודל() - מקס) + " נוספות — הגדילו את החלון", זה.x + 20, זה.y + זה.גבה - 18, זה.רחב - 40)
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא נקודה_במלבן(mx, my, זה.x, זה.y, זה.רחב, זה.גבה)) {
            החזר שקר
        }
        משתנה תצוגה = משימות_לתצוגה()
        משתנה מקס = זה.כמה_נכנסים()
        משתנה i = 0
        כל_עוד (i < תצוגה.גודל() וגם i < מקס) {
            משתנה yy = זה.y_של_אינדקס(i)
            משתנה xx = זה.כרטיס_x()
            משתנה ww = זה.כרטיס_רחב()
            אם (נקודה_במלבן(mx, my, xx, yy, ww, גובה_שורה)) {
                משתנה מ = תצוגה[i]
                // אזור צ׳קבוקס בימין
                אם (נקודה_במלבן(mx, my, xx + ww - 44, yy + 6, 36, 32)) {
                    אם (זה.בסימון != ריק) {
                        זה.בסימון(מ.מזהה)
                    }
                } אחרת {
                    אם (זה.בשינוי_בחירה != ריק) {
                        זה.בשינוי_בחירה(מ.מזהה)
                    }
                }
                זה.בקש_רענון()
                החזר אמת
            }
            i = i + 1
        }
        החזר אמת
    }
    פונקציה בעת_מקש(שם) {
        אם (שם == "מחק") {
            אם (מזהה_נבחר != ריק) {
                מחק_נבחרת()
            }
        }
    }
}
