// מחוון_טבעת.יוד — טבעת אחוזים חלקה (נקודות מילוי על היקף)
מחלקה מחוון_טבעת מרחיב רכיב {
    פונקציה בנאי(x, y, גודל, אחוז) {
        הורה(x, y, גודל, גודל)
        זה.אחוז = הגבל(אחוז, 0, 100)
    }
    פונקציה קבע_אחוז(v) {
        זה.אחוז = הגבל(v, 0, 100)
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה cx = זה.x + זה.רחב / 2
        משתנה cy = זה.y + זה.גבה / 2
        משתנה R = (זה.רחב / 2 - 1).שלם()
        משטח.קבע_מילוי(44, 48, 56)
        משטח.עיגול_מלא(cx, cy, R)
        משתנה סהכ = (זה.אחוז * 0.72).שלם()
        משתנה i = 0
        כל_עוד (i <= סהכ) {
            משתנה deg = - 90 + i * 5
            משתנה rad = deg * מתמטיקה.פי / 180
            משתנה px = cx + מתמטיקה.קוסינוס(rad) * (R - 3)
            משתנה py = cy + מתמטיקה.סינוס(rad) * (R - 3)
            משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
            משטח.עיגול_מלא(px, py, 2)
            i = i + 1
        }
        משטח.קבע_מילוי(ערכה_משטח_א, ערכה_משטח_י, ערכה_משטח_כ)
        משטח.עיגול_מלא(cx, cy, R - 7)
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        משטח.קבע_גודל_גופן(10)
        משטח.קבע_יישור("מרכז")
        משטח.טקסט("" + זה.אחוז.שלם(), cx, cy - 5)
        משטח.קבע_יישור("שמאל")
    }
}
