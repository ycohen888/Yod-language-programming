// מספר_מדרגה.יוד — כפתורי − / + מעוגלים

מחלקה מספר_מדרגה מרחיב רכיב
  פונקציה בנאי(x, y, מינ, מקס, ערך)
    הורה(x, y, 118, 32)
    זה.מינ = מינ
    זה.מקס = מקס
    זה.צעד = 1
    זה.ערך = עגל_לצעד(הגבל(ערך, מינ, מקס), זה.צעד)
    זה.בשינוי = ריק
    זה.רחב_כפתור = 30
  סוף

  פונקציה נרמל(v)
    החזר עגל_לצעד(הגבל(v, זה.מינ, זה.מקס), זה.צעד)
  סוף

  פונקציה קבע_ערך(v)
    משתנה קודם = זה.ערך
    זה.ערך = זה.נרמל(v)
    אם זה.ערך != קודם
      זה.בקש_רענון()
      אם זה.בשינוי != ריק
        זה.בשינוי(זה.ערך)
      סוף
    סוף
  סוף

  פונקציה קבע_ערך_שקט(v)
    משתנה קודם = זה.ערך
    זה.ערך = זה.נרמל(v)
    אם זה.ערך != קודם
      זה.בקש_רענון()
    סוף
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה bw = זה.רחב_כפתור
    מלבן_מעוגל_עם_גבול(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 8, ערכה_משטח_א, ערכה_משטח_י, ערכה_משטח_כ)
    משטח.קבע_מילוי(ערכה_גובה_א, ערכה_גובה_י, ערכה_גובה_כ)
    מלבן_מעוגל_מלא(משטח, זה.x + 2, זה.y + 2, bw - 2, זה.גבה - 4, 6)
    מלבן_מעוגל_מלא(משטח, זה.x + זה.רחב - bw, זה.y + 2, bw - 2, זה.גבה - 4, 6)
    משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
    משטח.קבע_גודל_גופן(15)
    משטח.טקסט("−", זה.x + 9, זה.y + 6)
    משטח.טקסט("" + זה.ערך.שלם(), זה.x + bw + 14, זה.y + 7)
    משטח.טקסט("+", זה.x + זה.רחב - bw + 8, זה.y + 6)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    משתנה bw = זה.רחב_כפתור
    אם mx < זה.x + bw
      זה.קבע_ערך(זה.ערך - זה.צעד)
    אחרת_אם mx >= זה.x + זה.רחב - bw
      זה.קבע_ערך(זה.ערך + זה.צעד)
    סוף
    החזר אמת
  סוף
סוף
