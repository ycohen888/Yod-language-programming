// תווית_ציור.יוד — טקסט מצויר על המשטח

מחלקה תווית_ציור מרחיב רכיב
  פונקציה בנאי(x, y, טקסט)
    הורה(x, y, 300, 24)
    זה.טקסט = טקסט
    זה.אדום = 180
    זה.ירוק = 185
    זה.כחול = 190
    זה.גודל = 13
  סוף

  פונקציה קבע_טקסט(t)
    זה.טקסט = t
    זה.בקש_רענון()
  סוף

  פונקציה קבע_צבע_rgb(א, י, כ)
    זה.אדום = א
    זה.ירוק = י
    זה.כחול = כ
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משטח.קבע_צבע(זה.אדום, זה.ירוק, זה.כחול)
    משטח.קבע_גודל_גופן(זה.גודל)
    משטח.טקסט(זה.טקסט, זה.x, זה.y)
  סוף
סוף
