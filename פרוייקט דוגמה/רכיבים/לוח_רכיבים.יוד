// לוח_רכיבים.יוד — מנהל משטח + פיזור אירועים + גלילה אנכית
מחלקה לוח_רכיבים {
    פונקציה בנאי(רוחב, גובה) {
        זה.משטח = חלונות.משטח(רוחב, גובה)
        זה.רחב = רוחב
        זה.גבה = גובה
        זה.רכיבים = []
        זה.פעיל = ריק
        זה.ממוקד = ריק
        זה.רמז_נוכחי = ""
        זה.בפריסה = ריק
        זה.רקע_א = ערכה_רקע_א
        זה.רקע_י = ערכה_רקע_י
        זה.רקע_כ = ערכה_רקע_כ
        זה.השהה_רענון = שקר
        זה.מלוכלך = שקר
        זה.כיוון = "ימין"
        זה.גלילה = 0
        זה.גובה_תוכן = גובה
        זה.רוחב_פס = 12
        זה.גורר_פס = שקר
        זה.גרירה_י_התחלה = 0
        זה.גלילה_בגרירה = 0
        משתנה עצמי = זה
        זה.משטח.בעכבר_למטה: פונקציה(x, y, כפתור) {
            עצמי.על_למטה(x, y, כפתור)
        }
        זה.משטח.בעכבר_גרירה: פונקציה(x, y, כפתור) {
            עצמי.על_גרירה(x, y, כפתור)
        }
        זה.משטח.בעכבר_למעלה: פונקציה(x, y, כפתור) {
            עצמי.על_למעלה(x, y, כפתור)
        }
        זה.משטח.בעכבר_זוז: פונקציה(x, y) {
            עצמי.על_זוז(x, y)
        }
        זה.משטח.בעכבר_גלגל: פונקציה(דלתא) {
            עצמי.על_גלגל(דלתא)
        }
        זה.משטח.בעת_תו: פונקציה(תו) {
            עצמי.על_תו(תו)
        }
        זה.משטח.בעת_מקש: פונקציה(שם) {
            עצמי.על_מקש(שם)
        }
        זה.משטח.בשינוי_גודל: פונקציה(רחב, גבה) {
            עצמי.על_גודל(רחב, גבה)
        }
    }
    פונקציה משטח_גלוי() {
        החזר זה.משטח
    }
    פונקציה קבע_כיוון(כ) {
        זה.כיוון = נרמל_כיוון(כ)
        זה.רענון()
    }
    פונקציה הוסף(ר) {
        ר.לוח = זה
        זה.רכיבים.הוסף(ר)
        זה.עדכן_גובה_תוכן()
        // בלי רענון מלא בכל הוספה — קוראים רענון() בסוף הבנייה
        זה.מלוכלך = אמת
    }
    פונקציה עדכן_גובה_תוכן() {
        משתנה מקס = זה.גבה
        עבור (ר בתוך זה.רכיבים) {
            אם (ר.נעוץ) {
                המשך
            }
            משתנה תחת = ר.y + ר.גבה + 24
            אם (תחת > מקס) {
                מקס = תחת
            }
        }
        זה.גובה_תוכן = מקס
        משתנה מ = זה.מקס_גלילה()
        אם (זה.גלילה > מ) {
            זה.גלילה = מ
        }
    }
    פונקציה מקס_גלילה() {
        משתנה מ = זה.גובה_תוכן - זה.גבה
        אם (מ < 0) {
            החזר 0
        }
        החזר מ
    }
    פונקציה קבע_גלילה(v) {
        משתנה מ = זה.מקס_גלילה()
        אם (v < 0) {
            v = 0
        }
        אם (v > מ) {
            v = מ
        }
        אם (v != זה.גלילה) {
            זה.גלילה = v
            זה.סמן_רענון()
        }
    }
    פונקציה על_גלגל(דלתא) {
        // דלתא חיובית = גלגל למעלה; צעד גדול לגלילה חלקה-מהירה
        זה.קבע_גלילה(זה.גלילה - דלתא * 72)
    }
    פונקציה יש_גלילה() {
        החזר זה.מקס_גלילה() > 0
    }
    פונקציה מלבן_פס() {
        החזר [זה.רחב - זה.רוחב_פס - 2, 2, זה.רוחב_פס, זה.גבה - 4]
    }
    פונקציה ידית_פס() {
        משתנה מ = זה.מקס_גלילה()
        משתנה פס = זה.מלבן_פס()
        משתנה ph = פס[3]
        אם (מ <= 0) {
            החזר [פס[0], פס[1], פס[2], ph]
        }
        משתנה יחס = זה.גבה / זה.גובה_תוכן
        משתנה th = (ph * יחס).שלם()
        אם (th < 28) {
            th = 28
        }
        אם (th > ph) {
            th = ph
        }
        משתנה ty = פס[1]
        אם (מ > 0) {
            ty = פס[1] + ((ph - th) * זה.גלילה / מ).שלם()
        }
        החזר [פס[0], ty, פס[2], th]
    }
    פונקציה על_פס(mx, my) {
        אם (לא זה.יש_גלילה()) {
            החזר שקר
        }
        משתנה פס = זה.מלבן_פס()
        החזר נקודה_במלבן(mx, my, פס[0], פס[1], פס[2], פס[3])
    }
    פונקציה גלילה_מי_ידית(my) {
        משתנה מ = זה.מקס_גלילה()
        אם (מ <= 0) {
            החזר 0
        }
        משתנה פס = זה.מלבן_פס()
        משתנה יד = זה.ידית_פס()
        משתנה track = פס[3] - יד[3]
        אם (track <= 0) {
            החזר 0
        }
        משתנה ty = my - יד[3] / 2 - פס[1]
        החזר הגבל(ty, 0, track) * מ / track
    }
    פונקציה סמן_רענון() {
        אם (זה.השהה_רענון) {
            זה.מלוכלך = אמת
        } אחרת {
            זה.רענון()
        }
    }
    // רענון חלקי — להקלדה/סמן בלי לצייר את כל הלוח מחדש
    פונקציה סמן_רענון_רכיב(ר) {
        אם (זה.השהה_רענון) {
            זה.מלוכלך = אמת
            החזר ריק
        }
        אם (ר == ריק) {
            זה.רענון()
            החזר ריק
        }
        זה.רענון_אזור_רכיב(ר)
    }
    פונקציה מלבן_תצוגה(ר) {
        משתנה vx = ר.x
        משתנה vy = ר.y
        אם (לא ר.נעוץ) {
            vy = ר.y - זה.גלילה
        }
        החזר [vx, vy, ר.רחב, ר.גבה]
    }
    פונקציה חופפים(ax, ay, aw, ah, bx, by, bw, bh) {
        אם (ax + aw < bx או bx + bw < ax) {
            החזר שקר
        }
        אם (ay + ah < by או by + bh < ay) {
            החזר שקר
        }
        החזר אמת
    }
    פונקציה רענון_אזור_רכיב(ר) {
        משתנה מ = זה.מלבן_תצוגה(ר)
        משתנה dx = מ[0] - 2
        משתנה dy = מ[1] - 2
        משתנה dw = מ[2] + 4
        משתנה dh = מ[3] + 4
        אם (dx < 0) {
            dx = 0
        }
        אם (dy < 0) {
            dy = 0
        }
        זה.משטח.השהה_הצגה()
        זה.משטח.קבע_מילוי(זה.רקע_א, זה.רקע_י, זה.רקע_כ)
        זה.משטח.מלבן_מלא(dx, dy, dw, dh)
        זה.משטח.קבע_יישור(יישור_טקסט(זה.כיוון))
        עבור (ו בתוך זה.רכיבים) {
            משתנה vm = זה.מלבן_תצוגה(ו)
            אם (לא זה.חופפים(dx, dy, dw, dh, vm[0], vm[1], vm[2], vm[3])) {
                המשך
            }
            אם (ו.נעוץ) {
                ו.צייר(זה.משטח)
            } אחרת {
                משתנה oy = ו.y
                ו.y = oy - זה.גלילה
                ו.צייר(זה.משטח)
                ו.y = oy
            }
        }
        אם (זה.יש_גלילה()) {
            זה.צייר_פס_גלילה()
        }
        זה.משטח.קבע_יישור("שמאל")
        זה.משטח.רענן()
    }
    פונקציה רענון() {
        זה.משטח.נקה(זה.רקע_א, זה.רקע_י, זה.רקע_כ)
        זה.משטח.קבע_יישור(יישור_טקסט(זה.כיוון))
        עבור (ר בתוך זה.רכיבים) {
            אם (ר.נעוץ) {
                ר.צייר(זה.משטח)
            } אחרת {
                משתנה oy = ר.y
                ר.y = oy - זה.גלילה
                אם (ר.y + ר.גבה >= -4 וגם ר.y <= זה.גבה + 4) {
                    ר.צייר(זה.משטח)
                }
                ר.y = oy
            }
        }
        זה.צייר_פס_גלילה()
        זה.משטח.קבע_יישור("שמאל")
        זה.משטח.רענן()
        זה.מלוכלך = שקר
    }
    פונקציה צייר_פס_גלילה() {
        אם (לא זה.יש_גלילה()) {
            החזר ריק
        }
        משתנה פס = זה.מלבן_פס()
        זה.משטח.קבע_מילוי(28, 30, 36)
        מלבן_מעוגל_מלא(זה.משטח, פס[0], פס[1], פס[2], פס[3], 4)
        משתנה יד = זה.ידית_פס()
        זה.משטח.קבע_מילוי(72, 78, 90)
        מלבן_מעוגל_מלא(זה.משטח, יד[0] + 1, יד[1], יד[2] - 2, יד[3], 4)
    }
    פונקציה עם_אצווה(פעולה) {
        זה.השהה_רענון = אמת
        פעולה()
        זה.השהה_רענון = שקר
        אם (זה.מלוכלך) {
            זה.רענון()
        }
    }
    פונקציה על_גודל(רחב, גבה) {
        אם (רחב < 40) {
            רחב = 40
        }
        אם (גבה < 40) {
            גבה = 40
        }
        זה.רחב = רחב
        זה.גבה = גבה
        אם (זה.בפריסה != ריק) {
            זה.בפריסה(רחב, גבה)
        }
        זה.עדכן_גובה_תוכן()
        זה.רענון()
    }
    פונקציה טקסט_רמז(ר) {
        אם (ר == ריק) {
            החזר ""
        }
        אם (ר.רמז == ריק או ר.רמז == "") {
            החזר ""
        }
        החזר ר.רמז
    }
    פונקציה נקה_מיקוד() {
        אם (זה.ממוקד != ריק) {
            זה.ממוקד.קבע_מיקוד(שקר)
            זה.ממוקד = ריק
        }
    }
    פונקציה על_תו(תו) {
        אם (זה.ממוקד != ריק) {
            זה.ממוקד.בעת_תו(תו)
        }
    }
    פונקציה על_מקש(שם) {
        אם (זה.ממוקד != ריק) {
            זה.ממוקד.בעת_מקש(שם)
            החזר ריק
        }
        אם (שם == "למעלה" או שם == "עמוד למעלה") {
            זה.קבע_גלילה(זה.גלילה - 96)
        } אחרת_אם (שם == "למטה" או שם == "עמוד למטה") {
            זה.קבע_גלילה(זה.גלילה + 96)
        }
    }
    פונקציה y_תוכן(y) {
        החזר y + זה.גלילה
    }
    פונקציה על_זוז(x, y) {
        משתנה tip = ""
        משתנה cy = זה.y_תוכן(y)
        משתנה i = אורך(זה.רכיבים) - 1
        כל_עוד (i >= 0) {
            משתנה ר = זה.רכיבים[i]
            משתנה hx = x
            משתנה hy = cy
            אם (ר.נעוץ) {
                hy = y
            }
            אם (ר.מכיל(hx, hy)) {
                tip = זה.טקסט_רמז(ר)
                עצור
            }
            i = i - 1
        }
        אם (tip != זה.רמז_נוכחי) {
            זה.רמז_נוכחי = tip
            זה.משטח.קבע_רמז(tip)
        }
    }
    פונקציה על_למטה(x, y, כפתור) {
        אם (זה.על_פס(x, y)) {
            זה.גורר_פס = אמת
            זה.גרירה_י_התחלה = y
            זה.גלילה_בגרירה = זה.גלילה
            זה.קבע_גלילה(זה.גלילה_מי_ידית(y))
            החזר ריק
        }
        משתנה עצמי = זה
        זה.עם_אצווה(פונקציה() {
            עצמי.נקה_מיקוד()
            עצמי.פעיל = ריק
            משתנה cy = עצמי.y_תוכן(y)
            משתנה i = אורך(עצמי.רכיבים) - 1
            כל_עוד (i >= 0) {
                משתנה ר = עצמי.רכיבים[i]
                משתנה hy = cy
                אם (ר.נעוץ) {
                    hy = y
                }
                אם (ר.בעכבר_למטה(x, hy, כפתור)) {
                    עצמי.פעיל = ר
                    אם (ר.מקבל_מיקוד()) {
                        עצמי.ממוקד = ר
                        ר.קבע_מיקוד(אמת)
                        עצמי.משטח.בקש_מיקוד()
                    }
                    החזר ריק
                }
                i = i - 1
            }
        })
    }
    פונקציה על_גרירה(x, y, כפתור) {
        אם (זה.גורר_פס) {
            זה.קבע_גלילה(זה.גלילה_מי_ידית(y))
            החזר ריק
        }
        משתנה עצמי = זה
        זה.עם_אצווה(פונקציה() {
            אם (עצמי.פעיל != ריק) {
                משתנה hy = עצמי.y_תוכן(y)
                אם (עצמי.פעיל.נעוץ) {
                    hy = y
                }
                עצמי.פעיל.בעכבר_גרירה(x, hy, כפתור)
            }
        })
    }
    פונקציה על_למעלה(x, y, כפתור) {
        אם (זה.גורר_פס) {
            זה.גורר_פס = שקר
            החזר ריק
        }
        משתנה עצמי = זה
        זה.עם_אצווה(פונקציה() {
            אם (עצמי.פעיל != ריק) {
                משתנה hy = עצמי.y_תוכן(y)
                אם (עצמי.פעיל.נעוץ) {
                    hy = y
                }
                עצמי.פעיל.בעכבר_למעלה(x, hy, כפתור)
                עצמי.פעיל = ריק
            }
        })
    }
}
