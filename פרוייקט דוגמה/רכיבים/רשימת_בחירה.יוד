// רשימת_בחירה.יוד — טקסט מיושר לפי כיוון
מחלקה רשימת_בחירה מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, פריטים) {
        הורה(x, y, רחב, 6 + אורך(פריטים) * 24)
        זה.פריטים = פריטים
        זה.נבחר = 0
        זה.גובה_שורה = 24
        זה.בשינוי = ריק
    }
    פונקציה קבע_נבחר(i) {
        אם (i < 0 או i >= אורך(זה.פריטים)) {
            החזר ריק
        }
        זה.נבחר = i
        זה.בקש_רענון()
        אם (זה.בשינוי != ריק) {
            זה.בשינוי(i, זה.פריטים[i])
        }
    }
    פונקציה ערך_נבחר() {
        אם (אורך(זה.פריטים) == 0) {
            החזר ריק
        }
        החזר זה.פריטים[זה.נבחר]
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 7, 28, 30, 36)
        משתנה i = 0
        כל_עוד (i < אורך(זה.פריטים)) {
            משתנה sy = זה.y + 3 + i * זה.גובה_שורה
            אם (i == זה.נבחר) {
                משטח.קבע_מילוי(ערכה_ראשי_כהה_א, ערכה_ראשי_כהה_י, ערכה_ראשי_כהה_כ)
                מלבן_מעוגל_מלא(משטח, זה.x + 3, sy, זה.רחב - 6, זה.גובה_שורה - 2, 4)
                משטח.קבע_צבע(230, 245, 240)
            } אחרת {
                משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
            }
            משטח.קבע_גודל_גופן(11)
            צייר_טקסט_ברכיב(משטח, זה, זה.פריטים[i], sy + 4, 10)
            i = i + 1
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        משתנה i = ((my - זה.y - 3) / זה.גובה_שורה).שלם()
        אם (i < 0) {
            i = 0
        }
        אם (i >= אורך(זה.פריטים)) {
            i = אורך(זה.פריטים) - 1
        }
        זה.קבע_נבחר(i)
        החזר אמת
    }
}
