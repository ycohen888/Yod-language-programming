// קבוצת_שדות.יוד — תווית + שדה; פריסה אנכית או אופקית לפי כיוון
מחלקה קבוצת_שדות מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, תווית, שדה) {
        הורה(x, y, רחב, 52)
        זה.תווית = תווית
        זה.שדה = שדה
        זה.אנכי = אמת
        זה.רווח = 4
        זה.גובה_תווית = 16
        אם (שדה != ריק) {
            זה.סדר_ילדים()
        }
    }
    פונקציה סדר_ילדים() {
        אם (זה.שדה == ריק) {
            החזר ריק
        }
        אם (זה.אנכי) {
            זה.גבה = זה.גובה_תווית + זה.רווח + זה.שדה.גבה
            זה.שדה.x = זה.x
            זה.שדה.y = זה.y + זה.גובה_תווית + זה.רווח
            זה.שדה.רחב = זה.רחב
        } אחרת {
            זה.גבה = זה.שדה.גבה
            אם (הוא_ימין(זה.כיוון())) {
                זה.שדה.x = זה.x
                זה.שדה.רחב = זה.רחב - 90
            } אחרת {
                זה.שדה.x = זה.x + 90
                זה.שדה.רחב = זה.רחב - 90
            }
            זה.שדה.y = זה.y
        }
        זה.בקש_רענון()
    }
    פונקציה קבע_אנכי(v) {
        זה.אנכי = v
        זה.סדר_ילדים()
    }
    פונקציה מכיל(mx, my) {
        החזר שקר
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
        משטח.קבע_גודל_גופן(11)
        אם (זה.אנכי) {
            צייר_טקסט_ברכיב(משטח, זה, זה.תווית, זה.y, 0)
        } אחרת {
            אם (הוא_ימין(זה.כיוון())) {
                משטח.קבע_יישור("ימין")
                משטח.טקסט(זה.תווית, זה.x + זה.רחב, זה.y + 6)
                משטח.קבע_יישור("שמאל")
            } אחרת {
                משטח.קבע_יישור("שמאל")
                משטח.טקסט(זה.תווית, זה.x, זה.y + 6)
            }
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        החזר שקר
    }
}
