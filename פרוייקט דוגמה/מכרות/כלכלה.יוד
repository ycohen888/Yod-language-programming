פונקציה גלגל_סוג_משאב(שטח) {
    אם (שטח == 3) {
        החזר גלגל_סוג_ים()
    }
    החזר גלגל_סוג_יבשה(שטח)
}

פונקציה לשלם_משכורות() {
    משתנה i = 0
    כל_עוד (i < שחקנים.גודל()) {
        משתנה עלות = שחקנים[i]["פועלים"] * משכורת_פועל
        אם (עלות > 0) {
            שחקנים[i]["כסף"] = שחקנים[i]["כסף"] - עלות
            הוסף_ליומן: שם_שחקן(i) + " שילם משכורות " + מספרים.שלם(עלות) + "₪"
        }
        i = i + 1
    }
}

פונקציה קנה_מקדחה(רמה) {
    משתנה ש = שחקן_נוכחי()
    אם (רמה <= ש["מקדחה"]) {
        הודעה = "כבר יש לכם מקדחה כזו או טובה יותר"
        החזר שקר
    }
    משתנה מחיר = מחיר_מקדחה[רמה]
    אם (ש["כסף"] < מחיר) {
        הודעה = "אין מספיק כסף למקדחה — " + מספרים.שלם(מחיר) + "₪"
        החזר שקר
    }
    שחקנים[תור]["כסף"] = שחקנים[תור]["כסף"] - מחיר
    שחקנים[תור]["מקדחה"] = רמה
    הוסף_ליומן: שם_שחקן(תור) + " קנה מקדחה " + שמות_מקדחה[רמה]
    הודעה = "נרכשה מקדחה " + שמות_מקדחה[רמה] + " · +" + בונוס_מקדחה[רמה] + "% לכמות מציאה"
    החזר אמת
}

פונקציה גייס_פועל() {
    משתנה ש = שחקן_נוכחי()
    אם (ש["כסף"] < עלות_פועל) {
        הודעה = "אין מספיק כסף לפועל — " + מספרים.שלם(עלות_פועל) + "₪"
        החזר שקר
    }
    שחקנים[תור]["כסף"] = שחקנים[תור]["כסף"] - עלות_פועל
    שחקנים[תור]["פועלים"] = שחקנים[תור]["פועלים"] + 1
    הוסף_ליומן: שם_שחקן(תור) + " גייס פועל · סה״כ " + שחקנים[תור]["פועלים"]
    הודעה = "פועל חדש בצוות · +" + בונוס_פועל_כמות + " כמות לכל משאב במכרה"
    החזר אמת
}

פונקציה הרחב_לוח() {
    משתנה ש = שחקן_נוכחי()
    אם (שורות_פתוחות >= גודל_לוח) {
        הודעה = "כל הלוח כבר פתוח"
        החזר שקר
    }
    אם (ש["כסף"] < עלות_הרחבה) {
        הודעה = "אין מספיק כסף להרחבה — " + מספרים.שלם(עלות_הרחבה) + "₪"
        החזר שקר
    }
    שחקנים[תור]["כסף"] = שחקנים[תור]["כסף"] - עלות_הרחבה
    שורות_פתוחות = שורות_פתוחות + 1
    הוסף_ליומן: שם_שחקן(תור) + " הרחיב את הלוח לשורה " + שורות_פתוחות
    הודעה = "הלוח הורחב — שורה חדשה נפתחה"
    החזר אמת
}

פונקציה קנה_גלאי() {
    משתנה ש = שחקן_נוכחי()
    אם (ש["גלאי"]) {
        הודעה = "כבר יש לכם גלאי מתכות"
        החזר שקר
    }
    אם (ש["כסף"] < מחיר_גלאי) {
