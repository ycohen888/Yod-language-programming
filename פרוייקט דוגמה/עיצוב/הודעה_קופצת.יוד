// הודעה_קופצת.יוד — Toast / Snackbar
כלול "פקד.יוד"

מחלקה הודעה_קופצת מרחיב פקד {
    פונקציה בנאי(טקסט, סגנון = "מידע", מזהה = "") {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        אם (סגנון == ריק או סגנון == "") {
            סגנון = "מידע"
        }
        הורה(מזהה)
        זה.טקסט = טקסט
        זה.סגנון = סגנון
        זה._צור("הודעה_קופצת", {
            "טקסט": טקסט,
            "סגנון": סגנון
        })
    }

    פונקציה הצג() {
        זה._שלח_פקודה("הצג", {})
    }

    פונקציה הסתר() {
        זה._שלח_פקודה("הסתר", {})
    }
}
