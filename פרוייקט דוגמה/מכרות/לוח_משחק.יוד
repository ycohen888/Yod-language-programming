// לוח_משחק.יוד — זריעת מכרות, חפירה ותורות

פונקציה אינדקס_תא x, y
  החזר y * גודל_לוח + x
סוף

פונקציה תא_ב x, y
  החזר תאים[אינדקס_תא(x, y)]
סוף

פונקציה גלגל_דרגה()
  משתנה ר = אקראי() * 100
  אם ר < 35
    החזר 1
  סוף
  אם ר < 60
    החזר 2
  סוף
  אם ר < 80
    החזר 3
  סוף
  אם ר < 93
    החזר 4
  סוף
  החזר 5
סוף

פונקציה זרע_לוח()
  תאים = []
  משתנה y = 0
  כל_עוד y < גודל_לוח
    משתנה x = 0
    כל_עוד x < גודל_לוח
      משתנה דרגה = גלגל_דרגה()
      משתנה תא_חדש = {
        "x": x,
        "y": y,
        "דרגה": דרגה,
        "חפור": שקר,
        "בעלים": 0 - 1,
        "משאב": 0 - 1,
        "כמות": 0
      }
      תאים.הוסף: תא_חדש
      x = x + 1
    סוף
    y = y + 1
  סוף
סוף

פונקציה צור_שחקן שם, מחשב
  משתנה ש = {
    "שם": שם,
    "כסף": כסף_התחלה,
    "מקדחה": 0,
    "פועלים": 0,
    "סהכ_רווח": 0,
    "מחשב": מחשב,
    "גלאי": שקר,
    "משאית": שקר,
    "דינמיט": 0
  }
  החזר ש
סוף

פונקציה עדכן_הודעת_תור()
  הודעה = "★ התור של " + שם_שחקן(תור) + " — לחצו על קוביה עם ? לחפירה (" + מספרים.שלם(עלות_חפירה) + "₪)"
סוף

פונקציה התחל_משחק שני_שחקנים
  בטל_טיימר_AI()
  מצב_2_שחקנים = שני_שחקנים
  שחקנים = []
  שחקנים.הוסף: צור_שחקן("שחקן 1", שקר)
  אם שני_שחקנים
    שחקנים.הוסף: צור_שחקן("שחקן 2", שקר)
  אחרת
    שחקנים.הוסף: צור_שחקן("מחשב", אמת)
  סוף
  תור = 0
  חודש = 1
  יום = 1
  מהלכים_בחודש = 0
  מצב_דינמיט = שקר
  שורות_פתוחות = 6
  יומן = []
  אפס_סיכום_חודש()
  זרע_לוח()
  מצב_מסך = "משחק"
  עדכן_הודעת_תור()
  הוסף_ליומן: "המשחק התחיל! לחצו על קוביה עם סימן שאלה"
  צייר_הכל()
סוף

פונקציה סיום_חודש()
  לשלם_משכורות()
  מצב_מסך = "דוח"
  הודעה = "סיכום חודש " + חודש
  צייר_הכל()
סוף

פונקציה המשך_אחרי_דוח()
  אפס_סיכום_חודש()
  חודש = חודש + 1
  מהלכים_בחודש = 0
  מצב_מסך = "משחק"
  עדכן_הודעת_תור()
  בדוק_ניצחון()
  אם מצב_מסך == "משחק"
    אולי_מהלך_מחשב()
  סוף
  צייר_הכל()
סוף

פונקציה בדוק_ניצחון()
  משתנה א = שחקנים[0]
  משתנה ב = שחקנים[1]
  אם א["כסף"] < 0 או ב["כסף"] < 0
    מצב_מסך = "ניצחון"
    אם א["כסף"] >= ב["כסף"]
      הודעה = "ניצחון ל" + שם_שחקן(0) + "!"
    אחרת
      הודעה = "ניצחון ל" + שם_שחקן(1) + "!"
    סוף
    החזר ריק
  סוף
  אם חודש > 12
    מצב_מסך = "ניצחון"
    אם א["כסף"] + א["סהכ_רווח"] >= ב["כסף"] + ב["סהכ_רווח"]
      הודעה = "סיום עונה — ניצחון ל" + שם_שחקן(0)
    אחרת
      הודעה = "סיום עונה — ניצחון ל" + שם_שחקן(1)
    סוף
  סוף
סוף

פונקציה סיים_תור()
  יום = יום + 1
  מהלכים_בחודש = מהלכים_בחודש + 1
  מצב_דינמיט = שקר
  תור = 1 - תור

  אם מהלכים_בחודש >= מהלכים_לחודש
    סיום_חודש()
    החזר ריק
  סוף

  עדכן_הודעת_תור()
  אולי_מהלך_מחשב()
  צייר_הכל()
סוף

פונקציה חפור_בתא x, y
  אם מצב_מסך != "משחק"
    החזר ריק
  סוף
  אם y >= שורות_פתוחות
    הודעה = "השורה נעולה — לחצו «הרחב לוח» בחנות או בפאנל"
    צייר_הכל()
    החזר ריק
  סוף
  משתנה ת = תא_ב(x, y)
  אם ת["חפור"]
    הודעה = "הקוביה כבר נחפרה — בחרו קוביה עם ?"
    צייר_הכל()
    החזר ריק
  סוף
  משתנה ש = שחקן_נוכחי()
  אם ש["מחשב"]
    // המחשב קורא ישירות — מותר
  אחרת
    // בדיקה כפולה למקרה של לחיצה בתור מחשב
  סוף

  משתנה עלות = עלות_חפירה
  משתנה בונוס_דינמיט = 0
  אם מצב_דינמיט
    אם ש["דינמיט"] < 1
      מצב_דינמיט = שקר
      הודעה = "אין דינמיט במלאי"
      צייר_הכל()
      החזר ריק
    סוף
    ש["דינמיט"] = ש["דינמיט"] - 1
    בונוס_דינמיט = 18
    מצב_דינמיט = שקר
  סוף

  אם ש["כסף"] < עלות
    הודעה = "אין מספיק כסף לחפירה — צריך " + מספרים.שלם(עלות) + "₪"
    צייר_הכל()
    החזר ריק
  סוף

  ש["כסף"] = ש["כסף"] - עלות
  ת["חפור"] = אמת
  ת["בעלים"] = תור

  משתנה סיכוי = סיכוי_מציאה(ש, ת["דרגה"]) + בונוס_דינמיט
  אם סיכוי > 96
    סיכוי = 96
  סוף
  משתנה גלגל = אקראי() * 100
  אם גלגל < סיכוי
    משתנה סוג = גלגל_סוג_משאב(ת["דרגה"])
    משתנה כמות = גלגל_כמות(ת["דרגה"])
    אם סוג == 10
      כמות = אקראי_בין: 1, 3
    סוף
    אם סוג == 9
      כמות = אקראי_בין: 1, 4
    סוף
    ת["משאב"] = סוג
    ת["כמות"] = כמות
    משתנה רווח_גולמי = כמות * מחיר_לקילו[סוג]
    משתנה רווח = רווח_גולמי
    אם ש["משאית"]
      רווח = (רווח_גולמי * 125 / 100).שלם()
    סוף
    ש["כסף"] = ש["כסף"] + רווח
    ש["סהכ_רווח"] = ש["סהכ_רווח"] + רווח
    חודש_קילו[סוג] = חודש_קילו[סוג] + כמות
    חודש_רווח[סוג] = חודש_רווח[סוג] + רווח
    הוסף_ליומן: שם_שחקן(תור) + " מצא " + כמות + "ק״ג " + שמות_משאב[סוג] + " (+" + מספרים.שלם(רווח) + "₪)"
    הודעה = "✓ " + שם_שחקן(תור) + " מצא " + שמות_משאב[סוג] + "! +" + מספרים.שלם(רווח) + "₪"
  אחרת
    הוסף_ליומן: שם_שחקן(תור) + " חפר — המכרה ריק"
    הודעה = "ריק… אין משאבים הפעם. התור עובר"
  סוף

  סיים_תור()
סוף
