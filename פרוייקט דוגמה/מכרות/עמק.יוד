// עמק.יוד — חלקות גדולות, שכנויות, מכרז ומחנה
פונקציה צבע_שטח(שטח) {
    אם (שטח == 3) {
        החזר [מים_א, מים_י, מים_כ]
    }
    אם (שטח == 0) {
        החזר [מישור_א, מישור_י, מישור_כ]
    }
    אם (שטח == 1) {
        החזר [הר_א + 18, הר_י + 10, הר_כ]
    }
    החזר [הר_א, הר_י, הר_כ]
}

פונקציה הגרל_איכות(שטח) {
    משתנה ר = אקראי_בין: 1, 100
    אם (שטח == 2) {
        אם (ר <= 12) {
            החזר 3
        }
        אם (ר <= 40) {
            החזר 2
        }
        אם (ר <= 75) {
            החזר 1
        }
        החזר 0
    }
    אם (שטח == 1) {
        אם (ר <= 8) {
            החזר 3
        }
        אם (ר <= 30) {
            החזר 2
        }
        אם (ר <= 70) {
            החזר 1
        }
        החזר 0
    }
    אם (שטח == 3) {
        אם (ר <= 6) {
            החזר 3
        }
        אם (ר <= 25) {
            החזר 2
        }
        אם (ר <= 65) {
            החזר 1
        }
        החזר 0
    }
    אם (ר <= 4) {
        החזר 3
    }
    אם (ר <= 18) {
        החזר 2
    }
    אם (ר <= 55) {
        החזר 1
    }
    החזר 0
}

פונקציה הגרל_משאב(שטח) {
    אם (שטח == 3) {
        משתנה מים = אקראי_בין: 0, 1
        אם (מים == 0) {
            החזר 2
        }
        החזר 4
    }
    אם (שטח == 2) {
        משתנה רכס = אקראי_בין: 0, 3
        אם (רכס == 0) {
            החזר 0
        }
        אם (רכס == 1) {
            החזר 3
        }
        אם (רכס == 2) {
            החזר 1
        }
        החזר 4
    }
    החזר אקראי_בין: 0, 4
}

פונקציה מחיר_בסיס_לאיכות(איכות) {
    משתנה בסיס = מחיר_איכות[איכות]
    משתנה תוספת = אקראי_בין: 0, בסיס / 5
    החזר בסיס + תוספת
}

פונקציה צור_חלקה(שם, x, y, רחב, גבה, שטח, שכנים) {
    משתנה איכות = הגרל_איכות(שטח)
    משתנה משאב = הגרל_משאב(שטח)
    משתנה ח ={ שם: שם, x: x, y: y, רחב: רחב, גבה: גבה, שטח: שטח, איכות: איכות, משאב: משאב, מחיר_בסיס: מחיר_בסיס_לאיכות(איכות), בעלים: ריק, שכנים: שכנים}
    החזר ח
}

פונקציה בנה_עמק() {
    חלקות = []
    // רכסים למעלה
    חלקות.הוסף: צור_חלקה("רכס הרוח", 40, 80, 170, 110, 2, [1, 4])
