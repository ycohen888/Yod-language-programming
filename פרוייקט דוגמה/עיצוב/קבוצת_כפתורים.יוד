// קבוצת_כפתורים.יוד — כפתורים מחוברים
כלול "פקד.יוד"

מחלקה קבוצת_כפתורים מרחיב פקד {
    פונקציה בנאי(פריטים, מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה.ערך = ""
        זה._שינוי = ריק
        זה._לחץ = ריק
        זה._צור("קבוצת_כפתורים", {
            "פריטים": פריטים
        })
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }
}
