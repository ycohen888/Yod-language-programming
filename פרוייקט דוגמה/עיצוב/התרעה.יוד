// התרעה.יוד — Alert / Banner
כלול "פקד.יוד"

מחלקה התרעה מרחיב פקד {
    פונקציה בנאי(טקסט, סגנון = "מידע", מזהה = "") {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        אם (סגנון == ריק או סגנון == "") {
            סגנון = "מידע"
        }
        הורה(מזהה)
        זה.טקסט = טקסט
        זה.סגנון = סגנון
        זה._צור("התרעה", {
            "טקסט": טקסט,
            "סגנון": סגנון
        })
    }

    פונקציה קבע_סגנון(ס) {
        אם (ס == ריק או ס == "") {
            ס = "מידע"
        }
        זה.סגנון = ס
        זה._שלח_פקודה("קבע_סגנון", { "סגנון": ס })
    }
}
