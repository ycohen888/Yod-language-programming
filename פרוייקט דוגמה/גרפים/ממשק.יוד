    {"שם": "2024", "ערכים": [38, 41, 45, 50, 52, 58], "צבע": "תכלת"}
  ]
  עמודות.קבע_גובה: 280

  משתנה קו = גרפים.קו()
  קו.קבע_כותרת: "משתמשים פעילים"
