// לשוניות.יוד — לשונית 0 בצד ההתחלה
מחלקה לשוניות מרחיב רכיב {
    פונקציה בנאי(x, y, רחב, שמות) {
        הורה(x, y, רחב, 28)
        זה.שמות = שמות
        זה.נבחר = 0
        זה.בשינוי = ריק
    }
    פונקציה קבע_נבחר(i) {
        אם (i < 0 או i >= אורך(זה.שמות)) {
            החזר ריק
        }
        זה.נבחר = i
        זה.בקש_רענון()
        אם (זה.בשינוי != ריק) {
            זה.בשינוי(i, זה.שמות[i])
        }
    }
    פונקציה אינדקס_ממיקום(mx) {
        משתנה n = אורך(זה.שמות)
        אם (n <= 0) {
            החזר 0
        }
        משתנה tw = זה.רחב / n
        משתנה i = 0
        אם (הוא_ימין(זה.כיוון())) {
            i = ((זה.x + זה.רחב - mx) / tw).שלם()
        } אחרת {
            i = ((mx - זה.x) / tw).שלם()
        }
        אם (i < 0) {
            i = 0
        }
        אם (i >= n) {
            i = n - 1
        }
        החזר i
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משטח.קבע_מילוי(28, 30, 36)
        מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 7)
        משתנה n = אורך(זה.שמות)
        אם (n <= 0) {
            החזר ריק
        }
        משתנה tw = זה.רחב / n
        משתנה i = 0
        כל_עוד (i < n) {
            משתנה tx = זה.x + i * tw
            אם (הוא_ימין(זה.כיוון())) {
                tx = זה.x + זה.רחב - (i + 1) * tw
            }
            אם (i == זה.נבחר) {
                משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
                מלבן_מעוגל_מלא(משטח, tx + 2, זה.y + 2, tw - 4, זה.גבה - 4, 5)
                משטח.קבע_צבע(240, 250, 248)
            } אחרת {
                משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
            }
            משטח.קבע_גודל_גופן(11)
            משטח.קבע_יישור("מרכז")
            משטח.טקסט(זה.שמות[i], tx + tw / 2, זה.y + 7)
            משטח.קבע_יישור("שמאל")
            i = i + 1
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        זה.קבע_נבחר(זה.אינדקס_ממיקום(mx))
        החזר אמת
    }
}
