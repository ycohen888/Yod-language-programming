    משתנה x = 0
    כל_עוד x < גודל_לוח
      משתנה px = בסיס_x + x * גודל_תא
      משתנה py = בסיס_y + y * גודל_תא
      אם y >= שורות_פתוחות
        לוח.קבע_מילוי: 14, 16, 22
        לוח.מלבן_מעוגל_מלא: px + מרווח_תאים, py + מרווח_תאים, גודל_תא - מרווח_תאים * 2, גודל_תא - מרווח_תאים * 2, 7
        לוח.קבע_מילוי: 22, 24, 30
        לוח.מלבן_מעוגל_מלא: px + 8, py + 8, גודל_תא - 16, גודל_תא - 16, 5
        לוח.תמונה: נתיב_נעול, px + 11, py + 10, 24, 24
      אחרת
        משתנה ת = תא_ב(x, y)
        אם ת["חפור"]
          אם ת["בעלים"] == 0
            לוח.קבע_מילוי: 18, 72, 58
          אחרת
            לוח.קבע_מילוי: 28, 58, 112
          סוף
          לוח.מלבן_מעוגל_מלא: px + מרווח_תאים, py + מרווח_תאים, גודל_תא - מרווח_תאים * 2, גודל_תא - מרווח_תאים * 2, 7

          // פס בעלות בתחתית התא
          אם ת["בעלים"] == 0
            לוח.קבע_מילוי: שחקן1_א, שחקן1_י, שחקן1_כ
          אחרת
            לוח.קבע_מילוי: שחקן2_א, שחקן2_י, שחקן2_כ
          סוף
          לוח.מלבן_מעוגל_מלא: px + מרווח_תאים + 2, py + גודל_תא - מרווח_תאים - 10, גודל_תא - מרווח_תאים * 2 - 4, 8, 3

          אם ת["משאב"] >= 0
            לוח.תמונה: נתיבי_משאב[ת["משאב"]], px + 5, py + 4, 20, 20
            משתנה ממ = ת["ממצאים"]
            אם ממ.גודל() > 1
              לוח.תמונה: נתיבי_משאב[ממ[1]["סוג"]], px + 24, py + 5, 16, 16
            סוף
            לוח.קבע_צבע: 240, 245, 250
            לוח.קבע_גודל_גופן: 10
            לוח.טקסט: "" + ממ.גודל(), px + גודל_תא - 16, py + 6
          סוף

          // תג שחקן בפינה
