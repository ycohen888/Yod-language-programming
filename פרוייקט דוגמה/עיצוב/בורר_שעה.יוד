// בורר_שעה.יוד — בחירת שעה (ריק מותר; HH:MM, אופציונלי שניות)
כלול "פקד.יוד"

מחלקה בורר_שעה מרחיב פקד {
    פונקציה בנאי(ערך = "", עם_שניות = שקר, מזהה = "") {
        אם (ערך == ריק) {
            ערך = ""
        }
        הורה(מזהה)
        זה.ערך = ערך
        זה.עם_שניות = עם_שניות
        זה._שינוי = ריק
        זה._צור("בורר_שעה", {
            "ערך": ערך,
            "עם_שניות": עם_שניות
        })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
