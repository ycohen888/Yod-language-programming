// קרוסלה.יוד — Carousel /Slideshow
כלול "פקד.יוד"

מחלקה קרוסלה מרחיב פקד {
    פונקציה בנאי(פריטים, נבחר = 0, מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        אם (נבחר == ריק) {
            נבחר = 0
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה.ערך = נבחר
        זה._שינוי = ריק
        זה._צור("קרוסלה", {
            "פריטים": פריטים,
            "ערך": נבחר
        })
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה קבע_ערך(מספר) {
        אם (מספר == ריק) {
            מספר = 0
        }
        זה.ערך = מספר
        זה._שלח_פקודה("קבע_ערך", { "ערך": מספר })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה הבא() {
        זה._שלח_פקודה("הבא", {})
    }

    פונקציה הקודם() {
        זה._שלח_פקודה("הקודם", {})
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
