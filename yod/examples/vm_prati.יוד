// פרטי / ציבורי במכונה
// yod מכונה examples\vm_prati.יוד
מחלקה חשבון
    פרטי משתנה יתרה = 0
    ציבורי פונקציה בנאי(סכום)
        זה.יתרה = סכום
    סוף
    ציבורי פונקציה הפקד(סכום)
        זה.יתרה = זה.יתרה + סכום
    סוף
    ציבורי פונקציה יתרה_נוכחית()
        החזר זה.יתרה
    סוף
    פרטי פונקציה לוג()
        הדפס("לוג פנימי: " + זה.יתרה)
    סוף
    ציבורי פונקציה הדפס_לוג()
        זה.לוג()
    סוף
סוף

משתנה ח = חדש חשבון(100)
ח.הפקד(50)
הדפס("יתרה: " + ח.יתרה_נוכחית())
ח.הדפס_לוג()
נסה
    הדפס(ח.יתרה)
תפוס שגיאה
    הדפס("גישה נחסמה: " + שגיאה)
סוף
