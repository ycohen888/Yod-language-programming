// מצב.יוד — מצב הצייר

משתנה כלי = "עיפרון"
משתנה צבע = "שחור"
משתנה צבע_r = 0
משתנה צבע_g = 0
משתנה צבע_b = 0
משתנה עובי = 3
משתנה x_קודם = 0
משתנה y_קודם = 0
משתנה x_התחלה = 0
משתנה y_התחלה = 0
משתנה לוח = ריק
משתנה סטטוס = ריק

פונקציה החל_צבע_נוכחי()
  אם לוח == ריק
    החזר ריק
  סוף
  אם צבע == "rgb"
    לוח.קבע_צבע: צבע_r, צבע_g, צבע_b
    לוח.קבע_מילוי: צבע_r, צבע_g, צבע_b
  אחרת
    לוח.קבע_צבע: צבע
    לוח.קבע_מילוי: צבע
  סוף
  לוח.קבע_עובי: עובי
סוף

פונקציה טקסט_צבע()
  אם צבע == "rgb"
    החזר "RGB(" + צבע_r + "," + צבע_g + "," + צבע_b + ")"
  סוף
  החזר צבע
סוף

פונקציה עדכן_סטטוס()
  אם סטטוס == ריק
    החזר ריק
  סוף
  סטטוס.קבע_טקסט: כלי
סוף

פונקציה בחר_כלי שם
  כלי = שם
  עדכן_סטטוס()
סוף

פונקציה בחר_צבע שם
  צבע = שם
  החל_צבע_נוכחי()
  עדכן_סטטוס()
סוף

פונקציה בחר_צבע_rgb r, g, b
  צבע = "rgb"
  צבע_r = r
  צבע_g = g
  צבע_b = b
  החל_צבע_נוכחי()
  עדכן_סטטוס()
סוף

פונקציה בחר_עובי n
  עובי = n
  אם לוח != ריק
    לוח.קבע_עובי: n
  סוף
  עדכן_סטטוס()
סוף

פונקציה מידות_מלבן x1, y1, x2, y2
  משתנה mx = x1
  משתנה my = y1
  אם x2 < x1
    mx = x2
  סוף
  אם y2 < y1
    my = y2
  סוף
  החזר [mx, my, (x2 - x1).מוחלט(), (y2 - y1).מוחלט()]
סוף

פונקציה צייר_צורה x1, y1, x2, y2
  החל_צבע_נוכחי()
  אם כלי == "קו"
    לוח.קו: x1, y1, x2, y2
    החזר ריק
  סוף
  אם כלי == "מלבן"
    משתנה מ = מידות_מלבן(x1, y1, x2, y2)
    לוח.מלבן: מ[0], מ[1], מ[2], מ[3]
    החזר ריק
  סוף
  אם כלי == "עיגול"
    משתנה cx = (x1 + x2) / 2
    משתנה cy = (y1 + y2) / 2
    משתנה rx = ((x2 - x1).מוחלט()) / 2
    משתנה ry = ((y2 - y1).מוחלט()) / 2
    משתנה רדיוס = rx
    אם ry > rx
      רדיוס = ry
    סוף
    אם רדיוס < 1
      רדיוס = 1
    סוף
    לוח.עיגול: cx, cy, רדיוס
    החזר ריק
  סוף
  אם כלי == "אליפסה"
    משתנה ecx = (x1 + x2) / 2
    משתנה ecy = (y1 + y2) / 2
    משתנה erx = ((x2 - x1).מוחלט()) / 2
    משתנה ery = ((y2 - y1).מוחלט()) / 2
    אם erx < 1
      erx = 1
    סוף
    אם ery < 1
      ery = 1
    סוף
    לוח.אליפסה: ecx, ecy, erx, ery
  סוף
סוף
