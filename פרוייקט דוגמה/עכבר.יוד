// עכבר.יוד — לוגיקת ציור לפי כלי (תצוגה מקדימה + בטל)

פונקציה כלי_צורה()
  אם כלי == "קו"
    החזר אמת
  סוף
  אם כלי == "מלבן"
    החזר אמת
  סוף
  אם כלי == "עיגול"
    החזר אמת
  סוף
  אם כלי == "אליפסה"
    החזר אמת
  סוף
  החזר שקר
סוף

פונקציה על_עכבר_למטה x, y
  x_התחלה = x
  y_התחלה = y
  x_קודם = x
  y_קודם = y

  אם כלי == "טפטפת"
    משתנה פיקסל = לוח.קרא_צבע: x, y
    בחר_צבע_rgb: פיקסל["אדום"], פיקסל["ירוק"], פיקסל["כחול"]
    החזר ריק
  סוף

  לוח.צלם()

  אם כלי == "מילוי"
    החל_צבע_נוכחי()
    לוח.מלא_באזור: x, y
    החזר ריק
  סוף

  אם כלי_צורה()
    לוח.גיבוי()
    החזר ריק
  סוף

  אם כלי == "עיפרון"
    החל_צבע_נוכחי()
    לוח.נקודה: x, y
    החזר ריק
  סוף

  אם כלי == "מחק"
    לוח.קבע_צבע: "לבן"
    משתנה ע = עובי
    אם ע < 6
      ע = 6
    סוף
    לוח.קבע_עובי: ע
    לוח.נקודה: x, y
  סוף
סוף

פונקציה על_עכבר_גרירה x, y
  אם כלי_צורה()
    לוח.שחזר()
    צייר_צורה: x_התחלה, y_התחלה, x, y
    החזר ריק
  סוף

  אם כלי == "עיפרון"
    החל_צבע_נוכחי()
    לוח.קו: x_קודם, y_קודם, x, y
    x_קודם = x
    y_קודם = y
    החזר ריק
  סוף

  אם כלי == "מחק"
    לוח.קבע_צבע: "לבן"
    משתנה ע = עובי
    אם ע < 6
      ע = 6
    סוף
    לוח.קבע_עובי: ע
    לוח.קו: x_קודם, y_קודם, x, y
    x_קודם = x
    y_קודם = y
  סוף
סוף

פונקציה על_עכבר_למעלה x, y
  אם כלי_צורה()
    לוח.שחזר()
    צייר_צורה: x_התחלה, y_התחלה, x, y
  סוף
סוף
