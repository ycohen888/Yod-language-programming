// פגע.יוד — בדיקות פגיעה גאומטריות לרכיבי משטח
פונקציה נקודה_במלבן(mx, my, x, y, רחב, גבה) {
    אם (mx < x) {
        החזר שקר
    }
    אם (my < y) {
        החזר שקר
    }
    אם (mx >= x + רחב) {
        החזר שקר
    }
    אם (my >= y + גבה) {
        החזר שקר
    }
    החזר אמת
}

פונקציה נקודה_בעיגול(mx, my, cx, cy, רדיוס) {
    משתנה dx = mx - cx
    משתנה dy = my - cy
    החזר dx * dx + dy * dy <= רדיוס * רדיוס
}

פונקציה הגבל(ערך, מינ, מקס) {
    אם (ערך < מינ) {
        החזר מינ
    }
    אם (ערך > מקס) {
        החזר מקס
    }
    החזר ערך
}
// עיגול לערך בצעד (למשל צעד=1 → מספר שלם)
פונקציה עגל_לצעד(ערך, צעד) {
    אם (צעד <= 0) {
        החזר ערך
    }
    החזר (ערך / צעד).עיגול() * צעד
}
