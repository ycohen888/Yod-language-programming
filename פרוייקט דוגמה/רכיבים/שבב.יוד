// שבב.יוד — שבב בחירה; טקסט ממורכז
מחלקה שבב מרחיב רכיב {
    פונקציה בנאי(x, y, טקסט, נבחר) {
        הורה(x, y, 64, 22)
        זה.טקסט = טקסט
        זה.נבחר = נבחר
        זה.בשינוי = ריק
    }
    פונקציה קבע_נבחר(v) {
        זה.נבחר = v
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משטח.קבע_גודל_גופן(11)
        משתנה tw = אומדן_רוחב_טקסט(משטח, זה.טקסט)
        זה.רחב = 20 + tw
        אם (זה.רחב < 44) {
            זה.רחב = 44
        }
        אם (זה.נבחר) {
            מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2, ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
            משטח.קבע_צבע(240, 250, 248)
        } אחרת {
            מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2, ערכה_גובה_א, ערכה_גובה_י, ערכה_גובה_כ)
            משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        }
        צייר_טקסט_ממורכז(משטח, זה, זה.טקסט, זה.y + 4)
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        אם (זה.נבחר) {
            זה.נבחר = שקר
        } אחרת {
            זה.נבחר = אמת
        }
        זה.בקש_רענון()
        אם (זה.בשינוי != ריק) {
            זה.בשינוי(זה.נבחר)
        }
        החזר אמת
    }
}
