// מילונים
משתנה אדם = { "שם": "נועם", "גיל": 30, עיר: "תל אביב" }
הדפס(אדם["שם"])
הדפס(אדם.עיר)
הדפס: "יש " + אורך(אדם) + " שדות"
אדם["גיל"] = 31
אדם.עיר = "חיפה"
הדפס: אדם.שם + " מ" + אדם.עיר + ", גיל " + אדם["גיל"]
משתנה ריקון = {}
הדפס: "מילון ריק: " + אורך(ריקון)
עבור מפתח בתוך אדם
    הדפס: מפתח + " = " + אדם[מפתח]
סוף
