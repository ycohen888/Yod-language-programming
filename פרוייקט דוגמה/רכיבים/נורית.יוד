// נורית.יוד — נקודת סטטוס בצד ההתחלה
מחלקה נורית מרחיב רכיב {
    פונקציה בנאי(x, y, טקסט, דולקת) {
        הורה(x, y, 120, 18)
        זה.טקסט = טקסט
        זה.דולקת = דולקת
    }
    פונקציה קבע_דולקת(v) {
        זה.דולקת = v
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה bx = x_פריט_מהתחלה(זה, 0, 10)
        משתנה cx = bx + 5
        משתנה cy = זה.y + זה.גבה / 2
        אם (זה.דולקת) {
            משטח.קבע_מילוי(36, 170, 90)
            משטח.עיגול_מלא(cx, cy, 5)
            משטח.קבע_מילוי(130, 235, 165)
            משטח.עיגול_מלא(cx - 1, cy - 1, 2)
        } אחרת {
            משטח.קבע_מילוי(90, 55, 55)
            משטח.עיגול_מלא(cx, cy, 5)
        }
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        משטח.קבע_גודל_גופן(11)
        צייר_טקסט_ברכיב(משטח, זה, זה.טקסט, זה.y + 3, 14)
    }
}
