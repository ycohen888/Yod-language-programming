// כפתור_צלמית.יוד — כפתור ריבועי קטן לסרגל כלים

מחלקה כפתור_צלמית מרחיב רכיב
  פונקציה בנאי(x, y, סמל)
    הורה(x, y, 36, 36)
    זה.סמל = סמל
    זה.פעיל = שקר
    זה.בלחיצה = ריק
  סוף

  פונקציה קבע_פעיל(v)
    זה.פעיל = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה מא = ערכה_גובה_א
    משתנה מי = ערכה_גובה_י
    משתנה מכ = ערכה_גובה_כ
    אם זה.פעיל
      מא = ערכה_ראשי_א
      מי = ערכה_ראשי_י
      מכ = ערכה_ראשי_כ
    סוף
    אם זה.לחוץ
      מא = 34
      מי = 36
      מכ = 42
    סוף
    מלבן_מעוגל_עם_גבול(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 9, מא, מי, מכ)
    משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
    משטח.קבע_גודל_גופן(14)
    משטח.טקסט(זה.סמל, זה.x + 10, זה.y + 9)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.לחוץ = אמת
    זה.בקש_רענון()
    החזר אמת
  סוף

  פונקציה בעכבר_למעלה(mx, my, כפתור)
    אם לא זה.לחוץ
      החזר ריק
    סוף
    זה.לחוץ = שקר
    זה.בקש_רענון()
    אם זה.מכיל(mx, my) וגם זה.בלחיצה != ריק
      זה.בלחיצה()
    סוף
  סוף
סוף
