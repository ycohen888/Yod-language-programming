// אריזה וחילוץ ZIP
כלול "קבצים"

משתנה תיקייה = "examples/archive_demo"
קבצים.צור_תיקייה(תיקייה)
קבצים.כתוב(קבצים.צרף(תיקייה, "שלום.txt"), "שלום מיוד")
קבצים.כתוב(קבצים.צרף(תיקייה, "עוד.txt"), "קובץ שני")

משתנה ארכיון = קבצים.ארוז(תיקייה, "examples/גיבוי.zip")
הדפס: "נארז אל: " + ארכיון

קבצים.תוכן_ארכיון(ארכיון)

משתנה יעד = "examples/archive_out"
קבצים.חלץ(ארכיון, יעד)
הדפס: "חולץ אל: " + יעד
הדפס(קבצים.קרא(קבצים.צרף(יעד, "archive_demo", "שלום.txt")))
