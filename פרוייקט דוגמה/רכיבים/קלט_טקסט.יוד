// קלט_טקסט.יוד — שדה הקלדה על משטח (מיקוד + מקלדת)

מחלקה קלט_טקסט מרחיב רכיב
  פונקציה בנאי(x, y, רחב, טקסט)
    אם טקסט == ריק
      טקסט = ""
    סוף
    הורה(x, y, רחב, 28)
    זה.טקסט = טקסט
    זה.מקום_שמור = ""
    זה.ממוקד = שקר
    זה.בשינוי = ריק
    זה.באנטר = ריק
    זה.רדיוס = 6
  סוף

  פונקציה מקבל_מיקוד()
    החזר אמת
  סוף

  פונקציה קבע_מיקוד(v)
    זה.ממוקד = v
    זה.בקש_רענון()
  סוף

  פונקציה קבע_טקסט(t)
    אם t == ריק
      זה.טקסט = ""
    אחרת
      זה.טקסט = t
    סוף
    זה.בקש_רענון()
  סוף

  פונקציה קרא_טקסט()
    אם זה.טקסט == ריק
      החזר ""
    סוף
    החזר זה.טקסט
  סוף

  פונקציה קבע_מקום_שמור(t)
    אם t == ריק
      זה.מקום_שמור = ""
    אחרת
      זה.מקום_שמור = t
    סוף
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה מא = 28
    משתנה מי = 30
    משתנה מכ = 36
    אם זה.ממוקד
      מא = 34
      מי = 38
      מכ = 48
    סוף
    אם זה.מושבת
      מא = 26
      מי = 28
      מכ = 32
    סוף
    מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, מא, מי, מכ)
    אם זה.ממוקד
      משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
      מלבן_מעוגל_מלא(משטח, זה.x + 3, זה.y + זה.גבה - 2, זה.רחב - 6, 2, 1)
    סוף

    משטח.קבע_גודל_גופן(11)
    משתנה tx = זה.x + 8
    משתנה ty = זה.y + 7
    אם זה.טקסט == "" או זה.טקסט == ריק
      אם זה.מקום_שמור != "" וגם זה.מקום_שמור != ריק
        משטח.קבע_צבע(100, 108, 118)
        משטח.טקסט(זה.מקום_שמור, tx, ty)
      סוף
    אחרת
      משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
      משטח.טקסט(זה.טקסט, tx, ty)
    סוף

    אם זה.ממוקד
      משטח.קבע_צבע(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
      משתנה caret_x = tx
      אם זה.טקסט != "" וגם זה.טקסט != ריק
        // קירוב: רוחב תו ~7 פיקסל לגופן 11
        caret_x = tx + זה.טקסט.אורך() * 7
        אם caret_x > זה.x + זה.רחב - 8
          caret_x = זה.x + זה.רחב - 8
        סוף
      סוף
      משטח.קבע_עובי(1)
      משטח.קו(caret_x, זה.y + 5, caret_x, זה.y + זה.גבה - 5)
    סוף
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.ממוקד = אמת
    זה.בקש_רענון()
    החזר אמת
  סוף

  פונקציה בעת_תו(תו)
    אם זה.מושבת או לא זה.ממוקד
      החזר ריק
    סוף
    אם תו == ריק או תו == ""
      החזר ריק
    סוף
    זה.טקסט = זה.טקסט + תו
    זה.בקש_רענון()
    אם זה.בשינוי != ריק
      זה.בשינוי(זה.טקסט)
    סוף
  סוף

  פונקציה בעת_מקש(שם)
    אם זה.מושבת או לא זה.ממוקד
      החזר ריק
    סוף
    אם שם == "מחיקה"
      משתנה ל = זה.טקסט.אורך()
      אם ל > 0
        זה.טקסט = זה.טקסט.חתוך(0, ל - 1)
        זה.בקש_רענון()
        אם זה.בשינוי != ריק
          זה.בשינוי(זה.טקסט)
        סוף
      סוף
    אחרת_אם שם == "מחק"
      זה.טקסט = ""
      זה.בקש_רענון()
      אם זה.בשינוי != ריק
        זה.בשינוי(זה.טקסט)
      סוף
    אחרת_אם שם == "אנטר"
      אם זה.באנטר != ריק
        זה.באנטר(זה.טקסט)
      סוף
    סוף
  סוף
סוף
