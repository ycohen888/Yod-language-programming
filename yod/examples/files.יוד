כלול "קבצים"
משתנה נתיב = "examples/temp_yod.txt"
קבצים.כתוב(נתיב, "שלום מקבצים של יוד")
הדפס(קבצים.קרא(נתיב))
אם (קבצים.קיים(נתיב))
    הדפס("הקובץ קיים")
סוף

קבצים.מחק(נתיב)
אם (!קבצים.קיים(נתיב))
    הדפס("הקובץ נמחק")
סוף

מקור = "examples/temp_copy_src.txt"
יעד = "examples/temp_copy_dst.txt"
קבצים.כתוב(מקור, "להעתקה")
קבצים.העתק(מקור, יעד)
הדפס(קבצים.קרא(יעד))
קבצים.מחק(מקור)
קבצים.מחק(יעד)