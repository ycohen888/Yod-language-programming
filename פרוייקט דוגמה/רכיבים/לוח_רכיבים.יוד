// לוח_רכיבים.יוד — מנהל משטח + פיזור אירועי עכבר/מקלדת לרכיבים
מחלקה לוח_רכיבים {
    פונקציה בנאי(רוחב, גובה) {
        זה.משטח = חלונות.משטח(רוחב, גובה)
        זה.רחב = רוחב
        זה.גבה = גובה
        זה.רכיבים = []
        זה.פעיל = ריק
        זה.ממוקד = ריק
        זה.רמז_נוכחי = ""
        זה.בפריסה = ריק
        זה.רקע_א = ערכה_רקע_א
        זה.רקע_י = ערכה_רקע_י
        זה.רקע_כ = ערכה_רקע_כ
        זה.השהה_רענון = שקר
        זה.מלוכלך = שקר
        משתנה עצמי = זה
        זה.משטח.בעכבר_למטה: פונקציה(x, y, כפתור) {
            עצמי.על_למטה(x, y, כפתור)
        }
        זה.משטח.בעכבר_גרירה: פונקציה(x, y, כפתור) {
            עצמי.על_גרירה(x, y, כפתור)
        }
        זה.משטח.בעכבר_למעלה: פונקציה(x, y, כפתור) {
            עצמי.על_למעלה(x, y, כפתור)
        }
        זה.משטח.בעכבר_זוז: פונקציה(x, y) {
            עצמי.על_זוז(x, y)
        }
        זה.משטח.בעת_תו: פונקציה(תו) {
            עצמי.על_תו(תו)
        }
        זה.משטח.בעת_מקש: פונקציה(שם) {
            עצמי.על_מקש(שם)
        }
        זה.משטח.בשינוי_גודל: פונקציה(רחב, גבה) {
            עצמי.על_גודל(רחב, גבה)
        }
    }
    פונקציה משטח_גלוי() {
        החזר זה.משטח
    }
    פונקציה הוסף(ר) {
        ר.לוח = זה
        זה.רכיבים.הוסף(ר)
        זה.רענון()
    }
    פונקציה סמן_רענון() {
        אם (זה.השהה_רענון) {
            זה.מלוכלך = אמת
        } אחרת {
            זה.רענון()
        }
    }
    פונקציה רענון() {
        זה.משטח.נקה(זה.רקע_א, זה.רקע_י, זה.רקע_כ)
        עבור (ר בתוך זה.רכיבים) {
            ר.צייר(זה.משטח)
        }
        זה.משטח.רענן()
        זה.מלוכלך = שקר
    }
    פונקציה עם_אצווה(פעולה) {
        זה.השהה_רענון = אמת
        פעולה()
        זה.השהה_רענון = שקר
        אם (זה.מלוכלך) {
            זה.רענון()
        }
    }
    פונקציה על_גודל(רחב, גבה) {
        אם (רחב < 40) {
            רחב = 40
        }
        אם (גבה < 40) {
            גבה = 40
        }
        זה.רחב = רחב
        זה.גבה = גבה
        אם (זה.בפריסה != ריק) {
            זה.בפריסה(רחב, גבה)
        }
        זה.רענון()
    }
    פונקציה טקסט_רמז(ר) {
        אם (ר == ריק) {
            החזר ""
        }
        אם (ר.רמז == ריק או ר.רמז == "") {
            החזר ""
        }
        החזר ר.רמז
    }
    פונקציה נקה_מיקוד() {
        אם (זה.ממוקד != ריק) {
            זה.ממוקד.קבע_מיקוד(שקר)
            זה.ממוקד = ריק
        }
    }
    פונקציה על_תו(תו) {
        אם (זה.ממוקד != ריק) {
            זה.ממוקד.בעת_תו(תו)
        }
    }
    פונקציה על_מקש(שם) {
        אם (זה.ממוקד != ריק) {
            זה.ממוקד.בעת_מקש(שם)
        }
    }
    פונקציה על_זוז(x, y) {
        משתנה tip = ""
        משתנה i = אורך(זה.רכיבים) - 1
        כל_עוד (i >= 0) {
            משתנה ר = זה.רכיבים[i]
            אם (ר.מכיל(x, y)) {
                tip = זה.טקסט_רמז(ר)
                עצור
            }
            i = i - 1
        }
        אם (tip != זה.רמז_נוכחי) {
            זה.רמז_נוכחי = tip
            זה.משטח.קבע_רמז(tip)
        }
    }
    פונקציה על_למטה(x, y, כפתור) {
        משתנה עצמי = זה
        זה.עם_אצווה(פונקציה() {
            עצמי.נקה_מיקוד()
            עצמי.פעיל = ריק
            משתנה i = אורך(עצמי.רכיבים) - 1
            כל_עוד (i >= 0) {
                משתנה ר = עצמי.רכיבים[i]
                אם (ר.בעכבר_למטה(x, y, כפתור)) {
                    עצמי.פעיל = ר
                    אם (ר.מקבל_מיקוד()) {
                        עצמי.ממוקד = ר
                        ר.קבע_מיקוד(אמת)
                        עצמי.משטח.בקש_מיקוד()
                    }
                    החזר ריק
                }
                i = i - 1
            }
        })
    }
    פונקציה על_גרירה(x, y, כפתור) {
        משתנה עצמי = זה
        זה.עם_אצווה(פונקציה() {
            אם (עצמי.פעיל != ריק) {
                עצמי.פעיל.בעכבר_גרירה(x, y, כפתור)
            }
        })
    }
    פונקציה על_למעלה(x, y, כפתור) {
        משתנה עצמי = זה
        זה.עם_אצווה(פונקציה() {
            אם (עצמי.פעיל != ריק) {
                עצמי.פעיל.בעכבר_למעלה(x, y, כפתור)
                עצמי.פעיל = ריק
            }
        })
    }
}
