// עזר.יוד — עיצוב טקסט ומספרים

פונקציה מספר_שלם ערך
  החזר מתמטיקה.עיגול: ערך
סוף

פונקציה פורמט_זמן_פעיל שניות
  משתנה ש = מספר_שלם: שניות
  משתנה ימים = מתמטיקה.רצפה: ש / 86400
  ש = ש - ימים * 86400
  משתנה שעות = מתמטיקה.רצפה: ש / 3600
  ש = ש - שעות * 3600
  משתנה דקות = מתמטיקה.רצפה: ש / 60
  משתנה שנ = ש - דקות * 60
  אם ימים > 0
    החזר ימים + "י " + שעות + "ש " + דקות + "ד"
  סוף
  אם שעות > 0
    החזר שעות + "ש " + דקות + "ד " + שנ + "שנ"
  סוף
  החזר דקות + "ד " + שנ + "שנ"
סוף

פונקציה שורת_תהליך פ
  משתנה שם = פ["שם"]
  משתנה מזהה = מספר_שלם: פ["מזהה"]
  משתנה מגה = מספר_שלם: פ["זיכרון_מגה"]
  החזר שם + "   |   מזהה " + מזהה + "   |   " + מגה + " מגה"
סוף

פונקציה שורת_כונן כ
  משתנה אות = כ["אות"]
  משתנה סהכ = מספר_שלם: כ["סהכ_מגה"]
  משתנה פנוי = מספר_שלם: כ["פנוי_מגה"]
  משתנה בשימוש = מספר_שלם: כ["בשימוש_מגה"]
  החזר אות + "  —  בשימוש " + בשימוש + " / " + סהכ + " מגה  (פנוי " + פנוי + ")"
סוף
