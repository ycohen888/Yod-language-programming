// פקד.יוד — מחלקת בסיס לכל פקד בממשק עיצוב (HTML)
כלול "עיצוב.יוד"

מחלקה פקד {
    פונקציה בנאי(מזהה = "") {
        אם (מזהה == ריק או מזהה == "") {
            מזהה = _עיצוב_מזהה_חדש()
        }
        זה.מזהה = מזהה
        זה.טקסט = ""
        זה.גלוי = אמת
        זה.מושבת = שקר
        זה._לחץ = ריק
        זה._סוג = "פקד"
        זה._הורה_מזהה = ""
        אם (_עיצוב_הורה_נוכחי != ריק וגם _עיצוב_הורה_נוכחי != "") {
            זה._הורה_מזהה = _עיצוב_הורה_נוכחי
        }
        _עיצוב_רשום(זה)
    }

    פונקציה _שלח_פקודה(שם, ערכים) {
        אם (ערכים == ריק) {
            ערכים = {}
        }
        ערכים.מזהה = זה.מזהה
        _עיצוב_שלח(שם, ערכים)
    }

    פונקציה _צור(סוג_פקד, נתונים) {
        אם (נתונים == ריק) {
            נתונים = {}
        }
        זה._סוג = סוג_פקד
        נתונים.סוג = סוג_פקד
        נתונים.מזהה = זה.מזהה
        אם (לא נתונים.יש("טקסט")) {
            נתונים.טקסט = זה.טקסט
        }
        אם (זה._הורה_מזהה != ריק וגם זה._הורה_מזהה != "") {
            נתונים.הורה = זה._הורה_מזהה
        }
        _עיצוב_שלח("צור", נתונים)
    }

    פונקציה קבע_טקסט(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.טקסט = ט
        זה._שלח_פקודה("קבע_טקסט", { "טקסט": ט })
    }

    פונקציה קבע_גלוי(ערך) {
        זה.גלוי = ערך
        זה._שלח_פקודה("קבע_גלוי", { "ערך": ערך })
    }

    פונקציה קבע_מושבת(ערך) {
        זה.מושבת = ערך
        זה._שלח_פקודה("קבע_מושבת", { "ערך": ערך })
    }

    פונקציה מחק() {
        _עיצוב_בטל_רישום(זה.מזהה)
        זה._שלח_פקודה("מחק", {})
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }
}
