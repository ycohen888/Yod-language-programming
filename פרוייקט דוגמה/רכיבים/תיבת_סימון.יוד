// תיבת_סימון.יוד — תיבת סימון (וי); כרום בצד ההתחלה
מחלקה תיבת_סימון מרחיב רכיב {
    פונקציה בנאי(x, y, טקסט, מסומן) {
        הורה(x, y, 180, 22)
        זה.טקסט = טקסט
        זה.מסומן = מסומן
        זה.בשינוי = ריק
        זה.גודל_תיבה = 14
    }
    פונקציה קבע_מסומן(v) {
        זה.מסומן = v
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה s = זה.גודל_תיבה
        משתנה bx = x_פריט_מהתחלה(זה, 0, s)
        משתנה by = זה.y + (זה.גבה - s) / 2
        אם (זה.מסומן) {
            משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
            מלבן_מעוגל_מלא(משטח, bx, by, s, s, 3)
            משטח.קבע_מילוי(235, 250, 245)
            משטח.מלבן_מלא(bx + 3, by + 7, 3, 2)
            משטח.מלבן_מלא(bx + 5, by + 8, 2, 2)
            משטח.מלבן_מלא(bx + 6, by + 6, 2, 3)
            משטח.מלבן_מלא(bx + 7, by + 4, 2, 3)
            משטח.מלבן_מלא(bx + 8, by + 3, 3, 2)
        } אחרת {
            מלבן_מעוגל_רך(משטח, bx, by, s, s, 3, 36, 38, 44)
        }
        משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
        משטח.קבע_גודל_גופן(12)
        צייר_טקסט_ברכיב(משטח, זה, זה.טקסט, זה.y + 4, s + 8)
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        אם (זה.מסומן) {
            זה.מסומן = שקר
        } אחרת {
            זה.מסומן = אמת
        }
        זה.בקש_רענון()
        אם (זה.בשינוי != ריק) {
            זה.בשינוי(זה.מסומן)
        }
        החזר אמת
    }
}
