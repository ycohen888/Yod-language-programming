// תווית.יוד — טקסט מלווה / כותרת / תת־כותרת בממשק עיצוב
// סגנונות: רגיל | כותרת | משני | תת_כותרת | הצלחה | סכנה | מידע
// (תת_כותרת = כינוי ל־משני; מתאים ל־dark/בהיר ול־RTL/LTR)
כלול "פקד.יוד"

מחלקה תווית מרחיב פקד {
    פונקציה בנאי(טקסט, סגנון = "רגיל", מזהה = "") {
        אם (טקסט == ריק) {
            טקסט = ""
        }
        אם (סגנון == ריק או סגנון == "") {
            סגנון = "רגיל"
        }
        הורה(מזהה)
        זה.טקסט = טקסט
        זה.סגנון = סגנון
        זה._צור("תווית", {
            "טקסט": טקסט,
            "סגנון": סגנון
        })
    }

    פונקציה קבע_סגנון(ס) {
        אם (ס == ריק או ס == "") {
            ס = "רגיל"
        }
        זה.סגנון = ס
        זה._שלח_פקודה("קבע_סגנון", { "סגנון": ס })
    }
}
