// ממשק.יוד — מזג־אוויר בחלון Windows רגיל (כמו המחשבון)
כלול "חלונות"
כלול "קבצים"
כלול "מערכת"

משתנה חלון_ראשי = ריק
משתנה דפדפן_מזג = ריק

פונקציה תיקיית_פרויקט() {
    משתנה תיק = מערכת.תיקיית_הרצה()
    אם (תיק == ריק או תיק == "") {
        תיק = מערכת.תיקייה()
    }
    אם (קבצים.קיים(תיק + "\\ממשק.html")) {
        החזר תיק
    }
    אם (קבצים.קיים(תיק + "\\מזג-אוויר\\ממשק.html")) {
        החזר תיק + "\\מזג-אוויר"
    }
    החזר תיק
}

פונקציה לנתיב_file(נתיב) {
    משתנה פ = "" + נתיב
    פ = פ.החלף("\\", "/")
    החזר "file:///" + פ
}

פונקציה על_הודעת_מזג(הודעה) {
    נסה {
        משתנה ט = ("" + הודעה).גזום()
        אם (ט.מתחיל_ב("\"") וגם ט.מסתיים_ב("\"")) {
            ט = ט.חתוך(1, ט.אורך() - 1)
        }
        אם (ט == "יציאה") {
            אם (חלון_ראשי != ריק) {
                נסה {
                    חלון_ראשי.סגור()
                } תפוס שגיאה {
                }
            }
            החזר ריק
        }
        אם (ט == "תמיד_מעל:אמת") {
            אם (חלון_ראשי != ריק) {
                חלון_ראשי.קבע_תמיד_מעל(אמת)
            }
            החזר ריק
        }
        אם (ט == "תמיד_מעל:שקר") {
            אם (חלון_ראשי != ריק) {
                חלון_ראשי.קבע_תמיד_מעל(שקר)
            }
            החזר ריק
        }
    } תפוס שגיאה {
    }
}

פונקציה בנה_חלון_מזג() {
    משתנה ח = חלונות.חלון("מזג־אוויר · יוד")
    חלון_ראשי = ח
    // חלון רגיל במפורש — עם כותרת וסגירה של Windows
    ח.קבע_בלי_מסגרת(שקר)
    ח.קבע_שקוף(שקר)
    ח.קבע_צורת_חלון("מלבן")
    ח.קבע_גודל(400, 580)
    ח.קבע_גודל_קבוע(אמת)
    ח.מרכז()
    ח.קבע_כהה(אמת)
    ח.קבע_רקע(16, 26, 43)
    ח.קבע_תמיד_מעל(אמת)

    משתנה תיק = תיקיית_פרויקט()
    נסה {
        אם (קבצים.קיים(תיק + "\\app.ico")) {
            ח.קבע_איקון(תיק + "\\app.ico")
        } אחרת_אם (קבצים.קיים(תיק + "\\לוגו.png")) {
            ח.קבע_איקון(תיק + "\\לוגו.png")
        }
    } תפוס שגיאה {
    }

    דפדפן_מזג = חלונות.דפדפן()
    נסה {
        דפדפן_מזג.קבע_מתיחה(1)
    } תפוס שגיאה {
    }

    דפדפן_מזג.בהודעה(פונקציה(ה) {
        על_הודעת_מזג(ה)
    })

    משתנה קובץ = תיק + "\\ממשק.html"
    אם (לא קבצים.קיים(קובץ)) {
        חלונות.הודעה("מזג־אוויר", "לא נמצא ממשק.html בתיקיית הפרויקט:\n" + תיק)
        החזר ריק
    }

    דפדפן_מזג.נווט(לנתיב_file(קובץ))
    ח.הוסף(דפדפן_מזג)
    ח.הצג()
}
