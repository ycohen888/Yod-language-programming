// AI.יוד — שחקן מחשב
פונקציה בטל_טיימר_AI() {
    אם (מזהה_AI != ריק) {
        טיימרים.עצור: מזהה_AI
        מזהה_AI = ריק
    }
}

פונקציה אולי_מהלך_מחשב() {
    אם (מצב_מסך != "משחק") {
        החזר ריק
    }
    משתנה ש = שחקן_נוכחי()
    אם (לא ש["מחשב"]) {
        החזר ריק
    }
    הודעה = "תור המחשב — חושב…"
    צייר_הכל()
    בטל_טיימר_AI()
    מזהה_AI = טיימרים.אחרי: 500, מהלך_מחשב
}

פונקציה מהלך_מחשב() {
    מזהה_AI = ריק
    אם (מצב_מסך != "משחק") {
        החזר ריק
    }
    משתנה ש = שחקן_נוכחי()
    אם (לא ש["מחשב"]) {
        החזר ריק
    }
    משתנה ר = אקראי() * 100
    אם (ר < 14 וגם ש["מקדחה"] < 3 וגם ש["כסף"] > מחיר_מקדחה[ש["מקדחה"] + 1] + 700) {
        קנה_מקדחה: ש["מקדחה"] + 1
        סיים_תור()
        החזר ריק
    }
    אם (ר < 22 וגם לא ש["גלאי"] וגם ש["כסף"] > מחיר_גלאי + 900) {
        קנה_גלאי()
        סיים_תור()
        החזר ריק
    }
    אם (ר < 28 וגם לא ש["משאית"] וגם ש["כסף"] > מחיר_משאית + 1100) {
        קנה_משאית()
        סיים_תור()
        החזר ריק
    }
    אם (ר < 34 וגם ש["פועלים"] < 4 וגם ש["כסף"] > עלות_פועל + 800) {
        גייס_פועל()
        סיים_תור()
        החזר ריק
    }
    אם (שורות_פתוחות < גודל_לוח וגם ר < 14 וגם ש["כסף"] > עלות_הרחבה + 1000) {
        הרחב_לוח()
        סיים_תור()
        החזר ריק
    }
    משתנה יעד_x = 0 - 1
    משתנה יעד_y = 0 - 1
    משתנה ציון_מקס = 0 - 100000
    משתנה y = 0
    כל_עוד (y < שורות_פתוחות) {
        משתנה x = 0
        כל_עוד (x < גודל_לוח) {
            משתנה ת = תא_ב(x, y)
            אם (לא ת["חפור"]) {
                משתנה עלות = עלות_תא(ת)
                אם (ש["כסף"] >= עלות
                // מעדיף רווח נטו גבוה (ערך אחרי מכירה פחות מחיר)
) {
                    משתנה צפי = ת["ערך"]
                    אם (ש["משאית"]) {
                        צפי = (צפי * 125 / 100).שלם()
                    }
                    משתנה ציון = צפי - עלות + אקראי_בין: 0, 40
                    אם (ציון > ציון_מקס) {
                        ציון_מקס = ציון
                        יעד_x = x
                        יעד_y = y
                    }
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    אם (יעד_x >= 0) {
        חפור_בתא: יעד_x, יעד_y
    } אחרת {
        // אין קנייה אפשרית — מעביר תור (לא חייב לקנות)
        הוסף_ליומן: "מחשב העביר תור — אין קנייה מתאימה"
        סיים_תור()
    }
}
