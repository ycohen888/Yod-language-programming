// מצב.יוד — מצב הצייר (כלי, צבע, עובי, נקודות עכבר)

משתנה כלי = "עיפרון"
משתנה צבע = "שחור"
משתנה עובי = 3
משתנה x_קודם = 0
משתנה y_קודם = 0
משתנה x_התחלה = 0
משתנה y_התחלה = 0
משתנה לוח = ריק
משתנה סטטוס = ריק

פונקציה עדכן_סטטוס()
  אם סטטוס == ריק
    החזר ריק
  סוף
  סטטוס.קבע_טקסט: "כלי: " + כלי + "  |  צבע: " + צבע + "  |  עובי: " + עובי
סוף

פונקציה בחר_כלי שם
  כלי = שם
  עדכן_סטטוס()
סוף

פונקציה בחר_צבע שם
  צבע = שם
  אם לוח != ריק
    לוח.קבע_צבע: שם
    לוח.קבע_מילוי: שם
  סוף
  עדכן_סטטוס()
סוף

פונקציה בחר_עובי n
  עובי = n
  אם לוח != ריק
    לוח.קבע_עובי: n
  סוף
  עדכן_סטטוס()
סוף
