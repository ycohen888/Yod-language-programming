// AI.יוד — שחקן מחשב פשוט

פונקציה בטל_טיימר_AI()
  אם מזהה_AI != ריק
    טיימרים.עצור: מזהה_AI
    מזהה_AI = ריק
  סוף
סוף

פונקציה אולי_מהלך_מחשב()
  אם מצב_מסך != "משחק"
    החזר ריק
  סוף
  משתנה ש = שחקן_נוכחי()
  אם לא ש["מחשב"]
    החזר ריק
  סוף
  הודעה = "המחשב חושב…"
  צייר_הכל()
  בטל_טיימר_AI()
  מזהה_AI = טיימרים.אחרי: 550, מהלך_מחשב
סוף

פונקציה מהלך_מחשב()
  מזהה_AI = ריק
  אם מצב_מסך != "משחק"
    החזר ריק
  סוף
  משתנה ש = שחקן_נוכחי()
  אם לא ש["מחשב"]
    החזר ריק
  סוף

  // לפעמים קונה שדרוג
  משתנה ר = אקראי() * 100
  אם ר < 18 וגם ש["מקדחה"] < 2 וגם ש["כסף"] > מחיר_מקדחה[ש["מקדחה"] + 1] + 600
    קנה_מקדחה: ש["מקדחה"] + 1
    סיים_תור()
    החזר ריק
  סוף
  אם ר < 28 וגם ש["פועלים"] < 3 וגם ש["כסף"] > עלות_פועל + 800
    גייס_פועל()
    סיים_תור()
    החזר ריק
  סוף
  אם שורות_פתוחות < גודל_לוח וגם ר < 12 וגם ש["כסף"] > עלות_הרחבה + 1000
    הרחב_לוח()
    סיים_תור()
    החזר ריק
  סוף

  // חפירת תא פתוח בדרגה גבוהה כשאפשר
  משתנה יעד_x = 0 - 1
  משתנה יעד_y = 0 - 1
  משתנה ציון_מקס = 0 - 1
  משתנה y = 0
  כל_עוד y < שורות_פתוחות
    משתנה x = 0
    כל_עוד x < גודל_לוח
      משתנה ת = תא_ב(x, y)
      אם לא ת["חפור"]
        משתנה עלות = עלות_חפירה + ת["דרגה"] * 40
        אם ש["כסף"] >= עלות
          משתנה ציון = ת["דרגה"] * 10 + אקראי_בין: 0, 5
          אם ציון > ציון_מקס
            ציון_מקס = ציון
            יעד_x = x
            יעד_y = y
          סוף
        סוף
      סוף
      x = x + 1
    סוף
    y = y + 1
  סוף

  אם יעד_x >= 0
    חפור_בתא: יעד_x, יעד_y
  אחרת
    // אין מה לחפור — מנסה גיוס או מדלג
    אם ש["כסף"] >= עלות_פועל
      גייס_פועל()
    סוף
    סיים_תור()
  סוף
סוף
