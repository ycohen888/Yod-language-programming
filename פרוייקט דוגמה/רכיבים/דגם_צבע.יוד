// דגם_צבע.יוד — ריבוע צבע לחיץ (לבחירת צבע בצייר)

מחלקה דגם_צבע_משטח מרחיב רכיב
  פונקציה בנאי(x, y, גודל, אדום, ירוק, כחול)
    הורה(x, y, גודל, גודל)
    זה.אדום = אדום
    זה.ירוק = ירוק
    זה.כחול = כחול
    זה.נבחר = שקר
    זה.בלחיצה = ריק
  סוף

  פונקציה קבע_נבחר(v)
    זה.נבחר = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משטח.קבע_מילוי(זה.אדום, זה.ירוק, זה.כחול)
    משטח.מלבן_מלא(זה.x, זה.y, זה.רחב, זה.גבה)
    אם זה.נבחר
      משטח.קבע_צבע(255, 255, 255)
      משטח.קבע_עובי(2)
    אחרת
      משטח.קבע_צבע(60, 64, 70)
      משטח.קבע_עובי(1)
    סוף
    משטח.מלבן(זה.x, זה.y, זה.רחב, זה.גבה)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    אם זה.בלחיצה != ריק
      זה.בלחיצה(זה.אדום, זה.ירוק, זה.כחול)
    סוף
    החזר אמת
  סוף
סוף
