// כפתור.יוד — כפתור מצויר (כהה) על משטח

מחלקה כפתור_משטח מרחיב רכיב
  פונקציה בנאי(x, y, רחב, גבה, טקסט)
    הורה(x, y, רחב, גבה)
    זה.טקסט = טקסט
    זה.ראשי = שקר
    זה.בלחיצה = ריק
  סוף

  פונקציה קבע_ראשי(v)
    זה.ראשי = v
    זה.בקש_רענון()
  סוף

  פונקציה קבע_טקסט(t)
    זה.טקסט = t
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם !זה.גלוי
      החזר ריק
    סוף
    משתנה מא = 50
    משתנה מי = 52
    משתנה מכ = 56
    אם זה.ראשי
      מא = 14
      מי = 124
      מכ = 112
    סוף
    אם זה.לחוץ
      אם זה.ראשי
        מא = 10
        מי = 98
        מכ = 88
      אחרת
        מא = 40
        מי = 42
        מכ = 46
      סוף
    סוף
    אם זה.מושבת
      מא = 40
      מי = 42
      מכ = 44
    סוף
    משטח.קבע_מילוי(מא, מי, מכ)
    משטח.מלבן_מלא(זה.x, זה.y, זה.רחב, זה.גבה)
    משטח.קבע_צבע(70, 74, 80)
    משטח.קבע_עובי(1)
    משטח.מלבן(זה.x, זה.y, זה.רחב, זה.גבה)
    משטח.קבע_צבע(230, 230, 230)
    אם זה.מושבת
      משטח.קבע_צבע(140, 145, 150)
    סוף
    משטח.קבע_גודל_גופן(14)
    // יישור גס למרכז
    משתנה tx = זה.x + 12
    משתנה ty = זה.y + זה.גבה / 2 - 6
    משטח.טקסט(זה.טקסט, tx, ty)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת
      החזר שקר
    סוף
    אם !זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.לחוץ = אמת
    זה.בקש_רענון()
    החזר אמת
  סוף

  פונקציה בעכבר_למעלה(mx, my, כפתור)
    אם !זה.לחוץ
      החזר ריק
    סוף
    זה.לחוץ = שקר
    זה.בקש_רענון()
    אם זה.מכיל(mx, my) וגם זה.בלחיצה != ריק
      זה.בלחיצה()
    סוף
  סוף
סוף
