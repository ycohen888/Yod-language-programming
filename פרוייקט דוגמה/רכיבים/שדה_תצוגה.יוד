// שדה_תצוגה.יוד — שדה טקסט מצויר (תצוגה + עדכון מקוד)

מחלקה שדה_תצוגה מרחיב רכיב
  פונקציה בנאי(x, y, רחב, טקסט)
    הורה(x, y, רחב, 34)
    זה.טקסט = טקסט
    זה.מקום_שמור = "הקלדה…"
    זה.ממוקד = שקר
    זה.בלחיצה = ריק
  סוף

  פונקציה קבע_טקסט(t)
    זה.טקסט = t
    זה.בקש_רענון()
  סוף

  פונקציה קרא_טקסט()
    החזר זה.טקסט
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה מא = 26
    משתנה מי = 28
    משתנה מכ = 34
    אם זה.ממוקד
      מא = 30
      מי = 34
      מכ = 42
    סוף
    מלבן_מעוגל_עם_גבול(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 9, מא, מי, מכ)
    אם זה.ממוקד
      משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
      מלבן_מעוגל_מלא(משטח, זה.x, זה.y + זה.גבה - 2, זה.רחב, 2, 1)
    סוף
    משטח.קבע_גודל_גופן(13)
    אם זה.טקסט == "" או זה.טקסט == ריק
      משטח.קבע_צבע(100, 108, 118)
      משטח.טקסט(זה.מקום_שמור, זה.x + 12, זה.y + 9)
    אחרת
      משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
      משטח.טקסט(זה.טקסט, זה.x + 12, זה.y + 9)
    סוף
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.ממוקד = אמת
    זה.בקש_רענון()
    אם זה.בלחיצה != ריק
      זה.בלחיצה()
    סוף
    החזר אמת
  סוף
סוף
