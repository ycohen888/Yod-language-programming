// מספר_תצוגה.יוד — מספר גדול לתצוגה

מחלקה מספר_תצוגה מרחיב רכיב
  פונקציה בנאי(x, y, ערך, יחידה)
    הורה(x, y, 70, 36)
    זה.ערך = ערך
    זה.יחידה = יחידה
  סוף

  פונקציה קבע_ערך(v)
    זה.ערך = v
    זה.בקש_רענון()
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, 7, 28, 30, 36)
    משטח.קבע_צבע(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
    משטח.קבע_גודל_גופן(16)
    משטח.טקסט("" + זה.ערך.שלם(), זה.x + 10, זה.y + 4)
    משטח.קבע_צבע(ערכה_משני_א, ערכה_משני_י, ערכה_משני_כ)
    משטח.קבע_גודל_גופן(9)
    משטח.טקסט(זה.יחידה, זה.x + 10, זה.y + 22)
  סוף
סוף
