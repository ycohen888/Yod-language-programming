// כלכלה.יוד — מחירים, סיכויים, קניות ומשכורות

פונקציה שחקן_נוכחי()
  החזר שחקנים[תור]
סוף

פונקציה שם_שחקן i
  אם i == 0
    החזר "אתם"
  סוף
  אם מצב_2_שחקנים
    החזר "שחקן ב"
  סוף
  החזר "מחשב"
סוף

פונקציה אפס_סיכום_חודש()
  חודש_קילו = [0, 0, 0, 0, 0, 0, 0]
  חודש_רווח = [0, 0, 0, 0, 0, 0, 0]
סוף

פונקציה הוסף_ליומן טקסט
  יומן.הוסף_בהתחלה: "יום " + יום + ": " + טקסט
  כל_עוד יומן.גודל() > 40
    משתנה אחרון = יומן.גודל() - 1
    יומן.הסר: אחרון
  סוף
סוף

פונקציה גלגל_כמות דרגה
  // ק״ג — דרגה גבוהה = כמויות/ערך גבוהים יותר
  אם דרגה == 1
    החזר אקראי_בין: 1, 4
  סוף
  אם דרגה == 2
    החזר אקראי_בין: 2, 6
  סוף
  אם דרגה == 3
    החזר אקראי_בין: 3, 9
  סוף
  אם דרגה == 4
    החזר אקראי_בין: 4, 12
  סוף
  החזר אקראי_בין: 5, 16
סוף

פונקציה גלגל_סוג_משאב דרגה
  // משקל: דרגה גבוהה → משאבים יקרים
  משתנה ר = אקראי() * 100
  אם דרגה >= 5
    אם ר < 12
      החזר 6
    סוף
    אם ר < 35
      החזר 5
    סוף
    אם ר < 55
      החזר 4
    סוף
    אם ר < 75
      החזר 3
    סוף
    החזר 2
  סוף
  אם דרגה == 4
    אם ר < 6
      החזר 6
    סוף
    אם ר < 22
      החזר 5
    סוף
    אם ר < 45
      החזר 4
    סוף
    אם ר < 70
      החזר 3
    סוף
    החזר 1
  סוף
  אם דרגה == 3
    אם ר < 3
      החזר 5
    סוף
    אם ר < 18
      החזר 4
    סוף
    אם ר < 40
      החזר 3
    סוף
    אם ר < 70
      החזר 2
    סוף
    החזר 0
  סוף
  אם דרגה == 2
    אם ר < 8
      החזר 3
    סוף
    אם ר < 30
      החזר 2
    סוף
    אם ר < 65
      החזר 1
    סוף
    החזר 0
  סוף
  // דרגה 1 — לרוב פחם/ברזל, סיכוי נמוך לזהב
  אם ר < 2
    החזר 5
  סוף
  אם ר < 12
    החזר 2
  סוף
  אם ר < 45
    החזר 1
  סוף
  החזר 0
סוף

פונקציה סיכוי_מציאה שחקן, דרגה
  משתנה בסיס = סיכוי_בסיס[דרגה - 1]
  משתנה בונוס = בונוס_מקדחה[שחקן["מקדחה"]]
  משתנה פועלים = שחקן["פועלים"]
  אם פועלים > 4
    פועלים = 4
  סוף
  משתנה ס = בסיס + בונוס + פועלים * 3
  אם ס > 92
    ס = 92
  סוף
  החזר ס
סוף

פונקציה לשלם_משכורות()
  משתנה i = 0
  כל_עוד i < שחקנים.גודל()
    משתנה ש = שחקנים[i]
    משתנה עלות = ש["פועלים"] * משכורת_פועל
    ש["כסף"] = ש["כסף"] - עלות
    אם עלות > 0
      הוסף_ליומן: שם_שחקן(i) + " שילם משכורות " + מספרים.שלם(עלות) + "₪"
    סוף
    i = i + 1
  סוף
סוף

פונקציה קנה_מקדחה רמה
  משתנה ש = שחקן_נוכחי()
  אם רמה <= ש["מקדחה"]
    הודעה = "כבר יש לכם מקדחה כזו או טובה יותר"
    החזר שקר
  סוף
  משתנה מחיר = מחיר_מקדחה[רמה]
  אם ש["כסף"] < מחיר
    הודעה = "אין מספיק כסף למקדחה"
    החזר שקר
  סוף
  ש["כסף"] = ש["כסף"] - מחיר
  ש["מקדחה"] = רמה
  הוסף_ליומן: שם_שחקן(תור) + " קנה מקדחה " + שמות_מקדחה[רמה]
  הודעה = "נרכשה מקדחה " + שמות_מקדחה[רמה]
  החזר אמת
סוף

פונקציה גייס_פועל()
  משתנה ש = שחקן_נוכחי()
  אם ש["כסף"] < עלות_פועל
    הודעה = "אין מספיק כסף לפועל"
    החזר שקר
  סוף
  ש["כסף"] = ש["כסף"] - עלות_פועל
  ש["פועלים"] = ש["פועלים"] + 1
  הוסף_ליומן: שם_שחקן(תור) + " גייס פועל (סה״כ " + ש["פועלים"] + ")"
  הודעה = "פועל חדש בצוות"
  החזר אמת
סוף

פונקציה הרחב_לוח()
  משתנה ש = שחקן_נוכחי()
  אם שורות_פתוחות >= גודל_לוח
    הודעה = "כל הלוח כבר פתוח"
    החזר שקר
  סוף
  אם ש["כסף"] < עלות_הרחבה
    הודעה = "אין מספיק כסף להרחבה"
    החזר שקר
  סוף
  ש["כסף"] = ש["כסף"] - עלות_הרחבה
  שורות_פתוחות = שורות_פתוחות + 1
  הוסף_ליומן: שם_שחקן(תור) + " הרחיב את הלוח לשורה " + שורות_פתוחות
  הודעה = "הלוח הורחב!"
  החזר אמת
סוף
