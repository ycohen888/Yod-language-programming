// שרת HTTP בסיסי (רץ עד עצירה)
// שימוש: yod הרץ examples\http_server.יוד
// ואז בדפדפן: http://127.0.0.1:8080/
כלול "רשת"
משתנה שרת = רשת.שרת(8080)
שרת.מסלול("/", פונקציה(בקשה)
    החזר: "שלום משרת יוד! שיטה=" + בקשה["שיטה"]
סוף
)
שרת.מסלול("/בריאות", פונקציה(בקשה)
    החזר: { "קוד": 200, "גוף": "תקין" }
סוף
)
הדפס: "שרת רץ על " + שרת.כתובת
הדפס "עצרו עם Ctrl+C"
שרת.הפעל()
