// כפתור_איקון.יוד — כפתור עם סימן/איקון בלבד
כלול "פקד.יוד"

מחלקה כפתור_איקון מרחיב פקד {
    פונקציה בנאי(איקון, סגנון = "ראשי", מזהה = "") {
        אם (איקון == ריק) {
            איקון = "★"
        }
        אם (סגנון == ריק או סגנון == "") {
            סגנון = "ראשי"
        }
        הורה(מזהה)
        זה.טקסט = איקון
        זה.סגנון = סגנון
        זה._לחץ = ריק
        זה._צור("כפתור_איקון", {
            "טקסט": איקון,
            "סגנון": סגנון
        })
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }
}
