// התחל.יוד — דמו דו־כיווני עם פריסה ברורה וגלילה
// פתחו את התיקייה בעורך יוד ← F5
כלול "חלונות"
כלול "עכבר"
כלול "רכיבים.יוד"

משתנה עובי = 3

משתנה לוח_ראשי = ריק

משתנה תג_כיוון = ריק

משתנה תווית_מצב = ריק

משתנה סרגל = ריק

משתנה פס = ריק

משתנה מדרגה = ריק

משתנה מונה = ריק

משתנה נור = ריק

משתנה שדה_קלט = ריק

משתנה שדה_סס = ריק

משתנה נפתח = ריק

פונקציה רענון_מצב() {
    אם (תווית_מצב == ריק) {
        החזר ריק
    }
    תווית_מצב.קבע_טקסט("עובי " + עובי.שלם())
    אם (מונה != ריק) {
        מונה.קבע_ערך(עובי)
    }
    אם (פס != ריק) {
        פס.קבע_אחוז(עובי * 5)
    }
}

פונקציה עדכן_תג_כיוון() {
    אם (לוח_ראשי == ריק או תג_כיוון == ריק) {
        החזר ריק
    }
    אם (הוא_ימין(לוח_ראשי.כיוון)) {
        תג_כיוון.קבע_טקסט("RTL")
    } אחרת {
        תג_כיוון.קבע_טקסט("LTR")
    }
}

פונקציה בנה_חלון() {
    משתנה ח = חלונות.חלון: "רכיבי משטח · RTL/LTR"
    ח.קבע_גודל(560, 640)
    ח.קבע_כהה: אמת
    לוח_ראשי = חדש לוח_רכיבים: 520, 580
    לוח_ראשי.קבע_כיוון("ימין")

    // —— כותרת ——
    משתנה כותרת = חדש תווית_ציור: 20, 16, "רכיבי משטח"
    כותרת.קבע_צבע_rgb(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
    כותרת.גודל = 14
    לוח_ראשי.הוסף(כותרת)

    תג_כיוון = חדש תג: 160, 14, "RTL"
    לוח_ראשי.הוסף(תג_כיוון)

    נור = חדש נורית: 340, 16, "מחובר", אמת
    לוח_ראשי.הוסף(נור)

    משתנה מת_כיוון = חדש מתג: 20, 44, אמת
    מת_כיוון.קבע_רמז("ימין = RTL, שמאל = LTR")
    מת_כיוון.בשינוי = פונקציה(דלוק) {
        אם (דלוק) {
            לוח_ראשי.קבע_כיוון("ימין")
        } אחרת {
            לוח_ראשי.קבע_כיוון("שמאל")
        }
        עדכן_תג_כיוון()
    }
    לוח_ראשי.הוסף(מת_כיוון)
    לוח_ראשי.הוסף(חדש תווית_ציור: 70, 46, "כיוון (RTL↔LTR)")

    תווית_מצב = חדש תווית_ציור: 20, 72, ""
    לוח_ראשי.הוסף(תווית_מצב)

    משתנה לשו = חדש לשוניות: 20, 94, 460, ["כלים", "קלט", "רשימה"]
    לשו.בשינוי = פונקציה(i, שם) {
        תג_כיוון.קבע_טקסט(שם)
        עדכן_תג_כיוון()
    }
    לוח_ראשי.הוסף(לשו)

    // —— כפתורים וערכים ——
    לוח_ראשי.הוסף(חדש כרטיס: 16, 136, 468, 150, "כפתורים וערכים")

    משתנה כפ_ראשי = חדש כפתור_משטח: 28, 176, 100, 28, "הרץ"
    כפ_ראשי.קבע_ראשי(אמת)
    כפ_ראשי.בלחיצה = פונקציה() {
        חלונות.הודעה("רכיבים", "עובי " + עובי.שלם())
    }
    לוח_ראשי.הוסף(כפ_ראשי)

    משתנה כפ_משני = חדש כפתור_משטח: 140, 176, 88, 28, "איפוס"
    כפ_משני.בלחיצה = פונקציה() {
        עובי = 3
        סרגל.קבע_ערך_שקט(3)
        מדרגה.קבע_ערך_שקט(3)
        רענון_מצב()
    }
    לוח_ראשי.הוסף(כפ_משני)

    משתנה קישור = חדש כפתור_טקסט: 244, 182, "עזרה"
    קישור.בלחיצה = פונקציה() {
        חלונות.הודעה("עזרה", "גלגל עכבר או פס מימין לגלילה")
    }
    לוח_ראשי.הוסף(קישור)

    מונה = חדש מספר_תצוגה: 380, 168, עובי, "px"
    לוח_ראשי.הוסף(מונה)

    סרגל = חדש סליידר: 28, 220, 300, 1, 20, עובי
    סרגל.בשינוי = פונקציה(v) {
        עובי = v.שלם()
        מדרגה.קבע_ערך_שקט(עובי)
        רענון_מצב()
    }
    לוח_ראשי.הוסף(סרגל)

    מדרגה = חדש מספר_מדרגה: 344, 218, 1, 20, עובי
    מדרגה.בשינוי = פונקציה(v) {
        עובי = v.שלם()
        סרגל.קבע_ערך_שקט(עובי)
        רענון_מצב()
    }
    לוח_ראשי.הוסף(מדרגה)

    פס = חדש פס_התקדמות: 28, 258, 440, עובי * 5
    לוח_ראשי.הוסף(פס)

    // —— בחירה ——
    לוח_ראשי.הוסף(חדש כרטיס: 16, 304, 468, 78, "בחירה")
    משתנה מת = חדש מתג: 28, 344, אמת
    מת.בשינוי = פונקציה(דלוק) {
        נור.קבע_דולקת(דלוק)
    }
    לוח_ראשי.הוסף(מת)
    לוח_ראשי.הוסף(חדש תיבת_סימון: 88, 344, "רמזים", אמת)
    לוח_ראשי.הוסף(חדש שבב: 250, 344, "דק", שקר)
    לוח_ראשי.הוסף(חדש שבב: 330, 344, "עבה", אמת)

    // —— קלט (עמודה אחת — בלי חפיפה) ——
    לוח_ראשי.הוסף(חדש כרטיס: 16, 400, 468, 340, "קלט")

    לוח_ראשי.הוסף(חדש תווית_ציור: 28, 438, "שם משתמש")
    שדה_קלט = חדש קלט_טקסט: 28, 456, 440, ""
    שדה_קלט.קבע_מקום_שמור("שם משתמש…")
    לוח_ראשי.הוסף(שדה_קלט)

    לוח_ראשי.הוסף(חדש תווית_ציור: 28, 494, "סיסמה")
    שדה_סס = חדש שדה_סיסמה: 28, 512, 440, ""
    לוח_ראשי.הוסף(שדה_סס)

    לוח_ראשי.הוסף(חדש תווית_ציור: 28, 550, "כלי")
    נפתח = חדש תפריט_נפתח: 28, 568, 440, ["עיפרון", "מלבן", "עיגול", "מילוי"], 0
    נפתח.בשינוי = פונקציה(i, שם) {
        שדה_קלט.קבע_טקסט(שם)
    }
    לוח_ראשי.הוסף(נפתח)

    לוח_ראשי.הוסף(חדש תווית_ציור: 28, 608, "הערות")
    משתנה תיבה = חדש תיבת_טקסט: 28, 626, 440, 96, "שורה 1\nשורה 2"
    תיבה.קבע_מקום_שמור("הערות…")
    לוח_ראשי.הוסף(תיבה)

    // —— בוררים ורשימה ——
    לוח_ראשי.הוסף(חדש כרטיס: 16, 760, 468, 220, "בורר ורשימה")

    משתנה קב = חדש קבוצת_בורר
    משתנה ב1 = חדש בורר: 28, 804, "עיפרון", קב, "עיפרון"
    משתנה ב2 = חדש בורר: 160, 804, "מלבן", קב, "מלבן"
    משתנה ב3 = חדש בורר: 290, 804, "מילוי", קב, "מילוי"
    קב.הוסף(ב1)
    קב.הוסף(ב2)
    קב.הוסף(ב3)
    קב.הצב_נבחר("עיפרון")
    לוח_ראשי.הוסף(ב1)
    לוח_ראשי.הוסף(ב2)
    לוח_ראשי.הוסף(ב3)

    משתנה רשימה = חדש רשימת_בחירה: 28, 840, 440, ["פריט א", "פריט ב", "פריט ג", "פריט ד"]
    לוח_ראשי.הוסף(רשימה)

    לוח_ראשי.הוסף(חדש תווית_ציור: 28, 980, "↓ גללו עם גלגל העכבר או פס הגלילה מימין")

    רענון_מצב()
    עדכן_תג_כיוון()
    לוח_ראשי.עדכן_גובה_תוכן()
    לוח_ראשי.רענון()
    ח.הוסף(לוח_ראשי.משטח_גלוי())
    ח.הצג()
}

בנה_חלון()
