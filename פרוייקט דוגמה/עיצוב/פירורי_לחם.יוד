// פירורי_לחם.יוד — Breadcrumbs
כלול "פקד.יוד"

מחלקה פירורי_לחם מרחיב פקד {
    פונקציה בנאי(פריטים, מזהה = "") {
        אם (פריטים == ריק) {
            פריטים = []
        }
        הורה(מזהה)
        זה.פריטים = פריטים
        זה.ערך = ""
        זה._לחץ = ריק
        זה._צור("פירורי_לחם", {
            "פריטים": פריטים
        })
    }

    פונקציה קבע_פריטים(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.פריטים = רשימה
        זה._שלח_פקודה("קבע_פריטים", { "פריטים": רשימה })
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }
}
