// התחל.יוד — דמו: ממשק כהה מרכיבי משטח
// פתחו את התיקייה בעורך יוד ← F5

כלול "חלונות"
כלול "עכבר"
כלול "רכיבים.יוד"

משתנה עובי = 3
משתנה צבע_א = 78
משתנה צבע_י = 201
משתנה צבע_כ = 176
משתנה מצב_אוטומט = אמת
משתנה תווית_מצב = ריק
משתנה סרגל = ריק
משתנה פס = ריק
משתנה ד1 = ריק
משתנה ד2 = ריק
משתנה ד3 = ריק
משתנה ד4 = ריק
משתנה ד5 = ריק
משתנה מדרגה = ריק

פונקציה רענון_מצב()
  אם תווית_מצב == ריק
    החזר ריק
  סוף
  תווית_מצב.קבע_טקסט("עובי: " + עובי + " · RGB(" + צבע_א + "," + צבע_י + "," + צבע_כ + ")")
סוף

פונקציה נקה_בחירת_צבע()
  ד1.קבע_נבחר(שקר)
  ד2.קבע_נבחר(שקר)
  ד3.קבע_נבחר(שקר)
  ד4.קבע_נבחר(שקר)
  ד5.קבע_נבחר(שקר)
סוף

פונקציה בנה_חלון()
  משתנה ח = חלונות.חלון: "רכיבי משטח · יוד"
  ח.קבע_גודל(540, 620)
  ח.קבע_כהה: אמת

  משתנה לוח = חדש לוח_רכיבים: 500, 540

  משתנה רקע = חדש מסגרת_ציור: 8, 8, 484, 524
  לוח.הוסף(רקע)

  משתנה כותרת = חדש תווית_ציור: 20, 20, "ממשק מצויר על משטח (בלי כפתורי Windows)"
  כותרת.קבע_צבע_rgb(78, 201, 176)
  כותרת.גודל = 15
  לוח.הוסף(כותרת)

  תווית_מצב = חדש תווית_ציור: 20, 48, ""
  לוח.הוסף(תווית_מצב)

  לוח.הוסף(חדש מפריד: 20, 74, 460)

  משתנה כפ_ראשי = חדש כפתור_משטח: 20, 90, 120, 34, "הרץ"
  כפ_ראשי.קבע_ראשי(אמת)
  כפ_ראשי.בלחיצה = פונקציה ()
    חלונות.הודעה("רכיבים", "נלחץ כפתור ראשי · עובי " + עובי)
  סוף
  לוח.הוסף(כפ_ראשי)

  משתנה כפ_משני = חדש כפתור_משטח: 152, 90, 120, 34, "איפוס"
  כפ_משני.בלחיצה = פונקציה ()
    עובי = 3
    סרגל.קבע_ערך(3)
    מדרגה.קבע_ערך(3)
    פס.קבע_אחוז(30)
    רענון_מצב()
  סוף
  לוח.הוסף(כפ_משני)

  משתנה תו_עובי = חדש תווית_ציור: 20, 140, "עובי קו (סליידר)"
  לוח.הוסף(תו_עובי)

  סרגל = חדש סליידר: 20, 164, 300, 1, 20, עובי
  סרגל.בשינוי = פונקציה (v)
    עובי = v
    מדרגה.קבע_ערך(v)
    פס.קבע_אחוז(v * 5)
    רענון_מצב()
  סוף
  לוח.הוסף(סרגל)

  משתנה תו_מדרגה = חדש תווית_ציור: 340, 140, "מדרגה"
  לוח.הוסף(תו_מדרגה)

  מדרגה = חדש מספר_מדרגה: 340, 164, 1, 20, עובי
  מדרגה.בשינוי = פונקציה (v)
    עובי = v
    סרגל.קבע_ערך(v)
    פס.קבע_אחוז(v * 5)
    רענון_מצב()
  סוף
  לוח.הוסף(מדרגה)

  פס = חדש פס_התקדמות: 20, 210, 460, עובי * 5
  לוח.הוסף(פס)

  לוח.הוסף(חדש מפריד: 20, 236, 460)

  משתנה תו_מתג = חדש תווית_ציור: 20, 250, "מצב אוטומטי"
  לוח.הוסף(תו_מתג)

  משתנה מת = חדש מתג: 160, 246, מצב_אוטומט
  מת.בשינוי = פונקציה (דלוק)
    מצב_אוטומט = דלוק
  סוף
  לוח.הוסף(מת)

  משתנה סימון = חדש תיבת_סימון: 20, 290, "הצג רמזים בכלי", אמת
  סימון.בשינוי = פונקציה (מ)
    אם מ
      תווית_מצב.קבע_צבע_rgb(180, 185, 190)
    אחרת
      תווית_מצב.קבע_צבע_rgb(100, 105, 110)
    סוף
  סוף
  לוח.הוסף(סימון)

  לוח.הוסף(חדש מפריד: 20, 326, 460)

  משתנה תו_בורר = חדש תווית_ציור: 20, 340, "מצב כלי"
  לוח.הוסף(תו_בורר)

  משתנה קב = חדש קבוצת_בורר
  משתנה ב1 = חדש בורר: 20, 368, "עיפרון", קב, "עיפרון"
  משתנה ב2 = חדש בורר: 160, 368, "מלבן", קב, "מלבן"
  משתנה ב3 = חדש בורר: 300, 368, "מילוי", קב, "מילוי"
  קב.הוסף(ב1)
  קב.הוסף(ב2)
  קב.הוסף(ב3)
  קב.הצב_נבחר("עיפרון")
  לוח.הוסף(ב1)
  לוח.הוסף(ב2)
  לוח.הוסף(ב3)

  לוח.הוסף(חדש מפריד: 20, 404, 460)

  משתנה תו_צבע = חדש תווית_ציור: 20, 418, "צבע נבחר"
  לוח.הוסף(תו_צבע)

  ד1 = חדש דגם_צבע_משטח: 20, 446, 28, 78, 201, 176
  ד2 = חדש דגם_צבע_משטח: 56, 446, 28, 239, 68, 68
  ד3 = חדש דגם_צבע_משטח: 92, 446, 28, 37, 99, 235
  ד4 = חדש דגם_צבע_משטח: 128, 446, 28, 250, 204, 21
  ד5 = חדש דגם_צבע_משטח: 164, 446, 28, 230, 230, 230

  ד1.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד1.קבע_נבחר(אמת)
    רענון_מצב()
  סוף
  ד2.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד2.קבע_נבחר(אמת)
    רענון_מצב()
  סוף
  ד3.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד3.קבע_נבחר(אמת)
    רענון_מצב()
  סוף
  ד4.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד4.קבע_נבחר(אמת)
    רענון_מצב()
  סוף
  ד5.בלחיצה = פונקציה (א, י, כ)
    צבע_א = א
    צבע_י = י
    צבע_כ = כ
    נקה_בחירת_צבע()
    ד5.קבע_נבחר(אמת)
    רענון_מצב()
  סוף
  ד1.קבע_נבחר(אמת)

  לוח.הוסף(ד1)
  לוח.הוסף(ד2)
  לוח.הוסף(ד3)
  לוח.הוסף(ד4)
  לוח.הוסף(ד5)

  רענון_מצב()
  לוח.רענון()

  ח.הוסף(לוח.משטח_גלוי())
  ח.הצג()
סוף

בנה_חלון()
