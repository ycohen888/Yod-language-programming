// חברות.יוד — שחקנים, ציוד, AI
פונקציה שם_שחקן(אינדקס) {
    אם (אינדקס == 0) {
        החזר "חברת צפון"
    }
    אם (מול_מחשב) {
        החזר "חברת מכונה"
    }
    החזר "חברת דרום"
}

פונקציה צבע_שחקן(אינדקס) {
    אם (אינדקס == 0) {
        החזר [חברה0_א, חברה0_י, חברה0_כ]
    }
    החזר [חברה1_א, חברה1_י, חברה1_כ]
}

פונקציה צור_שחקן(אינדקס) {
    החזר{ שם: שם_שחקן(אינדקס), כסף: כסף_התחלה, ממתין: 0, מקדחה: 0, פועלים: 0, גלאי: שקר, דינמיט: 0, נתיב: שקר, קנה_ראשון: שקר, מלאי: [0, 0, 0, 0, 0], מוניטין: 0}
}

פונקציה אתחל_שחקנים() {
    שחקנים = []
    שחקנים.הוסף: צור_שחקן(0)
    שחקנים.הוסף: צור_שחקן(1)
}

פונקציה ספור_מכרות(שחקן) {
    משתנה n = 0
    משתנה i = 0
    כל_עוד (i < חלקות.גודל()) {
        אם (חלקות[i]["בעלים"] == שחקן) {
            n = n + 1
        }
        i = i + 1
    }
    החזר n
}

פונקציה עדכן_מוניטין(שחקן) {
    משתנה ש = שחקנים[שחקן]
    משתנה מ = ספור_מכרות(שחקן)
    ש["מוניטין"] = מ * 10
    אם (ש["מקדחה"] > 0) {
        ש["מוניטין"] = ש["מוניטין"] + ש["מקדחה"] * 5
    }
    אם (ש["נתיב"]) {
        ש["מוניטין"] = ש["מוניטין"] + 8
    }
}

פונקציה קנה_מקדחה(דרגה) {
    משתנה ש = שחקנים[תור]
    אם (דרגה <= ש["מקדחה"]) {
        הודעה = "כבר יש לכם מקדחה ברמה הזו או גבוהה יותר"
        החזר שקר
    }
    משתנה מחיר = מחיר_מקדחה[דרגה]
    אם (ש["כסף"] < מחיר) {
        הודעה = "אין מספיק מזומן למקדחה"
        החזר שקר
    }
    ש["כסף"] = ש["כסף"] - מחיר
    ש["מקדחה"] = דרגה
    הודעה = "נרכשה מקדחה " + שמות_מקדחה[דרגה]
    עדכן_מוניטין: תור
    החזר אמת
}

פונקציה גייס_פועל() {
    משתנה ש = שחקנים[תור]
    אם (ש["כסף"] < מחיר_פועל) {
        הודעה = "אין מספיק מזומן לפועל"
        החזר שקר
    }
    ש["כסף"] = ש["כסף"] - מחיר_פועל
    ש["פועלים"] = ש["פועלים"] + 1
    הודעה = "גויס פועל חדש · סה״כ " + ש["פועלים"]
    עדכן_מוניטין: תור
    החזר אמת
}

פונקציה קנה_גלאי() {
    משתנה ש = שחקנים[תור]
    אם (ש["גלאי"]) {
        הודעה = "כבר יש גלאי בחברה"
        החזר שקר
    }
    אם (ש["כסף"] < מחיר_גלאי) {
        הודעה = "אין מספיק מזומן לגלאי"
        החזר שקר
    }
    ש["כסף"] = ש["כסף"] - מחיר_גלאי
    ש["גלאי"] = אמת
    הודעה = "גלאי משאבים הותקן"
    עדכן_מוניטין: תור
    החזר אמת
}

פונקציה קנה_דינמיט() {
    משתנה ש = שחקנים[תור]
    אם (ש["כסף"] < מחיר_דינמיט) {
        הודעה = "אין מספיק מזומן לדינמיט"
        החזר שקר
    }
    ש["כסף"] = ש["כסף"] - מחיר_דינמיט
    ש["דינמיט"] = ש["דינמיט"] + 1
    הודעה = "נוסף דינמיט למלאי · " + ש["דינמיט"]
    החזר אמת
}

פונקציה קנה_נתיב() {
    משתנה ש = שחקנים[תור]
    אם (ש["נתיב"]) {
        הודעה = "כבר יש נתיב למחנה"
        החזר שקר
    }
    אם (ספור_מכרות(תור) < 2) {
        הודעה = "נתיב זמין אחרי שתי חלקות לפחות"
        החזר שקר
    }
    אם (ש["כסף"] < מחיר_נתיב) {
        הודעה = "אין מספיק מזומן לנתיב"
        החזר שקר
    }
    ש["כסף"] = ש["כסף"] - מחיר_נתיב
    ש["נתיב"] = אמת
    הודעה = "נפרס נתיב הובלה למחנה"
    עדכן_מוניטין: תור
    החזר אמת
}

פונקציה בחר_חלקה_ל_AI() {
    משתנה ש = שחקנים[תור]
    משתנה הכי_טוב = ריק
    משתנה ציון_טוב = 0 - 1
    משתנה i = 0
    כל_עוד (i < חלקות.גודל()) {
        משתנה ח = חלקות[i]
        אם (ח["בעלים"] == ריק) {
            משתנה מחיר = מחיר_לחישוב(ח, תור)
            אם (ש["כסף"] >= מחיר) {
                משתנה ציון = ח["איכות"] * 1000000 / מחיר
                אם (מכרז_אינדקס == i) {
                    ציון = ציון + 2
                }
                אם (ציון > ציון_טוב) {
                    ציון_טוב = ציון
                    הכי_טוב = i
                }
            }
        }
        i = i + 1
    }
    החזר הכי_טוב
}

פונקציה מהלך_AI() {
    אם (מסך != "משחק") {
        החזר ריק
    }
    משתנה ש = שחקנים[תור]
    אם (לא ש["גלאי"] וגם ש["כסף"] >= מחיר_גלאי וגם ספור_מכרות(תור) >= 1) {
        קנה_גלאי()
        סיים_תור()
        החזר ריק
    }
    אם (ש["מקדחה"] < 1 וגם ש["כסף"] >= מחיר_מקדחה[1]) {
        קנה_מקדחה: 1
        סיים_תור()
        החזר ריק
    }
    אם (ש["פועלים"] < 2 וגם ש["כסף"] >= מחיר_פועל וגם ספור_מכרות(תור) >= 1) {
        גייס_פועל()
        סיים_תור()
        החזר ריק
    }
    משתנה יעד = בחר_חלקה_ל_AI()
    אם (יעד != ריק) {
        רכוש_חלקה: יעד
        החזר ריק
    }
    הודעה = שם_שחקן(תור) + " מעבירה תור"
    סיים_תור()
}
