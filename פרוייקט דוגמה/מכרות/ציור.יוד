            לוח.טקסט: "" + ממ.גודל() + "ס", px + 22, py + 22
          סוף

          אם ת["בעלים"] == 0
            לוח.קבע_צבע: שחקן1_א, שחקן1_י, שחקן1_כ
          אחרת
            לוח.קבע_צבע: שחקן2_א, שחקן2_י, שחקן2_כ
          סוף
          לוח.קבע_עובי: 3
          לוח.מלבן: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4
        אחרת
          צייר_שטח_פתוח: px, py, ת["שטח"]
          אם ת["מחיר"] >= 25000
            לוח.קבע_צבע: 255, 200, 60
            לוח.קבע_עובי: 2
            לוח.מלבן: px + 2, py + 2, גודל_תא - 4, גודל_תא - 4
          סוף
          אם ת["מחיר"] >= 5000 וגם ת["מחיר"] < 25000
