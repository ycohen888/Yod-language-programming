// כפתור_איקון.יוד — תמונה ממורכזת; כיתוב מיושר לפי כיוון
מחלקה כפתור_איקון מרחיב רכיב {
    פונקציה בנאי(x, y, נתיב) {
        הורה(x, y, 32, 32)
        זה.נתיב = נתיב
        זה.טקסט = ""
        זה.פעיל = שקר
        זה.בלחיצה = ריק
        זה.ריפוד = 6
        זה.רדיוס = 7
    }
    פונקציה קבע_נתיב(p) {
        זה.נתיב = p
        זה.בקש_רענון()
    }
    פונקציה קבע_טקסט(t) {
        זה.טקסט = t
        זה.בקש_רענון()
    }
    פונקציה קבע_פעיל(v) {
        זה.פעיל = v
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משתנה מא = ערכה_גובה_א
        משתנה מי = ערכה_גובה_י
        משתנה מכ = ערכה_גובה_כ
        אם (זה.פעיל) {
            מא = ערכה_ראשי_א
            מי = ערכה_ראשי_י
            מכ = ערכה_ראשי_כ
        }
        אם (זה.לחוץ) {
            מא = 34
            מי = 36
            מכ = 42
        }
        מלבן_מעוגל_רך(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.רדיוס, מא, מי, מכ)
        משתנה pad = זה.ריפוד
        משתנה iw = זה.רחב - 2 * pad
        משתנה ih = זה.גבה - 2 * pad
        אם (זה.טקסט != "" וגם זה.טקסט != ריק) {
            ih = ih - 10
        }
        אם (זה.נתיב != "" וגם זה.נתיב != ריק וגם iw > 0 וגם ih > 0) {
            משטח.תמונה(זה.נתיב, זה.x + pad, זה.y + pad, iw, ih)
        }
        אם (זה.טקסט != "" וגם זה.טקסט != ריק) {
            משטח.קבע_צבע(ערכה_טקסט_א, ערכה_טקסט_י, ערכה_טקסט_כ)
            משטח.קבע_גודל_גופן(9)
            צייר_טקסט_ברכיב(משטח, זה, זה.טקסט, זה.y + זה.גבה - 11, 4)
        }
    }
    פונקציה בעכבר_למטה(mx, my, כפתור) {
        אם (זה.מושבת או לא זה.מכיל(mx, my)) {
            החזר שקר
        }
        זה.לחוץ = אמת
        זה.בקש_רענון()
        החזר אמת
    }
    פונקציה בעכבר_למעלה(mx, my, כפתור) {
        אם (לא זה.לחוץ) {
            החזר ריק
        }
        זה.לחוץ = שקר
        זה.בקש_רענון()
        אם (זה.מכיל(mx, my) וגם זה.בלחיצה != ריק) {
            זה.בלחיצה()
        }
    }
}
