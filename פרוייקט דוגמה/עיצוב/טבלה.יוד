// טבלה.יוד — Table
כלול "פקד.יוד"

מחלקה טבלה מרחיב פקד {
    פונקציה בנאי(עמודות, שורות = [], מזהה = "") {
        אם (עמודות == ריק) {
            עמודות = []
        }
        אם (שורות == ריק) {
            שורות = []
        }
        הורה(מזהה)
        זה.עמודות = עמודות
        זה.שורות = שורות
        זה.ערך = ""
        זה._לחץ = ריק
        זה._שינוי = ריק
        זה._צור("טבלה", {
            "עמודות": עמודות,
            "שורות": שורות
        })
    }

    פונקציה קבע_עמודות(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.עמודות = רשימה
        זה._שלח_פקודה("קבע_עמודות", { "עמודות": רשימה })
    }

    פונקציה קבע_שורות(רשימה) {
        אם (רשימה == ריק) {
            רשימה = []
        }
        זה.שורות = רשימה
        זה._שלח_פקודה("קבע_שורות", { "שורות": רשימה })
    }

    פונקציה קבע_ערך(ט) {
        אם (ט == ריק) {
            ט = ""
        }
        זה.ערך = ט
        זה._שלח_פקודה("קבע_ערך", { "ערך": ט })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה בלחיצה(פונק) {
        זה._לחץ = פונק
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
