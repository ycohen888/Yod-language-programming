// רכיב.יוד — בסיס לכל רכיב מצויר על משטח

מחלקה רכיב
  פונקציה בנאי(x, y, רחב, גבה)
    זה.x = x
    זה.y = y
    זה.רחב = רחב
    זה.גבה = גבה
    זה.גלוי = אמת
    זה.מושבת = שקר
    זה.לחוץ = שקר
    זה.לוח = ריק
    זה.רמז = ""
  סוף

  פונקציה קבע_רמז(t)
    אם t == ריק
      זה.רמז = ""
    אחרת
      זה.רמז = t
    סוף
  סוף

  פונקציה מקבל_מיקוד()
    החזר שקר
  סוף

  פונקציה קבע_מיקוד(v)
  סוף

  פונקציה בעת_תו(תו)
  סוף

  פונקציה בעת_מקש(שם)
  סוף

  פונקציה מכיל(mx, my)
    אם !זה.גלוי
      החזר שקר
    סוף
    החזר נקודה_במלבן(mx, my, זה.x, זה.y, זה.רחב, זה.גבה)
  סוף

  פונקציה צייר(משטח)
    // נדרס במחלקות יורשות
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    החזר שקר
  סוף

  פונקציה בעכבר_גרירה(mx, my, כפתור)
  סוף

  פונקציה בעכבר_למעלה(mx, my, כפתור)
  סוף

  פונקציה בקש_רענון()
    אם זה.לוח != ריק
      זה.לוח.סמן_רענון()
    סוף
  סוף
סוף
