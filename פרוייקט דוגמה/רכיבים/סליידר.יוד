// סליידר.יוד — פס גרירה מעוגל (צעד שלם כברירת מחדל)

מחלקה סליידר מרחיב רכיב
  פונקציה בנאי(x, y, רחב, מינ, מקס, ערך)
    הורה(x, y, רחב, 28)
    זה.מינ = מינ
    זה.מקס = מקס
    זה.צעד = 1
    זה.ערך = עגל_לצעד(הגבל(ערך, מינ, מקס), זה.צעד)
    זה.בשינוי = ריק
    זה.גובה_מסלול = 8
    זה.רדיוס_ידית = 10
  סוף

  פונקציה נרמל(v)
    החזר עגל_לצעד(הגבל(v, זה.מינ, זה.מקס), זה.צעד)
  סוף

  פונקציה קבע_ערך(v)
    משתנה קודם = זה.ערך
    זה.ערך = זה.נרמל(v)
    אם זה.ערך != קודם
      זה.בקש_רענון()
      אם זה.בשינוי != ריק
        זה.בשינוי(זה.ערך)
      סוף
    סוף
  סוף

  פונקציה קבע_ערך_שקט(v)
    משתנה קודם = זה.ערך
    זה.ערך = זה.נרמל(v)
    אם זה.ערך != קודם
      זה.בקש_רענון()
    סוף
  סוף

  פונקציה ערך_נוכחי()
    החזר זה.ערך
  סוף

  פונקציה ידית_x()
    משתנה טווח = זה.מקס - זה.מינ
    אם טווח <= 0
      החזר זה.x + זה.רדיוס_ידית
    סוף
    משתנה t = (זה.ערך - זה.מינ) / טווח
    החזר זה.x + זה.רדיוס_ידית + t * (זה.רחב - 2 * זה.רדיוס_ידית)
  סוף

  פונקציה ערך_ממיקום(mx)
    משתנה פנימי = זה.רחב - 2 * זה.רדיוס_ידית
    אם פנימי <= 0
      החזר זה.מינ
    סוף
    משתנה t = (mx - זה.x - זה.רדיוס_ידית) / פנימי
    t = הגבל(t, 0, 1)
    החזר זה.נרמל(זה.מינ + t * (זה.מקס - זה.מינ))
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משתנה my = זה.y + זה.גבה / 2
    משתנה mx0 = זה.x + זה.רדיוס_ידית
    משתנה mw = זה.רחב - 2 * זה.רדיוס_ידית
    משתנה th = זה.גובה_מסלול
    משטח.קבע_מילוי(48, 52, 60)
    מלבן_מעוגל_מלא(משטח, mx0, my - th / 2, mw, th, th / 2)
    משתנה hx = זה.ידית_x()
    משתנה fill_w = hx - mx0
    אם fill_w > 0
      משטח.קבע_מילוי(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
      מלבן_מעוגל_מלא(משטח, mx0, my - th / 2, fill_w, th, th / 2)
    סוף
    // צל ידית
    משטח.קבע_מילוי(12, 14, 18)
    משטח.עיגול_מלא(hx + 1, my + 1, זה.רדיוס_ידית)
    משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
    אם זה.לחוץ
      משטח.קבע_מילוי(140, 235, 215)
    סוף
    משטח.עיגול_מלא(hx, my, זה.רדיוס_ידית)
    משטח.קבע_מילוי(255, 255, 255)
    משטח.עיגול_מלא(hx - 2, my - 3, 3)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.לחוץ = אמת
    זה.קבע_ערך(זה.ערך_ממיקום(mx))
    החזר אמת
  סוף

  פונקציה בעכבר_גרירה(mx, my, כפתור)
    אם זה.לחוץ
      זה.קבע_ערך(זה.ערך_ממיקום(mx))
    סוף
  סוף

  פונקציה בעכבר_למעלה(mx, my, כפתור)
    אם זה.לחוץ
      זה.לחוץ = שקר
      זה.בקש_רענון()
    סוף
  סוף
סוף
