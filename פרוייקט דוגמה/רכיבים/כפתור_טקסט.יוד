// כפתור_טקסט.יוד — כפתור טקסט בלי רקע (קישור)

מחלקה כפתור_טקסט מרחיב רכיב
  פונקציה בנאי(x, y, טקסט)
    הורה(x, y, 10 + אורך(טקסט) * 7, 18)
    זה.טקסט = טקסט
    זה.בלחיצה = ריק
  סוף

  פונקציה צייר(משטח)
    אם לא זה.גלוי
      החזר ריק
    סוף
    משטח.קבע_צבע(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
    אם זה.לחוץ
      משטח.קבע_צבע(ערכה_ראשי_א, ערכה_ראשי_י, ערכה_ראשי_כ)
    סוף
    משטח.קבע_גודל_גופן(11)
    משטח.טקסט(זה.טקסט, זה.x, זה.y + 2)
    משטח.קבע_מילוי(ערכה_הדגש_א, ערכה_הדגש_י, ערכה_הדגש_כ)
    משטח.מלבן_מלא(זה.x, זה.y + זה.גבה - 2, זה.רחב - 4, 1)
  סוף

  פונקציה בעכבר_למטה(mx, my, כפתור)
    אם זה.מושבת או לא זה.מכיל(mx, my)
      החזר שקר
    סוף
    זה.לחוץ = אמת
    זה.בקש_רענון()
    החזר אמת
  סוף

  פונקציה בעכבר_למעלה(mx, my, כפתור)
    אם לא זה.לחוץ
      החזר ריק
    סוף
    זה.לחוץ = שקר
    זה.בקש_רענון()
    אם זה.מכיל(mx, my) וגם זה.בלחיצה != ריק
      זה.בלחיצה()
    סוף
  סוף
סוף
