// מחלקות במכונה
// yod מכונה examples\vm_mahlaka.יוד
מחלקה שחקן
    משתנה נקודות = 0
    פונקציה בנאי(שם)
        זה.שם = שם
    סוף
    פונקציה הוסף_נקודה()
        זה.נקודות = זה.נקודות + 1
    סוף
    פונקציה הצג()
        הדפס(זה.שם + " — נקודות: " + זה.נקודות)
    סוף
סוף

משתנה פ = חדש שחקן("נועם")
פ.הוסף_נקודה()
פ.הוסף_נקודה()
פ.הצג()
