// הפעלה.יוד — טעינת מודולים, פתיחת מסד, ובניית החלון
כלול "חלונות"
כלול "קבצים"
כלול "מערכת"
כלול "..\עיצוב\עיצוב_הכל.יוד"
כלול "מסד.יוד"
כלול "ממשק.יוד"

יצא פונקציה הפעל_מטלות() {
    // הרצה מתיקיית התוכנה — כדי שנתיבי העיצוב/המסד יהיו יחסיים אליה
    נסה {
        משתנה תיק_הרצה = מערכת.תיקיית_הרצה()
        אם (תיק_הרצה != ריק וגם תיק_הרצה != "") {
            מערכת.שנה_תיקייה(תיק_הרצה)
        }
    } תפוס שגיאה {
    }
    פתח_מסד()
    בנה_חלון_מטלות()
}
