// לוח_משחק.יוד — שטחים, קנייה/פיתוח ותורות
פונקציה אינדקס_תא(x, y) {
    החזר y * גודל_לוח + x
}

פונקציה תא_ב(x, y) {
    החזר תאים[אינדקס_תא(x, y)]
}

פונקציה גלגל_שטח() {
    משתנה ר = אקראי() * 100
    אם (ר < 30) {
        החזר 0
    }
    אם (ר < 55) {
        החזר 1
    }
    אם (ר < 75) {
        החזר 2
    }
    החזר 3
}

פונקציה סוג_כבר_קיים(ממצאים, סוג) {
    משתנה i = 0
    כל_עוד (i < ממצאים.גודל()) {
        אם (ממצאים[i]["סוג"] == סוג) {
            החזר אמת
        }
        i = i + 1
    }
    החזר שקר
}

פונקציה זרע_ממצאים(שטח) {
    // תמיד לפחות משאב אחד — יכול להיות מעט מאוד
    משתנה ממצאים = []
    משתנה כמה = מספר_סוגים(שטח)
    משתנה ניסיונות = 0
    כל_עוד (ממצאים.גודל() < כמה וגם ניסיונות < 30) {
        משתנה סוג = גלגל_סוג_משאב(שטח)
        אם (לא סוג_כבר_קיים(ממצאים, סוג)) {
            משתנה כמות = גלגל_כמות(שטח, סוג)
            אם (כמות < 1) {
                כמות = 1
            }
            משתנה פריט ={ "סוג": סוג, "כמות": כמות}
            ממצאים.הוסף: פריט
        }
        ניסיונות = ניסיונות + 1
    }
    אם (ממצאים.גודל() == 0) {
        משתנה ס = 0
        אם (שטח == 3) {
            ס = 11
        }
        משתנה פריט_בסיס ={ "סוג": ס, "כמות": 1}
        ממצאים.הוסף: פריט_בסיס
    }
    החזר ממצאים
}

פונקציה זרע_לוח() {
    תאים = []
    משתנה y = 0
    כל_עוד (y < גודל_לוח) {
        משתנה x = 0
        כל_עוד (x < גודל_לוח) {
            משתנה שטח = גלגל_שטח()
            משתנה ממצאים = זרע_ממצאים(שטח)
            משתנה ערך = ערך_ממצאים(ממצאים)
            משתנה מחיר = חשב_מחיר_קנייה(ערך, שטח)
            משתנה תא_חדש ={ "x": x, "y": y, "שטח": שטח, "חפור": שקר, "בעלים": 0 - 1, "משאב": 0 - 1, "כמות": 0, "ממצאים": ממצאים, "ערך": ערך, "מחיר": מחיר, "שבוע_קנייה": 0}
            תאים.הוסף: תא_חדש
            x = x + 1
        }
        y = y + 1
    }
}

פונקציה צור_שחקן(שם, מחשב) {
    משתנה ש ={ "שם": שם, "כסף": כסף_התחלה, "מקדחה": 0, "פועלים": 0, "סהכ_רווח": 0, "ממתין": 0, "מחשב": מחשב, "גלאי": שקר, "משאית": שקר, "דינמיט": 0, "קנה_מכרה": שקר}
    החזר ש
}

פונקציה עדכן_הודעת_תור() {
    הודעה = "★ תור " + שם_שחקן(תור) + " — כסף מהמכרות בסוף השבוע · תורות " + מהלכים_בשבוע + "/" + מהלכים_לשבוע
}

פונקציה התחל_משחק(שני_שחקנים) {
    בטל_טיימר_AI()
    מצב_2_שחקנים = שני_שחקנים
    שחקנים = []
    שחקנים.הוסף: צור_שחקן("שחקן 1", שקר)
    אם (שני_שחקנים) {
        שחקנים.הוסף: צור_שחקן("שחקן 2", שקר)
    } אחרת {
        שחקנים.הוסף: צור_שחקן("מחשב", אמת)
    }
    תור = 0
    שבוע = 1
    יום = 1
    מהלכים_בשבוע = 0
    מצב_דינמיט = שקר
    מעקב_x = 0 - 1
    מעקב_y = 0 - 1
    שורות_פתוחות = 6
    יומן = []
    אפס_סיכום_שבוע()
    זרע_לוח()
    מצב_מסך = "משחק"
    עדכן_הודעת_תור()
    הוסף_ליומן: "המשחק התחיל — אחרי מכרה ראשונה מחירים פי " + מכפיל_אחרי_מכרה_ראשונה + " לשחקן שקנה"
    צייר_הכל()
}

פונקציה סיום_שבוע() {
    // קודם תפוקה ממכרות ישנות — גם למי שלא חפר השבוע
    קצור_מכרות_מבעלות()
    מצב_מסך = "דוח"
    הודעה = "סיכום שבוע " + שבוע + " — לחצו «המשך» לקבלת הכסף"
    צייר_הכל()
}

פונקציה המשך_אחרי_דוח() {
    // קודם נכנס הכסף לחשבון, אחר כך משכורות
    זכה_כסף_שבועי()
    לשלם_משכורות()
    אפס_סיכום_שבוע()
    שבוע = שבוע + 1
    מהלכים_בשבוע = 0
    מצב_מסך = "משחק"
    עדכן_הודעת_תור()
    אולי_מהלך_מחשב()
    צייר_הכל()
}

פונקציה בדוק_ניצחון() {
    // משחק בלי סוף — אין ניצחון אוטומטי
}

פונקציה סיים_תור() {
    יום = יום + 1
    מהלכים_בשבוע = מהלכים_בשבוע + 1
    מצב_דינמיט = שקר
    תור = 1 - תור
    אם (מהלכים_בשבוע >= מהלכים_לשבוע) {
        סיום_שבוע()
        החזר ריק
    }
    עדכן_הודעת_תור()
    אולי_מהלך_מחשב()
    צייר_הכל()
}

פונקציה חפור_בתא(x, y) {
    אם (מצב_מסך != "משחק") {
        החזר ריק
    }
    אם (y >= שורות_פתוחות) {
        הודעה = "השורה נעולה — הרחיבו את הלוח"
        צייר_הכל()
        החזר ריק
    }
    משתנה ת = תא_ב(x, y)
    אם (ת["חפור"]) {
        הודעה = "הנכס כבר נרכש — בחרו שטח פנוי"
        צייר_הכל()
        החזר ריק
    }
    משתנה ש = שחקן_נוכחי()
    משתנה עלות = עלות_תא(ת)
    משתנה תוספת_דינמיט = 0
    אם (מצב_דינמיט) {
        אם (ש["דינמיט"] < 1) {
            מצב_דינמיט = שקר
            הודעה = "אין דינמיט במלאי"
            צייר_הכל()
            החזר ריק
        }
        שחקנים[תור]["דינמיט"] = שחקנים[תור]["דינמיט"] - 1
        תוספת_דינמיט = בונוס_דינמיט_כמות
        מצב_דינמיט = שקר
    }
    אם (שחקנים[תור]["כסף"] < עלות) {
        הודעה = "אין מספיק כסף — הנכס עולה " + מספרים.שלם(עלות) + "₪"
        צייר_הכל()
        החזר ריק
    }
    // משלמים על הקנייה עכשיו — רווח המציאות נכנס רק בסוף השבוע
    שחקנים[תור]["כסף"] = שחקנים[תור]["כסף"] - עלות
    ת["חפור"] = אמת
    ת["בעלים"] = תור
    ת["שבוע_קנייה"] = שבוע
    משתנה ממצאים = ת["ממצאים"]
    ממצאים = החל_בונוס_מציאה(ממצאים, תור, תוספת_דינמיט)
    משתנה רווח_גולמי = ערך_ממצאים(ממצאים)
    משתנה רווח = רווח_גולמי
    אם (שחקנים[תור]["משאית"]) {
        רווח = (רווח_גולמי * 125 / 100).שלם()
    }
    ת["משאב"] = משאב_עיקרי(ממצאים)
    ת["כמות"] = ממצאים.גודל()
    ת["ממצאים"] = ממצאים
    ת["ערך"] = רווח_גולמי
    הוסף_לשבוע: תור, ממצאים, רווח, "מציאה"
    אם (לא שחקנים[תור]["קנה_מכרה"]) {
        שחקנים[תור]["קנה_מכרה"] = אמת
        הוסף_ליומן: שם_שחקן(תור) + " קנה מכרה ראשונה — מעתה מחירים פי " + מכפיל_אחרי_מכרה_ראשונה + " עבורו"
        הודעה = "✓ " + תיאור_ממצאים(ממצאים) + " · +" + מספרים.שלם(רווח) + "₪ · מחירים עלו פי " + מכפיל_אחרי_מכרה_ראשונה
    } אחרת {
        הודעה = "✓ " + תיאור_ממצאים(ממצאים) + " · +" + מספרים.שלם(רווח) + "₪ ייכנסו בסוף השבוע"
    }
    משתנה תיאור = תיאור_ממצאים(ממצאים)
    הוסף_ליומן: שם_שחקן(תור) + " קנה מכרה · מצא " + תיאור + " · +" + מספרים.שלם(רווח) + "₪ ממתינים · שילם " + מספרים.שלם(עלות) + "₪"
    סיים_תור()
}
