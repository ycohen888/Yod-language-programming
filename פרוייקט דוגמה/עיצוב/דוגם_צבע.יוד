// דוגם_צבע.יוד — Eyedropper (דגימת צבע מהמסך)
כלול "פקד.יוד"

מחלקה דוגם_צבע מרחיב פקד {
    פונקציה בנאי(טקסט = "דוגם צבע", צבע = "", מזהה = "") {
        אם (טקסט == ריק או טקסט == "") {
            טקסט = "דוגם צבע"
        }
        אם (צבע == ריק) {
            צבע = ""
        }
        הורה(מזהה)
        זה.טקסט = טקסט
        זה.ערך = צבע
        זה._שינוי = ריק
        זה._צור("דוגם_צבע", {
            "טקסט": טקסט,
            "ערך": צבע
        })
    }

    פונקציה קבע_ערך(צבע) {
        אם (צבע == ריק) {
            צבע = ""
        }
        זה.ערך = צבע
        זה._שלח_פקודה("קבע_ערך", { "ערך": צבע })
    }

    פונקציה קבל_ערך() {
        החזר זה.ערך
    }

    פונקציה דגום() {
        זה._שלח_פקודה("דגום", {})
    }

    פונקציה בשינוי(פונק) {
        זה._שינוי = פונק
    }
}
