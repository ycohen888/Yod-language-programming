  קו.קבע_סדרות: [
    {"שם": "אפליקציה", "ערכים": [120, 180, 210, 260], "צבע": "ירוק"},
    {"שם": "אתר", "ערכים": [90, 130, 150, 190], "צבע": "כתום"}
