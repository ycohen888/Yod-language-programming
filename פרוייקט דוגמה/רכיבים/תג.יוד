// תג.יוד — באדג׳; רוחב לפי מדידת טקסט, תוכן ממורכז
מחלקה תג מרחיב רכיב {
    פונקציה בנאי(x, y, טקסט) {
        הורה(x, y, 56, 18)
        זה.טקסט = טקסט
        זה.אדום = ערכה_ראשי_א
        זה.ירוק = ערכה_ראשי_י
        זה.כחול = ערכה_ראשי_כ
    }
    פונקציה קבע_טקסט(t) {
        זה.טקסט = t
        זה.בקש_רענון()
    }
    פונקציה קבע_צבע_rgb(א, י, כ) {
        זה.אדום = א
        זה.ירוק = י
        זה.כחול = כ
        זה.בקש_רענון()
    }
    פונקציה צייר(משטח) {
        אם (לא זה.גלוי) {
            החזר ריק
        }
        משטח.קבע_גודל_גופן(10)
        משתנה tw = אומדן_רוחב_טקסט(משטח, זה.טקסט)
        משתנה rw = 16 + tw
        אם (rw < 32) {
            rw = 32
        }
        זה.רחב = rw
        משטח.קבע_מילוי(זה.אדום, זה.ירוק, זה.כחול)
        מלבן_מעוגל_מלא(משטח, זה.x, זה.y, זה.רחב, זה.גבה, זה.גבה / 2)
        משטח.קבע_צבע(240, 250, 248)
        צייר_טקסט_ממורכז(משטח, זה, זה.טקסט, זה.y + 3)
    }
}
